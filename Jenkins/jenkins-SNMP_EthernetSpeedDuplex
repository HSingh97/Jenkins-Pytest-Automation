import jenkins.model.Jenkins

// Renamed the function to avoid conflict with the built-in step call syntax.
def archiveTestArtifacts(pattern) {
    // Corrected to use the standard built-in step notation
    archiveArtifacts artifacts: pattern, fingerprint: true, onlyIfSuccessful: false
}
// ------------------------------------------------------------------------------------------------------------------

pipeline {
    // Defines the Jenkins node where the pipeline will run.
    agent {
        node {
            // The parameter is defined in the Jenkins UI, accessed via params.TARGET_STAND
            label "${params.TARGET_STAND}"
        }
    }

    stages {
        stage('Preparation') {
            steps {
                script {
                    // FIX 1: Access parameter safely using .toString() to prevent NullPointerException on .trim()
                    def localIP = params.LOCAL_IP_ADDRESS.toString().trim()

                    echo "----------------------------------------"
                    echo "LOCAL IP: ${localIP}"
                    echo "ITERATION COUNT: ${params.ITERATION_COUNT}"
                    echo "TARGET STAND: ${params.TARGET_STAND}"
                    echo "----------------------------------------"

                    def resultFile = "EthernetSpeedDuplexTest.json"

                    // Clean up the workspace before the test run.
                    sh "rm -f ${resultFile} test-*.log debug_ethernet_table_iter*.txt || true"
                    // Initialize the JSON file as the Python script reads it initially.
                    sh "echo '{\"iterations\": []}' > ${resultFile}"
                    echo "Cleared old workspace and initialized ${resultFile}"
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    echo "----------------------------------------"
                    echo "Installing Dependencies"
                    echo "----------------------------------------"
                }
            }
        }

        stage('Run SNMP Duplex Test') {
            steps {
                script {
                    // FIX 1 APPLIED HERE
                    def localIP = params.LOCAL_IP_ADDRESS.toString().trim()
                    def count = params.ITERATION_COUNT.toInteger()
                    def scriptName = "EthernetSpeedDuplexTest.py"

                    echo "----------------------------------------"
                    echo "Starting Ethernet Speed/Duplex Test (Total Iterations: ${count})"
                    echo "----------------------------------------"

                    for (int i = 1; i <= count; i++) {
                        echo "=== DUPLEX TEST ITERATION ${i} of ${count} ==="
                        try {
                            // Pass the localIP value to the script's --su-ip argument
                            sh """
                                set -x
                                python3 ${scriptName} \\
                                --su-ip '${localIP}' \\
                                --iter ${i}
                            """
                        } catch (err) {
                            echo "Iteration ${i} FAILED: ${err}"
                        }
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def resultFile = "EthernetSpeedDuplexTest.json"
                    def reportJsonFile = "test_results.json"

                    // Rename the test script's result file for generic reporting
                    sh "mv ${resultFile} ${reportJsonFile} || true"

                    // FIX 1 APPLIED HERE
                    def localIP = params.LOCAL_IP_ADDRESS.toString().trim()
                    // Variable name corrected to local_fw
                    def local_fw = "N/A"

                    // Safely attempt to fetch firmware version using localIP
                    try {
                        local_fw = sh(
                            script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${localIP} 'cat /etc/version 2>/dev/null || echo Unknown'",
                            returnStdout: true
                        ).trim()
                    } catch (e) { echo "Could not fetch FW version" }

                    // Read the aggregated results JSON file
                    def jsonReport = readJSON file: reportJsonFile
                    def total = jsonReport.iterations?.size() ?: 0

                    def pass = jsonReport.iterations?.count { it.overall_status == 'PASS' } ?: 0
                    def fail = total - pass
                    def rate = total > 0 ? String.format("%.1f", (pass * 100.0 / total)) : "0.0"

                    def buildParams = [
                        "Local IP Address": localIP,
                        "FW Version (Local)": local_fw,
                        "Iteration Count": params.ITERATION_COUNT,
                        "Target Stand": params.TARGET_STAND
                    ]
                    def istDate = new Date().format("dd MMM yyyy, HH:mm:ss z", TimeZone.getTimeZone("Asia/Kolkata"))

                    // --- HTML Report Generation ---
                    def companyLogoUrl = "https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png"
                    def pipelineName = env.JOB_NAME
                    def currentDateTime = istDate
                    def successPercentageStr = rate
                    def totalTests = total
                    def passCount = pass
                    def failCount = fail
                    def reportFilename = "report.html"

                    // Start of HTML Content
                    def htmlContent = """
                    <html>
                    <head>
                        <title>Ethernet Speed/Duplex Test Report</title>
                        <style>
                            /* ... (CSS and JS content skipped for brevity) ... */
                        </style>
                        <script>
                            function showLog(logDataId) {
                                var logContent = document.getElementById(logDataId).innerHTML;
                                document.getElementById('log-content-pre').innerHTML = logContent;
                                document.getElementById('logModal').style.display = 'block';
                            }
                            function closeModal() {
                                document.getElementById('logModal').style.display = 'none';
                            }
                            window.onclick = function(event) {
                                var modal = document.getElementById('logModal');
                                if (event.target == modal) {
                                    modal.style.display = 'none';
                                }
                            }
                        </script>
                    </head>
                    <body>
                        <div class="container">
                            <div class="header">
                                <img src="${companyLogoUrl}" alt="Senao Networks, Inc."/>
                                <div class="header-info">
                                    <h1>Automated Test Report: Ethernet Speed/Duplex</h1>
                                    <p><strong>Pipeline:</strong> ${pipelineName}</p>
                                    <p><strong>Date & Time:</strong> ${currentDateTime}</p>
                                </div>
                            </div>

                            <h2>Build Parameters</h2>
                            <table>
                                <tr>
                                    <th>Parameter</th>
                                    <th>Value</th>
                                </tr>
                                ${buildParams.collect { "<tr><td><b>${it.key}</b></td><td>${it.value}</td></tr>" }.join('\n')}
                            </table>

                            <h2>Test Summary (Overall Iterations)</h2>
                            <div class="summary-container">
                                <div class="summary-card card-percent">
                                    <div class="card-icon">🎯</div>
                                    <div class="card-info">
                                        <p class="card-info-title">Success Rate</p>
                                        <p class="card-info-value percent">${successPercentageStr}<span class="percent-sign">%</span></p>
                                    </div>
                                </div>
                                <div class="summary-card card-total">
                                    <div class="card-icon">📦</div>
                                    <div class="card-info">
                                        <p class="card-info-title">Total Iterations</p>
                                        <p class="card-info-value">${totalTests}</p>
                                    </div>
                                </div>
                                <div class="summary-card card-pass">
                                    <div class="card-icon">✅</div>
                                    <div class="card-info">
                                        <p class="card-info-title">Passed</p>
                                        <p class="card-info-value">${passCount}</p>
                                    </div>
                                </div>
                                <div class="summary-card card-fail">
                                    <div class="card-icon">❌</div>
                                    <div class="card-info">
                                        <p class="card-info-title">Failed</p>
                                        <p class="card-info-value">${failCount}</p>
                                    </div>
                                </div>
                            </div>

                            <h2>Iteration Results</h2>
                            <table>
                                <tr>
                                    <th>Iteration</th>
                                    <th style="text-align:center;">Overall Status</th>
                                    <th style="text-align:center;">Logs</th>
                                </tr>
                    """

                    def tableRows = ""
                    def logDataBlocks = ""
                    if (jsonReport.iterations) {
                        jsonReport.iterations.each { result ->
                            def iteration = result.iteration ?: "-"
                            def status = result.overall_status == "PASS" ? "<span class='status-pass'>PASS</span>" : "<span class='status-fail'>FAIL</span>"
                            def logFile = "test-${iteration}.log"
                            def logDataId = "log-data-${iteration}"
                            def logContent = ""
                            try {
                                logContent = readFile(file: logFile)
                                // Escape HTML characters in log content
                                logContent = logContent.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
                            } catch (e) {
                                logContent = "ERROR: Log file not found (${logFile})."
                            }
                            def logButton = "<button class='log-button' onclick=\\\"showLog('${logDataId}')\\\">View Log</button>"
                            tableRows += "<tr><td>${iteration}</td><td style='text-align:center;'>${status}</td><td style='text-align:center;'>${logButton}</td></tr>"
                            logDataBlocks += "<div id='${logDataId}' style='display:none;'>${logContent}</div>"
                        }
                    } else {
                        tableRows += "<tr><td colspan='3' style='text-align:center;'>No iteration results found.</td></tr>"
                    }

                    htmlContent += tableRows + """
                            </table>
                        </div>
                        <div id="logModal" class="modal">
                            <div class="modal-content">
                            <div class="modal-header">
                                <h2>Iteration Log</h2>
                                <span class="modal-close" onclick="closeModal()">×</span>
                            </div>
                            <div class="modal-body">
                                <pre id="log-content-pre"></pre>
                            </div>
                            </div>
                        </div>
                        ${logDataBlocks}
                    </body>
                    </html>
                    """

                    writeFile file: 'report.html', text: htmlContent
                }
            }
        }
    }

    post {
        always {
            // ALL Groovy code/logic must be inside this script block in the post-actions
            script {
                def resultFile = "EthernetSpeedDuplexTest.json"
                def reportJsonFile = "test_results.json"

                // 1. Archive artifacts (using the globally defined function archiveTestArtifacts)
                archiveTestArtifacts(pattern: "${resultFile}, test-*.log, debug_ethernet_table_iter*.txt, report.html")

                // 2. Publish the HTML report
                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: '.',
                    reportFiles: 'report.html',
                    reportName: 'Test Report'
                ])

                echo "Cleaning up ephemeral files..."
                sh 'rm -f test-*.log debug_ethernet_table_iter*.txt || true'

                // 3. Email Notification Logic
                def buildCauses = currentBuild.getBuildCauses()
                def userCause = buildCauses.find { it._class == 'hudson.model.Cause$UserIdCause' }
                def buildUserName = userCause?.userName ?: "Unknown User"
                def buildUserId = userCause?.userId ?: "unknown"
                echo "Build started by: ${buildUserName} (${buildUserId})"

                // Define email mapping
                def userEmails = [
                    "puneet": "puneet.sharma@senao.com",
                    "harman": "harmanjot.singh@senao.com",
                    "mahesh": "mahesh.battala@senao.com",
                    "sandeep": "sandeep.manchikanti@senao.com",
                    "sampath": "sampath.marella@senao.com",
                    "jayanth": "jayanth.munnaluru@senao.com",
                    "srilatha": "srilatha.tadiboina@senao.com",
                    "phani": "phani.darla@senao.com",
                    "dinesh": "dinesh.redddy@senao.com"
                ]
                def userEmail = userEmails.get(buildUserId, "puneet.sharma@senao.com")
                echo "Sending email to: ${userEmail}"

                // Send email with attachments (report.html and test_results.json)
                emailext(
                    subject: "Jenkins Build: ${currentBuild.fullDisplayName} - ${currentBuild.currentResult}",
                    body: """
                        <html><body>
                            <h2 style="color:blue;">Jenkins Build Notification</h2>
                            <p><strong>Build Name:</strong> ${currentBuild.fullDisplayName}</p>
                            <p><strong>Status:</strong> <span style="color:${currentBuild.currentResult == 'SUCCESS' ? 'green' : 'red'};">${currentBuild.currentResult}</span></p>
                            <p><strong>Started By:</strong> ${buildUserName} (${buildUserId})</p>
                            <p><strong>Build URL:</strong> <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
                            <p><strong>Console Output:</strong> <a href="${env.BUILD_URL}console">${env.BUILD_URL}console</a></p>
                            <br/><p style="color:gray;">--<br/>Jenkins Automated Notification</p>
                        </body></html>
                    """,
                    to: userEmail,
                    mimeType: 'text/html',
                    attachmentsPattern: "report.html,${reportJsonFile}"
                )
            }
        }
        success { echo "Script Success" }
        failure { echo "Script Failure" }
    }
}