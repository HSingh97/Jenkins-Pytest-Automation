import jenkins.model.Jenkins

// Functions

def archiveArtifacts(pattern) {
    step([$class: 'ArtifactArchiver', artifacts: pattern, fingerprint: true, onlyIfSuccessful: false])
}

// Main Pipeline

pipeline {
    agent { node { label "${params.TARGET_STAND}" } }

    stages {
        stage('Prepare tests') {
            steps {
                script {
                    echo "----------------------------------------"
                    echo "---> TARGET STAND: ${params.TARGET_STAND} "
                    echo "----------------------------------------"
                    echo "REMOTE NODE     : ${params['Remote PC']}"
                    echo "TESTS SELECTED  : ${params.TEST_TYPES}"
                    echo "========================================"
                    env.REPORT_FILE = "Sanity_Report_${env.BUILD_NUMBER}.html"
                    sh 'rm -f *.json *.html *.log *.zip || true'
                    sh 'mkdir -p artifacts || true'
                    sh 'echo "{\\"iterations\\": []}" > iteration_results.json'
                }
            }
        }
        stage('Install Dependencies') {
            steps {
                script {
                    echo "----------------------------------------"
                    echo "         Installing Dependencies"
                    echo "----------------------------------------"
                    sh '''
                        pip3 install pytest || true
                        [ -f utilities/requirements.txt ] && pip3 install -r utilities/requirements.txt || true
                        sudo apt-get update -qq && sudo apt-get install -y sshpass snmp jq wget bc || true
                    '''
                    if (params.TEST_TYPES?.contains('Firmware Upgrade Test') && params.Build?.contains('/bonsai/')) {
                        def url = params.Build
                        def path = url.substring(url.indexOf('/bonsai/') + 8)
                        def dl = "https://jenkins.senao.com/bonsai/${path}"
                        dl += dl.endsWith('/') ? '' : '/'
                        def ok = sh(script: "wget --spider -S '${dl}' 2>&1 | grep -q '200 OK'", returnStatus: true)
                        if (ok == 0) {
                            sh "wget --no-verbose --no-parent --no-check-certificate -r -l1 -A '*-apps.tgz,*-apps.img.enc' --no-directories '${dl}'"
                            sh 'mv *-apps.img.enc fw.img.enc 2>/dev/null || true'
                            sh 'mv *-apps.tgz fw.tgz 2>/dev/null || true'
                            env.FIRMWARE_FILE = "fw.tgz"
                            archiveArtifacts('fw.tgz,fw.img.enc')
                        }
                    }
                }
            }
        }
        stage('Sanity Testing') {
            steps {
                script {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                        def allSelectedTests = params.TEST_TYPES.split(',').collect { it.trim() }
                        def factoryResetTest = allSelectedTests.find { it == 'Factory Reset Test' }
                        def standardTests = allSelectedTests - 'Factory Reset Test'

                        def globalIterations = params.ITERATION_COUNT.isInteger() ? params.ITERATION_COUNT.toInteger() : 2
                        def localIP = params['Local IP Address']
                        def remoteIP = params['Remote IP Address']

                        if (standardTests) {
                            for (int i = 1; i <= globalIterations; i++) {
                                echo "ITERATION ${i} / ${globalIterations}"
                                runTestList(standardTests, i, localIP, remoteIP)
                            }
                        }

                        if (factoryResetTest) {
                            echo "Running Factory Reset..."
                            runTestList([factoryResetTest], 1, localIP, remoteIP)
                        }
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def localIP = params['Local IP Address']
                    def remoteIP = params['Remote IP Address'] ?: 'N/A'
                    def (lModel, lLink, lRadio, lFW) = getDeviceInfo(localIP)
                    def (rModel, rLink, rRadio, rFW) = getDeviceInfo(remoteIP)
                    def jsonReport = readJSON file: 'iteration_results.json'
                    def testTypes = params.TEST_TYPES.split(',').collect { it.trim().replaceAll('&amp;', '&') }

                    def istZone = TimeZone.getTimeZone("Asia/Kolkata")
                    def istDate = Calendar.getInstance(istZone).getTime()
                    def currentDateTime = istDate.format("dd MMM yyyy, HH:mm:ss z", istZone)

                    def companyLogoUrl = "https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png"

                    def htmlContent = """
                    <html>
                    <head>
                        <title>Sanity Test Report</title>
                        <style>
                            body { font-family: 'Segoe UI', Tahoma, sans-serif; background: #f9f9f9; color: #2c3e50; padding: 40px; }
                            .header { display: flex; justify-content: space-between; align-items: center; background: linear-gradient(to right, #1e40af, #3b82f6); padding: 35px; border-radius: 16px; color: white; box-shadow: 0 10px 20px rgba(0,0,0,0.1); }
                            .header img { height: 80px; }
                            .header-info { text-align: right; }
                            .header-info h1 { margin: 0; font-size: 32px; font-weight: 700; }
                            .header-info p { margin: 8px 0; font-size: 18px; }
                            h2 { margin-top: 50px; font-size: 28px; font-weight: 600; color: #111827; border-bottom: 3px solid #3b82f6; padding-bottom: 12px; }
                            table { width: 100%; border-collapse: collapse; margin-top: 20px; background: #fff; border-radius: 16px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); }
                            th, td { padding: 16px 20px; border: 1px solid #e5e7eb; text-align: left; vertical-align: middle; }
                            th { background: #1e40af; color: white; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
                            tr:nth-child(even) { background-color: #f4f9fd; }
                            .pass { color: #059669; font-weight: 600; background: #d1fae5; padding: 8px 16px; border-radius: 99px; }
                            .fail { color: #dc2626; font-weight: 600; background: #fee2e2; padding: 8px 16px; border-radius: 99px; }
                            .partial { color: #d97706; font-weight: 600; background: #fef3c7; padding: 8px 16px; border-radius: 99px; }
                            .device-table td { text-align: left; }
                            .section { margin-top: 60px; }
                        </style>
                    </head>
                    <body>
                        <div class="header">
                            <img src="${companyLogoUrl}" alt="Senao Networks, Inc."/>
                            <div class="header-info">
                                <h1>Sanity Test Report</h1>
                                <p><strong>Pipeline:</strong> ${env.JOB_NAME} #${env.BUILD_NUMBER}</p>
                                <p><strong>Date:</strong> ${currentDateTime}</p>
                            </div>
                        </div>

                        <h2>Device Information</h2>
                        <table class="device-table">
                            <tr><td><b>Local DUT</b></td><td>${localIP} ( ${lModel} / ${lLink} / ${lRadio} ) ( ${lFW} )</td></tr>
                            <tr><td><b>Remote DUT</b></td><td>${remoteIP} ( ${rModel} / ${rLink} / ${rRadio} ) ( ${rFW} )</td></tr>
                        </table>

                        <h2>Test Summary</h2>
                        <table>
                            <tr><th>Test Case</th><th>Status</th></tr>
                    """

                    def order = ['Fast Channel Test', 'Firmware Upgrade Test', 'Ethernet Speed Duplex Test', 'Soft Reset Test', 'Link Disconnect Test', 'Soft Reboot Test', 'Throughput Test', 'VLAN Test', 'QOS Test', 'Factory Reset Test']
                    order.each { name ->
                        def results = jsonReport.iterations.findAll { it.test == name.replaceAll(' ', '_').toLowerCase() }
                        if (results) {
                            def statuses = results.collect { it.status }
                            def overall = statuses.every { it == "PASS" } ? "PASS" : (statuses.every { it == "FAIL" } ? "FAIL" : "PARTIALLY FAILED")
                            def statusClass = overall == "PASS" ? "pass" : (overall == "FAIL" ? "fail" : "partial")
                            htmlContent += """
                            <tr>
                                <td>${name}</td>
                                <td><span class="${statusClass}">${overall}</span></td>
                            </tr>
                            """
                        }
                    }
                    htmlContent += "</table>"

                    // Fast Channel Test Details
                    def channelFiles = findFiles(glob: '*_HT*.json').findAll { it.name != 'iteration_results.json' && it.length > 20 }
                    def channelResults = []
                    channelFiles.each { file ->
                        def d = readJSON file: file.name
                        if (d?.iterations && !d.iterations.isEmpty()) {
                            channelResults += d.iterations
                        }
                    }
                    if (channelResults) {
                        htmlContent += "<div class='section'><h2>Fast Channel Test Details</h2>"
                        channelResults.groupBy { "${it.Country} - ${it.Bandwidth}" }.each { key, group ->
                            def statuses = group.collect { it.status }
                            def overall = statuses.every { it == "PASS" } ? "PASS" : (statuses.every { it == "FAIL" } ? "FAIL" : "PARTIAL")
                            def statusColor = overall == "PASS" ? "#d4edda" : (overall == "FAIL" ? "#f8d7da" : "#fff3cd")
                            def statusTextColor = overall == "PASS" ? "green" : (overall == "FAIL" ? "red" : "orange")
                            htmlContent += """
                            <h3 style="background-color:#e0f2fe; padding:15px; border-radius:10px;">
                                ${key} | Status: <span style="background-color:${statusColor}; color:${statusTextColor}; padding:5px 10px; border-radius:5px;">${overall}</span>
                            </h3>
                            <table>
                                <tr>
                                    <th rowspan="2">Channel</th>
                                    <th rowspan="2">Status</th>
                                    <th colspan="2">Active Channel</th>
                                    <th rowspan="2">Device Uptime</th>
                                    <th rowspan="2">Remote IP</th>
                                    <th rowspan="2">Link Uptime</th>
                                    <th colspan="2">Local SNR</th>
                                    <th colspan="2">Remote SNR</th>
                                    <th colspan="2">Noise Floor</th>
                                    <th colspan="2">Rate</th>
                                    <th colspan="3">HT Mode</th>
                                </tr>
                                <tr>
                                    <th>Local</th>
                                    <th>Remote</th>
                                    <th>A1</th>
                                    <th>A2</th>
                                    <th>A1</th>
                                    <th>A2</th>
                                    <th>Local</th>
                                    <th>Remote</th>
                                    <th>Tx</th>
                                    <th>Rx</th>
                                    <th>Configured Local</th>
                                    <th>Active Local</th>
                                    <th>Active Remote</th>
                                </tr>
                            """
                            group.each { iter ->
                                iter["Tested Channels"].each { channel ->
                                    def stats = channel["link_stats"]
                                    def status = channel["status"] == "PASS" ? "<span class='pass'>✅ PASS</span>" : "<span class='fail'>❌ FAIL</span>"
                                    def localHT = channel.local_htmode ?: "-"
                                    def remoteHT = channel.remote_htmode ?: "-"
                                    def expectedBW = iter.Bandwidth.replaceAll("[^\\d]", "")
                                    def isHTMatch = { htmode, bw ->
                                        def validMap = [
                                            "20": ["11AHE20"],
                                            "40": ["11AHE40PLUS", "11AHE40MINUS"],
                                            "80": ["11AHE80"],
                                            "160": ["11AHE160"]
                                        ]
                                        validMap[bw]?.contains(htmode.toUpperCase())
                                    }
                                    def bandwidthMismatchLocal = !isHTMatch(localHT, expectedBW)
                                    def bandwidthMismatchRemote = !isHTMatch(remoteHT, expectedBW)
                                    def modeMismatch = localHT != remoteHT
                                    def localStyle = (bandwidthMismatchLocal || modeMismatch) ? "color:red; font-weight:bold;" : ""
                                    def remoteStyle = (bandwidthMismatchRemote || modeMismatch) ? "color:red; font-weight:bold;" : ""
                                    htmlContent += """
                                        <tr>
                                          <td>${channel.channel}</td>
                                          <td>${status}</td>
                                          <td>${channel.local_active ?: '-'}</td>
                                          <td>${channel.remote_active ?: '-'}</td>
                                          <td>${channel.device_uptime ?: '-'}</td>
                                          <td>${stats?.ip_address ?: 'N/A'}</td>
                                          <td>${stats?.link_uptime ?: '-'}</td>
                                          <td>${stats?.local_SNR_A1 ?: '-'}</td>
                                          <td>${stats?.local_SNR_A2 ?: '-'}</td>
                                          <td>${stats?.remote_SNR_A1 ?: '-'}</td>
                                          <td>${stats?.remote_SNR_A2 ?: '-'}</td>
                                          <td>${stats?.local_noise ?: '-'}</td>
                                          <td>${stats?.remote_noise ?: '-'}</td>
                                          <td>${stats?.tx_rate ?: '-'}</td>
                                          <td>${stats?.rx_rate ?: '-'}</td>
                                          <td>${channel.conf_htmode ?: '-'}</td>
                                          <td style="${localStyle}">${localHT}</td>
                                          <td style="${remoteStyle}">${remoteHT}</td>
                                        </tr>
                                        """
                                }
                            }
                            htmlContent += "</table>"
                        }
                        htmlContent += "</div>"
                    }

                    // Throughput Test Details
                    def throughputFiles = findFiles(glob: 'Throughput_*.json').findAll { it.length > 20 }
                    def throughputResults = []
                    throughputFiles.each { file ->
                        def d = readJSON file: file.name
                        if (d?.iterations && !d.iterations.isEmpty()) {
                            throughputResults += [filename: file.name, content: d.iterations]
                        }
                    }
                    if (throughputResults) {
                        htmlContent += "<div class='section'><h2>Throughput Test Details</h2>"
                        def modulationBase = [
                            "MCS0": "BPSK 1/2", "MCS1": "QPSK 1/2", "MCS2": "QPSK 3/4",
                            "MCS3": "16-QAM 1/2", "MCS4": "16-QAM 3/4", "MCS5": "64-QAM 2/3",
                            "MCS6": "64-QAM 3/4", "MCS7": "64-QAM 5/6", "MCS8": "256-QAM 3/4",
                            "MCS9": "256-QAM 5/6", "MCS10": "1024-QAM 3/4", "MCS11": "1024-QAM 5/6"
                        ]
                        def modulationTable = [:]
                        (0..23).each { i -> modulationTable["MCS${i}"] = modulationBase["MCS${i % 12}"] }
                        def mcsOrder = (0..23).collect { "MCS$it" }
                        def bandwidthOrder = ["HT20", "HT40", "HT80", "HT160"]
                        def groupedByBandwidth = throughputResults.groupBy { it.filename.split('_')[1].trim().toUpperCase() }
                        bandwidthOrder.each { bandwidth ->
                            if (!groupedByBandwidth.containsKey(bandwidth)) return
                            def entries = groupedByBandwidth[bandwidth]
                            def mcsMap = [:]
                            entries.each { entry ->
                                def mcs = entry.filename.split('_')[2].replace(".json", "").trim().toUpperCase()
                                if (!mcsMap[mcs]) mcsMap[mcs] = [:]
                                entry.content.each { iteration ->
                                    iteration.results_direction.each { result ->
                                        def key = "${result.traffic_type}_${result.Direction}".toLowerCase()
                                        mcsMap[mcs][key] = result.throughput
                                        if (result.Direction.toLowerCase() == "bi-di") {
                                            mcsMap[mcs]["${key}_tx"] = result.tx_value ?: 0.0
                                            mcsMap[mcs]["${key}_rx"] = result.rx_value ?: 0.0
                                        }
                                        if (!mcsMap[mcs].link_stats) {
                                            mcsMap[mcs].link_stats = result.link_stats
                                        }
                                    }
                                }
                            }
                            htmlContent += "<h3 style='background:#e0f2fe; padding:15px; border-radius:10px;'>Bandwidth: ${bandwidth}</h3><table><tr><th rowspan='2'>MCS</th><th rowspan='2'>Modulation</th><th colspan='2'>Rate (Mbps)</th>"
                            params['Traffic Type'].split(',').collect { it.trim().toUpperCase() }.each { htmlContent += "<th colspan='${params.Direction.split(',').size()}'>Throughput (${it}) (Mbps)</th>" }
                            htmlContent += "<th colspan='2'>Local SNR (dB)</th><th colspan='2'>Remote SNR (dB)</th><th colspan='2'>Noise (dBm)</th></tr><tr><th>Tx</th><th>Rx</th>"
                            params['Traffic Type'].split(',').collect { it.trim().toUpperCase() }.each { params.Direction.split(',').collect { it.trim().capitalize() }.each { htmlContent += "<th>${it}</th>" } }
                            htmlContent += "<th>A1</th><th>A2</th><th>A1</th><th>A2</th><th>Local</th><th>Remote</th></tr>"
                            mcsOrder.each { mcs ->
                                def data = mcsMap[mcs]
                                if (!data) return
                                def stats = data.link_stats ?: [:]
                                def tx = ((stats.tx_rate ?: "0") as double)
                                def rx = ((stats.rx_rate ?: "0") as double)
                                def modulation = modulationTable[mcs] ?: "-"
                                def rateTxStyle = tx != rx ? "style='color:red; font-weight:bold;'" : ""
                                def rateRxStyle = tx != rx ? "style='color:red; font-weight:bold;'" : ""
                                htmlContent += "<tr><td>${mcs}</td><td>${modulation}</td><td ${rateTxStyle}>${tx.intValue()}</td><td ${rateRxStyle}>${rx.intValue()}</td>"
                                params['Traffic Type'].split(',').collect { it.trim().toLowerCase() }.each { t ->
                                    params.Direction.split(',').collect { it.trim().toLowerCase() }.each { d ->
                                        def key = "${t}_${d}"
                                        def val = data[key] ?: "-"
                                        def cell = val
                                        if (val != "-" && tx > 0) {
                                            def value = (val as double)
                                            def percent = Math.round(value / tx * 100)
                                            def color = percent < 40 ? "red" : percent < 65 ? "orange" : "green"
                                            cell = "<b>${value}</b> <span style='color:${color};'>(~${percent}%)</span>"
                                        }
                                        htmlContent += "<td>${cell}</td>"
                                    }
                                }
                                htmlContent += "<td>${stats.local_SNR_A1 ?: '-'}</td><td>${stats.local_SNR_A2 ?: '-'}</td>"
                                htmlContent += "<td>${stats.remote_SNR_A1 ?: '-'}</td><td>${stats.remote_SNR_A2 ?: '-'}</td>"
                                htmlContent += "<td>${stats.local_noise ?: '-'}</td><td>${stats.remote_noise ?: '-'}</td></tr>"
                            }
                            htmlContent += "</table>"
                        }
                    }

                    htmlContent += "</body></html>"
                    writeFile file: env.REPORT_FILE, text: htmlContent
                }
            }
        }
    }

    post {
        always {
            publishHTML(target: [allowMissing: false, alwaysLinkToLastBuild: true, keepAll: true, reportDir: '.', reportFiles: env.REPORT_FILE, reportName: "Sanity Report - Build ${env.BUILD_NUMBER}"])
            archiveArtifacts("*.html,*.log,*.json")
            sh 'rm -f log_*.log || true'

            script {
                def buildCauses = currentBuild.getBuildCauses()
                def userCause = buildCauses.find { it._class == 'hudson.model.Cause$UserIdCause' }
                def buildUserName = userCause?.userName ?: "Unknown User"
                def buildUserId = userCause?.userId ?: "unknown"

                def userEmails = [
                    "puneet": "puneet.sharma@senao.com",
                    "harman": "harmanjot.singh@senao.com",
                    "mahesh": "mahesh.battala@senao.com",
                    "sandeep": "sandeep.manchikanti@senao.com",
                    "sampath": "sampath.marella@senao.com",
                    "jayanth": "jayanth.munnaluru@senao.com",
                    "srilatha": "srilatha.tadiboina@senao.com",
                    "phani": "phani.darla@senao.com",
                    "dinesh": "dinesh.redddy@senao.com"
                ]
                def userEmail = userEmails[buildUserId] ?: "harmanjot.singh@senao.com"

                emailext(
                    subject: "Sanity Result: ${currentBuild.currentResult} - Build #${env.BUILD_NUMBER}",
                    body: """<html><body>
                        <h2>Sanity Automation Completed</h2>
                        <p><strong>Status:</strong> <span style="color:${currentBuild.currentResult == 'SUCCESS' ? 'green' : 'red'};">${currentBuild.currentResult}</span></p>
                        <p><strong>Report:</strong> <a href="${env.BUILD_URL}artifact/${env.REPORT_FILE}">View Complete Report</a></p>
                    </body></html>""",
                    to: userEmail,
                    mimeType: 'text/html',
                    attachmentsPattern: env.REPORT_FILE
                )
            }
        }
    }
}