import jenkins.model.Jenkins

// --- Helper Functions ---
def archiveArtifacts(pattern) {
    step([$class: 'ArtifactArchiver', artifacts: pattern, fingerprint: true, onlyIfSuccessful: false])
}

// Helper to run specific test commands based on type
def runTestList(tests, iteration, localIP, remoteIP) {
    tests.each { testTypeRaw ->
        def testType = testTypeRaw.replaceAll('&amp;', '&')
        def logFile = "log_${testType.replaceAll(' ', '_')}_iter${iteration}.log"
        def status = "FAIL"
        def cmd = ""

        try {
            switch(testType) {
                case 'Fast Channel Test':
                    def selectedRadio = params['Radio']
                    def bandwidths = params.Bandwidth.split(',')
                    def countries = params.Countries.split(',')
                    sh 'rm -f *_HT*.json iteration_results.json'
                    sh "echo {\\\"iterations\\\": []} > iteration_results.json"
                    def iter = 1
                    for (country in countries) {
                        echo "Configuring Country: ${country}"
                        sh """
                            pytest -v -s testCases/test_channelTest.py::test_changecountry \
                            --local-ip '${localIP}' --remote-ip '${remoteIP}' \
                            --radio '${selectedRadio}' --country '${country}' 2>&1
                        """
                        for (bandwidth in bandwidths) {
                            if ((country == "Canada" || country == "US 5GHz Non-DFS") && bandwidth == "HT160") continue
                            echo "Testing: Country=${country}, Bandwidth=${bandwidth}"
                            sh "echo '{\"iterations\": []}' > custom_results.json"
                            def pytest_output = sh(script: """
                                python3.10 -m pytest -v -s testCases/test_channelTest.py::test_channelconnectivity \
                                --local-ip '${localIP}' --remote-ip '${remoteIP}' \
                                --radio '${selectedRadio}' --bandwidth '${bandwidth}' --country '${country}' --extra '1' \
                                2>&1 | tee ${logFile}
                            """, returnStdout: true).trim()
                            def iterationResults = readJSON file: 'custom_results.json'
                            def normalizedBandwidth = bandwidth == "HT40" ? "HT40+" : bandwidth
                            def newTests = iterationResults.iterations.findAll {
                                it.Country == country && it.Bandwidth == normalizedBandwidth
                            }
                            newTests.each { t ->
                                t.iteration = iter++
                                t.logs = pytest_output
                                status = t.status
                            }
                            def filename = "${country.trim().replaceAll("\\s+", "_")}_${bandwidth.trim()}.json"
                            writeJSON file: filename, json: [iterations: newTests]
                        }
                    }
                    break
                case 'Firmware Upgrade Test':
                    cmd = "export FW_PATH=\"${env.FIRMWARE_FILE ?: 'fw.tgz'}\"; pytest -v -s testCases/test_firmwareUpgrade.py::test_Upgrade --local-ip '${localIP}' --remote-ip '${remoteIP}' --serialPort '${params['Serial Logging Port'] ?: '/dev/ttyUSB0'}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
                case 'Ethernet Speed Duplex Test':
                    cmd = "python3 testCases/test_SNMPEthernetDuplex.py --su-ip '${localIP}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
                case 'Soft Reset Test':
                    cmd = "pytest -v -s testCases/test_SSHReset.py::test_soft_reset --local-ip '${localIP}' --remote-ip '${remoteIP}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
                case 'Link Disconnect Test':
                    cmd = "pytest -v -s testCases/test_SSHDisconnect.py::test_Disconnect_Connect --local-ip '${localIP}' --remote-ip '${remoteIP}' --model '${params.Model}' --radio '${params.Radio}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
                case 'Soft Reboot Test':
                    cmd = "pytest -v -s testCases/test_SSHReboot.py::test_reboot --local-ip '${localIP}' --remote-ip '${remoteIP}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
                case 'Throughput Test':
                    def remotePC = params['Remote PC']
                    def remotePCIP = null
                    node(remotePC) {
                        remotePCIP = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^192\\.168\\.1\\./ {print \$4}' | cut -d'/' -f1 | head -n1", returnStdout: true).trim()
                    }
                    def selectedRadio = params['Radio']
                    def traffic_types = params['Traffic Type'].split(',')
                    def directions = params.Direction.split(',')
                    def bandwidths = params.Bandwidth.split(',')
                    def link_types = params['Link Type'].split(',')
                    def modulationrates = params.MCS.split(',')
                    def test_time = params['Throughput Test Time']
                    sh 'rm -f Throughput_*.json iteration_results.json'
                    sh "echo {\\\"iterations\\\": []} > iteration_results.json"
                    def iter = 1
                    for (link_type in link_types) {
                        echo "Testing Link Type: ${link_type}"
                        sh """
                            python3.10 -m pytest -v -s testCases/test_Throughput.py::test_changelinktype \
                            --local-ip '${localIP}' --remote-ip '${remoteIP}' \
                            --radio '${selectedRadio}' --link-type '${link_type}' 2>&1
                        """
                        for (bandwidth in bandwidths) {
                            echo "Configuring Bandwidth: ${bandwidth}"
                            sh """
                                python3.10 -m pytest -v -s testCases/test_Throughput.py::test_changebandwidth \
                                --local-ip '${localIP}' --remote-ip '${remoteIP}' \
                                --radio '${selectedRadio}' --bandwidth '${bandwidth}' 2>&1
                            """
                            for (mcsrate in modulationrates) {
                                echo "Configuring MCS: ${mcsrate}"
                                sh """
                                    python3.10 -m pytest -v -s testCases/test_Throughput.py::test_changemcs \
                                    --local-ip '${localIP}' --remote-ip '${remoteIP}' \
                                    --radio '${selectedRadio}' --mcs-rate '${mcsrate}' 2>&1
                                """
                                for (traffic_type in traffic_types) {
                                    echo "Testing: Bandwidth=${bandwidth} | MCS=${mcsrate} | Type=${traffic_type}"
                                    sh "echo '{\"iterations\": []}' > custom_results.json"
                                    def pytest_output = sh(script: """
                                        python3.10 -m pytest -v -s testCases/test_Throughput.py::test_throughputtest \
                                        --local-ip '${localIP}' \
                                        --remote-ip '${remoteIP}' \
                                        --radio '${selectedRadio}' \
                                        --mcs-rate '${mcsrate}' \
                                        --traffic-type '${traffic_type}' \
                                        --traffic-dir '${directions.join(",")}' \
                                        --remote-pc-ip '${remotePCIP}' \
                                        --bandwidth '${bandwidth}' \
                                        --sleep '${test_time}' \
                                        2>&1 | tee ${logFile}
                                    """, returnStdout: true).trim()
                                    def iterationResults = readJSON file: 'custom_results.json'
                                    def newTests = iterationResults.iterations
                                    newTests.each { t ->
                                        t.iteration = iter++
                                        t.logs = pytest_output
                                        status = t.status
                                    }
                                    def filename = "Throughput_${link_type.trim()}_${bandwidth.trim()}_${mcsrate.trim()}.json"
                                    writeJSON file: filename, json: [iterations: newTests]
                                }
                            }
                        }
                    }
                    break
                case 'VLAN Test':
                    def r_IP, r_If, r_Mgmt, l_IP, l_If, l_Mgmt
                    node(params['Remote PC']) {
                        r_IP = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^192\\.168\\.1\\./ {print \$4}' | cut -d'/' -f1 | head -n1", returnStdout: true).trim()
                        r_If = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^192\\.168\\.1\\./ {print \$2}' | head -n1", returnStdout: true).trim()
                        r_Mgmt = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^10\\.0\\.150\\./ {print \$4}' | cut -d'/' -f1 | head -n1", returnStdout: true).trim()
                    }
                    node(params.TARGET_STAND) {
                        l_IP = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^192\\.168\\.1\\./ {print \$4}' | cut -d'/' -f1 | head -n1", returnStdout: true).trim()
                        l_If = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^192\\.168\\.1\\./ {print \$2}' | head -n1", returnStdout: true).trim()
                        l_Mgmt = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^10\\.0\\.150\\./ {print \$4}' | cut -d'/' -f1 | head -n1", returnStdout: true).trim()
                    }
                    cmd = "python3.10 -m pytest -v -s testCases/test_vlantesting.py::test_vlan --local-ip '${localIP}' --remote-ip '${remoteIP}' --radio '${params.Radio}' --vlan '${params.VLAN}' --local-interface '${l_If}' --remote-interface '${r_If}' --local-pc-ip '${l_IP}' --remote-pc-ip '${r_IP}' --local-pc-mgmt-ip '${l_Mgmt}' --remote-pc-mgmt-ip '${r_Mgmt}' 2>&1 | tee ${logFile}"
                    break
                case 'QOS Test':
                    def q_l_Mgmt, q_r_Mgmt
                    node(params['Remote PC']) { q_r_Mgmt = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^10\\.0\\.150\\./ {print \$4}' | cut -d'/' -f1 | head -n1", returnStdout: true).trim() }
                    node(params.TARGET_STAND) { q_l_Mgmt = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^10\\.0\\.150\\./ {print \$4}' | cut -d'/' -f1 | head -n1", returnStdout: true).trim() }
                    cmd = "python3.10 -m pytest -v -s testCases/test_qos.py::test_qosTest --local-ip '${localIP}' --remote-ip '${remoteIP}' --qosPIR '${params['QOS PIR']}' --local-pc-mgmt-ip '${q_l_Mgmt}' --remote-pc-mgmt-ip '${q_r_Mgmt}' 2>&1 | tee ${logFile}"
                    break
                case 'Factory Reset Test':
                    cmd = "pytest -v -s testCases/test_SSHFactoryReset.py::test_factory_reset --local-ip '${localIP}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
            }
            if (cmd) {
                def exitCode = sh(script: cmd, returnStatus: true)
                status = (exitCode == 0) ? "PASS" : "FAIL"
            }
        } catch (Exception e) {
            echo "Exception in ${testType}: ${e.message}"
            sh "echo 'Error: ${e.message}' >> ${logFile}"
        }

        def safeTestName = testType.replaceAll(' ', '_').toLowerCase()
        def pyCmd = """
import json
try:
    with open('iteration_results.json', 'r+') as f:
        data = json.load(f)
        data['iterations'].append({'test': '${safeTestName}', 'iteration': ${iteration}, 'status': '${status}', 'logFile': '${logFile}'})
        f.seek(0)
        json.dump(data, f, indent=4)
except Exception as e: print(e)
"""
        sh "python3 -c \"${pyCmd.stripIndent()}\""
        sleep 10
    }
}

def getDeviceInfo(ip) {
    if (!ip || ip == 'N/A') return ["N/A", "N/A", "N/A", "N/A"]
    def model = "N/A"
    def link = "N/A"
    def radio = "N/A"
    def fw = "N/A"
    try {
        sh "ssh-keygen -R ${ip} || true"
        fw = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${ip} 'cat /etc/version || echo N/A'", returnStdout: true).trim()
        model = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${ip} 'cat /etc/board.json | jq -r .model.name || echo N/A'", returnStdout: true).trim()
        def info = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${ip} 'iwinfo || echo N/A'", returnStdout: true).trim()
        link = info =~ /Mode:\s*(Access Point|Station|PtP|PtMP|Client)/ ? "$1" : "N/A"
        radio = info =~ /(2\.4|5|6)GHz/ ? "${it[0]}GHz" : "N/A"
    } catch (e) {
        echo "Failed to get device info for ${ip}: ${e}"
    }
    return [model, link, radio, fw]
}

pipeline {
    agent { node { label "${params.TARGET_STAND}" } }

    options {
        timestamps()
        timeout(time: 6, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Preparation') {
            steps {
                script {
                    echo "========================================"
                    echo "    SANITY AUTOMATION TEST SUITE       "
                    echo "========================================"
                    echo "TARGET STAND    : ${params.TARGET_STAND}"
                    echo "REMOTE NODE     : ${params['Remote PC']}"
                    echo "TESTS SELECTED  : ${params.TEST_TYPES}"
                    echo "========================================"

                    if (!params['Local IP Address']) {
                        error "❌ Missing required parameter: Local IP Address"
                    }

                    env.REPORT_FILE = "Sanity_Report_${env.BUILD_NUMBER}.html"

                    sh 'rm -f *.json *.html *.log *.zip'
                    sh 'rm -rf artifacts debug_tables'
                    sh 'mkdir -p artifacts debug_tables'

                    sh 'echo "{\\"iterations\\": []}" > iteration_results.json'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    echo "--- Installing Dependencies ---"
                    sh '''
                        pip3 install pytest || true
                        if [ -f "utilities/requirements.txt" ]; then
                            pip3 install -r utilities/requirements.txt || true
                        fi
                        which snmpget >/dev/null 2>&1 || {
                            echo "--- Installing SNMP tools ---"
                            sudo apt-get update -qq
                            sudo apt-get install -y snmp snmp-mibs-downloader sshpass
                        }
                    '''
                    if (params.TEST_TYPES.contains('Firmware Upgrade Test')) {
                        echo "--- Pre-downloading Firmware ---"
                        def url = params['Build']
                        if (url && url.contains('/bonsai/')) {
                            def buildPath = url.substring(url.indexOf('/bonsai/') + 8)
                            def WGET_URL = "https://jenkins.senao.com/bonsai/${buildPath}"
                            if (!WGET_URL.endsWith('/')) WGET_URL += '/'
                            def status = sh(script: "wget --spider -S ${WGET_URL} 2>&1 | grep 'HTTP/.* 200 OK'", returnStatus: true)
                            if (status == 0) {
                                sh "wget --no-verbose --no-parent --no-check-certificate -e robots=off --recursive --level=1 -A '*-apps.img.enc,*-apps.tgz' --no-directories ${WGET_URL} 2>&1"
                                sh """
                                   imgfile=\$(ls -t *-apps.img.enc 2>/dev/null | head -n 1)
                                   if [ -n "\$imgfile" ]; then mv -f "\$imgfile" "fw.img.enc"; fi
                                   tgzfile=\$(ls -t *-apps.tgz 2>/dev/null | head -n 1)
                                   if [ -n "\$tgzfile" ]; then mv -f "\$tgzfile" "fw.tgz"; fi
                                """
                                env.FIRMWARE_FILE = "fw.tgz"
                                archiveArtifacts('fw.img.enc, fw.tgz')
                            } else {
                                error "❌ FIRMWARE URL NOT FOUND (404): ${WGET_URL}"
                            }
                        } else {
                            echo "⚠️ No valid Bonsai URL provided. Assuming local file availability."
                        }
                    }
                }
            }
        }

        stage('Execute Tests') {
            steps {
                script {
                    def allSelectedTests = params.TEST_TYPES.split(',').collect { it.trim() }
                    def factoryResetTest = allSelectedTests.find { it == 'Factory Reset Test' }
                    def standardTests = allSelectedTests - 'Factory Reset Test'

                    def globalIterations = params.ITERATION_COUNT.isInteger() ? params.ITERATION_COUNT.toInteger() : 2
                    def localIP = params['Local IP Address']
                    def remoteIP = params['Remote IP Address']

                    if (standardTests) {
                        for (int i = 1; i <= globalIterations; i++) {
                            echo "ITERATION ${i} / ${globalIterations}"
                            runTestList(standardTests, i, localIP, remoteIP)
                        }
                    }

                    if (factoryResetTest) {
                        echo "Running Factory Reset..."
                        runTestList([factoryResetTest], 1, localIP, remoteIP)
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def localIP = params['Local IP Address']
                    def remoteIP = params['Remote IP Address'] ?: 'N/A'

                    def (lModel, lLink, lRadio, lFW) = getDeviceInfo(localIP)
                    def (rModel, rLink, rRadio, rFW) = getDeviceInfo(remoteIP)

                    def jsonReport = readJSON file: 'iteration_results.json'
                    def testTypes = params.TEST_TYPES.split(',').collect { it.trim().replaceAll('&amp;', '&') }

                    def istZone = TimeZone.getTimeZone("Asia/Kolkata")
                    def istDate = Calendar.getInstance(istZone).getTime()
                    def currentDateTime = istDate.format("dd MMM yyyy, HH:mm:ss z", istZone)

                    def companyLogoUrl = "https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png"

                    def htmlContent = """
                    <html>
                    <head>
                        <title>Sanity Test Report</title>
                        <style>
                            body { font-family: 'Segoe UI', Tahoma, sans-serif; background: #f9f9f9; color: #2c3e50; padding: 40px; }
                            .header { display: flex; justify-content: space-between; align-items: center; background: linear-gradient(to right, #1e40af, #3b82f6); padding: 35px; border-radius: 16px; color: white; box-shadow: 0 10px 20px rgba(0,0,0,0.1); }
                            .header img { height: 80px; }
                            .header-info { text-align: right; }
                            .header-info h1 { margin: 0; font-size: 32px; font-weight: 700; }
                            .header-info p { margin: 8px 0; font-size: 18px; }
                            h2 { margin-top: 50px; font-size: 28px; font-weight: 600; color: #111827; border-bottom: 3px solid #3b82f6; padding-bottom: 12px; }
                            table { width: 100%; border-collapse: collapse; margin-top: 20px; background: #fff; border-radius: 16px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); }
                            th, td { padding: 16px 20px; border: 1px solid #e5e7eb; text-align: center; vertical-align: middle; }
                            th { background: #1e40af; color: white; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
                            tr:nth-child(even) { background-color: #f4f9fd; }
                            .pass { color: #059669; font-weight: 600; background: #d1fae5; padding: 8px 16px; border-radius: 99px; }
                            .fail { color: #dc2626; font-weight: 600; background: #fee2e2; padding: 8px 16px; border-radius: 99px; }
                            .partial { color: #d97706; font-weight: 600; background: #fef3c7; padding: 8px 16px; border-radius: 99px; }
                            .device-table td { text-align: left; }
                            .section { margin-top: 60px; }
                        </style>
                    </head>
                    <body>
                        <div class="header">
                            <img src="${companyLogoUrl}" alt="Senao Networks, Inc."/>
                            <div class="header-info">
                                <h1>Sanity Test Report</h1>
                                <p><strong>Pipeline:</strong> ${env.JOB_NAME} #${env.BUILD_NUMBER}</p>
                                <p><strong>Date:</strong> ${currentDateTime}</p>
                            </div>
                        </div>

                        <h2>Device Information</h2>
                        <table class="device-table">
                            <tr><td><b>Local DUT</b></td><td>${localIP} ( ${lModel} / ${lLink} / ${lRadio} ) ( ${lFW} )</td></tr>
                            <tr><td><b>Remote DUT</b></td><td>${remoteIP} ( ${rModel} / ${rLink} / ${rRadio} ) ( ${rFW} )</td></tr>
                        </table>

                        <h2>Test Summary</h2>
                        <table>
                            <tr><th>Test Case</th><th>Status</th></tr>
                    """

                    def order = ['Fast Channel Test', 'Firmware Upgrade Test', 'Ethernet Speed Duplex Test', 'Soft Reset Test', 'Link Disconnect Test', 'Soft Reboot Test', 'Throughput Test', 'VLAN Test', 'QOS Test', 'Factory Reset Test']
                    order.each { name ->
                        def results = jsonReport.iterations.findAll { it.test == name.replaceAll(' ', '_').toLowerCase() }
                        if (results) {
                            def statuses = results.collect { it.status }
                            def overall = statuses.every { it == "PASS" } ? "PASS" : (statuses.every { it == "FAIL" } ? "FAIL" : "PARTIALLY FAILED")
                            def statusClass = overall == "PASS" ? "pass" : (overall == "FAIL" ? "fail" : "partial")
                            htmlContent += """
                            <tr>
                                <td>${name}</td>
                                <td><span class="${statusClass}">${overall}</span></td>
                            </tr>
                            """
                        }
                    }
                    htmlContent += "</table>"

                    // Fast Channel Test Detailed Section
                    def channelFiles = findFiles(glob: '*_HT*.json').findAll { it.name != 'iteration_results.json' && it.length > 20 }
                    def channelResults = []
                    channelFiles.each { file ->
                        def d = readJSON file: file.name
                        if (d?.iterations && !d.iterations.isEmpty()) {
                            channelResults += d.iterations
                        }
                    }
                    if (channelResults) {
                        htmlContent += "<div class='section'><h2>Fast Channel Test Details</h2>"
                        channelResults.groupBy { "${it.Country} - ${it.Bandwidth}" }.each { key, group ->
                            def statuses = group.collect { it.status }
                            def overall = statuses.every { it == "PASS" } ? "PASS" : (statuses.every { it == "FAIL" } ? "FAIL" : "PARTIAL")
                            def statusColor = overall == "PASS" ? "#d4edda" : (overall == "FAIL" ? "#f8d7da" : "#fff3cd")
                            def statusTextColor = overall == "PASS" ? "green" : (overall == "FAIL" ? "red" : "orange")
                            htmlContent += """
                            <h3 style="background-color:#e0f2fe; padding:15px; border-radius:10px;">
                                ${key} | Status: <span style="background-color:${statusColor}; color:${statusTextColor}; padding:5px 10px; border-radius:5px;">${overall}</span>
                            </h3>
                            <table>
                                <tr>
                                    <th rowspan="2">Channel</th>
                                    <th rowspan="2">Status</th>
                                    <th colspan="2">Active Channel</th>
                                    <th rowspan="2">Device Uptime</th>
                                    <th rowspan="2">Remote IP</th>
                                    <th rowspan="2">Link Uptime</th>
                                    <th colspan="2">Local SNR</th>
                                    <th colspan="2">Remote SNR</th>
                                    <th colspan="2">Noise Floor</th>
                                    <th colspan="2">Rate</th>
                                    <th colspan="3">HT Mode</th>
                                </tr>
                                <tr>
                                    <th>Local</th>
                                    <th>Remote</th>
                                    <th>A1</th>
                                    <th>A2</th>
                                    <th>A1</th>
                                    <th>A2</th>
                                    <th>Local</th>
                                    <th>Remote</th>
                                    <th>Tx</th>
                                    <th>Rx</th>
                                    <th>Configured Local</th>
                                    <th>Active Local</th>
                                    <th>Active Remote</th>
                                </tr>
                            """
                            group.each { iter ->
                                iter["Tested Channels"].each { channel ->
                                    def stats = channel["link_stats"]
                                    def status = channel["status"] == "PASS" ? "<span class='pass'>✅ PASS</span>" : "<span class='fail'>❌ FAIL</span>"
                                    def localHT = channel.local_htmode ?: "-"
                                    def remoteHT = channel.remote_htmode ?: "-"
                                    def expectedBW = iter.Bandwidth.replaceAll("[^\\d]", "")
                                    def isHTMatch = { htmode, bw ->
                                        def validMap = [
                                            "20": ["11AHE20"],
                                            "40": ["11AHE40PLUS", "11AHE40MINUS"],
                                            "80": ["11AHE80"],
                                            "160": ["11AHE160"]
                                        ]
                                        validMap[bw]?.contains(htmode.toUpperCase())
                                    }
                                    def bandwidthMismatchLocal = !isHTMatch(localHT, expectedBW)
                                    def bandwidthMismatchRemote = !isHTMatch(remoteHT, expectedBW)
                                    def modeMismatch = localHT != remoteHT
                                    def localStyle = (bandwidthMismatchLocal || modeMismatch) ? "color:red; font-weight:bold;" : ""
                                    def remoteStyle = (bandwidthMismatchRemote || modeMismatch) ? "color:red; font-weight:bold;" : ""
                                    htmlContent += """
                                        <tr>
                                          <td>${channel.channel}</td>
                                          <td>${status}</td>
                                          <td>${channel.local_active ?: '-'}</td>
                                          <td>${channel.remote_active ?: '-'}</td>
                                          <td>${channel.device_uptime ?: '-'}</td>
                                          <td>${stats?.ip_address ?: 'N/A'}</td>
                                          <td>${stats?.link_uptime ?: '-'}</td>
                                          <td>${stats?.local_SNR_A1 ?: '-'}</td>
                                          <td>${stats?.local_SNR_A2 ?: '-'}</td>
                                          <td>${stats?.remote_SNR_A1 ?: '-'}</td>
                                          <td>${stats?.remote_SNR_A2 ?: '-'}</td>
                                          <td>${stats?.local_noise ?: '-'}</td>
                                          <td>${stats?.remote_noise ?: '-'}</td>
                                          <td>${stats?.tx_rate ?: '-'}</td>
                                          <td>${stats?.rx_rate ?: '-'}</td>
                                          <td>${channel.conf_htmode ?: '-'}</td>
                                          <td style="${localStyle}">${localHT}</td>
                                          <td style="${remoteStyle}">${remoteHT}</td>
                                        </tr>
                                        """
                                }
                            }
                            htmlContent += "</table>"
                        }
                        htmlContent += "</div>"
                    }

                    // Throughput Test Detailed Section
                    def throughputFiles = findFiles(glob: 'Throughput_*.json').findAll { it.length > 20 }
                    def throughputResults = []
                    throughputFiles.each { file ->
                        def d = readJSON file: file.name
                        if (d?.iterations && !d.iterations.isEmpty()) {
                            throughputResults += [filename: file.name, content: d.iterations]
                        }
                    }
                    if (throughputResults) {
                        htmlContent += "<div class='section'><h2>Throughput Test Details</h2>"
                        def modulationBase = [
                            "MCS0": "BPSK 1/2", "MCS1": "QPSK 1/2", "MCS2": "QPSK 3/4",
                            "MCS3": "16-QAM 1/2", "MCS4": "16-QAM 3/4", "MCS5": "64-QAM 2/3",
                            "MCS6": "64-QAM 3/4", "MCS7": "64-QAM 5/6", "MCS8": "256-QAM 3/4",
                            "MCS9": "256-QAM 5/6", "MCS10": "1024-QAM 3/4", "MCS11": "1024-QAM 5/6"
                        ]
                        def modulationTable = [:]
                        (0..23).each { i -> modulationTable["MCS${i}"] = modulationBase["MCS${i % 12}"] }
                        def mcsOrder = (0..23).collect { "MCS$it" }
                        def bandwidthOrder = ["HT20", "HT40", "HT80", "HT160"]
                        def groupedByBandwidth = throughputResults.groupBy { it.filename.split('_')[1].trim().toUpperCase() }
                        bandwidthOrder.each { bandwidth ->
                            if (!groupedByBandwidth.containsKey(bandwidth)) return
                            def entries = groupedByBandwidth[bandwidth]
                            def mcsMap = [:]
                            entries.each { entry ->
                                def mcs = entry.filename.split('_')[2].replace(".json", "").trim().toUpperCase()
                                if (!mcsMap[mcs]) mcsMap[mcs] = [:]
                                entry.content.each { iteration ->
                                    iteration.results_direction.each { result ->
                                        def key = "${result.traffic_type}_${result.Direction}".toLowerCase()
                                        mcsMap[mcs][key] = result.throughput
                                        if (result.Direction.toLowerCase() == "bi-di") {
                                            mcsMap[mcs]["${key}_tx"] = result.tx_value ?: 0.0
                                            mcsMap[mcs]["${key}_rx"] = result.rx_value ?: 0.0
                                        }
                                        if (!mcsMap[mcs].link_stats) {
                                            mcsMap[mcs].link_stats = result.link_stats
                                        }
                                    }
                                }
                            }
                            htmlContent += "<h3 style='background:#e0f2fe; padding:15px; border-radius:10px;'>Bandwidth: ${bandwidth}</h3><table><tr><th rowspan='2'>MCS</th><th rowspan='2'>Modulation</th><th colspan='2'>Rate (Mbps)</th>"
                            params['Traffic Type'].split(',').collect { it.trim().toUpperCase() }.each { htmlContent += "<th colspan='${params.Direction.split(',').size()}'>Throughput (${it}) (Mbps)</th>" }
                            htmlContent += "<th colspan='2'>Local SNR (dB)</th><th colspan='2'>Remote SNR (dB)</th><th colspan='2'>Noise (dBm)</th></tr><tr><th>Tx</th><th>Rx</th>"
                            params['Traffic Type'].split(',').collect { it.trim().toUpperCase() }.each { params.Direction.split(',').collect { it.trim().capitalize() }.each { htmlContent += "<th>${it}</th>" } }
                            htmlContent += "<th>A1</th><th>A2</th><th>A1</th><th>A2</th><th>Local</th><th>Remote</th></tr>"
                            mcsOrder.each { mcs ->
                                def data = mcsMap[mcs]
                                if (!data) return
                                def stats = data.link_stats ?: [:]
                                def tx = ((stats.tx_rate ?: "0") as double)
                                def rx = ((stats.rx_rate ?: "0") as double)
                                def modulation = modulationTable[mcs] ?: "-"
                                def rateTxStyle = tx != rx ? "style='color:red; font-weight:bold;'" : ""
                                def rateRxStyle = tx != rx ? "style='color:red; font-weight:bold;'" : ""
                                htmlContent += "<tr><td>${mcs}</td><td>${modulation}</td><td ${rateTxStyle}>${tx.intValue()}</td><td ${rateRxStyle}>${rx.intValue()}</td>"
                                params['Traffic Type'].split(',').collect { it.trim().toLowerCase() }.each { t ->
                                    params.Direction.split(',').collect { it.trim().toLowerCase() }.each { d ->
                                        def key = "${t}_${d}"
                                        def val = data[key] ?: "-"
                                        def cell = val
                                        if (val != "-" && tx > 0) {
                                            def value = (val as double)
                                            def percent = Math.round(value / tx * 100)
                                            def color = percent < 40 ? "red" : percent < 65 ? "orange" : "green"
                                            cell = "<b>${value}</b> <span style='color:${color};'>(~${percent}%)</span>"
                                        }
                                        htmlContent += "<td>${cell}</td>"
                                    }
                                }
                                htmlContent += "<td>${stats.local_SNR_A1 ?: '-'}</td><td>${stats.local_SNR_A2 ?: '-'}</td>"
                                htmlContent += "<td>${stats.remote_SNR_A1 ?: '-'}</td><td>${stats.remote_SNR_A2 ?: '-'}</td>"
                                htmlContent += "<td>${stats.local_noise ?: '-'}</td><td>${stats.remote_noise ?: '-'}</td></tr>"
                            }
                            htmlContent += "</table>"
                        }
                        htmlContent += "</div>"
                    }

                    htmlContent += "</body></html>"

                    writeFile file: env.REPORT_FILE, text: htmlContent
                }
            }
        }
    }

    post {
        always {
            publishHTML (target: [
                allowMissing: false,
                alwaysLinkToLastBuild: true,
