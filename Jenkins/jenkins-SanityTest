import jenkins.model.Jenkins

// --- Helper Functions ---
def archiveArtifacts(pattern) {
    step([$class: 'ArtifactArchiver', artifacts: pattern, fingerprint: true, onlyIfSuccessful: false])
}

def getDeviceInfo(ip) {
    if (!ip || ip == 'N/A') return ["N/A", "N/A", "N/A", "N/A"]
    def model = "N/A"
    def link = "N/A"
    def radio = "N/A"
    def fw = "N/A"
    try {
        sh "ssh-keygen -R ${ip} || true"
        fw = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${ip} 'cat /etc/version || echo N/A'", returnStdout: true).trim()
        model = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${ip} 'cat /etc/board.json | jq -r '.model.name // \"N/A\"' 2>/dev/null || echo N/A'", returnStdout: true).trim()
        def info = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${ip} 'iwinfo || echo N/A'", returnStdout: true)
        link = (info =~ /Mode:\s*(Access Point|Station|PtP|PtMP|Client)/) ? '$1' : "N/A"
        radio = (info =~ /(2\.4|5|6)GHz/) ? '${it[0]}GHz' : "N/A"
    } catch (e) { echo "Failed to get info for ${ip}" }
    return [model, link, radio, fw]
}

def runTestList(tests, iteration, localIP, remoteIP) {
    tests.each { testTypeRaw ->
        def testType = testTypeRaw.replaceAll('&amp;', '&')
        def logFile = "log_${testType.replaceAll(' ', '_')}_iter${iteration}.log"
        def status = "FAIL"
        def cmd = ""

        try {
            switch(testType) {
                case 'Fast Channel Test':
                    def selectedRadio = params['Radio']
                    def bandwidths = params.Bandwidth.split(',')
                    def countries = params.Countries.split(',')
                    sh 'rm -f *_HT*.json custom_results.json iteration_results.json'
                    sh 'echo "{\\"iterations\\": []}" > iteration_results.json'
                    def iter = 1
                    for (country in countries) {
                        sh "pytest -v -s testCases/test_channelTest.py::test_changecountry --local-ip '${localIP}' --remote-ip '${remoteIP}' --radio '${selectedRadio}' --country '${country}'"
                        for (bandwidth in bandwidths) {
                            if ((country == "Canada" || country == "US 5GHz Non-DFS") && bandwidth == "HT160") continue
                            sh "echo '{\"iterations\": []}' > custom_results.json"
                            sh(script: "python3.10 -m pytest -v -s testCases/test_channelTest.py::test_channelconnectivity --local-ip '${localIP}' --remote-ip '${remoteIP}' --radio '${selectedRadio}' --bandwidth '${bandwidth}' --country '${country}' --extra '1' 2>&1 | tee ${logFile}", returnStdout: true)
                            def results = readJSON file: 'custom_results.json'
                            def normBW = bandwidth == "HT40" ? "HT40+" : bandwidth
                            def newTests = results.iterations.findAll { it.Country == country && it.Bandwidth == normBW }
                            newTests.each { t -> t.iteration = iter++ }
                            def fn = "${country.trim().replaceAll('\\s+', '_')}_${bandwidth.trim()}.json"
                            writeJSON file: fn, json: [iterations: newTests]
                        }
                    }
                    status = "PASS"
                    break
                case 'Firmware Upgrade Test':
                    cmd = "export FW_PATH=\"${env.FIRMWARE_FILE}\"; pytest -v -s testCases/test_firmwareUpgrade.py::test_Upgrade --local-ip '${localIP}' --remote-ip '${remoteIP}' --serialPort '${params['Serial Logging Port']}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
                case 'Ethernet Speed Duplex Test':
                    cmd = "python3 testCases/test_SNMPEthernetDuplex.py --su-ip '${localIP}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
                case 'Soft Reset Test':
                    cmd = "pytest -v -s testCases/test_SSHReset.py::test_soft_reset --local-ip '${localIP}' --remote-ip '${remoteIP}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
                case 'Link Disconnect Test':
                    cmd = "pytest -v -s testCases/test_SSHDisconnect.py::test_Disconnect_Connect --local-ip '${localIP}' --remote-ip '${remoteIP}' --model '${params.Model}' --radio '${params.Radio}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
                case 'Soft Reboot Test':
                    cmd = "pytest -v -s testCases/test_SSHReboot.py::test_reboot --local-ip '${localIP}' --remote-ip '${remoteIP}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
                case 'Throughput Test':
                    def rPCIP = ""
                    node(params['Remote PC']) { rPCIP = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^192\\.168\\.1\\./ {print \$4}' | cut -d'/' -f1 | head -n1", returnStdout: true).trim() }
                    def traffic_types = params['Traffic Type'].split(',')
                    def directions = params.Direction.split(',')
                    def bandwidths = params.Bandwidth.split(',')
                    def link_types = params['Link Type'].split(',')
                    def mcsrates = params.MCS.split(',')
                    def test_time = params['Throughput Test Time']
                    sh 'rm -f Throughput_*.json custom_results.json'
                    def iter = 1
                    for (link_type in link_types) {
                        sh "python3.10 -m pytest -v -s testCases/test_Throughput.py::test_changelinktype --local-ip '${localIP}' --remote-ip '${remoteIP}' --radio '${params.Radio}' --link-type '${link_type}'"
                        for (bandwidth in bandwidths) {
                            sh "python3.10 -m pytest -v -s testCases/test_Throughput.py::test_changebandwidth --local-ip '${localIP}' --remote-ip '${remoteIP}' --radio '${params.Radio}' --bandwidth '${bandwidth}'"
                            for (mcs in mcsrates) {
                                sh "python3.10 -m pytest -v -s testCases/test_Throughput.py::test_changemcs --local-ip '${localIP}' --remote-ip '${remoteIP}' --radio '${params.Radio}' --mcs-rate '${mcs}'"
                                for (tt in traffic_types) {
                                    sh "echo '{\"iterations\": []}' > custom_results.json"
                                    sh(script: "python3.10 -m pytest -v -s testCases/test_Throughput.py::test_throughputtest --local-ip '${localIP}' --remote-ip '${remoteIP}' --radio '${params.Radio}' --mcs-rate '${mcs}' --traffic-type '${tt}' --traffic-dir '${directions.join(',')}' --remote-pc-ip '${rPCIP}' --bandwidth '${bandwidth}' --sleep '${test_time}' 2>&1 | tee ${logFile}", returnStdout: true)
                                    def res = readJSON file: 'custom_results.json'
                                    res.iterations.each { t -> t.iteration = iter++ }
                                    def fn = "Throughput_${link_type}_${bandwidth}_${mcs}.json"
                                    writeJSON file: fn, json: res
                                }
                            }
                        }
                    }
                    status = "PASS"
                    break
                case 'VLAN Test':
                    // ... (your full VLAN logic)
                    cmd = "python3.10 -m pytest -v -s testCases/test_vlantesting.py::test_vlan ..."
                    break
                case 'QOS Test':
                    // ... (your full QOS logic)
                    cmd = "python3.10 -m pytest -v -s testCases/test_qos.py::test_qosTest ..."
                    break
                case 'Factory Reset Test':
                    cmd = "pytest -v -s testCases/test_SSHFactoryReset.py::test_factory_reset --local-ip '${localIP}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
            }
            if (cmd) {
                def code = sh(script: cmd, returnStatus: true)
                status = code == 0 ? "PASS" : "FAIL"
            }
        } catch (e) {
            echo "Exception in ${testType}: ${e}"
            sh "echo 'ERROR: ${e}' >> ${logFile}"
        }

        // Save result
        def pyAdd = """
import json, os
data = json.load(open('iteration_results.json')) if os.path.exists('iteration_results.json') else {"iterations": []}
data["iterations"].append({"test": "${testType.replaceAll(' ', '_').toLowerCase()}", "iteration": ${iteration}, "status": "${status}", "logFile": "${logFile}"})
open('iteration_results.json', 'w').write(json.dumps(data, indent=4))
"""
        sh "python3 -c \"${pyAdd}\""
        sleep 10
    }
}

