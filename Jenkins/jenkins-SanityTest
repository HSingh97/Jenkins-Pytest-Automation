import jenkins.model.Jenkins
import groovy.json.JsonSlurper

pipeline {
    agent { node { label "${params.TARGET_STAND}" } }

    options {
        timestamps()
        timeout(time: 6, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Preparation') {
            steps {
                script {
                    echo "========================================"
                    echo "      SANITY AUTOMATION SUITE           "
                    echo "========================================"
                    echo "TARGET STAND : ${params.TARGET_STAND}"
                    echo "REMOTE NODE  : ${params['Remote PC']}"

                    if (!params['Local IP Address']) {
                        error "❌ Error: 'Local IP Address' parameter is missing!"
                    }

                    env.REPORT_FILE = "Sanity_Report_${env.BUILD_NUMBER}.html"

                    // Clean workspace safely
                    sh 'rm -f *.json *.html *.log *.zip || true'
                    sh 'rm -rf artifacts debug_tables || true'
                    sh 'mkdir -p artifacts debug_tables'

                    // Initialize generic result file
                    writeFile file: 'iteration_results.json', text: '{"iterations": []}'

                    // Create Python Helper for Channel Test Parsing
                    // This creates a dedicated script file to avoid shell quoting errors
                    writeFile file: 'update_channel.py', text: '''
import json, sys, os

try:
    country = sys.argv[1]
    bandwidth = sys.argv[2]
    iteration = int(sys.argv[3])
    norm_bw = bandwidth if bandwidth != "HT40" else "HT40+"
    target_file = f"{country.replace(' ', '_')}_{bandwidth}.json"

    if os.path.exists('custom_results.json'):
        with open('custom_results.json') as f:
            data = json.load(f)

        new_tests = [t for t in data.get('iterations', []) if t.get('Country') == country and t.get('Bandwidth') == norm_bw]

        if new_tests:
            for t in new_tests:
                t['iteration'] = iteration

            final_data = {'iterations': []}
            if os.path.exists(target_file):
                try:
                    with open(target_file) as tf:
                        final_data = json.load(tf)
                except: pass

            final_data['iterations'].extend(new_tests)

            with open(target_file, 'w') as f:
                json.dump(final_data, f, indent=4)
            print(f"Successfully updated {target_file}")
except Exception as e:
    print(f"Error updating channel JSON: {str(e)}")
'''

                    // Create Python Helper for Throughput Parsing (Append Mode)
                    writeFile file: 'update_throughput.py', text: '''
import json, sys, os

try:
    filename = sys.argv[1]
    iteration = int(sys.argv[2])

    if os.path.exists('custom_results.json') and os.path.getsize('custom_results.json') > 10:
        with open('custom_results.json') as f:
            new_data = json.load(f)

        final_data = {'iterations': []}

        # Load existing if available to append (fix overwrite issue)
        if os.path.exists(filename):
            try:
                with open(filename) as tf:
                    final_data = json.load(tf)
            except: pass

        if new_data.get('iterations'):
            for it in new_data['iterations']:
                it['iteration'] = iteration
                final_data['iterations'].append(it)

        with open(filename, 'w') as f:
            json.dump(final_data, f, indent=4)
        print(f"Successfully updated {filename}")
except Exception as e:
    print(f"Error updating throughput JSON: {str(e)}")
'''
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    echo "--- Installing Dependencies ---"
                    sh '''
                        pip3 install pytest || true
                        if [ -f "utilities/requirements.txt" ]; then
                            sh utilities/requirements.txt || true
                        fi
                        which snmpget >/dev/null 2>&1 || {
                            sudo apt-get update -qq
                            sudo apt-get install -y snmp snmp-mibs-downloader sshpass
                        }
                    '''
                }
            }
        }

        stage('Execute Tests') {
            steps {
                script {
                    def tests = params.TEST_TYPES.split(',').collect { it.trim() }
                    def localIP = params['Local IP Address']
                    def remoteIP = params['Remote IP Address']
                    def iterCount = params.ITERATION_COUNT.isInteger() ? params.ITERATION_COUNT.toInteger() : 1

                    // --- 1. CHANNEL TEST ---
                    if (tests.contains('Channel Test')) {
                        echo ">>> STARTING CHANNEL TEST <<<"
                        def countries = params.Countries.split(',')
                        def bandwidths = params.Bandwidth.split(',')
                        def radio = params.Radio

                        // Loop through iterations
                        for (int i = 1; i <= iterCount; i++) {
                            echo "--- Channel Test Iteration ${i} ---"
                            for (country in countries) {
                                country = country.trim()
                                // Change Country
                                sh "pytest -v -s testCases/test_channelTest.py::test_changecountry --local-ip '${localIP}' --remote-ip '${remoteIP}' --radio '${radio}' --country '${country}' 2>&1"
                                sleep 5

                                for (bandwidth in bandwidths) {
                                    bandwidth = bandwidth.trim()

                                    // Change BW
                                    sh "python3.10 -m pytest -v -s testCases/test_Throughput.py::test_changebandwidth --local-ip '${localIP}' --remote-ip '${remoteIP}' --radio '${radio}' --bandwidth '${bandwidth}' 2>&1"
                                    sleep 10

                                    if ((country == "Canada" || country == "US 5GHz Non-DFS") && bandwidth == "HT160") {
                                        echo "Skipping HT160 for ${country}"
                                        continue
                                    }

                                    sh "echo '{\"iterations\": []}' > custom_results.json"

                                    // Run Scan
                                    sh """
                                        python3.10 -m pytest -v -s testCases/test_channelTest.py::test_channelconnectivity \
                                        --local-ip '${localIP}' --remote-ip '${remoteIP}' \
                                        --radio '${radio}' --bandwidth '${bandwidth}' --country '${country}' --extra '1' 2>&1
                                    """

                                    // Parse using the robust python script created in Prep
                                    sh "python3 update_channel.py '${country}' '${bandwidth}' ${i}"
                                }
                            }
                        }
                    }

                    // --- 2. THROUGHPUT TEST ---
                    if (tests.contains('Throughput')) {
                        echo ">>> STARTING THROUGHPUT TEST <<<"
                        def linktypes = params['Link Type']?.split(',') ?: ['ptp']
                        def bandwidths = params.Bandwidth.split(',')
                        def mcsList = params.MCS.split(',')
                        def trafficTypes = params['Traffic Type'].split(',')
                        def directions = params.Direction.split(',')

                        def rPCIP = ""
                        try {
                            node(params['Remote PC']) {
                                rPCIP = sh(script: "ip -4 -o addr show | awk '\\\$4 ~ /^192\\\\.168\\\\.1\\\\./ {print \\\$4}' | cut -d'/' -f1 | head -n1", returnStdout: true).trim()
                            }
                        } catch(e) { echo "⚠️ Warning: Could not get Remote PC IP. Using placeholder."; rPCIP = "192.168.1.x" }

                        for (int i = 1; i <= iterCount; i++) {
                            echo "--- Throughput Iteration ${i} ---"
                            for (linktype in linktypes) {
                                linktype = linktype.trim()
                                sh "python3.10 -m pytest -v -s testCases/test_Throughput.py::test_changelinktype --local-ip '${localIP}' --remote-ip '${remoteIP}' --radio '${params.Radio}' --link-type '${linktype}' 2>&1"

                                for (bw in bandwidths) {
                                    bw = bw.trim()
                                    sh "python3.10 -m pytest -v -s testCases/test_Throughput.py::test_changebandwidth --local-ip '${localIP}' --remote-ip '${remoteIP}' --radio '${params.Radio}' --bandwidth '${bw}' 2>&1"

                                    for (mcs in mcsList) {
                                        mcs = mcs.trim()
                                        sh "python3.10 -m pytest -v -s testCases/test_Throughput.py::test_changemcs --local-ip '${localIP}' --remote-ip '${remoteIP}' --radio '${params.Radio}' --mcs-rate '${mcs}' 2>&1"

                                        for (trafficType in trafficTypes) {
                                            trafficType = trafficType.trim()
                                            def filename = "Throughput_${linktype}_${bw}_${mcs}.json"

                                            sh "echo '{\"iterations\": []}' > custom_results.json"

                                            // Run Test
                                            sh """
                                                python3.10 -m pytest -v -s testCases/test_Throughput.py::test_throughputtest \
                                                --local-ip '${localIP}' --remote-ip '${remoteIP}' --radio '${params.Radio}' \
                                                --mcs-rate '${mcs}' --traffic-type '${trafficType}' --traffic-dir '${directions.join(',')}' \
                                                --remote-pc-ip '${rPCIP}' --bandwidth '${bw}' \
                                                --sleep '${params['Throughput Test Time'] ?: '10'}' 2>&1
                                            """

                                            // Append Result
                                            sh "python3 update_throughput.py '${filename}' ${i}"
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // --- 3. OTHER TESTS (Simple execution) ---
                    def simpleTests = tests.findAll { !['Channel Test', 'Throughput'].contains(it) }
                    if (simpleTests) {
                        for (int i = 1; i <= iterCount; i++) {
                            simpleTests.each { testType ->
                                def logFile = "log_${testType.replaceAll(' ', '_')}_iter${i}.log"
                                def cmd = ""
                                def status = "FAIL"

                                try {
                                    switch(testType) {
                                        case 'Firmware Upgrade':
                                            cmd = "export FW_PATH=\"${env.FIRMWARE_FILE ?: 'fw.tgz'}\"; pytest -v -s testCases/test_firmwareUpgrade.py::test_Upgrade --local-ip '${localIP}' --remote-ip '${remoteIP}' --serialPort '${params['Serial Logging Port'] ?: '/dev/ttyUSB0'}' --iter ${i} 2>&1"
                                            break
                                        case 'Ethernet Speed Duplex':
                                            cmd = "python3 testCases/test_SNMPEthernetDuplex.py --su-ip '${localIP}' --iter ${i} 2>&1"
                                            break
                                        case 'Soft Reset':
                                            cmd = "pytest -v -s testCases/test_SSHReset.py::test_soft_reset --local-ip '${localIP}' --remote-ip '${remoteIP}' --iter ${i} 2>&1"
                                            break
                                        case 'Disconnect Connect':
                                            cmd = "pytest -v -s testCases/test_SSHDisconnect.py::test_Disconnect_Connect --local-ip '${localIP}' --remote-ip '${remoteIP}' --model '${params.Model}' --radio '${params.Radio}' --iter ${i} 2>&1"
                                            break
                                        case 'Reboot':
                                            cmd = "pytest -v -s testCases/test_SSHReboot.py::test_reboot --local-ip '${localIP}' --remote-ip '${remoteIP}' --iter ${i} 2>&1"
                                            break
                                        case 'QOS':
                                            def q_l_Mgmt = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^10\\.0\\.150\\./ {print \$4}' | cut -d'/' -f1 | head -n1", returnStdout: true).trim()
                                            cmd = "python3.10 -m pytest -v -s testCases/test_qos.py::test_qosTest --local-ip '${localIP}' --remote-ip '${remoteIP}' --qosPIR '${params['QOS PIR']}' --local-pc-mgmt-ip '${q_l_Mgmt}' 2>&1"
                                            break
                                        case 'Factory Reset':
                                            cmd = "pytest -v -s testCases/test_SSHFactoryReset.py::test_factory_reset --local-ip '${localIP}' --iter ${i} 2>&1"
                                            break
                                    }

                                    if (cmd) {
                                        def exitCode = sh(script: "${cmd} | tee ${logFile}", returnStatus: true)
                                        status = (exitCode == 0) ? "PASS" : "FAIL"
                                    }
                                } catch (e) { echo "Error in ${testType}: ${e.message}" }

                                // Save Simple Result
                                def safeName = testType.replaceAll(' ', '_').toLowerCase()
                                def pyAppend = """
import json, os
try:
    data = {'iterations': []}
    if os.path.exists('iteration_results.json'):
        with open('iteration_results.json') as f: data = json.load(f)
    data['iterations'].append({'test': '${safeName}', 'iteration': ${i}, 'status': '${status}'})
    with open('iteration_results.json', 'w') as f: json.dump(data, f, indent=4)
except: pass
"""
                                writeFile file: "append_simple.py", text: pyAppend
                                sh "python3 append_simple.py"
                            }
                        }
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    echo "Generating HTML Report..."

                    // -- CSS & Styles --
                    def css = """
                        body { font-family: 'Segoe UI', sans-serif; background: #f4f7f6; color: #333; margin:0; padding:20px; }
                        .container { max-width: 1300px; margin: 0 auto; background: white; padding: 0; box-shadow: 0 4px 10px rgba(0,0,0,0.1); border-radius: 8px; overflow: hidden; }
                        .header { background: #fff; padding: 20px 30px; border-bottom: 3px solid #0056b3; display: flex; justify-content: space-between; align-items: center; }
                        .header img { height: 50px; }
                        .header-text h1 { margin: 0; font-size: 24px; color: #333; }
                        .header-text p { margin: 5px 0 0; font-size: 13px; color: #666; }
                        .content { padding: 30px; }
                        h2 { border-left: 5px solid #0056b3; padding-left: 10px; margin-top: 30px; color: #444; }
                        table { width: 100%; border-collapse: collapse; margin-top: 15px; font-size: 14px; }
                        th, td { padding: 12px; border-bottom: 1px solid #ddd; text-align: center; }
                        th { background: #343a40; color: white; text-transform: uppercase; font-size: 12px; letter-spacing: 0.5px; }
                        tr:nth-child(even) { background: #f8f9fa; }
                        .badge { padding: 4px 8px; border-radius: 4px; font-weight: bold; font-size: 11px; }
                        .pass { background: #d4edda; color: #155724; }
                        .fail { background: #f8d7da; color: #721c24; }
                        .warn { background: #fff3cd; color: #856404; }
                        .footer { background: #eee; text-align: center; padding: 10px; font-size: 12px; color: #777; }
                    """

                    def dateStr = new Date().format("dd MMM yyyy, HH:mm z", TimeZone.getTimeZone("Asia/Kolkata"))
                    def html = "<html><head><style>${css}</style></head><body><div class='container'>"

                    // -- Header --
                    html += """
                        <div class="header">
                            <img src="https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png" alt="Senao">
                            <div class="header-text">
                                <h1>Sanity Automation Report</h1>
                                <p>${env.JOB_NAME} #${env.BUILD_NUMBER} | ${dateStr}</p>
                            </div>
                        </div>
                        <div class="content">
                    """

                    // -- Parameters Table --
                    def localIP = params['Local IP Address']
                    def remoteIP = params['Remote IP Address']
                    def local_fw = "N/A"
                    try { local_fw = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${localIP} 'cat /etc/version' || echo 'N/A'", returnStdout: true).trim() } catch(e){}

                    html += """
                        <h2>Test Environment</h2>
                        <table style="text-align:left;">
                            <tr><th style="width:30%; text-align:left;">Local Device IP</th><td style="text-align:left;">${localIP}</td></tr>
                            <tr><th style="text-align:left;">Firmware Version</th><td style="text-align:left;"><b>${local_fw}</b></td></tr>
                            <tr><th style="text-align:left;">Radio</th><td style="text-align:left;">${params.Radio}</td></tr>
                            <tr><th style="text-align:left;">Tests Executed</th><td style="text-align:left;">${params.TEST_TYPES}</td></tr>
                        </table>
                    """

                    // -- 1. Channel Test Report --
                    if (params.TEST_TYPES.contains('Channel Test')) {
                        def reportFiles = findFiles(glob: '*_HT*.json').findAll { it.length > 20 }
                        if (reportFiles) {
                            reportFiles.each { f ->
                                def data = readJSON file: f.name
                                def nameParts = f.name.replace('.json', '').split('_')
                                def bw = nameParts[-1]
                                def country = nameParts[0..-2].join(' ')

                                html += "<h3>Channel Test: ${country} (${bw})</h3>"
                                html += "<table><tr><th>Ch</th><th>Status</th><th>Link Time</th><th>SNR (L/R)</th><th>HT Mode (L/R)</th></tr>"

                                data.iterations.each { iter ->
                                    iter['Tested Channels'].each { ch ->
                                        def cls = ch.status == 'PASS' ? 'pass' : 'fail'
                                        def stats = ch.link_stats ?: [:]
                                        html += "<tr><td><b>${ch.channel}</b></td><td><span class='badge ${cls}'>${ch.status}</span></td>"
                                        html += "<td>${stats.link_uptime ?: '-'}</td>"
                                        html += "<td>${stats.local_SNR_A1}/${stats.remote_SNR_A1}</td>"
                                        html += "<td>${ch.local_htmode} / ${ch.remote_htmode}</td></tr>"
                                    }
                                }
                                html += "</table>"
                            }
                        }
                    }

                    // -- 2. Throughput Report --
                    if (params.TEST_TYPES.contains('Throughput')) {
                        def reportFiles = findFiles(glob: 'Throughput_*.json').findAll { it.length > 20 }
                        if (reportFiles) {
                            def allResults = []
                            reportFiles.each { f ->
                                def d = readJSON file: f.name
                                if (d?.iterations) allResults << [name: f.name, data: d.iterations]
                            }

                            def grouped = allResults.groupBy { it.name.split('_')[2] } // Group by Bandwidth

                            grouped.each { bw, items ->
                                html += "<h3>Throughput Performance: ${bw}</h3>"
                                html += "<table><tr><th rowspan='2'>MCS</th><th colspan='2'>Phy Rate</th><th colspan='2'>Throughput (Mbps)</th><th colspan='2'>SNR</th></tr>"
                                html += "<tr><th>Tx</th><th>Rx</th><th>TCP</th><th>UDP</th><th>Local</th><th>Remote</th></tr>"

                                // Group items by MCS for matrix rows
                                def mcsGroups = items.groupBy { it.name.split('_')[3].replace('.json','') }
                                // Sort by MCS number
                                def sortedKeys = mcsGroups.keySet().sort { a,b -> (a =~ /\d+/)[0].toInteger() <=> (b =~ /\d+/)[0].toInteger() }

                                sortedKeys.each { mcs ->
                                    def rowItems = mcsGroups[mcs]
                                    def stats = rowItems[0].data[0].results_direction[0].link_stats ?: [:] // Grab stats from first available result
                                    def tx = (stats.tx_rate ?: 0) as int
                                    def rx = (stats.rx_rate ?: 0) as int

                                    // Extract TCP/UDP values
                                    def tcpVal = "-", udpVal = "-"
                                    rowItems.each { item ->
                                        item.data.each { it ->
                                            it.results_direction.each { r ->
                                                if (r.traffic_type.toUpperCase().contains('TCP')) tcpVal = r.throughput
                                                if (r.traffic_type.toUpperCase().contains('UDP')) udpVal = r.throughput
                                            }
                                        }
                                    }

                                    html += "<tr><td><b>${mcs}</b></td><td>${tx}</td><td>${rx}</td>"

                                    // Color Logic
                                    [tcpVal, udpVal].each { val ->
                                        def cell = val
                                        if (val != "-" && tx > 0) {
                                            def pct = ((val as double) / tx * 100).intValue()
                                            def c = pct < 50 ? "red" : (pct < 70 ? "#b8860b" : "green")
                                            cell = "<b>${val}</b> <span style='font-size:10px;color:${c}'>(${pct}%)</span>"
                                        }
                                        html += "<td>${cell}</td>"
                                    }
                                    html += "<td>${stats.local_SNR_A1}</td><td>${stats.remote_SNR_A1}</td></tr>"
                                }
                                html += "</table>"
                            }
                        }
                    }

                    // -- 3. Simple Tests Report --
                    def jsonFile = new File("${workspace}/iteration_results.json")
                    if (jsonFile.exists()) {
                        def master = readJSON file: 'iteration_results.json'
                        def others = master.iterations.findAll { !['channel_test', 'throughput'].contains(it.test) }
                        if (others) {
                            html += "<h3>Sanity Checks</h3><table><tr><th>Test Case</th><th>Iteration</th><th>Status</th></tr>"
                            others.each {
                                def c = it.status == 'PASS' ? 'pass' : 'fail'
                                html += "<tr><td>${it.test}</td><td>${it.iteration}</td><td><span class='badge ${c}'>${it.status}</span></td></tr>"
                            }
                            html += "</table>"
                        }
                    }

                    html += "</div><div class='footer'>Generated by Jenkins Auto-Report System</div></div></body></html>"
                    writeFile file: env.REPORT_FILE, text: html
                }
            }
        }
    }

    post {
        always {
            script {
                if (fileExists(env.REPORT_FILE)) {
                    publishHTML(target: [
                        allowMissing: false, alwaysLinkToLastBuild: true, keepAll: true,
                        reportDir: '.', reportFiles: env.REPORT_FILE, reportName: 'Sanity Report'
                    ])
                    archiveArtifacts("*.html, *.json, *.log")
                }

                // --- Email Notification ---
                def buildUserId = currentBuild.getBuildCauses().find { it._class == 'hudson.model.Cause$UserIdCause' }?.userId ?: "unknown"
                def userEmails = ["puneet": "puneet.sharma@senao.com", "harman": "harmanjot.singh@senao.com"]
                def emailTo = userEmails.get(buildUserId, "puneet.sharma@senao.com")

                def subject = "Sanity Result: ${currentBuild.currentResult} - ${env.JOB_NAME} #${env.BUILD_NUMBER}"
                def body = "<html><body><h2>Build Status: <span style='color:${currentBuild.currentResult=='SUCCESS'?'green':'red'}'>${currentBuild.currentResult}</span></h2><p>Please check the attached report for details.</p></body></html>"

                if (fileExists(env.REPORT_FILE)) {
                     emailext(subject: subject, body: body, to: emailTo, mimeType: 'text/html', attachmentsPattern: env.REPORT_FILE)
                } else {
                     emailext(subject: subject, body: body, to: emailTo, mimeType: 'text/html')
                }
            }
        }
    }
}