import jenkins.model.Jenkins

// ====================== DEVICE INFO ======================
def getDeviceInfo(ip) {
    if (!ip || ip == 'N/A') return ["N/A", "N/A", "N/A", "N/A"]
    def model = "N/A"
    def link = "N/A"
    def radio = "N/A"
    def fw = "N/A"
    try {
        sh "ssh-keygen -R ${ip} || true"
        fw = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${ip} 'cat /etc/version || echo N/A'", returnStdout: true)?.trim() ?: "N/A"
        model = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${ip} 'cat /etc/board.json | jq -r '.model.name // \"N/A\"' 2>/dev/null || echo N/A'", returnStdout: true)?.trim() ?: "N/A"
        def info = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${ip} 'iwinfo 2>/dev/null || echo N/A'", returnStdout: true) ?: ""
        link = (info =~ /Mode:\s*(Access Point|Station|PtP|PtMP|Client)/) ? '$1' : "N/A"
        radio = (info =~ /(2\.4|5|6)GHz/) ? '$1GHz' : "N/A"
    } catch (e) { echo "Warning: Could not get info for ${ip}" }
    return [model, link, radio, fw]
}

// ====================== TEST RUNNER ======================
def runTestList(tests, iterNum, localIP, remoteIP) {
    tests.each { testTypeRaw ->
        def testType = testTypeRaw.replaceAll('&amp;', '&').trim()
        def logFile = "log_${testType.replaceAll(' ', '_')}_iter${iterNum}.log"
        def status = "FAIL"
        def cmd = ""

        try {
            switch(testType) {
                case 'Fast Channel Test':
                    def selectedRadio = params['Radio']
                    def bandwidths = params.Bandwidth.split(',')
                    def countries = params.Countries.split(',')
                    sh 'rm -f *_HT*.json custom_results.json'
                    echo "✅ Cleared old workspace"
                    sh "echo {\\\"iterations\\\": []} > iteration_results.json"
                    def counter = 1
                    for (country in countries) {
                        echo "--------------------------------------------------------------"
                        echo " Configuring Country : ${country}"
                        echo "--------------------------------------------------------------"
                        sh """
                            pytest -v -s testCases/test_channelTest.py::test_changecountry \
                            --local-ip '${localIP}' --remote-ip '${remoteIP}' \
                            --radio '${selectedRadio}' --country '${country}' 2>&1
                        """
                        for (bandwidth in bandwidths) {
                            echo "----------------------------------------"
                            echo " Testing: Country=${country}, Bandwidth=${bandwidth}"
                            echo "----------------------------------------"
                            sh "echo '{\"iterations\": []}' > custom_results.json"
                            if ((country == "Canada" || country == "US 5GHz Non-DFS") && bandwidth == "HT160") continue
                            def pytest_output = sh(script: """
                                python3.10 -m pytest -v -s testCases/test_channelTest.py::test_channelconnectivity \
                                --local-ip '${localIP}' --remote-ip '${remoteIP}' \
                                --radio '${selectedRadio}' --bandwidth '${bandwidth}' --country '${country}' --extra '1'\
                                2>&1
                            """, returnStdout: true).trim()
                            echo "Pytest Output:\n${pytest_output}"
                            def iterationResults = readJSON file: 'custom_results.json'
                            def normalizedBandwidth = bandwidth == "HT40" ? "HT40+" : bandwidth
                            def newTests = iterationResults.iterations.findAll {
                                it.Country == country && it.Bandwidth == normalizedBandwidth
                            }
                            newTests.each { test ->
                                test.iteration = counter++
                                test.logs = pytest_output
                            }
                            def filename = "${country.trim().replaceAll("\\s+", "_")}_${bandwidth.trim()}.json"
                            writeJSON file: filename, json: [iterations: newTests]
                            newTests.each {
                                echo "Iteration ${it.iteration} - ${it.test} => ${it.status}"
                                echo "Country: ${it.Country}, Bandwidth: ${it.Bandwidth}"
                                echo "Channels Tested:"
                                it['Tested Channels'].each { ch ->
                                    echo " - Channel: ${ch.channel}, Status: ${ch.status}"
                                }
                            }
                        }
                    }
                    status = "PASS"
                    break
                case 'Firmware Upgrade Test':
                    cmd = "export FW_PATH=\"${env.FIRMWARE_FILE}\"; pytest -v -s testCases/test_firmwareUpgrade.py::test_Upgrade --local-ip '${localIP}' --remote-ip '${remoteIP}' --serialPort '${params['Serial Logging Port']}' --iter ${iterNum} 2>&1 | tee ${logFile}"
                    break
                case 'Ethernet Speed Duplex Test':
                    cmd = "python3 testCases/test_SNMPEthernetDuplex.py --su-ip '${localIP}' --iter ${iterNum} 2>&1 | tee ${logFile}"
                    break
                case 'Soft Reset Test':
                    cmd = "pytest -v -s testCases/test_SSHReset.py::test_soft_reset --local-ip '${localIP}' --remote-ip '${remoteIP}' --iter ${iterNum} 2>&1 | tee ${logFile}"
                    break
                case 'Link Disconnect Test':
                    cmd = "pytest -v -s testCases/test_SSHDisconnect.py::test_Disconnect_Connect --local-ip '${localIP}' --remote-ip '${remoteIP}' --model '${params.Model}' --radio '${params.Radio}' --iter ${iterNum} 2>&1 | tee ${logFile}"
                    break
                case 'Soft Reboot Test':
                    cmd = "pytest -v -s testCases/test_SSHReboot.py::test_reboot --local-ip '${localIP}' --remote-ip '${remoteIP}' --iter ${iterNum} 2>&1 | tee ${logFile}"
                    break
                case 'Throughput Test':
                    def remotePC = params['Remote PC']
                    def remotePCIP = null
                    node(remotePC) {
                        remotePCIP = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^192\\.168\\.1\\./ {print \$4}' | cut -d'/' -f1 | head -n1", returnStdout: true).trim()
                    }
                    def selectedRadio = params['Radio']
                    def traffic_types = params['Traffic Type'].split(',')
                    def directions = params.Direction.split(',')
                    def bandwidths = params.Bandwidth.split(',')
                    def link_types = params['Link Type'].split(',')
                    def modulationrates = params.MCS.split(',')
                    def test_time = params['Throughput Test Time']
                    sh 'rm -f Throughput_*.json custom_results.json'
                    echo "✅ Cleared old workspace"
                    sh "echo {\\\"iterations\\\": []} > iteration_results.json"
                    def counter = 1
                    for (link_type in link_types) {
                        echo "=============================================================="
                        echo " Testing Link Type : ${link_type}"
                        echo "=============================================================="
                        sh """
                            python3.10 -m pytest -v -s testCases/test_Throughput.py::test_changelinktype \
                            --local-ip '${localIP}' --remote-ip '${remoteIP}' \
                            --radio '${selectedRadio}' --link-type '${link_type}' 2>&1
                        """
                        for (bandwidth in bandwidths) {
                            echo "--------------------------------------------------------------"
                            echo " Configuring Bandwidth : ${bandwidth}"
                            echo "--------------------------------------------------------------"
                            sh """
                                python3.10 -m pytest -v -s testCases/test_Throughput.py::test_changebandwidth \
                                --local-ip '${localIP}' --remote-ip '${remoteIP}' \
                                --radio '${selectedRadio}' --bandwidth '${bandwidth}' 2>&1
                            """
                            for (mcsrate in modulationrates) {
                                echo "--------------------------------------------------------------"
                                echo " Configuring MCS : ${mcsrate}"
                                echo "--------------------------------------------------------------"
                                sh """
                                    python3.10 -m pytest -v -s testCases/test_Throughput.py::test_changemcs \
                                    --local-ip '${localIP}' --remote-ip '${remoteIP}' \
                                    --radio '${selectedRadio}' --mcs-rate '${mcsrate}' 2>&1
                                """
                                for (traffic_type in traffic_types) {
                                    echo "--------------------------------------------------------------"
                                    echo " Testing: Bandwidth=${bandwidth} | MCS=${mcsrate} | Type=${traffic_type} "
                                    echo "--------------------------------------------------------------"
                                    sh "echo '{\"iterations\": []}' > custom_results.json"
                                    def pytest_output = sh(script: """
                                        python3.10 -m pytest -v -s testCases/test_Throughput.py::test_throughputtest \
                                        --local-ip '${localIP}' \
                                        --remote-ip '${remoteIP}' \
                                        --radio '${selectedRadio}' \
                                        --mcs-rate '${mcsrate}' \
                                        --traffic-type '${traffic_type}' \
                                        --traffic-dir '${directions.join(",")}' \
                                        --remote-pc-ip '${remotePCIP}' \
                                        --bandwidth '${bandwidth}' \
                                        --sleep '${test_time}' \
                                        2>&1
                                    """, returnStdout: true).trim()
                                    echo "Pytest Output:\n${pytest_output}"
                                    def iterationResults = readJSON file: 'custom_results.json'
                                    def normalizedBandwidth = bandwidth == "HT40" ? "HT40+" : bandwidth
                                    def newTests = iterationResults.iterations
                                    newTests.each { test ->
                                        test.iteration = counter++
                                        test.logs = pytest_output
                                    }
                                    def filename = "Throughput_${link_type.trim()}_${bandwidth.trim()}_${mcsrate.trim()}.json"
                                    writeJSON file: filename, json: [iterations: newTests]
                                    newTests.each { test ->
                                        echo "Iteration ${test.iteration} - ${test.test} => ${test.status}"
                                        test.results_direction.eachWithIndex { result, idx ->
                                            echo " ↪ Run ${idx + 1} => Dir: ${result.Direction}, Type: ${result.traffic_type}"
                                            echo " Bandwidth: ${result.bandwidth}, MCS: ${result.data_rate}, Throughput: ${result.throughput} Mbps"
                                        }
                                    }
                                }
                            }
                        }
                    }
                    status = "PASS"
                    break
                case 'VLAN Test':
                    // VLAN logic
                    break
                case 'QOS Test':
                    // QOS logic
                    break
                case 'Factory Reset Test':
                    cmd = "pytest -v -s testCases/test_SSHFactoryReset.py::test_factory_reset --local-ip '${localIP}' --iter ${iterNum} 2>&1 | tee ${logFile}"
                    break
                default:
                    // Other tests
                    break
            }
            if (cmd) {
                def code = sh(script: cmd, returnStatus: true)
                status = code == 0 ? "PASS" : "FAIL"
            }
        } catch (e) {
            echo "ERROR in ${testType}: ${e}"
            sh "echo 'ERROR: ${e}' >> ${logFile}"
        }

        // FIXED PYTHON APPEND
        def pyAdd = """
import json, os
data = {"iterations": []}
if os.path.exists('iteration_results.json'):
    with open('iteration_results.json') as f:
        data = json.load(f)
data["iterations"].append({
    'test': '${testType.replaceAll(' ','_').toLowerCase()}',
    'iteration': ${iterNum},
    'status': '${status}',
    'logFile': '${logFile}'
})
with open('iteration_results.json', 'w') as f:
    json.dump(data, f, indent=4)
"""
        sh "python3 -c \"${pyAdd}\""
        sleep 10
    }
}

// ====================== MAIN PIPELINE ======================
pipeline {
    agent { node { label "${params.TARGET_STAND}" } }

    options {
        timestamps()
        timeout(time: 6, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Preparation') {
            steps {
                script {
                    echo "========================================"
                    echo "    SANITY AUTOMATION TEST SUITE       "
                    echo "========================================"
                    env.REPORT_FILE = "Sanity_Report_${env.BUILD_NUMBER}.html"
                    sh 'rm -f *.json *.html *.log *.zip || true'
                    sh 'mkdir -p artifacts || true'
                    sh 'echo "{\\"iterations\\": []}" > iteration_results.json'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    sh '''
                        pip3 install pytest || true
                        [ -f utilities/requirements.txt ] && pip3 install -r utilities/requirements.txt || true
                        sudo apt-get update -qq && sudo apt-get install -y sshpass snmp jq wget bc || true
                    '''
                    // Firmware download
                    if (params.TEST_TYPES?.contains('Firmware Upgrade Test') && params.Build?.contains('/bonsai/')) {
                        def url = params.Build
                        def path = url.substring(url.indexOf('/bonsai/') + 8)
                        def dl = "https://jenkins.senao.com/bonsai/${path}"
                        dl += dl.endsWith('/') ? '' : '/'
                        def ok = sh(script: "wget --spider -S '${dl}' 2>&1 | grep -q '200 OK'", returnStatus: true)
                        if (ok == 0) {
                            sh "wget --no-verbose --no-parent --no-check-certificate -r -l1 -A '*-apps.tgz,*-apps.img.enc' --no-directories '${dl}'"
                            sh 'mv *-apps.img.enc fw.img.enc 2>/dev/null || true'
                            sh 'mv *-apps.tgz fw.tgz 2>/dev/null || true'
                            env.FIRMWARE_FILE = "fw.tgz"
                            archiveArtifacts('fw.tgz,fw.img.enc')
                        }
                    }
                }
            }
        }

        stage('Execute Tests') {
            steps {
                script {
                    def all = params.TEST_TYPES.split(',').collect { it.trim() }
                    def normal = all - 'Factory Reset Test'
                    def factory = all.contains('Factory Reset Test') ? ['Factory Reset Test'] : []
                    def iters = params.ITERATION_COUNT?.isInteger() ? params.ITERATION_COUNT.toInteger() : 2
                    def lIP = params['Local IP Address']
                    def rIP = params['Remote IP Address']

                    for (int i = 1; i <= iters; i++) {
                        echo "ITERATION ${i} / ${iters}"
                        runTestList(normal, i, lIP, rIP)
                    }
                    if (factory) {
                        echo "Running Factory Reset..."
                        runTestList(factory, 1, lIP, rIP)
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def lIP = params['Local IP Address']
                    def rIP = params['Remote IP Address'] ?: 'N/A'
                    def (lModel, lLink, lRadio, lFW) = getDeviceInfo(lIP)
                    def (rModel, rLink, rRadio, rFW) = getDeviceInfo(rIP)
                    def json = readJSON file: 'iteration_results.json'
                    def now = new Date().format("dd MMM yyyy, HH:mm:ss z", TimeZone.getTimeZone('Asia/Kolkata'))
                    def logo = "https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png"

                    def html = """<html><head><meta charset="utf-8"><style>
                        body {font-family:'Segoe UI',sans-serif;background:#f8fafc;color:#1e293b;margin:0;padding:40px;}
                        .header {background:linear-gradient(135deg,#1e40af,#3b82f6);color:white;padding:40px;border-radius:20px;}
                        table {width:100%;border-collapse:collapse;margin:25px 0;background:white;border-radius:16px;overflow:hidden;box-shadow:0 8px 25px rgba(0,0,0,0.1);}
                        th {background:#1e40af;color:white;padding:20px;}
                        td {padding:18px;text-align:left;}
                        .pass {background:#d1fae5;color:#059669;font-weight:bold;}
                        .fail {background:#fee2e2;color:#dc2626;font-weight:bold;}
                        .partial {background:#fef3c7;color:#d97706;font-weight:bold;}
                    </style></head><body>
                        <div class="header"><img src="${logo}" height="80"/><div style="text-align:right;"><h1>Complete Sanity Report</h1><p>${env.JOB_NAME} #${env.BUILD_NUMBER} • ${now}</p></div></div>
                        <h2>Device Information</h2>
                        <table><tr><td><b>Local DUT</b></td><td>${lIP} ( ${lModel} / ${lLink} / ${lRadio} ) ( ${lFW} )</td></tr>
                               <tr><td><b>Remote DUT</b></td><td>${rIP} ( ${rModel} / ${rLink} / ${rRadio} ) ( ${rFW} )</td></tr></table>
                        <h2>Test Summary</h2><table><tr><th>Test Case</th><th>Status</th></tr>"""

                    ['Fast Channel Test','Firmware Upgrade Test','Ethernet Speed Duplex Test','Soft Reset Test','Link Disconnect Test','Soft Reboot Test','Throughput Test','VLAN Test','QOS Test','Factory Reset Test'].each { name ->
                        def key = name.replaceAll(' ','_').toLowerCase()
                        def res = json.iterations.findAll { it.test == key }
                        if (res) {
                            def allPass = res.every { it.status == "PASS" }
                            def anyFail = res.any { it.status == "FAIL" }
                            def status = allPass ? "PASS" : (anyFail ? "FAILED" : "PARTIALLY FAILED")
                            def cls = allPass ? "pass" : (anyFail ? "fail" : "partial")
                            html += "<tr><td>${name}</td><td class='${cls}'>${status}</td></tr>"
                        }
                    }
                    html += "</table>"

                    // Fast Channel Test Details (exact as your channel script)
                    def chFiles = findFiles(glob: '*_HT*.json').findAll { it.name != 'iteration_results.json' && it.length > 20 }
                    if (chFiles) {
                        html += "<h2>Fast Channel Test Details</h2>"
                        def allResults = []
                        chFiles.each { f ->
                            def d = readJSON file: f.name
                            if (d?.iterations) allResults += d.iterations
                        }
                        allResults.groupBy { "${it.Country} - ${it.Bandwidth}" }.each { key, group ->
                            def statuses = group.collect { it.status }
                            def iterationStatus = statuses.every { it == "PASS" } ? "PASS" : (statuses.every { it == "FAIL" } ? "FAIL" : "PARTIAL")
                            def statusColor = iterationStatus == "PASS" ? "#d4edda" : (iterationStatus == "FAIL" ? "#f8d7da" : "#fff3cd")
                            def statusTextColor = iterationStatus == "PASS" ? "green" : (iterationStatus == "FAIL" ? "red" : "orange")
                            html += """
                                <h3>
                                    Country: <i><span style="background-color:#ffff99; padding:2px 6px; border-radius:4px;"><b>${key.split(' - ')[0]}</b></span></i> |
                                    Bandwidth: <i><span style="background-color:#d0ebff; padding:2px 6px; border-radius:4px;"><b>${key.split(' - ')[1]} MHz</b></span></i> |
                                    Status: <span style="background-color:${statusColor}; color:${statusTextColor}; padding:2px 8px; border-radius:5px;"><b>${iterationStatus}</b></span>
                                </h3>
                                <table>
                                  <tr>
                                    <th rowspan="2">Channel</th>
                                    <th rowspan="2">Status</th>
                                    <th colspan="2">Active Channel</th>
                                    <th rowspan="2">Device Uptime</th>
                                    <th rowspan="2">Remote IP</th>
                                    <th rowspan="2">Link Uptime</th>
                                    <th colspan="2">Local SNR</th>
                                    <th colspan="2">Remote SNR</th>
                                    <th colspan="2">Noise Floor</th>
                                    <th colspan="2">Rate</th>
                                    <th colspan="3">HT Mode</th>
                                  </tr>
                                  <tr>
                                    <th>Local</th>
                                    <th>Remote</th>
                                    <th>A1</th>
                                    <th>A2</th>
                                    <th>A1</th>
                                    <th>A2</th>
                                    <th>Local</th>
                                    <th>Remote</th>
                                    <th>Tx</th>
                                    <th>Rx</th>
                                    <th>Configured Local</th>
                                    <th>Active Local</th>
                                    <th>Active Remote</th>
                                  </tr>
                            """
                            group.each { iteration ->
                                iteration["Tested Channels"].each { channel ->
                                    def stats = channel["link_stats"]
                                    def status = channel["status"] == "PASS" ? "<span class='pass'>✅ PASS</span>" : "<span class='fail'>❌ FAIL</span>"
                                    def localHT = channel.local_htmode ?: "-"
                                    def remoteHT = channel.remote_htmode ?: "-"
                                    def expectedBW = iteration.Bandwidth.replaceAll("[^\\d]", "")
                                    def isHTMatch = { htmode, bw ->
                                        def validMap = [
                                            "20": ["11AHE20"],
                                            "40": ["11AHE40PLUS", "11AHE40MINUS"],
                                            "80": ["11AHE80"],
                                            "160": ["11AHE160"]
                                        ]
                                        validMap[bw]?.contains(htmode.toUpperCase())
                                    }
                                    def bandwidthMismatchLocal = !isHTMatch(localHT, expectedBW)
                                    def bandwidthMismatchRemote = !isHTMatch(remoteHT, expectedBW)
                                    def modeMismatch = localHT != remoteHT
                                    def localStyle = (bandwidthMismatchLocal || modeMismatch) ? "color:red; font-weight:bold;" : ""
                                    def remoteStyle = (bandwidthMismatchRemote || modeMismatch) ? "color:red; font-weight:bold;" : ""
                                    html += """
                                        <tr>
                                          <td>${channel.channel}</td>
                                          <td>${status}</td>
                                          <td>${channel.local_active ?: '-'}</td>
                                          <td>${channel.remote_active ?: '-'}</td>
                                          <td>${channel.device_uptime ?: '-'}</td>
                                          <td>${stats?.ip_address ?: 'N/A'}</td>
                                          <td>${stats?.link_uptime ?: '-'}</td>
                                          <td>${stats?.local_SNR_A1 ?: '-'}</td>
                                          <td>${stats?.local_SNR_A2 ?: '-'}</td>
                                          <td>${stats?.remote_SNR_A1 ?: '-'}</td>
                                          <td>${stats?.remote_SNR_A2 ?: '-'}</td>
                                          <td>${stats?.local_noise ?: '-'}</td>
                                          <td>${stats?.remote_noise ?: '-'}</td>
                                          <td>${stats?.tx_rate ?: '-'}</td>
                                          <td>${stats?.rx_rate ?: '-'}</td>
                                          <td>${channel.conf_htmode ?: '-'}</td>
                                          <td style="${localStyle}">${localHT}</td>
                                          <td style="${remoteStyle}">${remoteHT}</td>
                                        </tr>
                                        """
                                }
                            }
                            html += "</table>"
                        }
                    }

                    // Throughput Test Details (exact as your throughput script)
                    def tpFiles = findFiles(glob: 'Throughput_*.json')
                    if (tpFiles) {
                        html += "<h2>Throughput Test Details</h2>"
                        def modulationBase = [
                            "MCS0": "BPSK 1/2", "MCS1": "QPSK 1/2", "MCS2": "QPSK 3/4",
                            "MCS3": "16-QAM 1/2", "MCS4": "16-QAM 3/4", "MCS5": "64-QAM 2/3",
                            "MCS6": "64-QAM 3/4", "MCS7": "64-QAM 5/6", "MCS8": "256-QAM 3/4",
                            "MCS9": "256-QAM 5/6", "MCS10": "1024-QAM 3/4", "MCS11": "1024-QAM 5/6"
                        ]
                        def modulationTable = [:]
                        (0..23).each { i -> modulationTable["MCS${i}"] = modulationBase["MCS${i % 12}"] }
                        def mcsOrder = (0..23).collect { "MCS$it" }
                        def bandwidthOrder = ["HT20", "HT40", "HT80", "HT160"]
                        def groupedByBandwidth = tpFiles.collect { f ->
                            def d = readJSON file: f.name
                            [filename: f.name, content: d.iterations]
                        }.groupBy { it.filename.split('_')[1].trim().toUpperCase() }
                        bandwidthOrder.each { bandwidth ->
                            if (!groupedByBandwidth[bandwidth]) return
                            def entries = groupedByBandwidth[bandwidth]
                            def mcsMap = [:]
                            entries.each { entry ->
                                def mcs = entry.filename.split('_')[2].replace(".json", "").trim().toUpperCase()
                                if (!mcsMap[mcs]) mcsMap[mcs] = [:]
                                entry.content.each { iteration ->
                                    iteration.results_direction.each { result ->
                                        def key = "${result.traffic_type}_${result.Direction}".toLowerCase()
                                        mcsMap[mcs][key] = result.throughput
                                        if (result.Direction.toLowerCase() == "bi-di") {
                                            mcsMap[mcs]["${key}_tx"] = result.tx_value ?: 0.0
                                            mcsMap[mcs]["${key}_rx"] = result.rx_value ?: 0.0
                                        }
                                        if (!mcsMap[mcs].link_stats) mcsMap[mcs].link_stats = result.link_stats
                                    }
                                }
                            }
                            html += "<h3 style='background:#e0f2fe; padding:15px; border-radius:10px;'>Bandwidth: ${bandwidth}</h3><table><tr><th rowspan='2'>MCS</th><th rowspan='2'>Modulation</th><th colspan='2'>Rate (Mbps)</th>"
                            params['Traffic Type'].split(',').collect { it.trim().toUpperCase() }.each { html += "<th colspan='${params.Direction.split(',').size()}'>Throughput (${it}) (Mbps)</th>" }
                            html += "<th colspan='2'>Local SNR (dB)</th><th colspan='2'>Remote SNR (dB)</th><th colspan='2'>Noise (dBm)</th></tr><tr><th>Tx</th><th>Rx</th>"
                            params['Traffic Type'].split(',').collect { it.trim().toUpperCase() }.each { params.Direction.split(',').collect { it.trim().capitalize() }.each { html += "<th>${it}</th>" } }
                            html += "<th>A1</th><th>A2</th><th>A1</th><th>A2</th><th>Local</th><th>Remote</th></tr>"
                            mcsOrder.each { mcs ->
                                def data = mcsMap[mcs]
                                if (!data) return
                                def stats = data.link_stats ?: [:]
                                def tx = ((stats.tx_rate ?: "0") as double)
                                def rx = ((stats.rx_rate ?: "0") as double)
                                def modulation = modulationTable[mcs] ?: "-"
                                def rateTxStyle = tx != rx ? "style='color:red; font-weight:bold;'" : ""
                                def rateRxStyle = tx != rx ? "style='color:red; font-weight:bold;'" : ""
                                html += "<tr><td>${mcs}</td><td>${modulation}</td><td ${rateTxStyle}>${tx.intValue()}</td><td ${rateRxStyle}>${rx.intValue()}</td>"
                                params['Traffic Type'].split(',').collect { it.trim().toLowerCase() }.each { t ->
                                    params.Direction.split(',').collect { it.trim().toLowerCase() }.each { d ->
                                        def key = "${t}_${d}"
                                        def val = data[key] ?: "-"
                                        def cell = val
                                        if (val != "-" && tx > 0) {
                                            def value = (val as double)
                                            def percent = Math.round(value / tx * 100)
                                            def color = percent < 40 ? "red" : percent < 65 ? "orange" : "green"
                                            cell = "<b>${value}</b> <span style='color:${color};'>(~${percent}%)</span>"
                                        }
                                        html += "<td>${cell}</td>"
                                    }
                                }
                                html += "<td>${stats.local_SNR_A1 ?: '-'}</td><td>${stats.local_SNR_A2 ?: '-'}</td>"
                                html += "<td>${stats.remote_SNR_A1 ?: '-'}</td><td>${stats.remote_SNR_A2 ?: '-'}</td>"
                                html += "<td>${stats.local_noise ?: '-'}</td><td>${stats.remote_noise ?: '-'}</td></tr>"
                            }
                            html += "</table>"
                        }
                    }

                    html += "</body></html>"
                    writeFile file: env.REPORT_FILE, text: html
                }
            }
        }
    }

    post {
