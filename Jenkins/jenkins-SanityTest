import jenkins.model.Jenkins

// ====================== DEVICE INFO ======================
def getDeviceInfo(ip) {
    if (!ip || ip == 'N/A') return ["N/A", "N/A", "N/A", "N/A"]
    def model = "N/A"
    def link = "N/A"
    def radio = "N/A"
    def fw = "N/A"
    try {
        sh "ssh-keygen -R ${ip} || true"
        fw = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${ip} 'cat /etc/version || echo N/A'", returnStdout: true)?.trim() ?: "N/A"
        model = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${ip} 'cat /etc/board.json | jq -r '.model.name // \"N/A\"' 2>/dev/null || echo N/A'", returnStdout: true)?.trim() ?: "N/A"
        def info = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${ip} 'iwinfo 2>/dev/null || echo N/A'", returnStdout: true) ?: ""
        link = (info =~ /Mode:\s*(Access Point|Station|PtP|PtMP|Client)/) ? /${'$1'}/ : "N/A"
        radio = (info =~ /(2\.4|5|6)GHz/) ? /${'$1'}GHz/ : "N/A"
    } catch (e) {}
    return [model, link, radio, fw]
}

// ====================== TEST EXECUTION ======================
def runTestList(tests, iteration, localIP, remoteIP) {
    tests.each { testTypeRaw ->
        def testType = testTypeRaw.replaceAll('&amp;', '&').trim()
        def logFile = "log_${testType.replaceAll(' ', '_')}_iter${iteration}.log"
        def status = "FAIL"
        def cmd = ""

        try {
            switch(testType) {
                case 'Fast Channel Test':
                    def radio = params.Radio
                    def countries = params.Countries.split(',')
                    def bandwidths = params.Bandwidth.split(',')
                    sh 'rm -f *_HT*.json custom_results.json'
                    def iter = 1
                    countries.each { country ->
                        sh "pytest -v -s testCases/test_channelTest.py::test_changecountry --local-ip '${localIP}' --remote-ip '${remoteIP}' --radio '${radio}' --country '${country}'"
                        bandwidths.each { bw ->
                            if ((country == "Canada" || country == "US 5GHz Non-DFS") && bw == "HT160") return
                            sh "echo '{\"iterations\": []}' > custom_results.json"
                            sh(script: "python3.10 -m pytest -v -s testCases/test_channelTest.py::test_channelconnectivity --local-ip '${localIP}' --remote-ip '${remoteIP}' --radio '${radio}' --bandwidth '${bw}' --country '${country}' --extra '1' 2>&1 | tee ${logFile}", returnStdout: true)
                            def res = readJSON file: 'custom_results.json'
                            def norm = bw == "HT40" ? "HT40+" : bw
                            def matches = res.iterations.findAll { it.Country == country && it.Bandwidth == norm }
                            matches.each { it.iteration = iter++ }
                            writeJSON file: "${country.replaceAll('\\s+','_')}_${bw}.json", json: [iterations: matches]
                        }
                    }
                    status = "PASS"
                    break
                case 'Firmware Upgrade Test':
                    cmd = "export FW_PATH=\"${env.FIRMWARE_FILE}\"; pytest -v -s testCases/test_firmwareUpgrade.py::test_Upgrade --local-ip '${localIP}' --remote-ip '${remoteIP}' --serialPort '${params['Serial Logging Port']}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
                case 'Ethernet Speed Duplex Test':
                    cmd = "python3 testCases/test_SNMPEthernetDuplex.py --su-ip '${localIP}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
                case 'Soft Reset Test':
                    cmd = "pytest -v -s testCases/test_SSHReset.py::test_soft_reset --local-ip '${localIP}' --remote-ip '${remoteIP}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
                case 'Link Disconnect Test':
                    cmd = "pytest -v -s testCases/test_SSHDisconnect.py::test_Disconnect_Connect --local-ip '${localIP}' --remote-ip '${remoteIP}' --model '${params.Model}' --radio '${params.Radio}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
                case 'Soft Reboot Test':
                    cmd = "pytest -v -s testCases/test_SSHReboot.py::test_reboot --local-ip '${localIP}' --remote-ip '${remoteIP}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
                case 'Throughput Test':
                    def rPCIP = ""
                    node(params['Remote PC']) { rPCIP = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^192\\.168\\.1\\./ {print \$4}' | cut -d'/' -f1 | head -n1", returnStdout: true).trim() }
                    def tt = params['Traffic Type'].split(',')
                    def dir = params.Direction.split(',')
                    def bwList = params.Bandwidth.split(',')
                    def mcsList = params.MCS.split(',')
                    def time = params['Throughput Test Time']
                    sh 'rm -f Throughput_*.json custom_results.json'
                    def iter = 1
                    bwList.each { bw ->
                        mcsList.each { mcs ->
                            tt.each { type ->
                                sh "echo '{\"iterations\": []}' > custom_results.json"
                                sh(script: "python3.10 -m pytest -v -s testCases/test_Throughput.py::test_throughputtest --local-ip '${localIP}' --remote-ip '${remoteIP}' --radio '${params.Radio}' --mcs-rate '${mcs}' --traffic-type '${type}' --traffic-dir '${dir.join(',')}' --remote-pc-ip '${rPCIP}' --bandwidth '${bw}' --sleep '${time}' 2>&1 | tee ${logFile}", returnStdout: true)
                                def res = readJSON file: 'custom_results.json'
                                res.iterations.each { it.iteration = iter++ }
                                writeJSON file: "Throughput_${bw}_${mcs}.json", json: res
                            }
                        }
                    }
                    status = "PASS"
                    break
                case 'VLAN Test':
                    def r_IP, r_If, r_Mgmt, l_IP, l_If, l_Mgmt
                    node(params['Remote PC']) {
                        r_IP = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^192\\.168\\.1\\./ {print \$4}' | cut -d'/' -f1 | head -n1", returnStdout: true).trim()
                        r_If = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^192\\.168\\.1\\./ {print \$2}' | head -n1", returnStdout: true).trim()
                        r_Mgmt = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^10\\.0\\.150\\./ {print \$4}' | cut -d'/' -f1 | head -n1", returnStdout: true).trim()
                    }
                    node(params.TARGET_STAND) {
                        l_IP = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^192\\.168\\.1\\./ {print \$4}' | cut -d'/' -f1 | head -n1", returnStdout: true).trim()
                        l_If = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^192\\.168\\.1\\./ {print \$2}' | head -n1", returnStdout: true).trim()
                        l_Mgmt = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^10\\.0\\.150\\./ {print \$4}' | cut -d'/' -f1 | head -n1", returnStdout: true).trim()
                    }
                    cmd = "python3.10 -m pytest -v -s testCases/test_vlantesting.py::test_vlan --local-ip '${localIP}' --remote-ip '${remoteIP}' --radio '${params.Radio}' --vlan '${params.VLAN}' --local-interface '${l_If}' --remote-interface '${r_If}' --local-pc-ip '${l_IP}' --remote-pc-ip '${r_IP}' --local-pc-mgmt-ip '${l_Mgmt}' --remote-pc-mgmt-ip '${r_Mgmt}' 2>&1 | tee ${logFile}"
                    break
                case 'QOS Test':
                    def q_l_Mgmt, q_r_Mgmt
                    node(params['Remote PC']) { q_r_Mgmt = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^10\\.0\\.150\\./ {print \$4}' | cut -d'/' -f1 | head -n1", returnStdout: true).trim() }
                    node(params.TARGET_STAND) { q_l_Mgmt = sh(script: "ip -4 -o addr show | awk '\$4 ~ /^10\\.0\\.150\\./ {print \$4}' | cut -d'/' -f1 | head -n1", returnStdout: true).trim() }
                    cmd = "python3.10 -m pytest -v -s testCases/test_qos.py::test_qosTest --local-ip '${localIP}' --remote-ip '${remoteIP}' --qosPIR '${params['QOS PIR']}' --local-pc-mgmt-ip '${q_l_Mgmt}' --remote-pc-mgmt-ip '${q_r_Mgmt}' 2>&1 | tee ${logFile}"
                    break
                case 'Factory Reset Test':
                    cmd = "pytest -v -s testCases/test_SSHFactoryReset.py::test_factory_reset --local-ip '${localIP}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
            }
            if (cmd) {
                def code = sh(script: cmd, returnStatus: true)
                status = code == 0 ? "PASS" : "FAIL"
            }
        } catch (e) {
            echo "ERROR in ${testType}: ${e}"
            sh "echo 'ERROR: ${e}' >> ${logFile}"
        }

        def pyAdd = """
import json, os
d = json.load(open('iteration_results.json')) if os.path.exists('iteration_results.json') else {"iterations": []}
d["iterations"].append({"test": "${testType.replaceAll(' ','_').toLowerCase()}", "iteration": ${iteration}, "status": "${status}", "logFile": "${logFile}"})
open('iteration_results.json', 'w').write(json.dumps(d, indent=4))
"""
        sh "python3 -c \"${pyAdd}\""
        sleep 10
    }
}

// ====================== MAIN PIPELINE ======================
pipeline {
    agent { node { label "${params.TARGET_STAND}" } }
    options {
        timestamps()
        timeout(time: 6, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Preparation') {
            steps {
                script {
                    echo "========================================"
                    echo "    SANITY AUTOMATION TEST SUITE       "
                    echo "========================================"
                    env.REPORT_FILE = "Sanity_Report_${env.BUILD_NUMBER}.html"
                    sh 'rm -f *.json *.html *.log *.zip; mkdir -p artifacts debug_tables'
                    sh 'echo "{\\"iterations\\": []}" > iteration_results.json'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    sh '''
                        pip3 install pytest || true
                        [ -f utilities/requirements.txt ] && pip3 install -r utilities/requirements.txt || true
                        sudo apt-get update -qq && sudo apt-get install -y sshpass snmp jq wget bc || true
                    '''
                    if (params.TEST_TYPES?.contains('Firmware Upgrade Test') && params.Build?.contains('/bonsai/')) {
                        def url = params.Build
                        def path = url.substring(url.indexOf('/bonsai/') + 8)
                        def dl = "https://jenkins.senao.com/bonsai/${path}"
                        dl += dl.endsWith('/') ? '' : '/'
                        def ok = sh(script: "wget --spider -S '${dl}' 2>&1 | grep -q '200 OK'", returnStatus: true)
                        if (ok == 0) {
                            sh "wget --no-verbose --no-parent --no-check-certificate -r -l1 -A '*-apps.tgz,*-apps.img.enc' --no-directories '${dl}'"
                            sh '''
                                [ -f *-apps.img.enc ] && mv *-apps.img.enc fw.img.enc
                                [ -f *-apps.tgz ] && mv *-apps.tgz fw.tgz
                            '''
                            env.FIRMWARE_FILE = "fw.tgz"
                            archiveArtifacts('fw.tgz,fw.img.enc')
                        }
                    }
                }
            }
        }

        stage('Execute Tests') {
            steps {
                script {
                    def all = params.TEST_TYPES.split(',').collect { it.trim() }
                    def normal = all - 'Factory Reset Test'
                    def factory = all.contains('Factory Reset Test') ? ['Factory Reset Test'] : []
                    def iters = params.ITERATION_COUNT?.isInteger() ? params.ITERATION_COUNT.toInteger() : 2
                    def lIP = params['Local IP Address']
                    def rIP = params['Remote IP Address']

                    (1..iters).each { i ->
                        echo "=== ITERATION ${i}/${iters} ==="
                        runTestList(normal, i, lIP, rIP)
                    }
                    if (factory) runTestList(factory, 1, lIP, rIP)
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def lIP = params['Local IP Address']
                    def rIP = params['Remote IP Address'] ?: 'N/A'
                    def (lModel, lLink, lRadio, lFW) = getDeviceInfo(lIP)
                    def (rModel, rLink, rRadio, rFW) = getDeviceInfo(rIP)
                    def json = readJSON file: 'iteration_results.json'
                    def now = new Date().format("dd MMM yyyy, HH:mm:ss z", TimeZone.getTimeZone('Asia/Kolkata'))
                    def logo = "https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png"

                    def html = """<!DOCTYPE html><html><head><meta charset="utf-8">
                        <style>
                            body {font-family:'Segoe UI',sans-serif;background:#f8fafc;color:#1e293b;margin:0;padding:40px;}
                            .header {background:linear-gradient(135deg,#1e40af,#3b82f6);color:white;padding:40px;border-radius:20px;box-shadow:0 15px 35px rgba(0,0,0,0.2);margin-bottom:40px;}
                            .header h1 {margin:0;font-size:38px;font-weight:800;}
                            .device-box {background:white;padding:30px;border-radius:16px;box-shadow:0 8px 25px rgba(0,0,0,0.1);margin-bottom:40px;}
                            table {width:100%;border-collapse:collapse;margin:25px 0;background:white;border-radius:16px;overflow:hidden;box-shadow:0 8px 25px rgba(0,0,0,0.1);}
                            th {background:#1e40af;color:white;padding:20px;font-size:18px;}
                            td {padding:18px;text-align:center;}
                            .pass {background:#d1fae5;color:#059669;font-weight:bold;}
                            .fail {background:#fee2e2;color:#dc2626;font-weight:bold;}
                            .partial {background:#fef3c7;color:#d97706;font-weight:bold;}
                            .section {margin-top:60px;}
                            .section h2 {color:#1e40af;font-size:30px;border-bottom:4px solid #3b82f6;padding-bottom:15px;}
                        </style>
                        </head><body>
                        <div class="header">
                            <img src="${logo}" height="80"/>
                            <div style="text-align:right;">
                                <h1>Complete Sanity Test Report</h1>
                                <p>${env.JOB_NAME} • Build #${env.BUILD_NUMBER}</p>
                                <p>${now}</p>
                            </div>
                        </div>

                        <div class="device-box">
                            <h2>Device Information</h2>
                            <table>
                                <tr><td style="width:180px;font-weight:bold;">Local DUT</td>
                                    <td>${lIP} ( ${lModel} / ${lLink} / ${lRadio} ) ( ${lFW} )</td></tr>
                                <tr><td style="font-weight:bold;">Remote DUT</td>
                                    <td>${rIP} ( ${rModel} / ${rLink} / ${rRadio} ) ( ${rFW} )</td></tr>
                            </table>
                        </div>

                        <div class="section">
                            <h2>Test Summary</h2>
                            <table>
                                <tr><th>Test Case</th><th>Status</th></tr>"""

                    ['Fast Channel Test','Firmware Upgrade Test','Ethernet Speed Duplex Test','Soft Reset Test','Link Disconnect Test','Soft Reboot Test','Throughput Test','VLAN Test','QOS Test','Factory Reset Test'].each { name ->
                        def key = name.replaceAll(' ','_').toLowerCase()
                        def res = json.iterations.findAll { it.test == key }
                        if (res) {
                            def allPass = res.every { it.status == "PASS" }
                            def anyFail = res.any { it.status == "FAIL" }
                            def status = allPass ? "PASS" : (anyFail ? "FAILED" : "PARTIALLY FAILED")
                            def cls = allPass ? "pass" : (anyFail ? "fail" : "partial")
                            html += "<tr><td style='text-align:left;font-weight:600;font-size:18px;'>${name}</td><td class='${cls}' style='font-size:20px;'>${status}</td></tr>"
                        }
                    }
                    html += "</table></div>"

                    // Fast Channel Test Full Details
                    def chFiles = findFiles(glob: '*_HT*.json') - findFiles(glob: 'iteration_results.json')
                    if (chFiles.size() > 0) {
                        html += "<div class='section'><h2>Fast Channel Test - Detailed Results</h2>"
                        def chData = []
                        chFiles.each { f -> chData += readJSON(file: f.name).iterations }
                        chData.groupBy { "${it.Country} - ${it.Bandwidth}" }.each { key, group ->
                            def allPass = group.every { it.status == "PASS" }
                            html += "<h3 style='background:#e0f2fe;padding:15px;border-radius:10px;'>${key} → <strong style='color:${allPass?'green':'red'}'>${allPass?'PASS':'FAIL'}</strong></h3>"
                            html += "<table><tr><th>Channel</th><th>Status</th><th>Local Active</th><th>Remote Active</th><th>Local SNR</th><th>Remote SNR</th><th>Tx Rate</th><th>Rx Rate</th></tr>"
                            group.sort { it['Tested Channels'][0].channel }.each { iter ->
                                iter['Tested Channels'].each { ch ->
                                    def s = ch.status == "PASS" ? "pass" : "fail"
                                    def stats = ch.link_stats
                                    html += "<tr><td>${ch.channel}</td><td class='${s}'>${ch.status}</td><td>${ch.local_active?:'-'}</td><td>${ch.remote_active?:'-'}</td><td>${stats?.local_SNR_A1?:'-'}</td><td>${stats?.remote_SNR_A1?:'-'}</td><td>${stats?.tx_rate?:'-'}</td><td>${stats?.rx_rate?:'-'}</td></tr>"
                                }
                            }
                            html += "</table>"
                        }
                        html += "</div>"
                    }

                    // Throughput Test Full Details
                    def tpFiles = findFiles(glob: 'Throughput_*.json')
                    if (tpFiles.size() > 0) {
                        html += "<div class='section'><h2>Throughput Test - Performance Results</h2>"
                        def tpData = []
                        tpFiles.each { f -> tpData += readJSON(file: f.name).iterations }
                        // Add your full MCS table generation here exactly as you had in your dedicated script
                        // (same logic with modulation, percentages, colors, etc.)
                        html += "<table><tr><th>MCS</th><th>Modulation</th><th>Tx Rate</th><th>Rx Rate</th><th>UDP Down</th><th>UDP Up</th><th>TCP Down</th><th>TCP Up</th><th>Bi-Di</th></tr>"
                        // ... your full MCS table code ...
                        html += "</table></div>"
                    }

                    html += "</body></html>"
                    writeFile file: env.REPORT_FILE, text: html
                }
            }
        }
    }

    post {
        always {
            publishHTML (target: [
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: '.',
                reportFiles: "${env.REPORT_FILE}",
                reportName: "Sanity Report - Build ${env.BUILD_NUMBER}"
            ])
            echo "-----------------------------------------\nScript Done!\n-----------------------------------------"
            script {
                def buildCauses = currentBuild.getBuildCauses()
                def userCause = buildCauses.find { it._class == 'hudson.model.Cause$UserIdCause' }
                def buildUserName = userCause?.userName ?: "Unknown User"
                def buildUserId = userCause?.userId ?: "unknown"
                echo "Build started by: ${buildUserName} (${buildUserId})"
                def userEmails = [
                    "harman": "harmanjot.singh@senao.com",
                    "mahesh": "mahesh.battala@senao.com",
                    "sandeep": "sandeep.manchikanti@senao.com",
                    "sampath": "sampath.marella@senao.com",
                    "jayanth": "jayanth.munnaluru@senao.com",
                    "srilatha": "srilatha.tadiboina@senao.com",
                    "phani": "phani.darla@senao.com",
                    "dinesh": "dinesh.redddy@senao.com"
                ]
                def userEmail = userEmails[buildUserId] ?: "harmanjot.singh@senao.com"
                emailext(
                    subject: "Sanity Result: ${currentBuild.currentResult} - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                    body: """<html><body>
                        <h2 style="color:${currentBuild.currentResult == 'SUCCESS' ? 'green' : 'red'};">
                            Sanity Automation: ${currentBuild.currentResult}
                        </h2>
                        <p><strong>Build:</strong> ${env.JOB_NAME} #${env.BUILD_NUMBER}</p>
                        <p><strong>Started By:</strong> ${buildUserName}</p>
                        <p><strong>Check Report:</strong> <a href="${env.BUILD_URL}Sanity_20Report_20-_20Build_20${env.BUILD_NUMBER}/">View Complete Report</a></p>
                        <p><strong>Console:</strong> <a href="${env.BUILD_URL}console">View Console</a></p>
                    </body></html>""",
                    to: userEmail,
                    mimeType: 'text/html',
                    attachmentsPattern: env.REPORT_FILE
                )
            }
        }
        success { echo "Script Success" }
        failure { echo "Script Failure" }
    }
}