import jenkins.model.Jenkins

// --- Helper Functions ---
def archiveArtifacts(pattern) {
    step([$class: 'ArtifactArchiver', artifacts: pattern, fingerprint: true, onlyIfSuccessful: false])
}

// Helper to run specific test commands based on type
def runTestList(tests, iteration, localIP, remoteIP) {
    tests.each { testTypeRaw ->
        def testType = testTypeRaw.replaceAll('&amp;', '&')
        def logFile = "log_${testType.replaceAll(' ', '_')}_iter${iteration}.log"
        def status = "FAIL"
        def cmd = ""

        try {
            switch(testType) {
                case 'Channel Test':
                    cmd = "python3.10 -m pytest -v -s testCases/test_channelTest.py::test_channelconnectivity --local-ip '${localIP}' --remote-ip '${remoteIP}' --radio '${params.Radio}' --country '${params.Countries}' --bandwidth '${params.Bandwidth}' --extra '1' 2>&1 | tee ${logFile}"
                    break
                case 'Firmware Upgrade':
                    cmd = "export FW_PATH=\"${env.FIRMWARE_FILE ?: 'fw.tgz'}\"; pytest -v -s testCases/test_firmwareUpgrade.py::test_Upgrade --local-ip '${localIP}' --remote-ip '${remoteIP}' --serialPort '${params['Serial Logging Port']}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
                case 'Ethernet Speed Duplex':
                    cmd = "python3 testCases/test_SNMPEthernetDuplex.py --su-ip '${localIP}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
                case 'Soft Reset':
                    cmd = "pytest -v -s testCases/test_SSHReset.py::test_soft_reset --local-ip '${localIP}' --remote-ip '${remoteIP}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
                case 'Disconnect Connect':
                    cmd = "pytest -v -s testCases/test_SSHDisconnect.py::test_Disconnect_Connect --local-ip '${localIP}' --remote-ip '${remoteIP}' --model '${params.Model}' --radio '${params.Radio}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
                case 'Reboot':
                    cmd = "pytest -v -s testCases/test_SSHReboot.py::test_reboot --local-ip '${localIP}' --remote-ip '${remoteIP}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
                case 'Throughput':
                    def rPCIP = ""
                    node(params['Remote PC']) {
                        rPCIP = sh(script: '''ip -4 -o addr show | awk '$4 ~ /^192\\.168\\.1\\./ {print $4}' | cut -d'/' -f1 | head -n1''', returnStdout: true).trim()
                    }
                    cmd = "python3.10 -m pytest -v -s testCases/test_Throughput.py::test_throughputtest --local-ip '${localIP}' --remote-ip '${remoteIP}' --radio '${params.Radio}' --mcs-rate '${params.MCS}' --traffic-type '${params['Traffic Type']}' --traffic-dir '${params.Direction}' --remote-pc-ip '${rPCIP}' --bandwidth '${params.Bandwidth}' --sleep '${params['Throughput Test Time']}' 2>&1 | tee ${logFile}"
                    break
                case 'VLAN Test':
                    status = "SKIPPED"
                    break
                case 'QOS Test':
                    status = "SKIPPED"
                    break
                case 'Factory Reset':
                    cmd = "pytest -v -s testCases/test_SSHFactoryReset.py::test_factory_reset --local-ip '${localIP}' --iter ${iteration} 2>&1 | tee ${logFile}"
                    break
            }
            if(cmd) {
                def exitCode = sh(script: cmd, returnStatus: true)
                status = (exitCode == 0) ? "PASS" : "FAIL"
            }
        } catch (Exception e) {
            echo "Exception in ${testType}: ${e.message}"
            sh "echo 'Error: ${e.message}' >> ${logFile}"
        }

        def safeTestName = testType.replaceAll(' ', '_').toLowerCase()
        def pyCmd = """
import json
try:
    with open('iteration_results.json', 'r+') as f:
        data = json.load(f)
        data['iterations'].append({'test': '${safeTestName}', 'iteration': ${iteration}, 'status': '${status}', 'logFile': '${logFile}'})
        f.seek(0)
        json.dump(data, f, indent=4)
        f.truncate()
except Exception as e:
    print(e)
"""
        sh "python3 -c \"${pyCmd}\""
        sleep 10
    }
}

pipeline {
    agent { node { label "${params.TARGET_STAND}" } }

    options {
        timestamps()
        timeout(time: 6, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Preparation') {
            steps {
                script {
                    echo "========================================"
                    echo "    SANITY AUTOMATION TEST SUITE       "
                    echo "========================================"
                    env.REPORT_FILE = "Sanity_Report_${env.BUILD_NUMBER}.html"
                    sh 'rm -f *.json *.html *.log *.zip || true'
                    sh 'mkdir -p artifacts'
                    sh 'echo "{\\"iterations\\": []}" > iteration_results.json'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    echo "--- Installing Dependencies ---"
                    sh '''
                        pip3 install pytest || true
                        if [ -f "utilities/requirements.txt" ]; then
                            sh utilities/requirements.txt || true
                        fi
                        which snmpget >/dev/null 2>&1 || {
                            echo "--- Installing SNMP tools ---"
                            sudo apt-get update -qq
                            sudo apt-get install -y snmp snmp-mibs-downloader sshpass
                        }
                    '''
                }
            }
        }

        stage('Firmware Prep') {
            when { expression { return params.TEST_TYPES.contains('Firmware Upgrade') } }
            steps {
                script {
                    echo "--- Pre-downloading Firmware ---"
                    def url = params['Build']
                    if (url && url.contains('/bonsai/')) {
                        def buildPath = url.substring(url.indexOf('/bonsai/') + 8)
                        def WGET_URL = "https://jenkins.senao.com/bonsai/${buildPath}"
                        if (!WGET_URL.endsWith('/')) WGET_URL += '/'

                        def status = sh(script: "wget --spider -S ${WGET_URL} 2>&1 | grep 'HTTP/.* 200 OK'", returnStatus: true)

                        if (status == 0) {
                             sh "wget --no-verbose --no-parent --no-check-certificate -e robots=off --recursive --level=1 -A '*-apps.img.enc,*-apps.tgz' --no-directories ${WGET_URL} 2>&1"

                            sh """
                               imgfile=\$(ls -t *-apps.img.enc 2>/dev/null | head -n 1)
                               if [ -n "\$imgfile" ]; then mv -f "\$imgfile" "fw.img.enc"; fi
                               tgzfile=\$(ls -t *-apps.tgz 2>/dev/null | head -n 1)
                               if [ -n "\$tgzfile" ]; then mv -f "\$tgzfile" "fw.tgz"; fi
                            """
                            env.FIRMWARE_FILE = "fw.tgz"
                            archiveArtifacts('fw.img.enc, fw.tgz')
                        }
                    }
                }
            }
        }

        stage('Execute Tests') {
            steps {
                script {
                    def allSelectedTests = params.TEST_TYPES.split(',').collect { it.trim() }
                    def factoryResetTest = allSelectedTests.find { it == 'Factory Reset' }
                    def standardTests = allSelectedTests - 'Factory Reset'

                    def globalIterations = params.ITERATION_COUNT.isInteger() ? params.ITERATION_COUNT.toInteger() : 2
                    def localIP = params['Local IP Address']
                    def remoteIP = params['Remote IP Address']

                    if (standardTests) {
                        for (def i = 1; i <= globalIterations; i++) {
                            echo "ITERATION ${i} / ${globalIterations}"
                            runTestList(standardTests, i, localIP, remoteIP)
                        }
                    }
                    if (factoryResetTest) {
                        echo "Running Factory Reset..."
                        runTestList([factoryResetTest], 1, localIP, remoteIP)
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def localIP = params['Local IP Address']
                    def remoteIP = params['Remote IP Address']

                    def local_fw_version = "N/A"
                    def remote_fw_version = "N/A"
                    try {
                        local_fw_version = sh(
                            script: """
                                ssh-keygen -R ${localIP} >/dev/null 2>&1 || true
                                ssh-keyscan -H ${localIP} >> ~/.ssh/known_hosts 2>/dev/null
                                sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${localIP} 'cat /etc/version'
                            """,
                            returnStdout: true
                        ).trim()
                    } catch (e) {
                        echo "Could not retrieve local firmware version from ${localIP}."
                        local_fw_version = "N/A (unreachable)"
                    }

                    try {
                        remote_fw_version = sh(
                            script: """
                                ssh-keygen -R ${remoteIP} >/dev/null 2>&1 || true
                                ssh-keyscan -H ${remoteIP} >> ~/.ssh/known_hosts 2>/dev/null
                                sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${remoteIP} 'cat /etc/version'
                            """,
                            returnStdout: true
                        ).trim()
                    } catch (e) {
                        echo "Could not retrieve remote firmware version from ${remoteIP}."
                        remote_fw_version = "N/A (unreachable)"
                    }

                    def buildParams = [
                        "Local IP Address": localIP,
                        "Remote IP Address": remoteIP,
                        "Radio"           : params['Radio'],
                        "Countries"       : params['Countries'],
                        "Bandwidths"      : params['Bandwidth'],
                        "FW Version (Local / Remote)"      : "${local_fw_version} / ${remote_fw_version}"
                    ]

                    def istZone = TimeZone.getTimeZone("Asia/Kolkata")
                    def istDate = Calendar.getInstance(istZone).getTime()
                    def currentDateTime = istDate.format("dd MMM yyyy, HH:mm:ss z", istZone)
                    def companyLogoUrl = "https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png"
                    def pipelineName = env.JOB_NAME

                    def htmlContent = """
                        <html>
                        <head>
                            <title>Channel Test Report</title>
                            <style>
                                body { font-family: 'Segoe UI', Tahoma, sans-serif; padding: 20px; background-color: #f9f9f9; color: #2c3e50; }
                                .header { display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 20px; border-bottom: 2px solid #e0e0e0; }
                                .header img { height: 60px; }
                                .header-info { text-align: right; }
                                .header-info h1 { margin: 0; font-size: 24px; }
                                .header-info p { margin: 5px 0; font-size: 14px; color: #555; }
                                h2 { margin-top: 40px; font-size: 20px; border-bottom: 2px solid #ddd; padding-bottom: 5px; }
                                table {
                                    width: 100%;
                                    border-collapse: collapse;
                                    margin-top: 15px;
                                    background: #fff;
                                    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
                                }

                                th, td {
                                    padding: 12px 15px;
                                    border: 1px solid #ddd;
                                    text-align: center;
                                    vertical-align: middle;
                                }
                                th { background: #2c3e50; color: white; }
                                table.build-params td, table.build-params th {
                                    text-align: left !important;
                                }
                                tr:nth-child(even) { background-color: #f4f4f4; }
                                .pass { color: green; font-weight: bold; }
                                .fail { color: red; font-weight: bold; }
                            </style>
                        </head>
                        <body>
                            <div class="header">
                                <img src="${companyLogoUrl}" />
                                <div class="header-info">
                                    <h1>Automated Sanity Report</h1>
                                    <p><strong>Pipeline:</strong> ${pipelineName}</p>
                                    <p><strong>Date:</strong> ${currentDateTime}</p>
                                </div>
                            </div>

                            <h2>Build Parameters</h2>
                            <table class="build-params">
                                ${buildParams.collect { "<tr><td><b>${it.key}</b></td><td>${it.value}</td></tr>" }.join('\n')}
                            </table>
                    """

                    def jsonReport = readJSON file: 'iteration_results.json'
                    def testTypes = params.TEST_TYPES.split(',').collect { it.trim().replaceAll('&amp;', '&') }

                    testTypes.each { testName ->
                        def safeName = testName.replaceAll(' ', '_').toLowerCase()
                        def results = jsonReport.iterations.findAll { it.test == safeName }

                        if(results) {
                            htmlContent += """
                            <h2>${testName} Results</h2>
                            <table>
                                <tr>
                                    <th>Iteration</th>
                                    <th>Status</th>
                                    <th>Logs</th>
                                </tr>
                            """

                            results.each { res ->
                                def statusClass = (res.status == 'PASS') ? 'pass' : 'fail'
                                def logId = "log_${safeName}_${res.iteration}"
                                def logText = ""
                                try {
                                    logText = readFile(file: res.logFile)
                                    logText = logText.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;")
                                } catch(e) { logText = "Log not found" }

                                htmlContent += """
                                <tr>
                                    <td>${res.iteration}</td>
                                    <td><span class="${statusClass}">${res.status}</span></td>
                                    <td><button onclick="showLog('${logId}')">View Log</button></td>
                                </tr>
                                """
                                htmlContent += "<div id='${logId}' style='display:none'>${logText}</div>"
                            }
                            htmlContent += "</table>"
                        }
                    }

                    htmlContent += """
                        <div id="logModal" style="display:none; position:fixed; z-index:1000; left:0; top:0; width:100%; height:100%; background:rgba(0,0,0,0.9);">
                            <div style="background:#fff; margin:5% auto; padding:20px; width:90%; max-width:1000px; border-radius:12px;">
                                <span style="color:#aaa; float:right; font-size:28px; cursor:pointer;" onclick="document.getElementById('logModal').style.display='none'">×</span>
                                <pre style="background:#000; color:#0f0; padding:20px; max-height:70vh; overflow:auto; white-space:pre-wrap;">Loading...</pre>
                            </div>
                        </div>

                        <script>
                            function showLog(id) {
                                document.getElementById('logModal').style.display = 'block';
                                document.querySelector('#logModal pre').textContent = document.getElementById(id).innerHTML;
                            }
                        </script>
                    </body></html>
                    """

                    writeFile file: env.REPORT_FILE, text: htmlContent
                    echo "HTML report generated: ${env.REPORT_FILE}"
                }
            }
        }
    }

    post {
        always {
            script {
                if (fileExists(env.REPORT_FILE)) {
                    publishHTML(target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: '.',
                        reportFiles: env.REPORT_FILE,
                        reportName: "Sanity Report - Build ${env.BUILD_NUMBER}"
                    ])
                    archiveArtifacts("*.html,*.log,*.json")
                }

                def buildCauses = currentBuild.getBuildCauses()
                def userCause = buildCauses.find { it._class == 'hudson.model.Cause$UserIdCause' }
                def buildUserId = userCause?.userId ?: "unknown"

                def userEmails = [
                    "puneet": "puneet.sharma@senao.com",
                    "harman": "harmanjot.singh@senao.com",
                    "mahesh": "mahesh.battala@senao.com",
                    "sandeep": "sandeep.manchikanti@senao.com",
                    "sampath": "sampath.marella@senao.com",
                    "jayanth": "jayanth.munnaluru@senao.com",
                    "srilatha": "srilatha.tadiboina@senao.com",
                    "phani": "phani.darla@senao.com",
                    "dinesh": "dinesh.redddy@senao.com"
                ]
                def userEmail = userEmails[buildUserId] ?: "harmanjot.singh@senao.com"

                emailext(
                    subject: "Sanity Result: ${currentBuild.currentResult} - Build #${env.BUILD_NUMBER}",
                    body: """<h2>Sanity Test Completed</h2>
                             <p><strong>Status:</strong> ${currentBuild.currentResult}</p>
                             <p><a href="${env.BUILD_URL}Sanity_20Report/">Click here to view report</a></p>""",
                    to: userEmail,
                    mimeType: 'text/html',
                    attachmentsPattern: fileExists(env.REPORT_FILE) ? env.REPORT_FILE : ""
                )
            }
        }
    }
}