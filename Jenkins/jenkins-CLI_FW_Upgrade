pipeline {
    agent any

    stages {
        stage('Download Firmware') {
            steps {
                script {
                    sh 'rm -f fw.tgz fw.img.enc'
                    def url = params['Build URL']
                    def path = url.substring(url.indexOf('/bonsai/') + 8)
                    def base = "https://jenkins.senao.com/bonsai/${path}"
                    base += base.endsWith('/') ? '' : '/'
                    sh "wget -q --no-check-certificate --recursive --level=1 --no-directories -A '*-apps.tgz,*-apps.img.enc,*single*.img.enc' '${base}'"
                    sh 'mv -f *-apps.tgz fw.tgz || true'
                    sh 'img=$(ls *-apps.img.enc *single*.img.enc 2>/dev/null | head -n1); [ -n "$img" ] && mv "$img" fw.img.enc || true'
                    env.FW = fileExists('fw.tgz') ? 'fw.tgz' : 'fw.img.enc'
                }
            }
        }

        stage('Deploy Script') {
            steps {
                sh '''
                    # Try both possible cases
                    cp testCases/test_CLI_FW_Upgrade.py ./ 2>/dev/null || \
                    cp testCases/test_CLI_FW_upgrade.py ./ 2>/dev/null || \
                    cp testCases/test_cli_fw_upgrade.py ./ 2>/dev/null || \
                    (echo "SCRIPT NOT FOUND!" && exit 1)

                    # Always name it correctly for the runner
                    mv test_CLI_FW_* test_CLI_FW_Upgrade.py 2>/dev/null || true
                    chmod +x test_CLI_FW_Upgrade.py
                    echo "SCRIPT DEPLOYED SUCCESSFULLY!"
                    ls -la test_CLI_FW_Upgrade.py
                '''
            }
        }

        stage('Run') {
            steps {
                script {
                    def ip = params['Local IP Address']
                    def n = (params.FIRMWARE_UPGRADE_COUNT ?: 1).toInteger()
                    def k = params['Keep Setting'] ? "" : "-n"
                    sh 'echo \'{"iterations":[]}\' > iteration_results.json'
                    (1..n).each { i ->
                        timeout(22) {
                            sh "python3 test_CLI_FW_Upgrade.py '${ip}' '${env.FW}' '${i}' '${k}'"
                        }
                    }
                }
            }
        }

        stage('Report') {
            steps {
                script {
                    def data = readJSON file: 'iteration_results.json', returnPojo: true
                    def pass = data.iterations.count { it.status == 'PASS' }
                    def total = data.iterations.size()
                    def rate = total > 0 ? String.format("%.1f", pass * 100.0 / total) : "0.0"
                    writeFile file: 'report.html', text: "<h1 style='color:green;text-align:center;padding:200px;font-size:100px;background:black;'>${rate}% SUCCESS</h1>"
                    publishHTML([reportName: 'CLI Report', reportDir: '.', reportFiles: 'report.html', keepAll: true])
                }
            }
        }
    }
}