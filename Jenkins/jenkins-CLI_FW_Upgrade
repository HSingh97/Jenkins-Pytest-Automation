pipeline {
    agent { node { label "${TARGET_STAND}" } }

    environment {
        SUCCESS_RATE = "0.0"  // Will be updated later
    }

    stages {
        stage('Prepare') {
            steps {
                script {
                    echo "TARGET STAND : ${TARGET_STAND}"
                    echo "Local IP     : ${params['Local IP Address']}"
                    echo "Remote IP    : ${params['Remote IP Address'] ?: 'N/A'}"
                    echo "Model        : ${params.Model}"
                    echo "Cycles       : ${params.FIRMWARE_UPGRADE_COUNT}"
                    echo "Keep Setting : ${params['Keep Setting'] ? 'YES' : 'NO'}"
                }
            }
        }

        stage('Deploy Script') {
            steps {
                script {
                    def py = findFiles(glob: "**/test_CLI_FW_Upgarde.py")[0]
                    if (!py) error "test_CLI_FW_Upgarde.py not found!"
                    sh """
                        cp -f "${py.path}" ./
                        chmod +x test_CLI_FW_Upgarde.py
                        sed -i '1i#!/usr/bin/env python3' test_CLI_FW_Upgarde.py
                    """
                }
            }
        }

        stage('Setup Passwordless SSH (Correct User)') {
            steps {
                sh '''
                    # Use the real user home (~/.ssh), NOT /root/.ssh
                    mkdir -p ~/.ssh && chmod 700 ~/.ssh

                    # Remove old host keys
                    ssh-keygen -R "${params['Local IP Address']}" || true
                    [ -n "${params['Remote IP Address']}" ] && ssh-keygen -R "${params['Remote IP Address']}" || true

                    # Generate key if missing
                    [ -f ~/.ssh/id_rsa ] || ssh-keygen -t rsa -b 4096 -f ~/.ssh/id_rsa -q -N ""

                    # Deploy key (you'll be asked password ONLY ONCE)
                    ssh-copy-id -f -o StrictHostKeyChecking=no root@${params['Local IP Address']} || true
                    [ -n "${params['Remote IP Address']}" ] && ssh-copy-id -f -o StrictHostKeyChecking=no root@${params['Remote IP Address']} || true
                '''
                echo "SSH key deployed from correct user (~senao)"
            }
        }

        stage('Firmware Upgrade Cycles') {
            steps {
                script {
                    def ip       = params['Local IP Address']
                    def fwPath   = params.CUSTOM_FIRMWARE?.trim() ?: "/var/lib/jenkins/firmware/${params.Model}-latest.bin"
                    def cycles   = params.FIRMWARE_UPGRADE_COUNT.toInteger()
                    def keep     = params['Keep Setting'] ? "" : "-n"

                    sh 'echo \'{"iterations": []}\' > iteration_results.json'

                    for (int i = 1; i <= cycles; i++) {
                        echo "=== UPGRADE CYCLE ${i}/${cycles} ==="
                        try {
                            timeout(time: 20, unit: 'MINUTES') {
                                sh "python3 test_CLI_FW_Upgarde.py '${ip}' '${fwPath}' '${i}' '${keep}'"
                            }
                        } catch (e) {
                            echo "Cycle ${i} FAILED"
                            currentBuild.result = 'UNSTABLE'
                        }
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    // Clean known hosts again
                    sh "ssh-keygen -R ${params['Local IP Address']} || true"
                    params['Remote IP Address'] && sh "ssh-keygen -R ${params['Remote IP Address']} || true"

                    def finalFW = "Unknown"
                    try {
                        finalFW = sh(
                            script: "ssh -o StrictHostKeyChecking=no root@${params['Local IP Address']} 'cat /etc/version || ubus call system board'",
                            returnStdout: true
                        ).trim()
                    } catch (e) {}

                    def json = readJSON file: 'iteration_results.json'
                    def total = json.iterations?.size() ?: 0
                    def pass  = json.iterations?.count { it.status == 'PASS' } ?: 0
                    env.SUCCESS_RATE = total > 0 ? String.format("%.1f", pass * 100.0 / total) : "0.0"

                    def date = new Date().format("dd MMM yyyy, HH:mm:ss", java.util.TimeZone.getTimeZone("Asia/Kolkata"))

                    def html = """
                    <!DOCTYPE html><html><head><meta charset="utf-8"><title>CLI FW Upgrade - ${params.Model}</title>
                    <style>/* ← Paste your full beautiful CSS from reboot report here */</style>
                    </head><body>
                    <div class="container">
                        <div class="header">
                            <img src="https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png">
                            <div class="header-info"><h1>CLI Firmware Upgrade</h1><p>${env.JOB_NAME} • ${date}</p></div>
                        </div>
                        <h2>Parameters</h2><table><tr><th>Parameter</th><th>Value</th></tr>
                        <tr><td>Stand</td><td>${TARGET_STAND}</td></tr>
                        <tr><td>Local IP</td><td>${params['Local IP Address']}</td></tr>
                        <tr><td>Remote IP</td><td>${params['Remote IP Address'] ?: 'N/A'}</td></tr>
                        <tr><td>Model</td><td>${params.Model}</td></tr>
                        <tr><td>Cycles</td><td>${total}</td></tr>
                        <tr><td>Keep Settings</td><td>${params['Keep Setting'] ? 'YES' : 'NO'}</td></tr>
                        <tr><td>Final FW</td><td>${finalFW}</td></tr>
                        </table>

                        <h2>Summary</h2>
                        <div class="summary-container">
                            <div class="summary-card card-total"><div class="card-icon">Box</div><div class="card-info"><p>Total</p><p class="card-info-value">${total}</p></div></div>
                            <div class="summary-card card-pass"><div class="card-icon">Check</div><div class="card-info"><p>Pass</p><p class="card-info-value">${pass}</p></div></div>
                            <div class="summary-card card-fail"><div class="card-icon">Cross</div><div class="card-info"><p>Fail</p><p class="card-info-value">${total-pass}</p></div></div>
                            <div class="summary-card card-percent"><div class="card-icon">Target</div><div class="card-info"><p>Rate</p><p class="card-info-value">${env.SUCCESS_RATE}%</p></div></div>
                        </div>

                        <h2>Results</h2><table>
                        <tr><th>#</th><th>Status</th><th>Logs</th></tr>
                    """

                    json.iterations?.each { r ->
                        def status = r.status == "PASS" ? "<span class='status-pass'>PASS</span>" : "<span class='status-fail'>FAIL</span>"
                        def logId = "log-${r.iteration}"
                        def log = fileExists("test-${r.iteration}.log") ? readFile("test-${r.iteration}.log").replace("&","&amp;").replace("<","&lt;").replace(">","&gt;") : "No log"
                        html += "<tr><td>${r.iteration}</td><td>${status}</td><td><button class='log-button' onclick=\"showLog('${logId}')\">View</button></td></tr>"
                        html += "<div id='${logId}' style='display:none;'>${log}</div>"
                    }

                    html += """
                        </table>
                        <div id="logModal" class="modal">...</div>
                        <script>function showLog(id){...}</script>
                        </div></body></html>
                    """
                    writeFile file: 'report.html', text: html
                }
            }
        }
    }

    post {
        always {
            publishHTML([
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: '.',
                reportFiles: 'report.html',
                reportName: 'CLI Firmware Upgrade Report'
            ])
            sh 'rm -f test-*.log || true'

            emailext(
                to: 'puneet.sharma@senao.com',
                subject: "FW Upgrade #${BUILD_NUMBER} → ${currentBuild.currentResult} (${env.SUCCESS_RATE}%)",
                body: "View report: ${env.BUILD_URL}CLI_Firmware_Upgrade_Report/",
                mimeType: 'text/html'
            )
        }
    }
}