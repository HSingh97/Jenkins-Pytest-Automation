import jenkins.model.Jenkins

pipeline {
    agent { node { label "${TARGET_STAND}" } }

    stages {
        stage('Prepare tests') {
            steps {
                script {
                    echo "----------------------------------------"
                    echo "--- TARGET STAND: ${TARGET_STAND}"
                    echo "----------------------------------------"
                    if (!params['Local IP Address']) {
                        error "Missing required parameters: Local IP Address"
                    }
                }
            }
        }

        stage mbedtls('Install Dependencies') {
            steps {
                script {
                    echo "----------------------------------------"
                    echo "Installing Dependencies (if any)"
                    echo "----------------------------------------"
                }
            }
        }

        stage('Firmware Upgrade Test') {
            steps {
                script {
                    def localIP   = params['Local IP Address']
                    def remoteIP  = params['Remote IP Address'] ?: ""
                    def fwPath    = params.CUSTOM_FIRMWARE ? "/tmp/custom_firmware.bin" : "/var/lib/jenkins/firmware/UBR655-latest.bin"
                    def count     = params.FIRMWARE_UPGRADE_COUNT.toInteger()
                    def keepFlag  = params['Keep Setting'] ? "" : "-n"

                    echo "Local IP Address : ${localIP}"
                    echo "Remote IP Address: ${remoteIP}"
                    echo "Upgrade Count    : ${count}"
                    echo "Keep Settings    : ${params['Keep Setting'] ? 'YES' : 'NO'}"
                    echo "Model            : ${params.Model}"
                    echo "Firmware Source  : ${params.CUSTOM_FIRMWARE ? 'Uploaded File' : 'Default Path'}"

                    sh "echo '{\"iterations\": []}' > iteration_results.json"

                    if (params.CUSTOM_FIRMWARE) {
                        sh "cp '${params.CUSTOM_FIRMWARE}' /tmp/custom_firmware.bin"
                    }

                    for (int i = 1; i <= count; i++) {
                        echo "Running firmware upgrade iteration ${i}"
                        try {
                            sh """
                                test_CLI_FW_Upgarde.py '${localIP}' '${fwPath}' '${i}' '${keepFlag}'
                            """
                        } catch (Exception e) {
                            echo "Upgrade iteration ${i} failed: ${e.message}"
                        }

                        if (remoteIP) {
                            sh "ping -c 3 ${remoteIP} || true"
                        }
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def localIP = params['Local IP Address']
                    def remoteIP = params['Remote IP Address'] ?: "N/A"

                    sh "ssh-keygen -R ${localIP} || true"
                    if (remoteIP != "N/A") sh "ssh-keygen -R ${remoteIP} || true"

                    // FIXED LINE — This was causing the build to fail
                    def local_fw_version = "N/A"
                    try {
                        def output = sh(script: "ssh -o StrictHostKeyChecking=no root@${localIP} 'cat /etc/version 2>/dev/null || ubus call system board'", returnStdout: true).trim()
                        if (output.contains('"description"')) {
                            // Extract from JSON: "description": "OpenWrt 23.05.2 ..."
                            def matcher = (output =~ /"description"\s*:\s*"([^"]+)"/)
                            local_fw_version = matcher ? matcher[0][1] : output
                        } else if (output) {
                            local_fw_version = output
                        }
                    } catch (e) {
                        echo "Warning: Could not fetch firmware version"
                    }

                    def jsonReport = readJSON file: 'iteration_results.json'

                    def totalTests = jsonReport.iterations.size()
                    def passCount = jsonReport.iterations.count { it.status == 'PASS' }
                    def failCount = totalTests - passCount
                    def successPercentage = totalTests > 0 ? String.format("%.1f", (passCount * 100.0 / totalTests)) : "0.0"

                    def buildParams = [
                        "Target Stand"       : TARGET_STAND,
                        "Local IP Address"   : localIP,
                        "Remote IP Address"  : remoteIP,
                        "Model"              : params.Model,
                        "Keep Settings"      : params['Keep Setting'] ? "YES" : "NO",
                        "Upgrade Cycles"     : totalTests,
                        "FW Version"         : local_fw_version
                    ]

                    def istDate = Calendar.getInstance(TimeZone.getTimeZone("Asia/Kolkata")).getTime()
                    def currentDateTime = istDate.format("dd MMM yyyy, HH:mm:ss z")

                    def companyLogoUrl = "https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png"

                    def htmlContent = """
                    <html>
                    <head>
                        <title>Firmware Upgrade Test Report</title>
                        <style>
                            body {font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin:0; background:#f9fafb; color:#1f2937;}
                            .container {max-width:1200px; margin:30px auto; padding:30px; background:white; border-radius:12px; box-shadow:0 4px 20px rgba(0,0,0,0.1);}
                            .header {background:linear-gradient(135deg,#667eea,#764ba2); color:white; padding:40px; border-radius:12px; text-align:center;}
                            .header img {height:65px;}
                            h1 {margin:10px 0; font-size:32px;}
                            table {width:100%; border-collapse:collapse; margin:25px 0; background:white; border-radius:8px; overflow:hidden;}
                            th, td {padding:14px; text-align:left; border-bottom:1px solid #e5e7eb;}
                            th {background:#f3f4f6; font-weight:600; color:#4b5563;}
                            .status-pass {background:#d1fae5; color:#065f46; padding:6px 14px; border-radius:30px; font-weight:bold;}
                            .status-fail {background:#fee2e2; color:#991b1b; padding:6px 14px; border-radius:30px; font-weight:bold;}
                            .summary {display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:20px; margin:30px 0;}
                            .card {background:white; padding:25px; border-radius:10px; box-shadow:0 4px 15px rgba(0,0,0,0.08); text-align:center;}
                            .card .big {font-size:42px; font-weight:bold;}
                        </style>
                    </head>
                    <body>
                        <div class="container">
                            <div class="header">
                                <img src="${companyLogoUrl}" alt="Senao"/>
                                <h1>Senao ${params.Model} - Firmware Upgrade Test</h1>
                                <p>${currentDateTime}</p>
                            </div>

                            <h2>Build Parameters</h2>
                            <table>
                                ${buildParams.collect { "<tr><td><b>${it.key}</b></td><td>${it.value}</td></tr>" }.join()}
                            </table>

                            <h2>Test Summary</h2>
                            <div class="summary">
                                <div class="card"><h3>Total</h3><div class="big">${totalTests}</div></div>
                                <div class="card"><h3>Pass</h3><div class="big" style="color:#16a34a;">${passCount}</div></div>
                                <div class="card"><h3>Fail</h3><div class="big" style="color:#dc2626;">${failCount}</div></div>
                                <div class="card"><h3>Success Rate</h3><div class="big" style="color:#16a34a;">${successPercentage}%</div></div>
                            </div>

                            <h2>Test Results</h2>
                            <table>
                                <tr><th>Iteration</th><th>Status</th><th>Keep Settings</th><th>Logs</th></tr>
                                ${jsonReport.iterations.collect { r ->
                                    def cls = r.status == "PASS" ? "status-pass" : "status-fail"
                                    "<tr><td>${r.iteration}</td><td><span class='${cls}'>${r.status}</span></td><td>${r.'Keep Settings'}</td><td>${r.'Device Logs'}</td></tr>"
                                }.join()}
                            </table>
                        </div>
                    </body>
                    </html>
                    """

                    writeFile file: 'report.html', text: htmlContent
                }
            }
        }
    }

    post {
        always {
            publishHTML(target: [
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: '.',
                reportFiles: 'report.html',
                reportName: 'Firmware Upgrade Test Report'
            ])

            archiveArtifacts artifacts: 'iteration_results.json,report.html', allowEmptyArchive: true
            sh 'rm -f test-*.log iteration_results.json || true'

            script {
                def cause = currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause')?.get(0)
                def userId = cause ? cause.userId : "unknown"
                def userEmails = [
                    "puneet":"puneet.sharma@senao.com",
                    "harman":"harmanjot.singh@senao.com",
                    "mahesh":"mahesh.battala@senao.com",
                    "sandeep":"sandeep.manchikanti@senao.com",
                    "sampath":"sampath.marella@senao.com",
                    "jayanth":"jayanth.munnaluru@senao.com",
                    "srilatha":"srilatha.tadiboina@senao.com",
                    "phani":"phani.darla@senao.com",
                    "dinesh":"dinesh.redddy@senao.com"
                ]
                def toEmail = userEmails.getOrDefault(userId, "puneet.sharma@senao.com")

                emailext(
                    subject: "FW Upgrade Test #${BUILD_NUMBER} - ${currentBuild.currentResult}",
                    body: """
                        <h2>Firmware Upgrade Test Completed</h2>
                        <p><strong>Model:</strong> ${params.Model}</p>
                        <p><strong>Keep Settings:</strong> ${params['Keep Setting'] ? 'YES' : 'NO'}</p>
                        <p><strong>Success Rate:</strong> ${successPercentage}%</p>
                        <p><a href="${env.BUILD_URL}Firmware_Upgrade_Test_Report/">View Full Report</a></p>
                    """,
                    to: toEmail,
                    mimeType: 'text/html',
                    attachmentsPattern: 'report.html'
                )
            }
        }
        success { echo "ALL FIRMWARE UPGRADES PASSED!" }
        unstable { echo "SOME UPGRADE CYCLES FAILED" }
        failure { echo "PIPELINE ERROR" }
    }
}