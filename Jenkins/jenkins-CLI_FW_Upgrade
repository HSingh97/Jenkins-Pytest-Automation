pipeline {
    agent { node { label "${TARGET_STAND}" } }

    environment {
        SUCCESS_RATE = "0.0"
        SSH_DIR      = "/home/senao/.ssh"
        PUBKEY       = ""
    }

    stages {
        stage('Prepare') {
            steps {
                echo """
╔══════════════════════════════════════════════════╗
   CLI FIRMWARE UPGRADE CYCLE TESTING
   Stand     : ${TARGET_STAND}
   Local IP  : ${params['Local IP Address']}
   Remote IP : ${params['Remote IP Address'] ?: 'N/A'}
   Model     : ${params.Model}
   Cycles    : ${params.FIRMWARE_UPGRADE_COUNT}
   Keep      : ${params['Keep Setting'] ? 'YES' : 'NO'}
╚══════════════════════════════════════════════════╝
                """
            }
        }

        stage('Deploy Test Script') {
            steps {
                script {
                    def py = findFiles(glob: "**/test_CLI_FW_Upgarde.py")[0]
                    sh """
                        cp -f "${py.path}" ./
                        chmod +x test_CLI_FW_Upgarde.py
                        sed -i '1i#!/usr/bin/env python3' test_CLI_FW_Upgarde.py
                    """
                    echo "Test script deployed"
                }
            }
        }

        stage('Setup Passwordless SSH — 100% WORKING METHOD') {
            steps {
                script {
                    def localIP  = params['Local IP Address']
                    def remoteIP = params['Remote IP Address']?.trim()

                    sh """
                        mkdir -p ${env.SSH_DIR} && chmod 700 ${env.SSH_DIR}

                        # Generate key if not exists
                        [ -f ${env.SSH_DIR}/id_rsa ] || ssh-keygen -t rsa -b 4096 -f ${env.SSH_DIR}/id_rsa -q -N ""

                        # Read public key into variable
                        cat ${env.SSH_DIR}/id_rsa.pub > pubkey.tmp
                    """

                    // Read the public key into Groovy variable
                    env.PUBKEY = readFile('pubkey.tmp').trim()
                    sh 'rm -f pubkey.tmp'

                    // THIS IS THE ONLY METHOD THAT WORKS WHEN PASSWORD AUTH IS DISABLED
                    sh """
                        echo "Deploying public key to root@${localIP}..."
                        ssh -o StrictHostKeyChecking=no root@${localIP} \
                            "mkdir -p /etc/dropbear && echo '${env.PUBKEY}' >> /etc/dropbear/authorized_keys && chmod 600 /etc/dropbear/authorized_keys"

                        [ -n "${remoteIP}" ] && ssh -o StrictHostKeyChecking=no root@${remoteIP} \
                            "mkdir -p /etc/dropbear && echo '${env.PUBKEY}' >> /etc/dropbear/authorized_keys && chmod 600 /etc/dropbear/authorized_keys" || true
                    """

                    // Verify
                    sh """
                        echo "Testing passwordless access..."
                        if ssh -o BatchMode=yes -o ConnectTimeout=10 root@${localIP} "cat /etc/version | head -1" >/dev/null 2>&1; then
                            echo "SUCCESS: Passwordless SSH to ${localIP} ESTABLISHED!"
                        else
                            error "Failed to establish passwordless SSH"
                        fi
                    """
                }
            }
        }

        stage('Firmware Upgrade Cycles') {
            steps {
                script {
                    def ip     = params['Local IP Address']
                    def fwPath = params.CUSTOM_FIRMWARE?.trim() ?: "/var/lib/jenkins/firmware/${params.Model}-latest.bin"
                    def cycles = params.FIRMWARE_UPGRADE_COUNT.toInteger()
                    def keep   = params['Keep Setting'] ? "" : "-n"

                    sh 'echo \'{"iterations": []}\' > iteration_results.json'

                    for (int i = 1; i <= cycles; i++) {
                        echo "FIRMWARE UPGRADE CYCLE ${i}/${cycles}"
                        try {
                            timeout(time: 20, unit: 'MINUTES') {
                                sh "python3 test_CLI_FW_Upgarde.py '${ip}' '${fwPath}' '${i}' '${keep}'"
                            }
                        } catch (err) {
                            echo "Cycle ${i} FAILED"
                            currentBuild.result = 'UNSTABLE'
                        }
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def json = readJSON file: 'iteration_results.json'
                    def total = json.iterations?.size() ?: 0
                    def pass  = json.iterations?.count { it.status == 'PASS' } ?: 0
                    env.SUCCESS_RATE = total > 0 ? String.format("%.1f", pass * 100.0 / total) : "0.0"

                    def date = new Date().format("dd MMM yyyy, HH:mm:ss 'IST'", TimeZone.getTimeZone('Asia/Kolkata'))
                    def finalFW = sh(script: "ssh root@${params['Local IP Address']} 'cat /etc/version 2>/dev/null || echo Unknown'", returnStdout: true, returnStatus: false).trim()

                    writeFile file: 'report.html', text: """
                    <!DOCTYPE html>
                    <html><head><meta charset="utf-8"><title>CLI FW Upgrade - ${params.Model}</title>
                    <style>
                        body{font-family:system-ui;background:#0f172a;color:#e2e8f0;margin:0}
                        .c{max-width:1200px;margin:40px auto;padding:40px;background:#1e293b;border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,0.6)}
                        .h{background:linear-gradient(135deg,#8b5cf6,#ec4899);padding:60px;border-radius:20px;text-align:center;color:white}
                        h1{font-size:48px;margin:15px 0}
                        table{width:100%;border-collapse:collapse;margin:30px 0;background:#334155;border-radius:15px;overflow:hidden}
                        th{background:#475569;color:white;padding:18px}
                        td{padding:16px;background:#1e293b}
                        .p{background:#22c55e;color:white}.f{background:#ef4444;color:white}
                        .p,.f{padding:10px 20px;border-radius:50px;font-weight:bold}
                        .s{display:grid;grid-template-columns:repeat(4,1fr);gap:30px;margin:50px 0}
                        .card{background:#334155;padding:35px;border-radius:18px;text-align:center}
                        .big{font-size:64px;font-weight:900}
                    </style></head>
                    <body><div class="c">
                        <div class="h">
                            <h1>CLI Firmware Upgrade<br><small style="font-size:28px">${params.Model}</small></h1>
                            <p style="font-size:20px">${date}</p>
                        </div>
                        <table>
                            <tr><th>Parameter</th><th>Value</th></tr>
                            <tr><td>Stand</td><td>${TARGET_STAND}</td></tr>
                            <tr><td>Local IP</td><td>${params['Local IP Address']}</td></tr>
                            <tr><td>Cycles</td><td>${total}</td></tr>
                            <tr><td>Keep Settings</td><td>${params['Keep Setting'] ? 'YES' : 'NO'}</td></tr>
                            <tr><td>Final Version</td><td>${finalFW}</td></tr>
                        </table>
                        <div class="s">
                            <div class="card"><h3>Total</h3><div class="big">${total}</div></div>
                            <div class="card"><h3>PASS</h3><div class="big" style="color:#22c55e">${pass}</div></div>
                            <div class="card"><h3>FAIL</h3><div class="big" style="color:#ef4444">${total-pass}</div></div>
                            <div class="card"><h3>SUCCESS RATE</h3><div class="big" style="color:#22c55e">${env.SUCCESS_RATE}%</div></div>
                        </div>
                    </div></body></html>
                    """
                }
            }
        }
    }

    post {
        always {
            publishHTML([
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: '.',
                reportFiles: 'report.html',
                reportName: 'CLI Firmware Upgrade Report'
            ])
            sh 'rm -f test-*.log pubkey.tmp || true'
            emailext(
                to: 'puneet.sharma@senao.com',
                subject: "FW Upgrade #${BUILD_NUMBER} → ${currentBuild.currentResult} (${env.SUCCESS_RATE}%)",
                body: "<h2>CLI Firmware Upgrade Completed</h2><p><strong>Success Rate: ${env.SUCCESS_RATE}%</strong></p><p><a href='${env.BUILD_URL}CLI_Firmware_Upgrade_Report/'>View Full Report</a></p>",
                mimeType: 'text/html'
            )
        }
    }
}