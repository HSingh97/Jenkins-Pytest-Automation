pipeline {
    agent { node { label "${TARGET_STAND}" } }

    environment {
        SUCCESS_RATE = "0.0"
        LOCAL_IP     = "${params['Local IP Address']}"
        REMOTE_IP    = "${params['Remote IP Address'] ?: 'N/A'}"
        SCRIPT_NAME  = "test_CLI_FW_Upgarde.py"
    }

    stages {
        stage('Deploy Test Script') {
            steps {
                script {
                    def scriptFile = findFiles(glob: "**/${env.SCRIPT_NAME}")[0]
                    if (!scriptFile) { error "FATAL: ${env.SCRIPT_NAME} not found in repo!" }

                    sh """
                        cp -f "${scriptFile.path}" "./${env.SCRIPT_NAME}"
                        chmod +x "./${env.SCRIPT_NAME}"
                        sed -i '1i#!/usr/bin/env python3' "./${env.SCRIPT_NAME}"
                    """
                    echo "Deployed ${env.SCRIPT_NAME} → ready"
                }
            }
        }

        stage('Setup Passwordless SSH (Silent)') {
            steps {
                sh '''
                    mkdir -p ~/.ssh && chmod 700 ~/.ssh
                    [ -f ~/.ssh/id_rsa ] || ssh-keygen -t rsa -b 4096 -f ~/.ssh/id_rsa -q -N ""

                    # Try to copy key silently — ignore all errors
                    ssh-copy-id -f -o StrictHostKeyChecking=no root@${LOCAL_IP} > /dev/null 2>&1 || true

                    # Always clean known hosts
                    ssh-keygen -R ${LOCAL_IP} > /dev/null 2>&1 || true
                '''
                echo "SSH setup completed (passwordless from now on)"
            }
        }

        stage('Firmware Upgrade Cycles') {
            steps {
                script {
                    def fwPath   = params.CUSTOM_FIRMWARE ? "/tmp/custom_firmware.bin" : "/var/lib/jenkins/firmware/UBR655-latest.bin"
                    def count    = params.FIRMWARE_UPGRADE_COUNT.toInteger()
                    def keepFlag = params['Keep Setting'] ? "" : "-n"

                    sh "echo '{\"iterations\": []}' > iteration_results.json"

                    if (params.CUSTOM_FIRMWARE) {
                        sh "cp '${params.CUSTOM_FIRMWARE}' /tmp/custom_firmware.bin"
                    }

                    for (int i = 1; i <= count; i++) {
                        echo "=== STARTING CYCLE ${i}/${count} ==="
                        try {
                            timeout(time: 20, unit: 'MINUTES') {
                                sh "python3 ./${env.SCRIPT_NAME} '${env.LOCAL_IP}' '${fwPath}' '${i}' '${keepFlag}'"
                            }
                        } catch (err) {
                            echo "CYCLE ${i} FAILED → ${err}"
                            currentBuild.result = 'UNSTABLE'
                        }
                        if (env.REMOTE_IP != 'N/A') {
                            sh "ping -c 3 ${env.REMOTE_IP} || true"
                        }
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def fw_version = "Not reachable"
                    try {
                        def out = sh(
                            script: "ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 root@${env.LOCAL_IP} 'cat /etc/version 2>/dev/null || ubus call system board || echo Unknown'",
                            returnStdout: true
                        ).trim()
                        fw_version = out.contains('"description"') ?
                            (out =~ /"description"\\s*:\\s*"([^"]+)"/)[0][1] : out
                    } catch (e) {}

                    def json = [iterations: []]
                    try { json = readJSON file: 'iteration_results.json' } catch (e) {}

                    def total = json.iterations.size()
                    def pass  = json.iterations.count { it.status == 'PASS' }
                    env.SUCCESS_RATE = total > 0 ? String.format("%.1f", pass * 100.0 / total) : "0.0"

                    writeFile file: 'report.html', text: """
                    <html>
                    <head><title>FW Upgrade - ${params.Model}</title>
                    <style>
                        body{font-family:system-ui;background:#0f172a;color:#e2e8f0;margin:0}
                        .c{max-width:1200px;margin:40px auto;padding:30px;background:#1e293b;border-radius:16px;box-shadow:0 20px 50px rgba(0,0,0,.5)}
                        .h{background:linear-gradient(135deg,#7c3aed,#ec4899);color:white;padding:50px;border-radius:16px;text-align:center}
                        .h img{height:80px;margin-bottom:20px}
                        h1{font-size:38px;margin:15px 0}
                        table{width:100%;border-collapse:collapse;margin:30px 0;background:#334155;border-radius:12px;overflow:hidden}
                        th{background:#475569;color:white;padding:16px;font-weight:600}
                        td{padding:14px;background:#1e293b;border-bottom:1px solid #475569}
                        .p{background:#22c55e;color:white}.f{background:#ef4444;color:white}
                        .p,.f{padding:8px 16px;border-radius:50px;font-weight:bold;display:inline-block}
                        .s{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:25px;margin:40px 0}
                        .card{background:#334155;padding:30px;border-radius:16px;text-align:center;box-shadow:0 8px 25px rgba(0,0,0,.3)}
                        .big{font-size:52px;font-weight:900;margin:10px 0}
                    </style>
                    </head>
                    <body>
                        <div class="c">
                            <div class="h">
                                <img src="https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png">
                                <h1>Senao ${params.Model}<br>Firmware Upgrade Stress Test</h1>
                                <p>${new Date().format("dd MMM yyyy, HH:mm:ss z", TimeZone.getTimeZone("Asia/Kolkata"))}</p>
                            </div>
                            <h2>Parameters</h2>
                            <table>
                                <tr><th>Node</th><td>${TARGET_STAND}</td></tr>
                                <tr><th>Local IP</th><td>${env.LOCAL_IP}</td></tr>
                                <tr><th>Remote IP</th><td>${env.REMOTE_IP}</td></tr>
                                <tr><th>Model</th><td>${params.Model}</td></tr>
                                <tr><th>Cycles</th><td>${total}</td></tr>
                                <tr><th>Final FW</th><td>${fw_version}</td></tr>
                            </table>
                            <h2>Summary</h2>
                            <div class="s">
                                <div class="card"><h3>Total</h3><div class="big">${total}</div></div>
                                <div class="card"><h3>Pass</h3><div class="big" style="color:#22c55e">${pass}</div></div>
                                <div class="card"><h3>Fail</h3><div class="big" style="color:#ef4444">${total-pass}</div></div>
                                <div class="card"><h3>Success Rate</h3><div class="big" style="color:#22c55e">${env.SUCCESS_RATE}%</div></div>
                            </div>
                            <h2>Results</h2>
                            <table>
                                <tr><th>#</th><th>Status</th><th>Keep</th><th>Log</th></tr>
                                ${json.iterations.collect { r ->
                                    "<tr><td>${r.iteration}</td><td><span class='${r.status=='PASS'?'p':'f'}'>${r.status}</span></td><td>${r.'Keep Settings'}</td><td><pre>${r.'Device Logs'}</pre></td></tr>"
                                }.join('')}
                            </table>
                        </div>
                    </body>
                    </html>
                    """
                }
            }
        }
    }

    post {
        always {
            publishHTML([
                reportDir: '.',
                reportFiles: 'report.html',
                reportName: 'Firmware Upgrade Test Report',
                keepAll: true,
                alwaysLinkToLastBuild: true
            ])

            archiveArtifacts artifacts: 'iteration_results.json,report.html', allowEmptyArchive: true

            script {
                def email = "puneet.sharma@senao.com"
                try {
                    def cause = currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause')
                    if (cause && cause[0]?.userId) {
                        email = [
                            "puneet": "puneet.sharma@senao.com",
                            "harman": "harmanjot.singh@senao.com"
                        ].getOrDefault(cause[0].userId.toLowerCase(), email)
                    }
                } catch (e) {}

                emailext(
                    subject: "FW Upgrade #${BUILD_NUMBER} - ${currentBuild.currentResult} (${env.SUCCESS_RATE}%)",
                    body: "<h2>Firmware Upgrade Test Completed</h2><p>Model: ${params.Model} | Success: ${env.SUCCESS_RATE}%</p><p><a href='${env.BUILD_URL}Firmware_Upgrade_Test_Report/'>View Full Report</a></p>",
                    to: email,
                    mimeType: 'text/html',
                    attachmentsPattern: 'report.html'
                )
            }
        }
    }
}