pipeline {
    agent { label 'test-puneet' }   // ONLY YOUR NODE, NO CHANCE OF GIT ERROR

    parameters {
        string(name: 'Local IP Address', defaultValue: '192.168.1.10')
        string(name: 'Build URL', defaultValue: 'https://jenkins.senao.com/bonsai/5018/UBR655/debug/425/')
        string(name: 'FIRMWARE_UPGRADE_COUNT', defaultValue: '10')
        booleanParam(name: 'Keep Setting', defaultValue: true)
        choice(name: 'Model', choices: ['UBR655', 'Other'])
    }

    stages {
        stage('Download Firmware') {
            steps {
                script {
                    sh 'rm -f fw.tgz fw.img.enc'
                    def url = params['Build URL'].trim()
                    def base = url.startsWith('http') ? url : "https://jenkins.senao.com/bonsai/${url}"
                    if (!base.endsWith('/')) base += '/'

                    sh "wget -q --no-check-certificate --recursive --level=1 --no-directories -A '*-apps.tgz,*-apps.img.enc,*single*.img.enc' '${base}'"
                    sh 'mv -f *-apps.tgz fw.tgz || true'
                    sh 'img=\$(ls *-apps.img.enc *single*.img.enc 2>/dev/null | head -n1); [ -n "\$img" ] && mv "\$img" fw.img.enc || true'

                    env.FW_FILE = fileExists('fw.tgz') ? 'fw.tgz' : 'fw.img.enc'
                    echo "Using → ${env.FW_FILE}"
                }
            }
        }

        stage('Deploy Script') {
            steps {
                sh '''
                    # TRY EVERY POSSIBLE NAME — ONE WILL WORK
                    cp -f testCases/test_CLI_FW_Upgrade.py . 2>/dev/null || \
                    cp -f testCases/test_CLI_FW_upgrade.py . 2>/dev/null || \
                    cp -f testCases/test_cli_fw_upgrade.py . 2>/dev/null || \
                    cp -f testCases/*.py . 2>/dev/null || \
                    (echo "SCRIPT NOT FOUND IN testCases/ — CHECK FILENAME & COMMIT!" && exit 1)

                    # RENAME TO STANDARD NAME
                    mv *.py test_CLI_FW_Upgrade.py 2>/dev/null || true
                    chmod +x test_CLI_FW_Upgrade.py
                    echo "SCRIPT DEPLOYED → test_CLI_FW_Upgrade.py"
                    ls -la test_CLI_FW_Upgrade.py
                '''
            }
        }

        stage('Run Cycles') {
            steps {
                script {
                    def ip = params['Local IP Address']
                    def n = params.FIRMWARE_UPGRADE_COUNT.toInteger()
                    def keep = params['Keep Setting'] ? "" : "-n"

                    sh 'echo \'{"iterations": []}\' > iteration_results.json'

                    for (int i = 1; i <= n; i++) {
                        echo "CYCLE ${i}/${n}"
                        timeout(22) {
                            sh "python3 test_CLI_FW_Upgrade.py '${ip}' '${env.FW_FILE}' '${i}' '${keep}'"
                        }
                    }
                }
            }
        }

        stage('Report') {
            steps {
                script {
                    def json = readJSON file: 'iteration_results.json'
                    def total = json.iterations.size()
                    def pass = json.iterations.count { it.status == 'PASS' }
                    def rate = total > 0 ? String.format("%.1f", pass * 100.0 / total) : "0.0"
                    env.SUCCESS_RATE = rate

                    def ver = "Unknown"
                    try { ver = sh(script: "sshpass -p admin ssh -o StrictHostKeyChecking=no root@${params['Local IP Address']} 'cat /etc/version'", returnStdout: true).trim() }
                    catch(e) { ver = "Failed to read" }

                    def now = new Date().format('dd MMM yyyy, HH:mm:ss z', TimeZone.getTimeZone('Asia/Kolkata'))

                    writeFile file: 'report.html', text: """
                    <!DOCTYPE html>
                    <html><head><meta charset="utf-8"><title>CLI Upgrade Report</title>
                    <style>
                        body{background:#000;color:#0f0;font-family:system-ui;text-align:center;padding:100px;}
                        .box{background:#111;padding:120px;border-radius:60px;display:inline-block;box-shadow:0 0 150px #0f0;width:90%;max-width:1100px;}
                        h1{font-size:100px;margin:20px;color:#22c55e;}
                        .big{font-size:400px;font-weight:900;color:#22c55e;line-height:1;}
                        .logo{height:90px;margin-bottom:40px;}
                    </style></head>
                    <body>
                        <div class="box">
                            <img src="https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png" class="logo">
                            <h1>CLI FIRMWARE UPGRADE</h1>
                            <h1>${params.Model} • test-puneet</h1>
                            <div class="big">${rate}<span style="font-size:200px;">%</span></div>
                            <h1>${pass}/${total} PASSED</h1>
                            <h1>Final Version: ${ver}</h1>
                            <p style="font-size:50px;margin-top:60px;">${now}</p>
                        </div>
                    </body></html>
                    """

                    publishHTML([reportName: 'CLI Upgrade Report', reportDir: '.', reportFiles: 'report.html', keepAll: true])
                }
            }
        }
    }

    post {
        always {
            script {
                def rate = env.SUCCESS_RATE ?: "0.0"
                emailext(
                    to: 'puneet.sharma@senao.com',
                    subject: "CLI Upgrade #${BUILD_NUMBER} → ${rate}% SUCCESS",
                    body: "<h2>CLI Firmware Upgrade Done!</h2><p>Success Rate: <b style='font-size:50px;color:green;'>${rate}%</b></p><p><a href='${BUILD_URL}CLI_Upgrade_Report/'>View Full Report</a></p>",
                    mimeType: 'text/html',
                    attachmentsPattern: 'report.html'
                )
            }
        }
    }
}