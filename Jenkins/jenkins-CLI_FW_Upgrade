import java.util.Calendar
import java.util.TimeZone

pipeline {
    agent { node { label "${TARGET_STAND}" } }  // This runs on whatever node you select

    environment {
        // Script will be auto-deployed to workspace — no /usr/local/bin needed
        SCRIPT_NAME = "test_CLI_FW_Upgarde.py"
        SUCCESS_RATE = "0.0"
    }

    stages {
        stage('Auto-Deploy Test Script') {
            steps {
                script {
                    // Find the Python script in the repo (supports any folder depth)
                    def scriptFile = findFiles(glob: "**/${env.SCRIPT_NAME}")[0]
                    if (!scriptFile) {
                        error "ERROR: ${env.SCRIPT_NAME} not found in the repository!"
                    }

                    // Copy it to workspace and make executable
                    sh """
                        cp "${scriptFile.path}" "./${env.SCRIPT_NAME}"
                        chmod +x "./${env.SCRIPT_NAME}"
                        sed -i '1i#!/usr/bin/env python3' "./${env.SCRIPT_NAME}"  # ensure shebang
                    """
                    echo "Auto-deployed ${env.SCRIPT_NAME} → ready to run"
                }
            }
        }

        stage('Auto-Setup Passwordless SSH') {
            steps {
                script {
                    def ip = params['Local IP Address']
                    echo "Setting up passwordless SSH to root@${ip} (one-time per node)"

                    sh """
                        # Create .ssh dir if missing
                        mkdir -p ~/.ssh
                        chmod 700 ~/.ssh

                        # Generate key if not exists
                        [ -f ~/.ssh/id_rsa ] || ssh-keygen -t rsa -b 4096 -f ~/.ssh/id_rsa -q -N ""

                        # Try to copy key — ignore failures (user can enter password once)
                        ssh-copy-id -o StrictHostKeyChecking=no root@${ip} || echo "SSH key copy failed — you'll be prompted once"

                        # Always clean known_hosts to avoid conflicts
                        ssh-keygen -R ${ip} || true
                    """
                }
            }
        }

        stage('Firmware Upgrade Test') {
            steps {
                script {
                    def localIP   = params['Local IP Address']
                    def remoteIP   = params['Remote IP Address'] ?: ""
                    def fwPath     = params.CUSTOM_FIRMWARE ? "/tmp/custom_firmware.bin" : "/var/lib/jenkins/firmware/UBR655-latest.bin"
                    def count      = params.FIRMWARE_UPGRADE_COUNT.toInteger()
                    def keepFlag   = params['Keep Setting'] ? "" : "-n"

                    echo "Starting ${count} cycle(s) on ${local}"

                    sh "echo '{\"iterations\": []}' > iteration_results.json"

                    if (params.CUSTOM_FIRMWARE) {
                        sh "cp '${params.CUSTOM_FIRMWARE}' /tmp/custom_firmware.bin"
                    }

                    for (int i = 1; i <= count; i++) {
                        echo "CYCLE ${i}/${count}"
                        try {
                            timeout(time: 20, unit: 'MINUTES') {
                                sh """
                                    python3 "./${env.SCRIPT_NAME}" '${local}' '${fwPath}' '${i}' '${keepFlag}'
                                """
                            }
                        } catch (err) {
                            echo "Cycle ${i} FAILED → ${err}"
                            currentBuild.result = 'UNSTABLE'
                        }

                        if (remoteIP) {
                            sh "ping -c 3 ${remoteIP} || true"
                        }
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def localIP = params['Local IP Address']
                    def fw_version = "Not reachable"

                    try {
                        def out = sh(
                            script: "ssh -o StrictHostKeyChecking=no -o ConnectTimeout=15 root@${localIP} 'cat /etc/version 2>/dev/null || ubus call system board || echo Unknown'",
                            returnStdout: true
                        ).trim()

                        if (out.contains('"description"')) {
                            fw_version = (out =~ /"description"\\s*:\\s*"([^"]+)"/)[0][1]
                        } else if (out && out != "Unknown") {
                            fw_version = out
                        }
                    } catch (e) {}

                    def json = [iterations: []]
                    try { json = readJSON file: 'iteration_results.json' } catch (e) {}

                    def total = json.iterations.size()
                    def pass  = json.iterations.count { it.status == 'PASS' }
                    env.SUCCESS_RATE = total > 0 ? String.format("%.1f", pass * 100.0 / total) : "0.0"

                    def dateStr = Calendar.getInstance(TimeZone.getTimeZone("Asia/Kolkata"))
                                          .getTime().format("dd MMM yyyy, HH:mm:ss z")

                    def logo = "https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png"

                    writeFile file: 'report.html', text: """
                    <html><head><title>FW Upgrade - ${params.Model}</title>
                    <style>
                        body{font-family:system-ui;background:#f8fafc;color:#1e293b;margin:0}
                        .c{max-width:1200px;margin:40px auto;padding:30px;background:#fff;border-radius:12px;box-shadow:0 10px 40px rgba(0,0,0,.1)}
                        .h{background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;padding:40px;border-radius:12px;text-align:center}
                        .h img{height:70px;margin-bottom:15px}
                        h1{margin:10px 0;font-size:34px}
                        table{width:100%;border-collapse:collapse;margin:25px 0}
                        th,td{padding:14px;border-bottom:1px solid #e2e8f0;text-align:left}
                        th{background:#f1f5f9;font-weight:600}
                        .p{background:#dcfce7;color:#166534}.f{background:#fee2e2;color:#991b1b}
                        .p,.f{padding:8px 16px;border-radius:50px;font-weight:bold;display:inline-block}
                        .s{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;margin:30px 0}
                        .card{background:#fff;padding:25px;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,.08);text-align:center}
                        .big{font-size:48px;font-weight:bold}
                    </style></head>
                    <body><div class="c">
                        <div class="h"><img src="${logo}"><h1>Senao ${params.Model}<br>Firmware Upgrade Test</h1><p>${dateStr}</p></div>
                        <h2>Parameters</h2>
                        <table>
                            <tr><b>Node</b></td><td>${TARGET_STAND}</td></tr>
                            <tr><td><b>Local IP</b></td><td>${localIP}</td></tr>
                            <tr><td><b>Model</b></td><td>${params.Model}</td></tr>
                            <tr><td><b>Cycles</b></td><td>${total}</td></tr>
                            <tr><td><b>Final FW</b></td><td>${fw_version}</td></tr>
                        </table>
                        <h2>Summary</h2>
                        <div class="s">
                            <div class="card"><h3>Total</h3><div class="big">${total}</div></div>
                            <div class="card"><h3>Pass</h3><div class="big" style="color:#16a34a">${pass}</div></div>
                            <div class="card"><h3>Fail</h3><div class="big" style="color:#dc2626">${total-pass}</div></div>
                            <div class="card"><h3>Rate</h3><div class="big" style="color:#16a34a">${env.SUCCESS_RATE}%</div></div>
                        </div>
                        <h2>Results</h2>
                        <table>
                            <tr><th>#</th><th>Status</th><th>Keep</th><th>Log</th></tr>
                            ${json.iterations.collect { r ->
                                "<tr><td>${r.iteration}</td><td><span class='${r.status=='PASS'?'p':'f'}'>${r.status}</span></td><td>${r.'Keep Settings'}</td><td>${r.'Device Logs'}</td></tr>"
                            }.join('')}
                        </table>
                    </div></body></html>
                    """
                }
            }
        }
    }

    post {
        always {
            publishHTML([
                reportDir: '.',
                reportFiles: 'report.html',
                reportName: 'Firmware Upgrade Test Report',
                keepAll: true,
                alwaysLinkToLastBuild: true,
                allowMissing: false
            ])

            archiveArtifacts artifacts: 'iteration_results.json,report.html', allowEmptyArchive: true
            cleanWs() // optional: clean workspace

            script {
                def userId = "unknown"
                try {
                    userId = currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause')?.userId?.get(0) ?: "unknown"
                } catch (e) {}

                def email = [
                    puneet: "puneet.sharma@senao.com",
                    harman: "harmanjot.singh@senao.com"
                ].get(userId.toLowerCase(), "puneet.sharma@senao.com")

                emailext(
                    subject: "FW Upgrade #${BUILD_NUMBER} - ${currentBuild.currentResult} (${env.SUCCESS_RATE}%)",
                    body: "<h2>Firmware Upgrade Test</h2><p>Model: ${params.Model} | Rate: ${env.SUCCESS_RATE}%</p><p><a href='${env.BUILD_URL}Firmware_Upgrade_Test_Report/'>View Report</a></p>",
                    to: email,
                    mimeType: 'text/html',
                    attachmentsPattern: 'report.html'
                )
            }
        }
    }
}