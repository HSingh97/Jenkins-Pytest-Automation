pipeline {
    agent { node { label "${TARGET_STAND}" } }

    parameters {
        string(name: 'Local IP Address', defaultValue: '192.168.1.10')
        string(name: 'Remote IP Address', defaultValue: '192.168.1.11')
        string(name: 'FIRMWARE_UPGRADE_COUNT', defaultValue: '10')
        booleanParam(name: 'Keep Setting', defaultValue: true)
        choice(name: 'Model', choices: ['UBR655', 'EOC655', 'ENH1750', 'Custom'], description: 'Select model')
        string(name: 'CUSTOM_FIRMWARE', defaultValue: '', description: 'Optional full path to .tgz/.bin')
    }

    stages {
        stage('Install sshpass') {
            steps {
                sh 'which sshpass || (sudo yum install -y sshpass || sudo apt install -y sshpass)'
            }
        }

        stage('Deploy CLI Script') {
            steps {
            steps {
                sh '''
                    cp -f testCases/test_CLI_FW_Upgrade.py ./
                    chmod +x test_CLI_FW_Upgrade.py
                '''
            }
        }

        stage('Run Upgrade Cycles') {
            steps {
                script {
                    def ip = params['Local IP Address']
                    def fw = params.CUSTOM_FIRMWARE?.trim() ?: "/var/lib/jenkins/firmware/${params.Model}-latest.tgz"
                    def cycles = params.FIRMWARE_UPGRADE_COUNT.toInteger()
                    def keep = params['Keep Setting'] ? "" : "-n"

                    sh 'echo \'{"iterations": []}\' > iteration_results.json'

                    for (int i = 1; i <= cycles; i++) {
                        echo "CYCLE ${i}/${cycles} – CLI UPGRADE"
                        timeout(time: 22, unit: 'MINUTES') {
                            sh """
                                python3 test_CLI_FW_Upgrade.py '${ip}' '${fw}' '${i}' '${keep}'
                            """
                        }
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def data = readJSON file: 'iteration_results.json'
                    def total = data.iterations.size()
                    def pass  = data.iterations.count { it.status == 'PASS' }
                    def rate  = total > 0 ? String.format("%.1f", pass * 100.0 / total) : "0.0"

                    def finalVer = sh(script: "sshpass -p admin ssh -o StrictHostKeyChecking=no root@${params['Local IP Address']} 'cat /etc/version || echo Unknown'", returnStdout: true).trim()

                    writeFile file: 'report.html', text: """
                    <!DOCTYPE html>
                    <html>
                    <head><meta charset="utf-8"><title>CLI FW Upgrade Result</title>
                    <style>
                        body {font-family: system-ui; background: #000; color: #0f0; text-align: center; padding: 80px;}
                        h1 {font-size: 90px;} .big {font-size: 180px; font-weight: 900;}
                    </style>
                    </head>
                    <body>
                        <h1>CLI FIRMWARE UPGRADE</h1>
                        <h2>${params.Model} • ${TARGET_STAND}</h2>
                        <div class="big">${rate}%</div>
                        <h1>${pass} / ${total} PASSED</h1>
                        <h3>Final Version: ${finalVer}</h3>
                    </body>
                    </html>
                    """
                    publishHTML([reportName: 'CLI Firmware Upgrade Report', reportDir: '.', reportFiles: 'report.html', keepAll: true])
                }
            }
        }
    }

    post {
        always {
            emailext(
                to: 'puneet.sharma@senao.com',
                subject: "CLI FW Upgrade #${BUILD_NUMBER} → ${env.SUCCESS_RATE ?: rate}%",
                body: "Success Rate: ${env.SUCCESS_RATE ?: rate}%<br><a href='${BUILD_URL}CLI_Firmware_Upgrade_Report/'>View Report</a>",
                mimeType: 'text/html'
            )
        }
    }
}