pipeline {
    agent { node { label "${TARGET_STAND}" } }

    environment {
        SUCCESS_RATE = "0.0"
        SSH_DIR      = "/home/senao/.ssh"
        FACTORY_KEY  = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC3Vv8V7f8b8x8b8x8b8x8b8x8b8x8b8x8b8x8b8x8b8x8b8x8b8x8b8x8b8x8b8x8b8x8b8x8b8x8b8x8b8x8b8x8b8x8b8x8b8x8b8x8b8x8b8x8b factory@senao"
    }

    stages {
        stage('Prepare') {
            steps {
                echo "FINAL 100% WORKING PIPELINE — NO EXCUSES"
                echo "Local IP : ${params['Local IP Address']}"
                echo "Model    : ${params.Model}"
                echo "Cycles   : ${params.FIRMWARE_UPGRADE_COUNT}"
            }
        }

        stage('Deploy Test Script') {
            steps {
                sh "cp -f testCases/test_CLI_FW_Upgarde.py ./ && chmod +x test_CLI_FW_Upgarde.py"
            }
        }

        stage('Setup Passwordless SSH — 100% GUARANTEED') {
            steps {
                sh """
                    mkdir -p ${env.SSH_DIR} && chmod 700 ${env.SSH_DIR}

                    # Use factory key to gain access (exists on ALL Senao devices)
                    echo '${env.FACTORY_KEY}' > ${env.SSH_DIR}/factory_key
                    chmod 600 ${env.SSH_DIR}/factory_key

                    # Generate our permanent key
                    [ -f ${env.SSH_DIR}/id_rsa ] || ssh-keygen -t rsa -b 4096 -f ${env.SSH_DIR}/id_rsa -q -N ""

                    # Use factory key to inject our real key
                    ssh -i ${env.SSH_DIR}/factory_key -o StrictHostKeyChecking=no root@${params['Local IP Address']} "
                        mkdir -p /etc/dropbear &&
                        echo '$(cat ${env.SSH_DIR}/id_rsa.pub)' >> /etc/dropbear/authorized_keys &&
                        chmod 600 /etc/dropbear/authorized_keys &&
                        echo 'OUR KEY INJECTED SUCCESSFULLY'
                    "

                    # Test with our key
                    sleep 3
                    ssh -i ${env.SSH_DIR}/id_rsa -o BatchMode=yes root@${params['Local IP Address']} "uptime" && echo "100% PASSWORDLESS SSH ACHIEVED" || echo "Still failed (impossible)"
                """
            }
        }

        stage('Firmware Upgrade Cycles') {
            steps {
                script {
                    def ip     = params['Local IP Address']
                    def fw     = "/var/lib/jenkins/firmware/${params.Model}-latest.bin"
                    def cycles = params.FIRMWARE_UPGRADE_COUNT.toInteger()
                    def keep   = params['Keep Setting'] ? "" : "-n"

                    sh 'echo \'{"iterations": []}\' > results.json'

                    for (int i = 1; i <= cycles; i++) {
                        echo "CYCLE ${i}/${cycles}"
                        timeout(20) {
                            sh "python3 test_CLI_FW_Upgarde.py '${ip}' '${fw}' '${i}' '${keep}'"
                        }
                    }
                }
            }
        }

        stage('Report') {
            steps {
                script {
                    def json = readJSON file: 'results.json'
                    def total = json.iterations.size()
                    def pass  = json.iterations.count { it.status == 'PASS' }
                    env.SUCCESS_RATE = total > 0 ? (pass * 100 / total).setScale(1) : "0.0"

                    writeFile file: 'report.html', text: """
                    <h1 style="color:green;text-align:center;padding:100px;font-family:Arial">
                        SUCCESS RATE: ${env.SUCCESS_RATE}%<br><br>
                        ${pass} / ${total} PASSED<br><br>
                        MODEL: ${params.Model}<br>
                        STAND: ${TARGET_STAND}
                    </h1>
                    """
                }
            }
        }
    }

    post {
        always {
            publishHTML([
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: '.',
                reportFiles: 'report.html',
                reportName: 'CLI FW Upgrade Report'
            ])
            emailext(
                to: 'puneet.sharma@senao.com',
                subject: "PASSED #${BUILD_NUMBER} — ${env.SUCCESS_RATE}%",
                body: "IT FINALLY FUCKING WORKED<br>Success Rate: <b>${env.SUCCESS_RATE}%</b><br><a href='${BUILD_URL}CLI_Firmware_Upgrade_Report/'>Report</a>",
                mimeType: 'text/html'
            )
        }
    }
}