// Functions
def archiveArtifacts(pattern) {
    step([$class: 'ArtifactArchiver', artifacts: pattern, fingerprint: true, onlyIfSuccessful: false])
}

pipeline {
    agent { node { label "${TARGET_STAND}" } }

    environment {
        // Automatically sets report filename to "JobName.html"
        REPORT_FILE_NAME = "${env.JOB_BASE_NAME}.html"
    }

    stages {
        stage('Prepare tests') {
            steps {
                script {
                    echo "----------------------------------------"
                    echo "--- TARGET STAND: ${TARGET_STAND}"
                    echo "--- JOB NAME: ${env.JOB_BASE_NAME}"
                    echo "----------------------------------------"
                }
            }
        }

        stage('Install Python Dependencies') {
            steps {
                script {
                    echo "Installing Dependencies..."

                    // FIX: Remove invalid 'apt-get' lines from requirements.txt to prevent pip failure
                    sh "sed -i '/apt-get/d' utilities/requirements.txt || true"

                    // Try pip with break-system-packages (for newer systems) or standard pip
                    sh "pip3 install -r utilities/requirements.txt --break-system-packages || pip3 install -r utilities/requirements.txt || true"
                }
            }
        }

        stage('Download Firmware') {
            steps {
                script {
                    echo "Downloading the Build..."
                    sh "mkdir -p artifacts"
                    // Clean up specific old files
                    sh "rm -f fw.img.enc fw.tgz"

                    def targetImgFile = "fw.img.enc"
                    def targetTgzFile = "fw.tgz"
                    def singleImage = params['Single Image'] ?: false
                    def customBuildFile = params.UPLOADED_FIRMWARE
                    def logFile = "${workspace}/artifacts/flashing-device.log"

                    def url = params['Build URL']
                    int bonsaiIndex = url.indexOf('/bonsai/')
                    if (bonsaiIndex == -1) error "Invalid Build URL: ${url}. URL must contain '/bonsai/'."
                    def buildPath = url.substring(bonsaiIndex + 8)
                    def WGET_URL = "https://jenkins.senao.com/bonsai/${buildPath}"
                    if (!WGET_URL.endsWith('/')) WGET_URL += '/'

                    if (customBuildFile) {
                        if (singleImage) {
                            sh "mv -f '${customBuildFile}' ${targetImgFile}"
                        } else {
                            sh "mv -f '${customBuildFile}' ${targetTgzFile}"
                        }
                    } else {
                        // Download both potential extensions
                        sh "wget --no-verbose --no-parent --no-check-certificate -e robots=off --recursive --level=1 -A '*-apps.img.enc,*-apps.tgz' --no-directories ${WGET_URL} 2>&1 | tee -a \"${logFile}\""

                        // Rename downloaded files to standard names
                        sh """
                            imgfile=\$(ls -t *-apps.img.enc 2>/dev/null | head -n 1)
                            if [ -n "\$imgfile" ]; then mv -f "\$imgfile" "${targetImgFile}"; fi
                            tgzfile=\$(ls -t *-apps.tgz 2>/dev/null | head -n 1)
                            if [ -n "\$tgzfile" ]; then mv -f "\$tgzfile" "${targetTgzFile}"; fi
                        """
                    }

                    // --- PRIORITY LOGIC ---
                    // 1. If .img.enc exists, USE IT. (Most reliable for sysupgrade)
                    // 2. If not, use .tgz.
                    if (fileExists(targetImgFile)) {
                        echo "Found valid image file (.img.enc). Using this for upgrade."
                        env.FIRMWARE_FILE = targetImgFile
                    } else if (fileExists(targetTgzFile)) {
                        echo "Only found .tgz file. Attempting upgrade with .tgz."
                        env.FIRMWARE_FILE = targetTgzFile
                    } else {
                        error "No firmware file found! Checked for ${targetImgFile} and ${targetTgzFile}"
                    }

                    echo "Selected Firmware: ${env.FIRMWARE_FILE}"
                    archiveArtifacts(env.FIRMWARE_FILE)
                }
            }
        }

        stage('Firmware Upgrade') {
            steps {
                script {
                    def localIP = params['Local IP Address']
                    def keep = params['Keep Setting'] ? "" : "-n"
                    def FIRMWARE_UPGRADE_COUNT = params.FIRMWARE_UPGRADE_COUNT ?: "1"

                    // Reset previous results
                    sh 'rm -f test-*.log iteration_results.json'
                    sh "echo '{\"iterations\": []}' > iteration_results.json"

                    echo "----------------------------------------"
                    echo "Upgrading FW using file: ${env.FIRMWARE_FILE}"
                    echo "----------------------------------------"

                    for (int i = 1; i <= FIRMWARE_UPGRADE_COUNT.toInteger(); i++) {
                        echo "--- Iteration ${i} ---"
                        // Run Python script and tee output to a log file for the report
                        sh "python3 testCases/test_CLI_FW_Upgrade.py '${localIP}' '${env.FIRMWARE_FILE}' '${i}' '${keep}' 2>&1 | tee test-${i}.log"
                    }

                    archiveArtifacts('iteration