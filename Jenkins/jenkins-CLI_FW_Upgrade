// Functions
def archiveArtifacts(pattern) {
    step([$class: 'ArtifactArchiver', artifacts: pattern, fingerprint: true, onlyIfSuccessful: false])
}

pipeline {
    agent { node { label "${TARGET_STAND}" } }

    stages {
        stage('Prepare') {
            steps {
                echo "TARGET STAND : ${TARGET_STAND} | IP: ${params['Local IP Address']} | Model: ${params.Model}"
            }
        }

        stage('Install sshpass') {
            steps {
                sh 'which sshpass || (sudo yum install -y sshpass || sudo apt install -y sshpass || true)'
            }
        }

        stage('Download Firmware') {
            steps {
                script {
                    sh 'mkdir -p artifacts && rm -f fw.tgz fw.img.enc'

                    def url = params['Build URL']?.trim()
                    if (!url) error "Build URL is empty!"

                    def path = url.substring(url.indexOf('/bonsai/') + 8)
                    def wgetUrl = "https://jenkins.senao.com/bonsai/${path}"
                    if (!wgetUrl.endsWith('/')) wgetUrl += '/'

                    sh """
                        wget --no-verbose --no-parent --no-check-certificate \
                             -e robots=off --recursive --level=1 \
                             -A '*-apps.tgz,*-apps.img.enc' --no-directories \
                             "${wgetUrl}"
                    """

                    sh 'mv -f *-apps.tgz fw.tgz || true'
                    sh 'img=\$(ls *-apps.img.enc 2>/dev/null | head -n1); [ -n "\$img" ] && mv -f "\$img" fw.img.enc || true'

                    if (!fileExists('fw.tgz')) error "fw.tgz not downloaded!"

                    env.FW_FILE = 'fw.tgz'
                    archiveArtifacts('fw.tgz')
                    archiveArtifacts('fw.img.enc')
                }
            }
        }

        stage('Deploy CLI Script') {
            steps {
                sh '''
                    cp -f testCases/test_CLI_FW_Upgrade.py ./
                    chmod +x test_CLI_FW_Upgrade.py
                    ls -la test_CLI_FW_Upgrade.py
                '''
            }
        }

        stage('Run CLI Upgrade Cycles') {
            steps {
                script {
                    def ip     = params['Local IP Address']
                    def cycles = params.FIRMWARE_UPGRADE_COUNT.toInteger()
                    def keep   = params['Keep Setting'] ? "" : "-n"

                    sh 'echo \'{"iterations": []}\' > iteration_results.json'

                    for (int i = 1; i <= cycles; i++) {
                        echo "=== CYCLE ${i}/${cycles} ==="
                        timeout(time: 22, unit: 'MINUTES') {
                            sh "python3 test_CLI_FW_Upgrade.py '${ip}' '${env.FW_FILE}' '${i}' '${keep}'"
                        }
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def json = fileExists('iteration_results.json') ? readJSON(file: 'iteration_results.json') : [iterations: []]
                    def total = json.iterations.size()
                    def pass  = json.iterations.count { it.status == 'PASS' }
                    def rate  = total > 0 ? String.format("%.1f", pass * 100.0 / total) : "0.0"
                    env.RATE = rate

                    def ver = "Unknown"
                    try {
                        ver = sh(script: "sshpass -p admin ssh -o StrictHostKeyChecking=no root@${params['Local IP Address']} 'cat /etc/version || echo Unknown'", returnStdout: true).trim()
                    } catch (e) {}

                    def now = new java.text.SimpleDateFormat("dd MMM yyyy, HH:mm:ss z")
                              .tap { it.timeZone = TimeZone.getTimeZone('Asia/Kolkata') }
                              .format(new Date())

                    writeFile file: 'report.html', text: """
                    <!DOCTYPE html>
                    <html>
                    <head>
                        <meta charset="utf-8">
                        <title>CLI FW Upgrade Report</title>
                        <style>
                            body {font-family: system-ui; background: #000; color: #0f0; text-align: center; padding: 80px;}
                            h1 {font-size: 100px; margin: 20px;}
                            .big {font-size: 300px; font-weight: 900; color: #22c55e;}
                            .box {background: #111; padding: 80px; border-radius: 40px; display: inline-block; box-shadow: 0 0 100px #0f0;}
                        </style>
                    </head>
                    <body>
                        <div class="box">
                            <h1>CLI FIRMWARE UPGRADE</h1>
                            <h1>${params.Model} • ${TARGET_STAND}</h1>
                            <div class="big">${rate}%</div>
                            <h1>${pass}/${total} PASSED</h1>
                            <h1>Final Version: ${ver}</h1>
                            <p>${now}</p>
                        </div>
                    </body>
                    </html>
                    """

                    publishHTML([
                        reportName: 'CLI Firmware Upgrade Report',
                        reportDir: '.',
                        reportFiles: 'report.html',
                        keepAll: true,
                        alwaysLinkToLastBuild: true
                    ])
                }
            }
        }
    }

    post {
        always {
            script {
                def rate = env.RATE ?: "0.0"
                emailext(
                    to: 'puneet.sharma@senao.com',
                    subject: "CLI FW Upgrade #${BUILD_NUMBER} → ${rate}%",
                    body: "<h2>Success Rate: <b>${rate}%</b></h2><p><a href='${BUILD_URL}CLI_Firmware_Upgrade_Report/'>View Report</a></p>",
                    mimeType: 'text/html',
                    attachmentsPattern: 'report.html'
                )
            }
        }
    }
}