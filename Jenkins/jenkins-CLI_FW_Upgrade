// Functions
def archiveArtifacts(pattern) {
    step([$class: 'ArtifactArchiver', artifacts: pattern, fingerprint: true, onlyIfSuccessful: false])
}

// Main Pipeline — CLI Firmware Upgrade (Exact twin of your Selenium job)
pipeline {
    agent { node { label "${TARGET_STAND}" } }

    stages {
        stage('Prepare tests') {
            steps {
                script {
                    echo "----------------------------------------"
                    echo "--- TARGET STAND: ${TARGET_STAND}"
                    echo "----------------------------------------"
                }
            }
        }

        stage('Install Python Dependencies') {
            steps {
                script {
                    echo "----------------------------------------"
                    echo "Installing Dependencies"
                    echo "----------------------------------------"
                    sh "sh utilities/requirements.txt"
                }
            }
        }

        // TERA 100% ORIGINAL DOWNLOAD FIRMWARE STAGE — NO CHANGE
        stage('Download Firmware') {
            steps {
                script {
                    echo "----------------------------------------"
                    echo "Downloading the Build"
                    echo "----------------------------------------"
                    sh "mkdir -p artifacts"
                    sh "pwd"

                    echo "Cleaning up any old firmware files..."
                    sh "rm -f fw.img.enc fw.tgz"

                    def targetImgFile = "fw.img.enc"
                    def targetTgzFile = "fw.tgz"

                    def singleImage = params['Single Image'] ?: false
                    def customBuildFile = params.UPLOADED_FIRMWARE
                    def logFile = "${workspace}/artifacts/flashing-device.log"

                    def url = params['Build URL']
                    int bonsaiIndex = url.indexOf('/bonsai/')
                    if (bonsaiIndex == -1) {
                        error "Invalid Build URL: ${url}. URL must contain '/bonsai/'."
                    }
                    def buildPath = url.substring(bonsaiIndex + 8)
                    def WGET_URL = "https://jenkins.senao.com/bonsai/${buildPath}"
                    if (!WGET_URL.endsWith('/')) {
                        WGET_URL += '/'
                    }
                    echo "Full WGET URL: ${WGET_URL}"

                    if (customBuildFile) {
                        if (singleImage) {
                            echo "Using custom uploaded file as SINGLE IMAGE: ${targetImgFile}"
                            sh "mv -f '${customBuildFile}' ${targetImgFile} 2>&1 | tee \"${logFile}\""
                            sh "echo 'Downloading .tgz file...' | tee -a \"${logFile}\""
                            sh "wget --no-verbose --no-parent --no-check-certificate -e robots=off --recursive --level=1 -A '*-apps.tgz' --no-directories ${WGET_URL} 2>&1 | tee -a \"${logFile}\""
                            sh "mv -f *-apps.tgz ${targetTgzFile} 2>&1 | tee -a \"${logFile}\""
                        } else {
                            echo "Using custom uploaded file as TGZ: ${targetTgzFile}"
                            sh "mv -f '${customBuildFile}' ${targetTgzFile} 2>&1 | tee \"${logFile}\""
                            sh "echo 'Downloading .img.enc file...' | tee -a \"${logFile}\""
                            sh "wget --no-verbose --no-parent --no-check-certificate -e robots=off --recursive --level=1 -A '*-apps.img.enc' --no-directories ${WGET_URL} 2>&1 | tee -a \"${logFile}\""
                            sh """
                               #!/bin/bash
                               imgfile=\$(ls -t *-apps.img.enc 2>/dev/null | head -n 1)
                               if [ -n "\$imgfile" ]; then mv -f "\$imgfile" "${targetImgFile}"; fi
                            """ + " 2>&1 | tee -a \"${logFile}\""
                        }
                    } else {
                        sh "echo 'No custom build found. Downloading from URL.' | tee \"${logFile}\""
                        sh "wget --no-verbose --no-parent --no-check-certificate -e robots=off --recursive --level=1 -A '*-apps.img.enc,*-apps.tgz' --no-directories ${WGET_URL} 2>&1 | tee -a \"${logFile}\""

                        sh "mv -f *-apps.tgz ${targetTgzFile} 2>&1 | tee -a \"${logFile}\""
                        sh """
                           #!/bin/bash
                           imgfile=\$(ls -t *-apps.img.enc 2>/dev/null | head -n 1)
                           if [ -n "\$imgfile" ]; then
                               echo "Found image file: \$imgfile. Renaming to ${targetImgFile}"
                               mv -f "\$imgfile" "${targetImgFile}"
                           fi
                        """ + " 2>&1 | tee -a \"${logFile}\""
                    }

                    if (singleImage) {
                        env.FIRMWARE_FILE = targetImgFile
                    } else {
                        env.FIRMWARE_FILE = targetTgzFile
                    }

                    archiveArtifacts(targetImgFile)
                    archiveArtifacts(targetTgzFile)
                }
            }
        }

        // CLI UPGRADE STAGE — ONLY CHANGE
        stage('Firmware Upgrade') {
            steps {
                script {
                    def localIP = params['Local IP Address']
                    def keep = params['Keep Setting'] ? "" : "-n"

                    sh 'rm -f test-*.log test.log'
                    echo "Cleared old workspace"

                    sh "echo '{\"iterations\": []}' > iteration_results.json"

                    def FIRMWARE_UPGRADE_COUNT = params.FIRMWARE_UPGRADE_COUNT ?: "1"

                    echo "Local IP Address: ${localIP}"
                    echo "--- Firmware file: ${env.FIRMWARE_FILE} ---"

                    echo "----------------------------------------"
                    echo "Upgrading the Firmware (CLI)"
                    echo "----------------------------------------"
                    sh "mkdir -p artifacts"

                    for (int i = 1; i <= FIRMWARE_UPGRADE_COUNT.toInteger(); i++) {
                        echo "Running CLI Firmware Upgrade test iteration ${i}"
                        try {
                            sh "python3 testCases/test_CLI_FW_Upgrade.py '${localIP}' '${env.FIRMWARE_FILE}' '${i}' '${keep}'"
                        } catch (Exception e) {
                            echo "CLI Upgrade iteration ${i} failed: ${e.message}"
                        }
                    }

                    archiveArtifacts('artifacts/**/*')
                }
            }
        }

        // TERA 100% ORIGINAL REPORT STAGE — NO CHANGE
        stage('Generate Report') {
            steps {
                script {
                    def localIP = params['Local IP Address']
                    def remoteIP = params['Remote IP Address']

                    sh "ssh-keygen -R ${localIP} || true"
                    sh "ssh-keygen -R ${remoteIP} || true"

                    def local_fw_version = "N/A"
                    def remote_fw_version = "N/A"

                    try {
                        local_fw_version = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${localIP} 'cat /etc/version'", returnStdout: true).trim()
                    } catch (e) { echo "Failed to get local version" }

                    try {
                        remote_fw_version = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${remoteIP} 'cat /etc/version'", returnStdout: true).trim()
                    } catch (e) { echo "Failed to get remote version" }

                    def jsonReport = readJSON file: 'iteration_results.json'

                    def totalTests = jsonReport.iterations ? jsonReport.iterations.size() : 0
                    def passCount = jsonReport.iterations ? jsonReport.iterations.count { it.status == 'PASS' } : 0
                    def failCount = totalTests - passCount
                    def successPercentageStr = totalTests > 0 ? String.format("%.1f", (passCount / (double)totalTests) * 100) : "0.0"

                    def istDate = Calendar.getInstance(TimeZone.getTimeZone("Asia/Kolkata")).getTime()
                    def currentDateTime = istDate.format("dd MMM yyyy, HH:mm:ss z", TimeZone.getTimeZone("Asia/Kolkata"))

                    def companyLogoUrl = "https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png"
                    def pipelineName = env.JOB_NAME

                    def buildParams = [
                        "Local IP Address": params['Local IP Address'],
                        "Remote IP Address": params['Remote IP Address'],
                        "Model": params.Model,
                        "FW Version (Local / Remote)": "${local_fw_version} / ${remote_fw_version}",
                        "Build URL": params['Build URL'],
                        "Cycles": totalTests
                    ]

                    def htmlContent = """
                    <YOUR FULL ORIGINAL SELENIUM HTML REPORT — SAME AS YOU PASTED>
                    """

                    writeFile file: 'report.html', text: htmlContent
                }
            }
        }
    }

    post {
        always {
            publishHTML(target: [
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: '.',
                reportFiles: 'report.html',
                reportName: 'Test Report'
            ])

            sh 'rm -f test-*.log || true'

            echo "-----------------------------------------"
            echo 'Script Done!'
            echo "-----------------------------------------"

            script {
                def buildCauses = currentBuild.getBuildCauses()
                def userCause = buildCauses.find { it._class == 'hudson.model.Cause$UserIdCause' }
                def buildUserName = userCause?.userName ?: "Unknown User"
                def buildUserId = userCause?.userId ?: "unknown"

                def userEmails = [
                    "puneet": "puneet.sharma@senao.com",
                    "harman": "harmanjot.singh@senao.com",
                    "mahesh": "mahesh.battala@senao.com"
                ]
                def userEmail = userEmails.get(buildUserId, "puneet.sharma@senao.com")

                emailext(
                    subject: "CLI FW Upgrade #${BUILD_NUMBER} - ${currentBuild.currentResult}",
                    to: userEmail,
                    body: "<h2>CLI Firmware Upgrade Completed</h2><p><a href='${BUILD_URL}Test_Report/'>View Report</a></p>",
                    mimeType: 'text/html',
                    attachmentsPattern: 'report.html'
                )
            }
        }
        success { echo "Script Success" }
        failure { echo "Script Failure" }
    }
}