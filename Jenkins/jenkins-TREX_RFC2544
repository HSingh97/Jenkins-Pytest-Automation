pipeline {
    agent {
        node {
            label "${params.TARGET_STAND}"
        }
    }

    parameters {
        string(name: 'TARGET_STAND', defaultValue: 'test-puneet', description: 'Jenkins node label')
        string(name: 'TREX_BSU_IP', defaultValue: '192.168.1.6', description: 'TRex server IP with BSU connected')
        string(name: 'TREX_SU_IP', defaultValue: '', description: 'TRex SU server IP (4-7 SUs)')
        string(name: 'TREX_SU2_IP', defaultValue: '', description: 'TRex SU2 server IP (8-11 SUs)')
        string(name: 'TREX_SU3_IP', defaultValue: '', description: 'TRex SU3 server IP (12-15 SUs)')
        string(name: 'TREX_SU4_IP', defaultValue: '', description: 'TRex SU4 server IP (16-19 SUs)')
        string(name: 'SU_COUNT', defaultValue: '1', description: 'Total number of SUs')
        string(name: 'DL_BW', defaultValue: '250M', description: 'Total downlink bandwidth e.g. 250M 1G')
        string(name: 'UL_BW', defaultValue: '250M', description: 'Total uplink bandwidth e.g. 250M 1G')
        string(name: 'PACKET_SIZE', defaultValue: '1500', description: 'Packet size (64 128 1500 imix ...)')
        string(name: 'DURATION', defaultValue: '60', description: 'Duration in seconds (0 = indefinite)')
        string(name: 'BSU_IP', defaultValue: '192.168.2.10', description: 'BSU device IP for pinging')
        string(name: 'SU_IPS', defaultValue: '192.168.2.11', description: 'Comma separated SU IPs for pinging')
        string(
            name: 'SCRIPT_LOCAL_PATH',
            defaultValue: '/home/senao/master_script_extended_16SU.py',
            description: 'Full path to master_script_extended_16SU.py on the agent machine'
        )
    }

    options {
        timestamps()
        timeout(time: 8, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '30', daysToKeepStr: '90'))
        disableConcurrentBuilds()
    }

    environment {
        SCRIPT_NAME           = 'master_script_extended_16SU.py'
        TREX_REMOTE_PATH      = '/opt/v3.06'
        PYTHONPATH_EXPORT     = 'export PYTHONPATH=/opt/v3.06/automation/trex_control_plane/interactive/'
        SSH_OPTS              = '-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
        ROOT_PASSWORD         = 'ubuntu'
        TREX_PORT             = '4501'
        MAX_HEALTH_CHECKS     = '8'
        HEALTH_CHECK_INTERVAL = '8'
    }

    stages {
        stage('Copy Script to Workspace') {
            steps {
                script {
                    echo "──────────────────────────────────────────────────────"
                    echo "Copying test script from agent to workspace..."
                    echo "Expected location: ${params.SCRIPT_LOCAL_PATH}"
                    echo "──────────────────────────────────────────────────────"

                    if (fileExists(params.SCRIPT_LOCAL_PATH)) {
                        sh "cp -v '${params.SCRIPT_LOCAL_PATH}' ./${SCRIPT_NAME}"
                        echo "Script copied successfully."
                    } else {
                        error """
                        Cannot find the script at:
                            ${params.SCRIPT_LOCAL_PATH}

                        Actions:
                        1. Verify the file exists in /home/senao/
                        2. Correct the SCRIPT_LOCAL_PATH parameter in Build with Parameters
                        3. Or move/rename the file to match the path
                        """
                    }

                    // Final check
                    if (!fileExists(SCRIPT_NAME)) {
                        error "Copy failed - ${SCRIPT_NAME} not present in workspace."
                    }

                    sh "ls -lh ${SCRIPT_NAME}"
                    echo "Script is ready."
                }
            }
        }

        stage('Validate Parameters') {
            steps {
                script {
                    echo "──────────────────────────────────────────────────────"
                    echo "Validating parameters"
                    echo "──────────────────────────────────────────────────────"

                    def required = ['TARGET_STAND','TREX_BSU_IP','SU_COUNT','DL_BW','UL_BW','PACKET_SIZE','DURATION','BSU_IP']
                    required.each { p ->
                        if (!params[p]?.trim()) {
                            error "Parameter ${p} is missing or empty"
                        }
                    }

                    echo "Parameters OK"
                }
            }
        }

        stage('Ping Check') {
            steps {
                script {
                    echo "──────────────────────────────────────────────────────"
                    echo "Pinging all devices"
                    echo "──────────────────────────────────────────────────────"

                    def trex_ips = [params.TREX_BSU_IP]
                    [params.TREX_SU_IP, params.TREX_SU2_IP, params.TREX_SU3_IP, params.TREX_SU4_IP].each {
                        if (it?.trim()) trex_ips << it.trim()
                    }

                    trex_ips.unique().each { ip ->
                        sh "ping -c 4 -W 4 ${ip} || exit 1"
                    }

                    sh "ping -c 4 -W 4 ${params.BSU_IP} || exit 1"

                    if (params.SU_IPS?.trim()) {
                        params.SU_IPS.split(',').collect{it.trim()}.each { ip ->
                            sh "ping -c 4 -W 4 ${ip} || exit 1"
                        }
                    }
                }
            }
        }

        stage('Add SSH Known Hosts') {
            steps {
                script {
                    echo "Adding known hosts entries..."
                    def kh = "${WORKSPACE}/known_hosts_temp"
                    sh "touch ${kh}"

                    def ips = [params.TREX_BSU_IP]
                    [params.TREX_SU_IP, params.TREX_SU2_IP, params.TREX_SU3_IP, params.TREX_SU4_IP].each {
                        if (it?.trim()) ips << it.trim()
                    }

                    ips.unique().each { ip ->
                        sh "ssh-keyscan -H ${ip} >> ${kh} 2>/dev/null || true"
                    }

                    env.SSH_OPTS = "${SSH_OPTS} -o UserKnownHostsFile=${kh}"
                }
            }
        }

        stage('Prepare & Start TRex Servers') {
            steps {
                script {
                    echo "──────────────────────────────────────────────────────"
                    echo "Preparing TRex servers"
                    echo "──────────────────────────────────────────────────────"

                    def trex_ips = [params.TREX_BSU_IP]
                    [params.TREX_SU_IP, params.TREX_SU2_IP, params.TREX_SU3_IP, params.TREX_SU4_IP].each {
                        if (it?.trim()) trex_ips << it.trim()
                    }

                    trex_ips.unique().each { ip ->
                        echo "→ ${ip}"

                        sh "sshpass -p '${ROOT_PASSWORD}' ssh ${env.SSH_OPTS} root@${ip} 'echo 1024 > /sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages || true'"
                        sh "sshpass -p '${ROOT_PASSWORD}' ssh ${env.SSH_OPTS} root@${ip} 'pkill -9 t-rex-64 || true'"
                        sh "sshpass -p '${ROOT_PASSWORD}' ssh ${env.SSH_OPTS} root@${ip} 'cd /opt/v3.06 && nohup ./t-rex-64 -i --no-scapy-server --no-ofed-check > trex.log 2>&1 &'"

                        def healthy = false
                        for (int i = 1; i <= env.MAX_HEALTH_CHECKS.toInteger(); i++) {
                            sleep env.HEALTH_CHECK_INTERVAL.toInteger()
                            def rc = sh(script: "nc -z -w 5 ${ip} ${TREX_PORT}", returnStatus: true)
                            if (rc == 0) { healthy = true; break }
                            echo "   Waiting (${i}/${env.MAX_HEALTH_CHECKS})..."
                        }

                        if (!healthy) {
                            sh "sshpass -p '${ROOT_PASSWORD}' ssh ${env.SSH_OPTS} root@${ip} 'cat /opt/v3.06/trex.log || true'"
                            error "TRex not running on ${ip}"
                        }
                    }
                }
            }
        }

        stage('Run Test Script') {
            steps {
                script {
                    echo "──────────────────────────────────────────────────────"
                    echo "Starting test on BSU TRex server"
                    echo "──────────────────────────────────────────────────────"

                    sh "sshpass -p '${ROOT_PASSWORD}' scp ${env.SSH_OPTS} ${SCRIPT_NAME} root@${params.TREX_BSU_IP}:${TREX_REMOTE_PATH}/"

                    def su_args = ""
                    if (params.TREX_SU_IP?.trim())    su_args += "--server-su ${params.TREX_SU_IP} "
                    if (params.TREX_SU2_IP?.trim())   su_args += "--server-su2 ${params.TREX_SU2_IP} "
                    if (params.TREX_SU3_IP?.trim())   su_args += "--server-su3 ${params.TREX_SU3_IP} "
                    if (params.TREX_SU4_IP?.trim())   su_args += "--server-su4 ${params.TREX_SU4_IP} "

                    sh """
                        sshpass -p '${ROOT_PASSWORD}' ssh ${env.SSH_OPTS} root@${params.TREX_BSU_IP} '
                            cd ${TREX_REMOTE_PATH} &&
                            ${PYTHONPATH_EXPORT} &&
                            python3 ${SCRIPT_NAME} \
                                --server-bsu ${params.TREX_BSU_IP} \
                                ${su_args} \
                                --su ${params.SU_COUNT} \
                                --dl-bw ${params.DL_BW} \
                                --ul-bw ${params.UL_BW} \
                                --size ${params.PACKET_SIZE} \
                                --duration ${params.DURATION} \
                                --graph \
                                2>&1 | tee test_run.log
                        '
                    """

                    // Fetch results
                    sh "sshpass -p '${ROOT_PASSWORD}' scp ${env.SSH_OPTS} root@${params.TREX_BSU_IP}:${TREX_REMOTE_PATH}/throughput_*.png   . || true"
                    sh "sshpass -p '${ROOT_PASSWORD}' scp ${env.SSH_OPTS} root@${params.TREX_BSU_IP}:${TREX_REMOTE_PATH}/trex_test_results.csv . || true"
                    sh "sshpass -p '${ROOT_PASSWORD}' scp ${env.SSH_OPTS} root@${params.TREX_BSU_IP}:${TREX_REMOTE_PATH}/test_run.log         . || true"
                }
            }
        }

        stage('Archive Results') {
            steps {
                archiveArtifacts artifacts: '**/*.png, **/*.csv, **/*.log', allowEmptyArchive: true
                echo "Results archived."
            }
        }
    }

    post {
        always {
            echo "Pipeline finished."
        }
        success {
            echo "SUCCESS"
        }
        failure {
            echo "FAILED - check console"
        }
    }
}