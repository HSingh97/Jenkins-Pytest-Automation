pipeline {
    agent {
        node {
            label "${params.TARGET_STAND}"
        }
    }

    options {
        timestamps()
        timeout(time: 8, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '30', daysToKeepStr: '90'))
        disableConcurrentBuilds()
    }

    environment {
        SCRIPT_PATH_ON_JENKINS = "master_script_extended_16SU.py"
        TREX_REMOTE_PATH      = "/opt/v3.06"
        PYTHONPATH_EXPORT     = "export PYTHONPATH=/opt/v3.06/automation/trex_control_plane/interactive/"
        SSH_COMMON_OPTS       = "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
        ROOT_PASSWORD         = "ubuntu"
        TREX_START_TIMEOUT    = "25"   // seconds to wait for TRex port to appear
    }

    stages {

        stage('Validate Parameters') {
            steps {
                script {
                    echo "┌───────────────────────────────────────────────┐"
                    echo "│             Parameter Validation              │"
                    echo "└───────────────────────────────────────────────┘"

                    def required = ['TREX_BSU_IP', 'BSU_IP', 'SU_COUNT', 'DL_BW', 'UL_BW', 'PACKET_SIZE', 'DURATION']
                    required.each { param ->
                        if (!params[param] || params[param].trim() == '') {
                            error "Missing required parameter: ${param}"
                        }
                    }

                    echo "TARGET_STAND     = ${params.TARGET_STAND}"
                    echo "TREX_BSU_IP      = ${params.TREX_BSU_IP}"
                    echo "TREX_SU_IP       = ${params.TREX_SU_IP ?: 'not set'}"
                    echo "TREX_SU2_IP      = ${params.TREX_SU2_IP ?: 'not set'}"
                    echo "TREX_SU3_IP      = ${params.TREX_SU3_IP ?: 'not set'}"
                    echo "TREX_SU4_IP      = ${params.TREX_SU4_IP ?: 'not set'}"
                    echo "SU_COUNT         = ${params.SU_COUNT}"
                }
            }
        }


        stage('Connectivity Check') {
            steps {
                script {
                    def trex_ips = []
                    if (params.TREX_BSU_IP?.trim()) trex_ips << params.TREX_BSU_IP.trim()
                    if (params.TREX_SU_IP?.trim())  trex_ips << params.TREX_SU_IP.trim()
                    if (params.TREX_SU2_IP?.trim()) trex_ips << params.TREX_SU2_IP.trim()
                    if (params.TREX_SU3_IP?.trim()) trex_ips << params.TREX_SU3_IP.trim()
                    if (params.TREX_SU4_IP?.trim()) trex_ips << params.TREX_SU4_IP.trim()

                    if (trex_ips.isEmpty()) error "No TRex server IPs provided!"

                    echo "Found ${trex_ips.size()} TRex server(s): ${trex_ips.join(', ')}"

                    trex_ips.each { ip ->
                        sh "ping -c 3 -W 4 ${ip} || error 'Cannot ping TRex server ${ip}'"
                    }

                    sh "ping -c 3 -W 4 ${params.BSU_IP} || error 'Cannot ping BSU'"
                }
            }
        }

        stage('Prepare TRex Servers') {
            steps {
                script {
                    def trex_ips = []
                    if (params.TREX_BSU_IP?.trim()) trex_ips << params.TREX_BSU_IP.trim()
                    if (params.TREX_SU_IP?.trim())  trex_ips << params.TREX_SU_IP.trim()
                    if (params.TREX_SU2_IP?.trim()) trex_ips << params.TREX_SU2_IP.trim()
                    if (params.TREX_SU3_IP?.trim()) trex_ips << params.TREX_SU3_IP.trim()
                    if (params.TREX_SU4_IP?.trim()) trex_ips << params.TREX_SU4_IP.trim()

                    echo "Preparing ${trex_ips.size()} TRex server(s)"

                    trex_ips.eachWithIndex { ip, idx ->
                        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                        echo "→ SERVER ${idx+1}/${trex_ips.size()}: ${ip}"
                        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

                        // 1. Hugepages
                        echo "Setting hugepages..."
                        sh "sshpass -p '${ROOT_PASSWORD}' ssh ${SSH_COMMON_OPTS} root@${ip} 'echo 1024 > /sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages || true'"

                        // 2. Kill old instances
                        echo "Killing old TRex instances..."
                        sh "sshpass -p '${ROOT_PASSWORD}' ssh ${SSH_COMMON_OPTS} root@${ip} 'pkill -9 t-rex-64 || true'"

                        // 3. Start TRex
                        echo "Starting new TRex instance..."
                        sh """
                            sshpass -p '${ROOT_PASSWORD}' ssh ${SSH_COMMON_OPTS} root@${ip} '
                                cd ${TREX_REMOTE_PATH} &&
                                nohup ./t-rex-64 -i --no-scapy-server --no-ofed-check > trex-start.log 2>&1 &
                                echo \$! > trex.pid
                            '
                        """

                        echo "Waiting up to ${TREX_START_TIMEOUT} seconds for TRex to listen on port 4501..."
                        sh """
                            for i in {1..${TREX_START_TIMEOUT}}; do
                                if sshpass -p '${ROOT_PASSWORD}' ssh ${SSH_COMMON_OPTS} root@${ip} 'nc -z 127.0.0.1 4501 >/dev/null 2>&1'; then
                                    echo "TRex port 4501 is now listening on ${ip}"
                                    exit 0
                                fi
                                echo "Still waiting... (\$i/${TREX_START_TIMEOUT})"
                                sleep 1
                            done
                            echo "ERROR: TRex did not start listening on port 4501 within ${TREX_START_TIMEOUT} seconds on ${ip}"
                            sshpass -p '${ROOT_PASSWORD}' ssh ${SSH_COMMON_OPTS} root@${ip} 'cat ${TREX_REMOTE_PATH}/trex-start.log || true'
                            exit 1
                        """

                        echo "→ ${ip} looks healthy"
                    }
                }
            }
        }

        stage('Run TRex Test Script') {
            steps {
                script {
                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                    echo "Starting test execution on BSU server: ${params.TREX_BSU_IP}"
                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

                    sh """
                        sshpass -p '${ROOT_PASSWORD}' scp ${SSH_COMMON_OPTS} \
                            ${SCRIPT_PATH_ON_JENKINS} \
                            root@${params.TREX_BSU_IP}:${TREX_REMOTE_PATH}/
                    """

                    def su_args = ""
                    if (params.TREX_SU_IP)    su_args += "--server-su ${params.TREX_SU_IP} "
                    if (params.TREX_SU2_IP)   su_args += "--server-su2 ${params.TREX_SU2_IP} "
                    if (params.TREX_SU3_IP)   su_args += "--server-su3 ${params.TREX_SU3_IP} "
                    if (params.TREX_SU4_IP)   su_args += "--server-su4 ${params.TREX_SU4_IP} "

                    sh """
                        sshpass -p '${ROOT_PASSWORD}' ssh ${SSH_COMMON_OPTS} root@${params.TREX_BSU_IP} '
                            cd ${TREX_REMOTE_PATH} &&
                            ${PYTHONPATH_EXPORT} &&
                            python3 master_script_extended_16SU.py \
                                --server-bsu ${params.TREX_BSU_IP} \
                                ${su_args} \
                                --su ${params.SU_COUNT} \
                                --dl-bw ${params.DL_BW} \
                                --ul-bw ${params.UL_BW} \
                                --size ${params.PACKET_SIZE} \
                                --duration ${params.DURATION} \
                                --graph \
                                2>&1 | tee -a test_run.log
                        '
                    """

                    // Fetch artifacts
                    sh """
                        sshpass -p '${ROOT_PASSWORD}' scp ${SSH_COMMON_OPTS} root@${params.TREX_BSU_IP}:${TREX_REMOTE_PATH}/{throughput_*.png,trex_test_results.csv,test_run.log} . || true
                    """

                    archiveArtifacts artifacts: '*.png, *.csv, test_run.log', allowEmptyArchive: true
                }
            }
        }

        stage('Archive Logs & Results') {
            steps {
                archiveArtifacts artifacts: '**/*.png, **/*.csv, **/*.log', allowEmptyArchive: true
                echo "All available results archived."
            }
        }
    }

    post {
        always {
            echo "Pipeline finished at \$(date)"
        }
        success {
            echo "✓ SUCCESS"
        }
        failure {
            echo "✗ FAILED – check console + artifacts"
        }
    }
}