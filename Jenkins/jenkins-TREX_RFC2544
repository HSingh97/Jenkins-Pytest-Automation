pipeline {
    agent {
        node {
            label "${params.TARGET_STAND}"
        }
    }
    options {
        timestamps()
        timeout(time: 8, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '30', daysToKeepStr: '90'))
        disableConcurrentBuilds()
    }
    environment {
        SCRIPT_PATH_ON_JENKINS = "master_script_extended_16SU.py"
        TREX_REMOTE_PATH = "/opt/v3.06"
        PYTHONPATH_EXPORT = "export PYTHONPATH=/opt/v3.06/automation/trex_control_plane/interactive/"
        SSH_COMMON_OPTS = "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
        TREX_USERNAME = "ubuntu"
        TREX_PASSWORD = "ubuntu"
    }
    stages {
        stage('Validate Parameters') {
            steps {
                script {
                    echo "│ Parameter Validation │"
                    def required = ['TARGET_STAND', 'TREX_BSU_IP', 'BSU_IP', 'SU_COUNT', 'DL_BW', 'UL_BW', 'PACKET_SIZE', 'DURATION']
                    required.each { param ->
                        if (!params[param] || params[param].trim() == '') {
                            error "Missing required parameter: ${param}"
                        }
                    }
                    echo "• TARGET_STAND = ${params.TARGET_STAND}"
                    echo "• TREX_BSU_IP = ${params.TREX_BSU_IP}"
                    echo "• TREX_SU_IP = ${params.TREX_SU_IP ?: 'not set'}"
                    echo "• TREX_SU2_IP = ${params.TREX_SU2_IP ?: 'not set'}"
                    echo "• TREX_SU3_IP = ${params.TREX_SU3_IP ?: 'not set'}"
                    echo "• TREX_SU4_IP = ${params.TREX_SU4_IP ?: 'not set'}"
                    echo "• SU_COUNT = ${params.SU_COUNT}"
                    echo "• DL_BW = ${params.DL_BW}"
                    echo "• UL_BW = ${params.UL_BW}"
                    echo "• PACKET_SIZE = ${params.PACKET_SIZE}"
                    echo "• DURATION = ${params.DURATION} sec"
                    echo "• BSU_IP = ${params.BSU_IP}"
                    echo "• SU_IPS = ${params.SU_IPS ?: 'not provided'}"
                    // Check if script exists on agent
                    if (!fileExists("${SCRIPT_PATH_ON_JENKINS}")) {
                        error "Script ${SCRIPT_PATH_ON_JENKINS} not found in workspace. Ensure it's in the Jenkins folder on the target stand."
                    }
                    echo "✓ Script ${SCRIPT_PATH_ON_JENKINS} found."
                }
            }
        }
        stage('Connectivity Check') {
            steps {
                script {
                    def trex_ips = [params.TREX_BSU_IP]
                    if (params.TREX_SU_IP) trex_ips << params.TREX_SU_IP
                    if (params.TREX_SU2_IP) trex_ips << params.TREX_SU2_IP
                    if (params.TREX_SU3_IP) trex_ips << params.TREX_SU3_IP
                    if (params.TREX_SU4_IP) trex_ips << params.TREX_SU4_IP
                    echo "Pinging all TRex servers..."
                    trex_ips.each { ip ->
                        sh "ping -c 4 -W 3 ${ip} || exit 1"
                    }
                    echo "Pinging BSU..."
                    sh "ping -c 4 -W 3 ${params.BSU_IP} || exit 1"
                    if (params.SU_IPS?.trim()) {
                        echo "Pinging SUs..."
                        def suList = params.SU_IPS.split(',').collect { it.trim() }
                        suList.each { ip ->
                            sh "ping -c 4 -W 3 ${ip} || exit 1"
                        }
                    } else {
                        echo "No SU_IPS provided, skipping SU pings."
                    }
                }
            }
        }
        stage('Prepare TRex Servers') {
            steps {
                script {
                    def trex_ips = [params.TREX_BSU_IP]
                    if (params.TREX_SU_IP) trex_ips << params.TREX_SU_IP
                    if (params.TREX_SU2_IP) trex_ips << params.TREX_SU2_IP
                    if (params.TREX_SU3_IP) trex_ips << params.TREX_SU3_IP
                    if (params.TREX_SU4_IP) trex_ips << params.TREX_SU4_IP
                    echo "Starting / restarting TRex on all servers..."
                    trex_ips.each { ip ->
                        echo "→ Processing TRex server: ${ip}"
                        // Set hugepages with sudo
                        sh """
                            sshpass -p '${TREX_PASSWORD}' ssh ${SSH_COMMON_OPTS} ${TREX_USERNAME}@${ip} '
                                sudo sh -c "echo 1024 > /sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages" || true
                            '
                        """
                        // Kill any old instance with sudo
                        sh """
                            sshpass -p '${TREX_PASSWORD}' ssh ${SSH_COMMON_OPTS} ${TREX_USERNAME}@${ip} '
                                sudo pkill -9 t-rex-64 || true
                            '
                        """
                        // Start TRex in background
                        sh """
                            sshpass -p '${TREX_PASSWORD}' ssh ${SSH_COMMON_OPTS} ${TREX_USERNAME}@${ip} '
                                cd /opt/v3.06 &&
                                nohup ./t-rex-64 -i --no-scapy-server --no-ofed-check > trex.log 2>&1 &
                            '
                        """
                        sleep 20 // Increased sleep time for startup
                        // Check if TRex is running (port 4501 open)
                        def max_attempts = 6
                        def attempt = 0
                        def healthy = false
                        while (attempt < max_attempts && !healthy) {
                            attempt++
                            def status = sh(script: "nc -z -w 5 ${ip} 4501", returnStatus: true)
                            if (status == 0) {
                                healthy = true
                            } else {
                                echo "Attempt ${attempt}/${max_attempts}: Port 4501 not open yet on ${ip}. Waiting 10s..."
                                sleep 10
                            }
                        }
                        if (!healthy) {
                            echo "ERROR: TRex failed to start on ${ip}. Dumping log:"
                            sh """
                                sshpass -p '${TREX_PASSWORD}' ssh ${SSH_COMMON_OPTS} ${TREX_USERNAME}@${ip} 'cat /opt/v3.06/trex.log || true'
                            """
                            error "TRex port 4501 not open on ${ip} after retries."
                        }
                        echo " → ${ip} is healthy (port 4501 open)."
                    }
                }
            }
        }
        stage('Run TRex Test Script') {
            steps {
                script {
                    echo "Copying test script to BSU TRex server (${params.TREX_BSU_IP})..."
                    sh """
                        sshpass -p '${TREX_PASSWORD}' scp ${SSH_COMMON_OPTS} ${SCRIPT_PATH_ON_JENKINS} ${TREX_USERNAME}@${params.TREX_BSU_IP}:${TREX_REMOTE_PATH}/
                    """
                    def su_args = ""
                    if (params.TREX_SU_IP) su_args += "--server-su ${params.TREX_SU_IP} "
                    if (params.TREX_SU2_IP) su_args += "--server-su2 ${params.TREX_SU2_IP} "
                    if (params.TREX_SU3_IP) su_args += "--server-su3 ${params.TREX_SU3_IP} "
                    if (params.TREX_SU4_IP) su_args += "--server-su4 ${params.TREX_SU4_IP} "
                    echo "Launching test on BSU TRex server..."
                    sh """
                        sshpass -p '${TREX_PASSWORD}' ssh ${SSH_COMMON_OPTS} ${TREX_USERNAME}@${params.TREX_BSU_IP} '
                            cd ${TREX_REMOTE_PATH} &&
                            ${PYTHONPATH_EXPORT} &&
                            python3 master_script_extended_16SU.py \
                                --server-bsu ${params.TREX_BSU_IP} \
                                ${su_args} \
                                --su ${params.SU_COUNT} \
                                --dl-bw ${params.DL_BW} \
                                --ul-bw ${params.UL_BW} \
                                --size ${params.PACKET_SIZE} \
                                --duration ${params.DURATION} \
                                --graph \
                                2>&1 | tee test_run.log
                        '
                    """
                    // Fetch results back
                    sh """
                        sshpass -p '${TREX_PASSWORD}' scp ${SSH_COMMON_OPTS} ${TREX_USERNAME}@${params.TREX_BSU_IP}:${TREX_REMOTE_PATH}/throughput_*.png . || true
                        sshpass -p '${TREX_PASSWORD}' scp ${SSH_COMMON_OPTS} ${TREX_USERNAME}@${params.TREX_BSU_IP}:${TREX_REMOTE_PATH}/trex_test_results.csv . || true
                        sshpass -p '${TREX_PASSWORD}' scp ${SSH_COMMON_OPTS} ${TREX_USERNAME}@${params.TREX_BSU_IP}:${TREX_REMOTE_PATH}/test_run.log . || true
                    """
                    archiveArtifacts artifacts: '*.png, *.csv, test_run.log', allowEmptyArchive: true
                }
            }
        }
        stage('Archive Logs & Results') {
            steps {
                archiveArtifacts artifacts: '**/*.png, **/*.csv, **/*.log', allowEmptyArchive: true
                echo "Results, graphs and console log archived."
            }
        }
    }
    post {
        always {
            echo "───────────────────────────────────────────────"
            echo " Pipeline finished "
            echo "───────────────────────────────────────────────"
        }
        success {
            echo "✓ Test completed successfully"
        }
        failure {
            echo "✗ Test failed - check console output and artifacts"
        }
        aborted {
            echo "Test was aborted by user"
        }
    }
}