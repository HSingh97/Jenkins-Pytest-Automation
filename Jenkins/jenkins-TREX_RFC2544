pipeline {
    agent {
        node {
            label params.TARGET_STAND
        }
    }

    parameters {
        string(name: 'TARGET_STAND',      defaultValue: 'test-puneet',      description: 'Jenkins agent label')
        string(name: 'TREX_BSU_IP',       defaultValue: '192.168.1.6',      description: 'TRex server with BSU')
        string(name: 'TREX_SU_IP',        defaultValue: '',                 description: 'TRex SU server 1 (4-7 SUs)')
        string(name: 'TREX_SU2_IP',       defaultValue: '',                 description: 'TRex SU server 2 (8-11 SUs)')
        string(name: 'TREX_SU3_IP',       defaultValue: '',                 description: 'TRex SU server 3 (12-15 SUs)')
        string(name: 'TREX_SU4_IP',       defaultValue: '',                 description: 'TRex SU server 4 (16-19 SUs)')
        string(name: 'SU_COUNT',          defaultValue: '1',                description: 'Total number of SUs')
        string(name: 'DL_BW',             defaultValue: '250M',             description: 'Downlink bandwidth e.g. 250M')
        string(name: 'UL_BW',             defaultValue: '250M',             description: 'Uplink bandwidth e.g. 250M')
        string(name: 'PACKET_SIZE',       defaultValue: '1500',             description: 'Packet size e.g. 64 1500 imix')
        string(name: 'DURATION',          defaultValue: '60',               description: 'Duration seconds (0 = indefinite)')
        string(name: 'BSU_IP',            defaultValue: '192.168.2.10',     description: 'BSU IP for ping')
        string(name: 'SU_IPS',            defaultValue: '192.168.2.11',     description: 'Comma-separated SU IPs for ping')
    }

    options {
        timestamps()
        timeout(time: 4, unit: 'HOURS')
        disableConcurrentBuilds()
    }

    environment {
        SSH             = '-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
        PWD             = 'ubuntu'
        TREX_DIR        = '/opt/v3.06'
        TREX_PORT       = '4501'
        PYTHONPATH_CMD  = 'export PYTHONPATH=/opt/v3.06/automation/trex_control_plane/interactive/'
        SCRIPT_NAME     = 'master_script_extended_16SU.py'
    }

    stages {

        stage('Copy script') {
            steps {
                sh "cp -v '/home/senao/${SCRIPT_NAME}' . || exit 1"
                sh "ls -lh '${SCRIPT_NAME}'"
            }
        }

        stage('Ping devices') {
            steps {
                script {
                    def trex_ips = [params.TREX_BSU_IP]
                    [params.TREX_SU_IP, params.TREX_SU2_IP, params.TREX_SU3_IP, params.TREX_SU4_IP].each {
                        if (it?.trim()) trex_ips << it.trim()
                    }
                    trex_ips.unique().each { ip -> sh "ping -c 3 '${ip}' || exit 1" }
                    sh "ping -c 3 '${params.BSU_IP}' || exit 1"
                    if (params.SU_IPS?.trim()) {
                        params.SU_IPS.split(',').collect{it.trim()}.each { ip -> sh "ping -c 3 '${ip}' || exit 1" }
                    }
                }
            }
        }

        stage('Start TRex servers') {
            steps {
                script {
                    def servers = [
                        [ip: params.TREX_BSU_IP, label: 'BSU']
                    ]
                    if (params.TREX_SU_IP)  servers << [ip: params.TREX_SU_IP,  label: 'SU1']
                    if (params.TREX_SU2_IP) servers << [ip: params.TREX_SU2_IP, label: 'SU2']
                    if (params.TREX_SU3_IP) servers << [ip: params.TREX_SU3_IP, label: 'SU3']
                    if (params.TREX_SU4_IP) servers << [ip: params.TREX_SU4_IP, label: 'SU4']

                    servers.each { s ->
                        def ip = s.ip
                        def lbl = s.label

                        echo "\n=== ${lbl} (${ip}) ==="

                        sh "sshpass -p '${PWD}' ssh ${SSH} root@${ip} 'echo 1024 > /sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages || true'"
                        sh "sshpass -p '${PWD}' ssh ${SSH} root@${ip} 'pkill -9 t-rex-64 || true'"

                        sh """
                            sshpass -p '${PWD}' ssh ${SSH} root@${ip} '
                                cd ${TREX_DIR} &&
                                nohup ./t-rex-64 -i --no-scapy-server --no-ofed-check > trex.log 2>&1 < /dev/null &
                            '
                        """

                        echo "Started. Waiting up to 120s for port ${TREX_PORT}..."

                        def max = 12  // 120s
                        def att = 0
                        def open = false

                        while (att < max && !open) {
                            att++
                            sleep 10
                            def rc = sh(script: "nc -z -w 5 '${ip}' '${TREX_PORT}'", returnStatus: true)
                            if (rc == 0) {
                                open = true
                                echo "Port open after ~${att*10}s"
                            } else {
                                echo "Attempt ${att}/${max} — not yet..."
                            }
                        }

                        if (!open) {
                            echo "PORT FAILED AFTER 120s. Log tail:"
                            sh "sshpass -p '${PWD}' ssh ${SSH} root@${ip} 'tail -n 50 ${TREX_DIR}/trex.log || true'"
                            error "TRex not ready on ${ip}"
                        }

                        echo "${lbl} ready"
                    }
                }
            }
        }

        stage('Run test on BSU') {
            steps {
                script {
                    echo "\n=== Running test script on BSU ==="

                    sh "sshpass -p '${PWD}' scp ${SSH} ${SCRIPT_NAME} root@${params.TREX_BSU_IP}:${TREX_DIR}/"

                    def su_args = ""
                    if (params.TREX_SU_IP)  su_args += "--server-su ${params.TREX_SU_IP} "
                    if (params.TREX_SU2_IP) su_args += "--server-su2 ${params.TREX_SU2_IP} "
                    if (params.TREX_SU3_IP) su_args += "--server-su3 ${params.TREX_SU3_IP} "
                    if (params.TREX_SU4_IP) su_args += "--server-su4 ${params.TREX_SU4_IP} "

                    sh """
                        sshpass -p '${PWD}' ssh ${SSH} root@${params.TREX_BSU_IP} '
                            cd ${TREX_DIR} &&
                            ${PYTHONPATH_CMD} &&
                            nohup python3 ${SCRIPT_NAME} \
                                --server-bsu ${params.TREX_BSU_IP} \
                                ${su_args} \
                                --su ${params.SU_COUNT} \
                                --dl-bw ${params.DL_BW} \
                                --ul-bw ${params.UL_BW} \
                                --size ${params.PACKET_SIZE} \
                                --duration ${params.DURATION} \
                                --graph \
                                > test_run.log 2>&1 < /dev/null &
                        '
                    """

                    echo "Test running in background on ${params.TREX_BSU_IP}"
                    echo "Check: ssh root@${params.TREX_BSU_IP} ; tail -f /opt/v3.06/test_run.log"
                }
            }
        }
    }

    post {
        success {
            echo "\n=== ALL GOOD ===\nTest is running!"
        }
        failure {
            echo "\n=== FAILED ===\nLook at the log output above"
        }
    }
}