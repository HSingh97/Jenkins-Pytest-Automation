pipeline {
    agent {
        node {
            label params.TARGET_STAND
        }
    }

    parameters {
        string(name: 'TARGET_STAND',      defaultValue: 'test-puneet',      description: 'Jenkins node')
        string(name: 'TREX_BSU_IP',       defaultValue: '192.168.1.6',      description: 'TRex + BSU')
        string(name: 'TREX_SU_IP',        defaultValue: '',                 description: 'TRex SU 1 (4-7 SUs)')
        string(name: 'TREX_SU2_IP',       defaultValue: '',                 description: 'TRex SU 2 (8-11 SUs)')
        string(name: 'TREX_SU3_IP',       defaultValue: '',                 description: 'TRex SU 3 (12-15 SUs)')
        string(name: 'TREX_SU4_IP',       defaultValue: '',                 description: 'TRex SU 4 (16-19 SUs)')
        string(name: 'SU_COUNT',          defaultValue: '1',                description: 'Number of SUs')
        string(name: 'DL_BW',             defaultValue: '250M',             description: 'Downlink BW')
        string(name: 'UL_BW',             defaultValue: '250M',             description: 'Uplink BW')
        string(name: 'PACKET_SIZE',       defaultValue: '1500',             description: 'Packet size')
        string(name: 'DURATION',          defaultValue: '60',               description: 'Duration (0 = forever)')
        string(name: 'BSU_IP',            defaultValue: '192.168.2.10',     description: 'BSU IP')
        string(name: 'SU_IPS',            defaultValue: '192.168.2.11',     description: 'SU IPs, comma separated')
    }

    options {
        timestamps()
        timeout(time: 4, unit: 'HOURS')
        disableConcurrentBuilds()
    }

    environment {
        SSH             = '-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
        PWD             = 'ubuntu'
        TREX_DIR        = '/opt/v3.06'
        PORT            = '4501'
        WAIT_SEC        = '20'
    }

    stages {

        stage('Ping everything') {
            steps {
                script {
                    def trex_ips = [params.TREX_BSU_IP]
                    if (params.TREX_SU_IP)  trex_ips << params.TREX_SU_IP
                    if (params.TREX_SU2_IP) trex_ips << params.TREX_SU2_IP
                    if (params.TREX_SU3_IP) trex_ips << params.TREX_SU3_IP
                    if (params.TREX_SU4_IP) trex_ips << params.TREX_SU4_IP

                    trex_ips.unique().each { ip ->
                        sh "ping -c 3 '${ip}' || exit 1"
                    }

                    sh "ping -c 3 '${params.BSU_IP}' || exit 1"

                    if (params.SU_IPS?.trim()) {
                        params.SU_IPS.split(',').collect{it.trim()}.each { ip ->
                            sh "ping -c 3 '${ip}' || exit 1"
                        }
                    }
                }
            }
        }

        stage('Start each TRex server in separate SSH') {
            steps {
                script {
                    def servers = [
                        [ip: params.TREX_BSU_IP, label: 'BSU server']
                    ]
                    if (params.TREX_SU_IP)  servers << [ip: params.TREX_SU_IP,  label: 'SU 1']
                    if (params.TREX_SU2_IP) servers << [ip: params.TREX_SU2_IP, label: 'SU 2']
                    if (params.TREX_SU3_IP) servers << [ip: params.TREX_SU3_IP, label: 'SU 3']
                    if (params.TREX_SU4_IP) servers << [ip: params.TREX_SU4_IP, label: 'SU 4']

                    servers.each { s ->
                        echo "\n─────────────────────"
                        echo "Starting ${s.label} → ${s.ip}"
                        echo "─────────────────────"

                        // Hugepages
                        sh "sshpass -p '${PWD}' ssh ${SSH} root@${s.ip} 'echo 1024 > /sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages || true'"

                        // Kill old
                        sh "sshpass -p '${PWD}' ssh ${SSH} root@${s.ip} 'pkill -9 t-rex-64 || true'"

                        // Start in separate session (SSH exits immediately)
                        sh """
                            sshpass -p '${PWD}' ssh ${SSH} root@${s.ip} '
                                cd ${TREX_DIR}
                                nohup ./t-rex-64 -i --no-scapy-server --no-ofed-check > trex.log 2>&1 < /dev/null &
                                disown
                                exit
                            '
                        """

                        echo "Started → waiting ${WAIT_SEC}s..."
                        sleep WAIT_SEC.toInteger()

                        def port_ok = sh(script: "nc -z -w 5 '${s.ip}' '${PORT}'", returnStatus: true) == 0
                        if (!port_ok) {
                            sh "sshpass -p '${PWD}' ssh ${SSH} root@${s.ip} 'cat ${TREX_DIR}/trex.log || true'"
                            error "Port ${PORT} not open on ${s.ip}"
                        }

                        echo "OK → ${s.ip} running"
                    }
                }
            }
        }

        stage('Launch test script on BSU server (background)') {
            steps {
                script {
                    echo "\n─────────────────────"
                    echo "Launching test on BSU server ${params.TREX_BSU_IP}"
                    echo "─────────────────────"

                    // Copy script
                    sh "sshpass -p '${PWD}' scp ${SSH} master_script_extended_16SU.py root@${params.TREX_BSU_IP}:${TREX_DIR}/"

                    def su_args = ""
                    if (params.TREX_SU_IP)  su_args += "--server-su ${params.TREX_SU_IP} "
                    if (params.TREX_SU2_IP) su_args += "--server-su2 ${params.TREX_SU2_IP} "
                    if (params.TREX_SU3_IP) su_args += "--server-su3 ${params.TREX_SU3_IP} "
                    if (params.TREX_SU4_IP) su_args += "--server-su4 ${params.TREX_SU4_IP} "

                    def test_cmd = """
                        cd ${TREX_DIR}
                        ${env.PYTHONPATH_CMD}
                        nohup python3 master_script_extended_16SU.py \
                            --server-bsu ${params.TREX_BSU_IP} \
                            ${su_args} \
                            --su ${params.SU_COUNT} \
                            --dl-bw ${params.DL_BW} \
                            --ul-bw ${params.UL_BW} \
                            --size ${params.PACKET_SIZE} \
                            --duration ${params.DURATION} \
                            --graph \
                            > test_run.log 2>&1 < /dev/null &
                        disown
                        exit
                    """

                    sh "sshpass -p '${PWD}' ssh ${SSH} root@${params.TREX_BSU_IP} '${test_cmd}'"

                    echo "\nTest launched in background"
                    echo "Check manually:"
                    echo "  ssh root@${params.TREX_BSU_IP}"
                    echo "  tail -f /opt/v3.06/test_run.log"
                    echo "  ls /opt/v3.06/throughput_*.png"
                }
            }
        }
    }

    post {
        success {
            echo "\nDONE! Test is running on ${params.TREX_BSU_IP}"
        }
        failure {
            echo "\nFAILED - see which step above failed"
        }
    }
}