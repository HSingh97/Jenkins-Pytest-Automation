// ==================== MAIN PIPELINE ====================

def dateStamp = new Date().format("yyyyMMdd", TimeZone.getTimeZone("Asia/Kolkata"))
def reportFilename = "ptmp_channel_report_${env.BUILD_NUMBER}_${dateStamp}.html"

pipeline {
    agent { node { label "${TARGET_STAND}" } }

    environment {
        SSH_USER = 'root'
        SSH_PASS = 'admin'
    }

    stages {
        stage('Prepare') {
            steps {
                script {
                    echo "=== PTMP CHANNEL TEST ==="
                    echo "Stand: ${TARGET_STAND?:'N/A'} | BSU: ${params['Local IP Address']?:'N/A'} | SUs: ${params['Remote IP Addresses']?:'N/A'}"

                    if(!params['Local IP Address']?.trim()) error "❌ BSU IP required"
                    if(!params['Remote IP Addresses']?.trim()) error "❌ SU IPs required"

                    def suList = (params['Remote IP Addresses']?:'').split(',').collect{it?.trim()}.findAll{it && !it.isEmpty()}
                    env.SU_IP_COUNT = suList.size()
                    echo "✅ Testing ${env.SU_IP_COUNT} SU(s)"
                }
            }
        }

        stage('Dependencies') {
            steps {
                script {
                    sh "pip3.10 install -r utilities/requirements.txt --quiet 2>&1 || true"
                }
            }
        }

        stage('PTMP Testing') {
            steps {
                script {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                        def bsuIP = params['Local IP Address']?.trim() ?: '192.168.1.10'
                        def suIPs = params['Remote IP Addresses']?.trim() ?: '192.168.1.11'
                        def radio = params.Radio ?: 'Radio1'
                        def bws = (params.Bandwidth ?: 'HT20').split(',').collect{it?.trim() ?: 'HT20'}
                        def cts = (params.Countries ?: '5GHz').split(',').collect{it?.trim() ?: '5GHz'}
                        def snapTime = params['Snapshot Time']?.trim() ?: '30'
                        def randCh = params['Random Channels'] ?: '0'
                        def custCh = params['Custom Channels']?.trim() ?: ''

                        sh 'rm -f ptmp_*.json *_PTMP.json || true'
                        sh 'echo {"iterations":[]} > ptmp_channel_results.json'

                        def iterNum = 1

                        for(ct in cts){
                            echo "🌍 Country: ${ct}"
                            sh "pytest -v -s testCases/test_PTMPChannelConnectivity.py::test_ptmp_changecountry --local-ip '${bsuIP}' --remote-ip '${suIPs}' --radio '${radio}' --country '${ct}' 2>&1 || true"

                            for(bw in bws){
                                if((ct=="Canada" || ct=="US 5GHz Non-DFS") && bw=="HT160"){ echo "⚠ Skip HT160 for ${ct}"; continue }
                                echo "📡 ${ct} / ${bw}"
                                sh 'echo {"iterations":[]} > ptmp_channel_results.json'

                                // ✅ FIXED: Correct test function name + space before --local-ip
                                def cmd = "python3.10 -m pytest -v -s testCases/test_PTMPChannelConnectivity.py::test_ptmp_channelconnectivity --local-ip '${bsuIP}' --remote-ip '${suIPs}' --radio '${radio}' --bandwidth '${bw}' --country '${ct}' --extra '${randCh}' --sleep '${snapTime}' 2>&1"
                                if(custCh) cmd += " --channels '${custCh}'"

                                def out = ""
                                try{ out = sh(script:cmd, returnStdout:true)?.trim() ?: "" }
                                catch(Exception e){ echo "⚠️ ${e.message}"; out = "Error: ${e.message}" }

                                def res = [iterations:[]]
                                try{ res = readJSON file:'ptmp_channel_results.json' }
                                catch(Exception e){ echo "⚠️ JSON read: ${e.message}" }

                                def nBW = bw=="HT40" ? "HT40+" : bw
                                def matches = (res?.iterations?:[]).findAll{ t -> t?.Country==ct && t?.Bandwidth==nBW }

                                matches.each{ t ->
                                    if(t){ t.iteration=iterNum++; t.logs=out?:"No logs"; t.su_count=env.SU_IP_COUNT?.toInteger()?:0 }
                                }

                                def fname = "${ct.trim().replaceAll("\\s+","_")}_${bw.trim()}_PTMP.json"
                                writeJSON file:fname, json:[iterations:matches]
                                matches.each{ m -> if(m) echo "✅ Iter ${m.iteration}: ${m.status?:'N/A'}" }
                            }
                        }
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def files = []
                    try{ files = findFiles(glob:'*_PTMP.json')?.findAll{ f -> f?.name && f.name!='ptmp_channel_results.json' && f.length>20 }?:[] }
                    catch(Exception e){ echo "⚠️ Find files: ${e.message}" }

                    def results = []
                    files.each{ f ->
                        if(f?.name){
                            try{
                                def data = readJSON file:f.name
                                if(data?.iterations && !data.iterations.isEmpty()) results << [filename:f.name, content:data.iterations]
                            }catch(Exception e){ echo "⚠️ Parse ${f.name}: ${e.message}" }
                        }
                    }

                    def lIP = params['Local IP Address']?.trim() ?: '192.168.1.10'
                    def sIPs = (params['Remote IP Addresses']?:'').split(',').collect{it?.trim()}.findAll{it && !it.isEmpty()}

                    def lFW = _fetchFirmwareVersion(lIP, "BSU", env.SSH_USER, env.SSH_PASS)
                    def sFW = sIPs.collect{ ip -> _fetchFirmwareVersion(ip, "SU", env.SSH_USER, env.SSH_PASS) }.unique().join(" | ")

                    def paramsMap = [
                        "Test":"PTMP Channel","BSU IP":lIP,"SU IPs":params['Remote IP Addresses']?:'N/A',
                        "SUs":env.SU_IP_COUNT?:'N/A',"Radio":params.Radio?:'Radio1',
                        "Countries":params.Countries?:'5GHz',"Bandwidths":params.Bandwidth?:'HT20',
                        "FW":"${lFW} / ${sFW?:'N/A'}"
                    ]

                    def tz = TimeZone.getTimeZone("Asia/Kolkata")
                    def now = new Date().format("dd MMM yyyy, HH:mm:ss z", tz)
                    def logo = "https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png"

                    def html = _generatePTMPHTMLReport(paramsMap, results, now, logo, env.JOB_NAME?:'PTMP', reportFilename)
                    writeFile file:reportFilename, text:html
                    echo "📄 Report: ${reportFilename}"
                }
            }
        }
    }

    post {
        always {
            publishHTML(target:[allowMissing:false, alwaysLinkToLastBuild:true, keepAll:true, reportDir:'.', reportFiles:"${reportFilename}", reportName:"PTMP Report - Build ${env.BUILD_NUMBER}"])

            // ✅ FIXED: Use step() directly with correct ArtifactArchiver syntax
            step([$class: 'ArtifactArchiver', artifacts: '*_PTMP.json, ptmp_channel_results.json', fingerprint: true, onlyIfSuccessful: false, allowEmptyArchive: true])

            echo "✅ Done"
            script { _sendEmailNotification(reportFilename) }
        }
        success { echo "🎉 SUCCESS" }
        failure { echo "❌ FAILED" }
        unstable { echo "⚠️ UNSTABLE" }
    }
}