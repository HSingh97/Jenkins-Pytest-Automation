// ==================== MAIN PIPELINE BLOCK (ONLY ONE) ====================

def dateStamp = new Date().format("yyyyMMdd", TimeZone.getTimeZone("Asia/Kolkata"))
def reportFilename = "ptmp_channel_report_${env.BUILD_NUMBER}_${dateStamp}.html"

pipeline {
    agent { node { label "${TARGET_STAND}" } }

    environment {
        SSH_USER = 'root'
        SSH_PASS = 'admin'
        SNMP_COMMUNITY = 'ubr@rw123'
    }

    stages {
        stage('Prepare Environment') {
            steps {
                script {
                    echo "========================================"
                    echo "PTMP CHANNEL CONNECTIVITY TEST"
                    echo "========================================"
                    echo "Target Stand: ${TARGET_STAND ?: 'NOT SET'}"
                    echo "BSU IP: ${params['Local IP Address'] ?: 'NOT SET'}"
                    echo "SU IPs: ${params['Remote IP Addresses'] ?: 'NOT SET'}"

                    if (!params['Local IP Address']?.trim()) {
                        error "❌ BSU IP Address is required"
                    }
                    if (!params['Remote IP Addresses']?.trim()) {
                        error "❌ At least one SU IP Address is required"
                    }

                    def suIps = (params['Remote IP Addresses'] ?: '')
                        .split(',')
                        .collect{it?.trim()}
                        .findAll{it && !it.isEmpty()}

                    env.SU_IP_COUNT = suIps.size()
                    env.SU_IP_LIST = suIps.join(',')
                    echo "✅ Testing ${env.SU_IP_COUNT} SU(s)"
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    echo "Installing dependencies..."
                    sh "pip3.10 install -r utilities/requirements.txt --quiet 2>&1 || true"
                }
            }
        }

        stage('PTMP Channel Testing') {
            steps {
                script {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                        def bsuIP = params['Local IP Address']?.trim() ?: '192.168.1.10'
                        def suIPs = params['Remote IP Addresses']?.trim() ?: '192.168.1.11'
                        def selectedRadio = params.Radio ?: 'Radio1'
                        def bandwidths = (params.Bandwidth ?: 'HT20').split(',').collect{it?.trim() ?: 'HT20'}
                        def countries = (params.Countries ?: '5GHz').split(',').collect{it?.trim() ?: '5GHz'}
                        def snapshotTime = params['Snapshot Time']?.trim() ?: '30'
                        def randomChannels = params['Random Channels'] ?: '0'
                        def customChannels = params['Custom Channels']?.trim() ?: ''

                        sh 'rm -f ptmp_*.json *_PTMP.json || true'
                        sh 'echo {"iterations": []} > ptmp_channel_results.json'

                        def iteration = 1

                        for (country in countries) {
                            echo "\n🌍 Country: ${country}"

                            sh """
                                pytest -v -s testCases/test_PTMPChannelConnectivity.py::test_ptmp_changecountry \\
                                --local-ip '${bsuIP}' --remote-ip '${suIPs}' \\
                                --radio '${selectedRadio}' --country '${country}' 2>&1 || true
                            """

                            for (bandwidth in bandwidths) {
                                if ((country == "Canada" || country == "US 5GHz Non-DFS") && bandwidth == "HT160") {
                                    echo "⚠ Skipping HT160 for ${country}"
                                    continue
                                }

                                echo "📡 Testing: ${country} / ${bandwidth}"
                                sh 'echo {"iterations": []} > ptmp_channel_results.json'

                                def pytestCmd = """
                                    python3.10 -m pytest -v -s testCases/test_PTMPChannelConnectivity.py::test_ptmp_channelconnectivity \\
                                    --local-ip '${bsuIP}' --remote-ip '${suIPs}' --radio '${selectedRadio}' \\
                                    --bandwidth '${bandwidth}' --country '${country}' \\
                                    --extra '${randomChannels}' --sleep '${snapshotTime}' 2>&1
                                """
                                if (customChannels) { pytestCmd += " --channels '${customChannels}'" }

                                def pytestOutput = ""
                                try {
                                    pytestOutput = sh(script: pytestCmd, returnStdout: true)
                                    pytestOutput = pytestOutput?.trim() ?: ""
                                } catch (Exception e) {
                                    echo "⚠️ Pytest warning: ${e.message}"
                                    pytestOutput = "Interrupted: ${e.message}"
                                }

                                def iterationResults = [iterations: []]
                                try {
                                    iterationResults = readJSON file: 'ptmp_channel_results.json'
                                } catch (Exception e) {
                                    echo "⚠️ Could not read JSON: ${e.message}"
                                }

                                def normalizedBW = bandwidth == "HT40" ? "HT40+" : bandwidth
                                def newTests = (iterationResults?.iterations ?: [])
                                    .findAll { it?.Country == country && it?.Bandwidth == normalizedBW }

                                newTests.each { test ->
                                    if (test) {
                                        test.iteration = iteration++
                                        test.logs = pytestOutput ?: "No logs"
                                        test.su_count = env.SU_IP_COUNT?.toInteger() ?: 0
                                    }
                                }

                                def filename = "${country.trim().replaceAll("\\s+", "_")}_${bandwidth.trim()}_PTMP.json"
                                writeJSON file: filename, json: [iterations: newTests]

                                newTests.each { it ->
                                    if (it) {
                                        echo "✅ Iter ${it.iteration}: ${it.status ?: 'N/A'} | ${it['Tested Channels']?.size() ?: 0} channels"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Generate PTMP HTML Report') {
            steps {
                script {
                    def reportFiles = []
                    try {
                        reportFiles = findFiles(glob: '*_PTMP.json')?.findAll {
                            it?.name && it.name != 'ptmp_channel_results.json' && it.length > 20
                        } ?: []
                    } catch (Exception e) {
                        echo "⚠️ Could not find report files: ${e.message}"
                    }

                    def allResults = []
                    reportFiles.each { file ->
                        if (file?.name) {
                            try {
                                def data = readJSON file: file.name
                                if (data?.iterations && !data.iterations.isEmpty()) {
                                    allResults << [filename: file.name, content: data.iterations]
                                }
                            } catch (Exception e) {
                                echo "⚠️ Could not parse ${file.name}: ${e.message}"
                            }
                        }
                    }

                    def localIP = params['Local IP Address']?.trim() ?: '192.168.1.10'
                    def suIPs = (params['Remote IP Addresses'] ?: '').split(',').collect{it?.trim()}.findAll{it && !it.isEmpty()}

                    def local_fw = _fetchFirmwareVersion(localIP, "BSU", env.SSH_USER, env.SSH_PASS)
                    def su_fw_list = suIPs.collect { ip -> _fetchFirmwareVersion(ip, "SU", env.SSH_USER, env.SSH_PASS) }.unique().join(" | ")

                    def buildParams = [
                        "Test Type": "PTMP Channel Connectivity",
                        "BSU IP": localIP,
                        "SU IPs": params['Remote IP Addresses'] ?: 'N/A',
                        "SU Count": env.SU_IP_COUNT ?: 'N/A',
                        "Radio": params.Radio ?: 'Radio1',
                        "Countries": params.Countries ?: '5GHz',
                        "Bandwidths": params.Bandwidth ?: 'HT20',
                        "FW (BSU/SUs)": "${local_fw} / ${su_fw_list ?: 'N/A'}"
                    ]

                    def istZone = TimeZone.getTimeZone("Asia/Kolkata")
                    def currentDateTime = new Date().format("dd MMM yyyy, HH:mm:ss z", istZone)
                    def logoUrl = "https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png"

                    def html = _generatePTMPHTMLReport(
                        buildParams, allResults, currentDateTime, logoUrl, env.JOB_NAME ?: 'PTMP-Test', reportFilename
                    )

                    writeFile file: reportFilename, text: html
                    echo "📄 Report generated: ${reportFilename}"
                }
            }
        }
    }

    post {
        always {
            publishHTML(target: [
                allowMissing: false, alwaysLinkToLastBuild: true, keepAll: true,
                reportDir: '.', reportFiles: "${reportFilename}",
                reportName: "PTMP Report - Build ${env.BUILD_NUMBER}"
            ])
            archiveArtifacts artifacts: '*_PTMP.json, ptmp_channel_results.json', allowEmptyArchive: true
            echo "✅ Pipeline completed"

            script {
                _sendEmailNotification(reportFilename)
            }
        }
        success { echo "🎉 SUCCESS" }
        failure { echo "❌ FAILED" }
        unstable { echo "⚠️ UNSTABLE" }
    }
}