def archiveArtifacts(pattern) {
    step([$class: 'ArtifactArchiver', artifacts: pattern, fingerprint: true, onlyIfSuccessful: false, allowEmptyArchive: true])
}

def _fetchFirmwareVersion(ip, label, sshUser, sshPass) {
    try {
        sh "ssh-keygen -R ${ip} 2>/dev/null || true"
        return sh(
            script: "sshpass -p '${sshPass}' ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 ${sshUser}@${ip} 'cat /etc/version 2>/dev/null || echo N/A'",
            returnStdout: true
        )?.trim() ?: "N/A"
    } catch (Exception e) {
        echo "⚠️ Failed to get FW from ${label} (${ip}): ${e.message}"
        return "N/A (unreachable)"
    }
}

def _generatePTMPHTMLReport(buildParams, allResults, currentDateTime, companyLogoUrl, pipelineName, reportFilename) {
    def html = """
        <!DOCTYPE html><html><head><title>PTMP Report</title><style>
        body{font-family:Segoe UI;padding:20px;background:#f8f9fa}
        .header{display:flex;justify-content:space-between;background:white;padding:20px;border-radius:8px;margin-bottom:30px}
        .header img{height:60px}.status-pass{color:#22c55e;font-weight:bold}
        .status-fail{color:#ef4444;font-weight:bold}.status-partial{color:#f59e0b;font-weight:bold}
        table{width:100%;border-collapse:collapse;margin:15px 0;background:white}
        th,td{padding:10px;border:1px solid #e2e8f0;text-align:left}
        th{background:#1a365d;color:white}tr:nth-child(even){background:#f8fafc}
        </style></head><body>
        <div class="header"><img src="${companyLogoUrl}"/>
        <div><h1>PTMP Channel Report</h1><p>Pipeline: ${pipelineName}</p><p>Generated: ${currentDateTime}</p></div></div>
        <h2>Configuration</h2><table>
        ${buildParams.collect{"<tr><td><b>${it.key}</b></td><td>${it.value?:'N/A'}</td></tr>"}.join('\n')}
        </table><h2>Summary</h2>
    """

    def total = allResults?.sum{it?.content?.size()?:0}?:0
    def passC = allResults?.sum{it?.content?.count{it?.status=='PASS'}?:0}?:0
    def failC = allResults?.sum{it?.content?.count{it?.status=='FAIL'}?:0}?:0

    html += "<p>Total: ${total} | Pass: <span class='status-pass'>${passC}</span> | Fail: <span class='status-fail'>${failC}</span></p>"

    if(allResults){
        allResults.each{ rf ->
            if(!rf?.filename)return
            def parts = rf.filename.replace('.json','').split('_')
            def bw = parts?.last()?:'Unknown'
            def ct = parts?.take(parts.size()-1)?.join(' ')?:'Unknown'

            if(rf?.content){
                rf.content.each{ iter ->
                    if(!iter)return
                    def st = iter.status?:'UNKNOWN'
                    def cls = st=='PASS'?'status-pass':(st=='FAIL'?'status-fail':'status-partial')
                    html += "<h3>${ct} | ${bw} | Iter #${iter.iteration?:'N/A'} <span class='${cls}'>${st}</span></h3><table><tr><th>Channel</th><th>Status</th><th>Frequency</th><th>SUs</th></tr>"

                    if(iter['Tested Channels']){
                        iter['Tested Channels'].each{ ch ->
                            if(!ch)return
                            def cs = ch.status?:'N/A'
                            def ccls = cs=='PASS'?'status-pass':(cs=='FAIL'?'status-fail':'status-partial')
                            def sus = ch.su_results?.collect{ s -> (s?.su_ip?:'N/A') + ':' + (s?.status=='PASS'?'✓':'✗') }?.join(', ')?:'N/A'
                            html += "<tr><td><b>${ch.channel?:'N/A'}</b></td><td class='${ccls}'>${cs}</td><td>${ch.frequency_mhz?:'N/A'}MHz</td><td>${sus}</td></tr>"
                        }
                    }
                    html += "</table>"
                }
            }
        }
    }
    html += "<p style='margin-top:40px;text-align:center;color:#666'>Build #${env.BUILD_NUMBER} | <a href='${env.BUILD_URL}'>View</a></p></body></html>"
    return html
}

