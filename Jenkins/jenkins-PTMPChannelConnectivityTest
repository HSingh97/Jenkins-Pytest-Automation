                table { width: 100%; border-collapse: collapse; margin: 15px 0; background: white; box-shadow: 0 2px 5px rgba(0,0,0,0.05); border-radius: 6px; overflow: hidden; }
                th, td { padding: 10px 12px; border: 1px solid #e2e8f0; text-align: left; vertical-align: middle; font-size: 13px; }
                th { background: #1a365d; color: white; font-weight: 600; }
                tr:nth-child(even) { background: #f8fafc; }
                tr:hover { background: #edf2f7; }
                .status-pass { color: #22c55e; font-weight: bold; }
                .status-fail { color: #ef4444; font-weight: bold; }
                .status-partial { color: #f59e0b; font-weight: bold; }
                .su-table { margin-left: 20px; margin-top: 8px; font-size: 12px; }
                .su-table th { background: #4a5568; font-size: 11px; }
                .channel-header { background: #e0e7ff !important; font-weight: 600; }
                .summary-card { background: white; padding: 15px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin: 10px 0; }
                .summary-stats { display: flex; gap: 20px; flex-wrap: wrap; }
                .stat-item { text-align: center; }
                .stat-value { font-size: 24px; font-weight: bold; color: #1a365d; }
                .stat-label { font-size: 12px; color: #64748b; }
                @media print { body { background: white; } .no-print { display: none; } }
            </style>
        </head>
        <body>
            <div class="header">
                <img src="${companyLogoUrl}" alt="Logo"/>
                <div class="header-info">
                    <h1>PTMP Channel Connectivity Report</h1>
                    <p><strong>Pipeline:</strong> ${pipelineName}</p>
                    <p><strong>Generated:</strong> ${currentDateTime}</p>
                    <p><span class="topology-badge">1 BSU + ${buildParams['SU Count']} SUs</span></p>
                </div>
            </div>

            <h2>📋 Test Configuration</h2>
            <table class="build-params">
                ${buildParams.collect { "<tr><td width='30%'><b>${it.key}</b></td><td>${it.value ?: 'N/A'}</td></tr>" }.join('\n')}
            </table>
    """

    // Summary section
    def totalTests = allResults?.sum { it?.content?.size() ?: 0 } ?: 0
    def passCount = allResults?.sum { it?.content?.count { it?.status == 'PASS' } ?: 0 } ?: 0
    def failCount = allResults?.sum { it?.content?.count { it?.status == 'FAIL' } ?: 0 } ?: 0
    def partialCount = totalTests - passCount - failCount

    html += """
            <h2>📊 Test Summary</h2>
            <div class="summary-card">
                <div class="summary-stats">
                    <div class="stat-item">
                        <div class="stat-value">${totalTests}</div>
                        <div class="stat-label">Total Combinations</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value status-pass">${passCount}</div>
                        <div class="stat-label">Passed</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value status-fail">${failCount}</div>
                        <div class="stat-label">Failed</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value status-partial">${partialCount}</div>
                        <div class="stat-label">Partial</div>
                    </div>
                </div>
            </div>
    """

    // Detailed results
    if (allResults) {
        allResults.each { resultFile ->
            if (!resultFile?.filename) return

            def parts = resultFile.filename.replace('.json','').split('_')
            def bandwidth = parts?.last() ?: 'Unknown'
            def country = parts?.take(parts.size()-1)?.join(' ')?.replace('_PTMP','')?.replaceAll('_', ' ') ?: 'Unknown'

            if (resultFile?.content) {
                resultFile.content.each { iteration ->
                    if (!iteration) return

                    def iterationStatus = iteration.status ?: 'UNKNOWN'
                    def statusClass = iterationStatus == "PASS" ? "status-pass" :
                                     (iterationStatus == "FAIL" ? "status-fail" : "status-partial")

                    html += """
                        <h2>🌍 ${country} | 📡 ${bandwidth} | Iteration #${iteration.iteration ?: 'N/A'}</h2>
                        <div class="summary-card">
                            <p><strong>Overall Status:</strong> <span class="${statusClass}">${iterationStatus}</span> |
                               <strong>Channels Tested:</strong> ${iteration['Tested Channels']?.size() ?: 0} |
                               <strong>SUs:</strong> ${iteration.su_count ?: 'N/A'}</p>
                        </div>

                        <table>
                            <tr class="channel-header">
                                <th>Channel</th>
                                <th>Status</th>
                                <th>Frequency</th>
                                <th>BSU Verified</th>
                                <th>SU Results Summary</th>
                                <th>Timestamp</th>
                            </tr>
                    """

                    if (iteration['Tested Channels']) {
                        iteration['Tested Channels'].each { channel ->
                            if (!channel) return

                            def chStatus = channel.status ?: 'N/A'
                            def chStatusClass = chStatus == "PASS" ? "status-pass" :
                                               (chStatus == "FAIL" ? "status-fail" : "status-partial")

                            def suSummary = channel.su_results?.collect { su ->
                                if (!su) return "N/A"
                                def suStatus = su.status == "PASS" ? "✓" : "✗"
                                return "${su.su_ip ?: 'N/A'}: ${suStatus}"
                            }?.findAll{it}?.join('<br/>') ?: "N/A"

                            html += """
                                <tr>
                                    <td><b>${channel.channel ?: 'N/A'}</b></td>
                                    <td class="${chStatusClass}">${chStatus}</td>
                                    <td>${channel.frequency_mhz ?: 'N/A'} MHz</td>
                                    <td>${channel.bsu_verified ? '✓ Yes' : '✗ No'}</td>
                                    <td><div style="max-height:80px;overflow-y:auto;font-size:11px">${suSummary}</div></td>
                                    <td style="font-size:11px">${channel.timestamp?.split('T')?.get(1)?.tokenize('.')?.get(0) ?: channel.timestamp ?: '-'}</td>
                                </tr>
                            """

                            // SU details table
                            html += """
                                <tr>
                                    <td colspan="6" style="padding:0;background:#f8fafc">
                                        <table class="su-table">
                                            <tr>
                                                <th>SU IP</th>
                                                <th>Status</th>
                                                <th>SNR (L/R)</th>
                                                <th>Signal (L/R)</th>
                                                <th>Noise (L/R)</th>
                                                <th>Tx/Rx Rate</th>
                                                <th>Uptime</th>
                                                <th>Notes</th>
                                            </tr>
                            """

                            if (channel.su_results) {
                                channel.su_results.each { su ->
                                    if (!su) return
                                    def suStatusClass = su.status == "PASS" ? "status-pass" : "status-fail"
                                    html += """
                                        <tr>
                                            <td><b>${su.su_ip ?: 'N/A'}</b></td>
                                            <td class="${suStatusClass}">${su.status ?: 'N/A'}</td>
                                            <td>${su.local_snr ?: '-'} / ${su.remote_snr ?: '-'}</td>
                                            <td>${su.local_signal ?: '-'} / ${su.remote_signal ?: '-'} dBm</td>
                                            <td>${su.local_noise ?: '-'} / ${su.remote_noise ?: '-'} dBm</td>
                                            <td>${su.tx_rate ?: '-'} / ${su.rx_rate ?: '-'} Mbps</td>
                                            <td>${su.link_uptime ?: '-'}</td>
                                            <td style="font-size:11px;color:#64748b">${su.notes ?: '-'}</td>
                                        </tr>
                                    """
                                }
                            }

                            html += """
                                        </table>
                                    </td>
                                </tr>
                            """
                        }
                    }

                    html += "</table>"
                }
            }
        }
    }

    // Collapsible logs section
    html += """
            <h2 class="no-print">📜 Console Logs (Click to Expand)</h2>
            <details class="no-print">
                <summary style="cursor:pointer;color:#667eea;font-weight:600">View Test Execution Logs</summary>
                <pre style="background:#1e293b;color:#e2e8f0;padding:15px;border-radius:6px;overflow-x:auto;font-size:11px;margin-top:10px">
    """

    if (allResults) {
        allResults.each { resultFile ->
            if (resultFile?.content) {
                resultFile.content.each { iteration ->
                    if (iteration?.logs) {
                        html += "\n<!-- Iteration ${iteration.iteration} - ${iteration.Country} ${iteration.Bandwidth} -->\n"
                        html += iteration.logs.replaceAll('<', '&lt;').replaceAll('>', '&gt;')
                        html += "\n${'='*80}\n\n"
                    }
                }
            }
        }
    }

    html += """
                </pre>
            </details>

            <div style="margin-top:40px;text-align:center;color:#94a3b8;font-size:12px">
                <p>Report generated by Jenkins PTMP Channel Connectivity Pipeline</p>
                <p>Build #${env.BUILD_NUMBER} | <a href="${env.BUILD_URL}">View Build</a></p>
            </div>
        </body>
        </html>
    """

    return html
}

