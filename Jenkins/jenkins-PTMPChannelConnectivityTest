                            if (countryResult != 0) {
                                echo "⚠️ Country change test returned status: ${countryResult}"
                            }

                            for (bandwidth in bandwidths) {
                                // Skip unsupported combinations
                                if ((country == "Canada" || country == "US 5GHz Non-DFS") && bandwidth == "HT160") {
                                    echo "⚠ Skipping HT160 for ${country} (regulatory restriction)"
                                    continue
                                }

                                echo "\n${'-'*60}"
                                echo "📡 Testing: Country=${country}, Bandwidth=${bandwidth}"
                                echo "${'-'*60}"

                                // Reset results file for this test combination
                                sh 'echo {"iterations": []} > ptmp_channel_results.json'

                                // Build pytest command
                                def pytestCmd = """
                                    python3.10 -m pytest -v -s testCases/test_PTMPChannelConnectivity.py::test_ptmp_channelconnectivity \\
                                    --local-ip '${bsuIP}' \\
                                    --remote-ip '${suIPs}' \\
                                    --radio '${selectedRadio}' \\
                                    --bandwidth '${bandwidth}' \\
                                    --country '${country}' \\
                                    --extra '${randomChannels}' \\
                                    --sleep '${snapshotTime}' \\
                                    2>&1
                                """

                                // Add custom channels if specified
                                if (customChannels) {
                                    pytestCmd += " --channels '${customChannels}'"
                                }

                                // Execute test with null-safe output handling
                                def pytestOutput = ""
                                try {
                                    pytestOutput = sh(script: pytestCmd, returnStdout: true)
                                    // Safe trim with null check
                                    pytestOutput = pytestOutput?.trim() ?: ""
                                } catch (Exception e) {
                                    echo "⚠️ Pytest execution warning: ${e.message}"
                                    pytestOutput = "Pytest execution interrupted: ${e.message}"
                                }

                                echo "Pytest Output (first 500 chars):\n${pytestOutput?.take(500) ?: 'N/A'}..."

                                // Read and process results with null safety
                                def iterationResults = null
                                try {
                                    iterationResults = readJSON file: 'ptmp_channel_results.json'
                                } catch (Exception e) {
                                    echo "⚠️ Could not read ptmp_channel_results.json: ${e.message}"
                                    iterationResults = [iterations: []]
                                }

                                def normalizedBW = bandwidth == "HT40" ? "HT40+" : bandwidth

                                def newTests = []
                                if (iterationResults?.iterations) {
                                    newTests = iterationResults.iterations.findAll {
                                        it?.Country == country && it?.Bandwidth == normalizedBW
                                    } ?: []
                                }

                                // Add iteration metadata
                                newTests.each { test ->
                                    if (test) {
                                        test.iteration = iteration++
                                        test.logs = pytestOutput ?: "No logs captured"
                                        test.su_count = env.SU_IP_COUNT?.toInteger() ?: 0
                                    }
                                }

                                // Save per-combination JSON
                                def filename = "${country.trim().replaceAll("\\s+", "_")}_${bandwidth.trim()}_PTMP.json"
                                writeJSON file: filename, json: [iterations: newTests]

                                // Log summary
                                newTests.each { it ->
                                    if (it) {
                                        echo "✅ Iteration ${it.iteration} - ${it.test ?: 'N/A'} => ${it.status ?: 'UNKNOWN'}"
                                        echo "   SUs: ${it.su_count ?: 'N/A'}, Channels Tested: ${it['Tested Channels']?.size() ?: 0}"
                                        it['Tested Channels']?.each { ch ->
                                            if (ch) {
                                                def suPass = ch.su_results?.count{su -> su?.status == 'PASS'} ?: 0
                                                def suTotal = ch.su_results?.size() ?: 0
                                                echo "   - Channel ${ch.channel ?: 'N/A'}: ${ch.status ?: 'N/A'} (${suPass}/${suTotal} SUs PASS)"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    } // catchError
                }
            }
        }

        stage('Generate PTMP HTML Report') {
            steps {
                script {
                    // Find all PTMP result files with null safety
                    def reportFiles = []
                    try {
                        reportFiles = findFiles(glob: '*_PTMP.json')?.findAll {
                            it?.name && it.name != 'ptmp_channel_results.json' && it.length > 20
                        } ?: []
                    } catch (Exception e) {
                        echo "⚠️ Could not find report files: ${e.message}"
                    }

                    def allResults = []
                    reportFiles.each { file ->
                        if (file?.name) {
                            try {
                                def data = readJSON file: file.name
                                if (data?.iterations && !data.iterations.isEmpty()) {
                                    allResults << [filename: file.name, content: data.iterations]
                                }
                            } catch (Exception e) {
                                echo "⚠️ Could not parse ${file.name}: ${e.message}"
                            }
                        }
                    }

                    // Fetch firmware versions - USING YOUR SUGGESTED PATTERN
                    def localIP = params['Local IP Address']?.trim() ?: '192.168.1.10'
                    def suIPs = (params['Remote IP Addresses'] ?: '')
                        .split(',')
                        .collect{it?.trim()}
                        .findAll{it && !it.isEmpty()}

                    // Clear old SSH keys to avoid host key conflicts
                    sh "ssh-keygen -R ${localIP} 2>/dev/null || true"
                    suIPs.each { ip -> sh "ssh-keygen -R ${ip} 2>/dev/null || true" }

                    // Fetch BSU firmware version
                    def local_fw_version = "N/A"
                    try {
                        local_fw_version = sh(
                            script: "sshpass -p '${SSH_PASS}' ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 ${SSH_USER}@${localIP} 'cat /etc/version 2>/dev/null || echo N/A'",
                            returnStdout: true
                        )?.trim() ?: "N/A"
                    } catch (Exception e) {
                        echo "⚠️ Failed to get BSU FW version from ${localIP}: ${e.message}"
                        local_fw_version = "N/A (unreachable)"
                    }

                    // Fetch SU firmware versions
                    def su_fw_map = [:]
                    suIPs.each { ip ->
                        try {
                            def fw = sh(
                                script: "sshpass -p '${SSH_PASS}' ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 ${SSH_USER}@${ip} 'cat /etc/version 2>/dev/null || echo N/A'",
                                returnStdout: true
                            )?.trim() ?: "N/A"
                            su_fw_map[ip] = fw
                        } catch (Exception e) {
                            echo "⚠️ Failed to get FW from SU ${ip}: ${e.message}"
                            su_fw_map[ip] = "N/A"
                        }
                    }
                    def su_fw_versions = su_fw_map.values().unique().join(" | ")

                    // Build report parameters
                    def buildParams = [
                        "Test Type"       : "PTMP Channel Connectivity",
                        "BSU IP Address"  : localIP,
                        "SU IP Addresses" : params['Remote IP Addresses'] ?: 'N/A',
                        "SU Count"        : env.SU_IP_COUNT ?: 'N/A',
                        "Radio"           : params.Radio ?: 'Radio1',
                        "Countries"       : params.Countries ?: '5GHz',
                        "Bandwidths"      : params.Bandwidth ?: 'HT20',
                        "Snapshot Delay"  : "${params['Snapshot Time'] ?: '30'} seconds",
                        "FW Version (BSU)": local_fw_version,
                        "FW Versions (SUs)": su_fw_versions ?: 'N/A'
                    ]

                    def istZone = TimeZone.getTimeZone("Asia/Kolkata")
                    def currentDateTime = new Date().format("dd MMM yyyy, HH:mm:ss z", istZone)
                    def companyLogoUrl = "https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png"
                    def pipelineName = env.JOB_NAME ?: 'PTMP-Channel-Test'

                    // Generate HTML report
                    def htmlContent = _generatePTMPHTMLReport(
                        buildParams, allResults, currentDateTime,
                        companyLogoUrl, pipelineName, reportFilename
                    )

                    writeFile file: reportFilename, text: htmlContent
                    echo "📄 PTMP HTML report generated: ${reportFilename}"
                }
            }
        }
    }

    post {
        always {
            // Publish HTML report
            publishHTML(target: [
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: '.',
                reportFiles: "${reportFilename}",
                reportName: "PTMP Channel Test Report - Build ${env.BUILD_NUMBER}"
            ])

            // Archive JSON results
            archiveArtifacts artifacts: '*_PTMP.json, ptmp_channel_results.json', allowEmptyArchive: true

            echo "✅ PTMP Test Pipeline Completed"

            // Email notification
            script {
                _sendEmailNotification(reportFilename)
            }
        }
        success {
            echo "🎉 PTMP Test SUCCESS"
        }
        failure {
            echo "❌ PTMP Test FAILED - Check console output"
        }
        unstable {
            echo "⚠️ PTMP Test UNSTABLE - Partial failures detected"
        }
    }
}

