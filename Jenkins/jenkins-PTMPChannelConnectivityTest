def _fetchFirmwareVersion(ip, label) {
    try {
        return sh(
            script: """
                ssh-keygen -R ${ip} >/dev/null 2>&1 || true
                ssh-keyscan -H ${ip} >> ~/.ssh/known_hosts 2>/dev/null
                sshpass -p 'admin' ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 root@${ip} 'cat /etc/version 2>/dev/null || echo "N/A"'
            """,
            returnStdout: true
        ).trim() ?: "N/A"
    } catch (e) {
        echo "⚠️ Could not fetch firmware from ${label} (${ip}): ${e.message}"
        return "N/A (unreachable)"
    }
}

