def dateStamp = new Date().format("yyyyMMdd", TimeZone.getTimeZone("Asia/Kolkata"))
def reportFilename = "ptmp_channel_report_${env.BUILD_NUMBER}_${dateStamp}.html"

pipeline {
    agent { node { label "${TARGET_STAND}" } }

    stages {
        stage('Prepare Environment') {
            steps {
                script {
                    echo "========================================"
                    echo "PTMP CHANNEL CONNECTIVITY TEST"
                    echo "========================================"
                    echo "Target Stand: ${TARGET_STAND}"
                    echo "BSU IP: ${params['Local IP Address']}"
                    echo "SU IPs: ${params['Remote IP Addresses']}"
                    echo "Radio: ${params.Radio}"
                    echo "Bandwidths: ${params.Bandwidth}"
                    echo "Countries: ${params.Countries}"
                    echo "========================================"

                    // Parse and validate SU IPs
                    def suIps = params['Remote IP Addresses']?.split(',')?.collect{it.trim()}?.findAll{it} ?: []
                    env.SU_IP_COUNT = suIps.size()
                    echo "Number of SUs to test: ${env.SU_IP_COUNT}"

                    // Validate required parameters
                    if (!params['Local IP Address'] || !params['Remote IP Addresses']) {
                        error "❌ Missing required parameters: Local IP Address or Remote IP Addresses"
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    echo "Installing Python dependencies..."
                    sh "pip3.10 install -r utilities/requirements.txt --quiet" || true
                }
            }
        }

        stage('PTMP Channel Testing') {
            steps {
                script {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                        def bsuIP = params['Local IP Address']
                        def suIPs = params['Remote IP Addresses']
                        def selectedRadio = params.Radio ?: 'Radio1'
                        def bandwidths = (params.Bandwidth ?: 'HT20').split(',')
                        def countries = (params.Countries ?: '5GHz').split(',')
                        def snapshotTime = params['Snapshot Time'] ?: '30'
                        def randomChannels = params['Random Channels'] ?: '0'
                        def customChannels = params['Custom Channels'] ?: ''

                        // Clear previous results
                        sh 'rm -f ptmp_*.json *_PTMP.json'
                        echo "✅ Cleaned workspace"

                        // Initialize results file
                        sh 'echo {"iterations": []} > ptmp_channel_results.json'

                        def iteration = 1

                        for (country in countries) {
                            echo "\n${'='*60}"
                            echo "🌍 Configuring Country: ${country}"
                            echo "${'='*60}"

                            // Change country on all devices
                            sh """
                                pytest -v -s testCases/test_PTMPChannelConnectivity.py::test_ptmp_changecountry \\
                                --local-ip '${bsuIP}' --remote-ip '${suIPs}' \\
                                --radio '${selectedRadio}' --country '${country}' 2>&1
                            """

                            for (bandwidth in bandwidths) {
                                // Skip unsupported combinations
                                if ((country == "Canada" || country == "US 5GHz Non-DFS") && bandwidth == "HT160") {
                                    echo "⚠ Skipping HT160 for ${country} (regulatory restriction)"
                                    continue
                                }

                                echo "\n${'-'*60}"
                                echo "📡 Testing: Country=${country}, Bandwidth=${bandwidth}"
                                echo "${'-'*60}"

                                // Reset results file for this test combination
                                sh 'echo {"iterations": []} > ptmp_channel_results.json'

                                // Build pytest command
                                def pytestCmd = """
                                    python3.10 -m pytest -v -s testCases/test_PTMPChannelConnectivity.py::test_ptmp_channelconnectivity \\
                                    --local-ip '${bsuIP}' \\
                                    --remote-ip '${suIPs}' \\
                                    --radio '${selectedRadio}' \\
                                    --bandwidth '${bandwidth}' \\
                                    --country '${country}' \\
                                    --extra '${randomChannels}' \\
                                    --sleep '${snapshotTime}' \\
                                    2>&1
                                """

                                // Add custom channels if specified
                                if (customChannels?.trim()) {
                                    pytestCmd += " --channels '${customChannels}'"
                                }

                                // Execute test
                                def pytestOutput = sh(script: pytestCmd, returnStdout: true).trim()
                                echo "Pytest Output:\n${pytestOutput}"

                                // Read and process results
                                def iterationResults = readJSON file: 'ptmp_channel_results.json'
                                def normalizedBW = bandwidth == "HT40" ? "HT40+" : bandwidth

                                def newTests = iterationResults.iterations.findAll {
                                    it.Country == country && it.Bandwidth == normalizedBW
                                }

                                // Add iteration metadata
                                newTests.each { test ->
                                    test.iteration = iteration++
                                    test.logs = pytestOutput
                                    test.su_count = env.SU_IP_COUNT.toInteger()
                                }

                                // Save per-combination JSON
                                def filename = "${country.trim().replaceAll("\\s+", "_")}_${bandwidth.trim()}_PTMP.json"
                                writeJSON file: filename, json: [iterations: newTests]

                                // Log summary
                                newTests.each {
                                    echo "✅ Iteration ${it.iteration} - ${it.test} => ${it.status}"
                                    echo "   SUs: ${it.su_count}, Channels Tested: ${it.Tested_Channels?.size() ?: 0}"
                                    it['Tested Channels']?.each { ch ->
                                        def suPass = ch.su_results?.count{it.status=='PASS'} ?: 0
                                        def suTotal = ch.su_results?.size() ?: 0
                                        echo "   - Channel ${ch.channel}: ${ch.status} (${suPass}/${suTotal} SUs PASS)"
                                    }
                                }
                            }
                        }
                    } // catchError
                }
            }
        }

        stage('Generate PTMP HTML Report') {
            steps {
                script {
                    // Find all PTMP result files
                    def reportFiles = findFiles(glob: '*_PTMP.json').findAll {
                        it.name != 'ptmp_channel_results.json' && it.length > 20
                    }

                    def allResults = []
                    reportFiles.each { file ->
                        def data = readJSON file: file.name
                        if (data?.iterations && !data.iterations.isEmpty()) {
                            allResults << [filename: file.name, content: data.iterations]
                        }
                    }

                    // Fetch firmware versions
                    def localIP = params['Local IP Address']
                    def suIPs = params['Remote IP Addresses']?.split(',')?.collect{it.trim()} ?: []

                    def local_fw_version = _fetchFirmwareVersion(localIP, "BSU")
                    def su_fw_versions = suIPs.collectEntries { ip ->
                        [(ip): _fetchFirmwareVersion(ip, "SU-${ip.tokenize('.')[-1]}")]
                    }

                    // Build report parameters
                    def buildParams = [
                        "Test Type"       : "PTMP Channel Connectivity",
                        "BSU IP Address"  : localIP,
                        "SU IP Addresses" : params['Remote IP Addresses'],
                        "SU Count"        : env.SU_IP_COUNT,
                        "Radio"           : params.Radio ?: 'Radio1',
                        "Countries"       : params.Countries ?: '5GHz',
                        "Bandwidths"      : params.Bandwidth ?: 'HT20',
                        "Snapshot Delay"  : "${params['Snapshot Time'] ?: '30'} seconds",
                        "FW Version (BSU)": local_fw_version,
                        "FW Versions (SUs)": su_fw_versions.values().join(" | ")
                    ]

                    def istZone = TimeZone.getTimeZone("Asia/Kolkata")
                    def currentDateTime = new Date().format("dd MMM yyyy, HH:mm:ss z", istZone)
                    def companyLogoUrl = "https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png"
                    def pipelineName = env.JOB_NAME

                    // Generate HTML report
                    def htmlContent = _generatePTMPHTMLReport(
                        buildParams, allResults, currentDateTime,
                        companyLogoUrl, pipelineName, reportFilename
                    )

                    writeFile file: reportFilename, text: htmlContent
                    echo "📄 PTMP HTML report generated: ${reportFilename}"
                }
            }
        }
    }

    post {
        always {
            // Publish HTML report
            publishHTML(target: [
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: '.',
                reportFiles: "${reportFilename}",
                reportName: "PTMP Channel Test Report - Build ${env.BUILD_NUMBER}"
            ])

            // Archive JSON results
            archiveArtifacts artifacts: '*_PTMP.json, ptmp_channel_results.json', allowEmptyArchive: true

            echo "✅ PTMP Test Pipeline Completed"

            // Email notification
            script {
                _sendEmailNotification(reportFilename)
            }
        }
        success {
            echo "🎉 PTMP Test SUCCESS"
        }
        failure {
            echo "❌ PTMP Test FAILED - Check console output"
        }
    }
}

