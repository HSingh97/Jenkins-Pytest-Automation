import jenkins.model.Jenkins

pipeline {
    agent { node { label "${params.TARGET_STAND}" } }

    options {
        timestamps()
        timeout(time: 6, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        EXCEL_FILE = "snr_test_report_${new Date().format('yyyyMMdd_HHmmss')}.xlsx"
        LOG_FILE   = "test_run.log"
    }

    stages {
        stage('Prepare tests') {
            steps {
                script {
                    echo "----------------------------------------"
                    echo "--- TARGET STAND: ${params.TARGET_STAND}"
                    echo "--- Local IP     : ${params['Local IP Address']}"
                    echo "--- Remote IP    : ${params['Remote IP Address']}"
                    echo "--- Radio        : ${params.Radio}"
                    echo "--- Channels     : ${params.Channels}"
                    echo "--- Powers       : ${params.Powers}"
                    echo "----------------------------------------"

                    if (!params['Local IP Address'] || !params['Remote IP Address']) {
                        error "Missing required IP parameters"
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'python3 -m pip install openpyxl pytest || true'
            }
        }

        stage('SNR Tx Power Test') {
            steps {
                script {
                    def localIP = params['Local IP Address']
                    def remoteIP = params['Remote IP Address']
                    def radio = params.Radio
                    def channels = params.Channels
                    def powers = params.Powers

                    echo "Running SNR Tx Power Test"

                    withEnv(["EXCEL_FILE=${env.EXCEL_FILE}"]) {
                        sh """
                            python3 -u -m pytest -v -s testCases/test_SNRTxpower.py::test_snr_tx_power \
                            --local-ip '${localIP}' \
                            --remote-ip '${remoteIP}' \
                            --radio '${radio}' \
                            --channels '${channels}' \
                            --powers '${powers}' 2>&1 | tee ${env.LOG_FILE}
                        """
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def localIP = params['Local IP Address']
                    def remoteIP = params['Remote IP Address']

                    sh "ssh-keygen -R ${localIP} || true"
                    sh "ssh-keygen -R ${remoteIP} || true"

                    def local_fw_version = "N/A"
                    def remote_fw_version = "N/A"
                    try {
                        local_fw_version = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${localIP} 'cat /etc/version'", returnStdout: true).trim()
                    } catch (e) {}
                    try {
                        remote_fw_version = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${remoteIP} 'cat /etc/version'", returnStdout: true).trim()
                    } catch (e) {}

                    def buildParams = [
                        "Local IP Address": localIP,
                        "Remote IP Address": remoteIP,
                        "Radio": params.Radio,
                        "Channels": params.Channels,
                        "Powers": params.Powers,
                        "FW Version (Local / Remote)": "${local_fw_version} / ${remote_fw_version}"
                    ]

                    def currentDateTime = new Date().format("dd MMM yyyy, HH:mm:ss z", TimeZone.getTimeZone("Asia/Kolkata"))
                    def companyLogoUrl = "https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png"

                    def logContent = fileExists(env.LOG_FILE) ?
                        readFile(file: env.LOG_FILE)
                            .replace("&", "&amp;")
                            .replace("<", "&lt;")
                            .replace(">", "&gt;") :
                        "No log available"

                    def htmlContent = """
                    <html>
                    <head>
                        <title>SNR Tx Power Test Report</title>
                        <style>
                            body {font-family: 'Segoe UI', sans-serif; background:#f9f9f9; color:#333; margin:0; padding:20px;}
                            .header {display:flex; justify-content:space-between; align-items:center; background:#fff; padding:20px; border-bottom:3px solid #2c3e50; box-shadow:0 2px 5px rgba(0,0,0,0.1);}
                            .header img {height:70px;}
                            .header-info {text-align:right;}
                            .header-info h1 {margin:0; font-size:32px; color:#2c3e50;}
                            .header-info p {margin:5px 0; font-size:16px; color:#555;}
                            h2 {margin:40px 0 20px; font-size:26px; color:#2c3e50; border-bottom:2px solid #3498db; padding-bottom:10px;}
                            table {width:100%; border-collapse:collapse; margin:20px 0; background:#fff; box-shadow:0 4px 10px rgba(0,0,0,0.1);}
                            th {background:#2c3e50; color:#fff; padding:14px; text-align:center; font-weight:600;}
                            td {padding:12px 16px; text-align:center; border-bottom:1px solid #ddd;}
                            tr:nth-child(even) {background:#f8f9fa;}
                            tr:hover {background:#eaf4ff;}
                            .channel-header {background:#3498db !important; color:white; font-weight:bold; font-size:18px;}
                            .power-cell {text-align:left; padding-left:60px; font-weight:500;}
                            .log-button {background:#3498db; color:white; padding:14px 30px; border-radius:8px; font-weight:600; cursor:pointer; border:none; font-size:16px; margin:40px auto; display:block; box-shadow:0 4px 8px rgba(0,0,0,0.2);}
                            .log-button:hover {background:#2980b9;}
                            .modal {display:none; position:fixed; z-index:100; left:0; top:0; width:100%; height:100%; background:rgba(0,0,0,0.7);}
                            .modal-content {background:#fff; margin:5% auto; padding:20px; border-radius:12px; width:90%; max-width:1100px; box-shadow:0 10px 30px rgba(0,0,0,0.3);}
                            .modal-header {display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #eee; padding-bottom:10px; margin-bottom:20px;}
                            .modal-close {font-size:30px; cursor:pointer; color:#aaa;}
                            .modal-close:hover {color:#000;}
                            #log-content-pre {background:#2c3e50; color:#ecf0f1; padding:20px; max-height:70vh; overflow:auto; font-family:monospace; font-size:14px; border-radius:8px;}
                        </style>
                        <script>
                            function showLog() {
                                document.getElementById('log-content-pre').innerHTML = document.getElementById('full-log').innerHTML;
                                document.getElementById('logModal').style.display = 'block';
                            }
                            function closeModal() { document.getElementById('logModal').style.display = 'none'; }
                            window.onclick = function(e) { if (e.target == document.getElementById('logModal')) closeModal(); }
                        </script>
                    </head>
                    <body>
                        <div class="header">
                            <img src="${companyLogoUrl}" alt="Senao Networks"/>
                            <div class="header-info">
                                <h1>SNR Tx Power Test Report</h1>
                                <p><strong>Pipeline:</strong> ${env.JOB_NAME}</p>
                                <p><strong>Date & Time:</strong> ${currentDateTime}</p>
                            </div>
                        </div>

                        <h2>Build Parameters</h2>
                        <table>
                            <tr><th>Parameter</th><th>Value</th></tr>
                            ${buildParams.collect { "<tr><td><b>${it.key}</b></td><td>${it.value}</td></tr>" }.join('')}
                        </table>

                        <h2>SNR vs Tx Power Results</h2>
                        <table>
                            <tr>
                                <th>Channel</th>
                                <th>Power (dBm)</th>
                                <th>Remote IP</th>
                                <th>Local SNR A1</th>
                                <th>Local SNR A2</th>
                                <th>Remote SNR A1</th>
                                <th>Remote SNR A2</th>
                                <th>Tx Rate</th>
                                <th>Rx Rate</th>
                                <th>Status Check</th>
                            </tr>
                    """

                    if (fileExists(env.EXCEL_FILE)) {
                        def wb = openpyxl.load_workbook(env.EXCEL_FILE)
                        def ws = wb.active

                        def currentChannel = ""
                        for (row in ws.iter_rows(min_row=1, values_only=true)) {
                            if (row[0] && row[0].toString().startsWith("Channel ")) {
                                def channelText = row[0].toString()
                                htmlContent += "<tr class='channel-header'><td colspan='10'><strong>${channelText}</strong></td></tr>"
                                currentChannel = channelText
                            } else if (row[1] != null) {  // Power row
                                def power = row[1] ?: ""
                                def remoteIp = row[2] ?: ""
                                def localA1 = row[3] ?: ""
                                def localA2 = row[4] ?: ""
                                def remoteA1 = row[5] ?: ""
                                def remoteA2 = row[6] ?: ""
                                def txRate = row[7] ?: ""
                                def rxRate = row[8] ?: ""
                                def status = row[9] ?: ""

                                htmlContent += """
                                <tr>
                                    <td></td>
                                    <td class="power-cell">${power}</td>
                                    <td>${remoteIp}</td>
                                    <td>${localA1}</td>
                                    <td>${localA2}</td>
                                    <td>${remoteA1}</td>
                                    <td>${remoteA2}</td>
                                    <td>${txRate}</td>
                                    <td>${rxRate}</td>
                                    <td>${status}</td>
                                </tr>
                                """
                            }
                        }
                    } else {
                        htmlContent += "<tr><td colspan='10' style='color:red; padding:30px;'>No test data found</td></tr>"
                    }

                    htmlContent += """
                        </table>

                        <div style="text-align:center;">
                            <button class="log-button" onclick="showLog()">See Full Logs</button>
                        </div>

                        <div id="logModal" class="modal">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h2>Test Run Log</h2>
                                    <span class="modal-close" onclick="closeModal()">&times;</span>
                                </div>
                                <div style="padding:0;">
                                    <pre id="log-content-pre"></pre>
                                </div>
                            </div>
                        </div>

                        <div id="full-log" style="display:none;">${logContent}</div>
                    </body>
                    </html>
                    """

                    writeFile file: 'snr_test_report.html', text: htmlContent
                }
            }
        }
    }

    post {
        always {
            publishHTML(target: [
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: '.',
                reportFiles: 'snr_test_report.html',
                reportName: 'SNR Tx Power Test Report'
            ])

            archiveArtifacts artifacts: "${env.EXCEL_FILE},snr_test_report.html,${env.LOG_FILE}", allowEmptyArchive: true

            sh "rm -f ${env.LOG_FILE} || true"

            echo "-----------------------------------------"
            echo 'SNR Tx Power Test Completed!'
            echo "-----------------------------------------"

            script {
                def userEmails = [
                    "puneet": "puneet.sharma@senao.com",
                    "harman": "harmanjot.singh@senao.com",
                    "mahesh": "mahesh.battala@senao.com",
                    "sandeep": "sandeep.manchikanti@senao.com",
                    "sampath": "sampath.marella@senao.com",
                    "jayanth": "jayanth.munnaluru@senao.com",
                    "srilatha": "srilatha.tadiboina@senao.com",
                    "phani": "phani.darla@senao.com",
                    "dinesh": "dinesh.redddy@senao.com"
                ]

                def buildUserId = currentBuild.getBuildCauses().find { it._class == 'hudson.model.Cause$UserIdCause' }?.userId ?: "unknown"
                def userEmail = userEmails.get(buildUserId, "puneet.sharma@senao.com")

                emailext(
                    subject: "SNR Tx Power Test #${BUILD_NUMBER} - ${currentBuild.currentResult}",
                    body: """
                        <html><body>
                            <h2 style="color:#3498db;">Jenkins Build Notification</h2>
                            <p><strong>Build:</strong> ${currentBuild.fullDisplayName}</p>
                            <p><strong>Status:</strong> <span style="color:${currentBuild.currentResult == 'SUCCESS' ? 'green' : 'red'};">${currentBuild.currentResult}</span></p>
                            <p><strong>Build URL:</strong> <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
                            <p><strong>Report:</strong> <a href="${env.BUILD_URL}SNR_20Tx_20Power_20Test_20Report">View Report</a></p>
                            <br/><p style="color:#777;">-- Jenkins Automated Notification</p>
                        </body></html>
                    """,
                    to: userEmail,
                    mimeType: 'text/html',
                    attachmentsPattern: "snr_test_report.html,${env.EXCEL_FILE}"
                )
            }
        }
    }
}