// Functions

def archiveArtifacts(pattern) {
    step([$class: 'ArtifactArchiver', artifacts: pattern, fingerprint: true, onlyIfSuccessful: false])
}


// Main Pipeline

pipeline {
    agent { node { label "${params['Local PC']}" } }

    stages {
        stage('Prepare Testbed') {
            steps {
                script {

                    def local_pc = params['Local PC']
                    def remote_pc = params['Remote PC']

                    echo "------------------------------------------"
                    echo "---> Local TARGET STAND: ${local_pc} "
                    echo "------------------------------------------"

                    echo "------------------------------------------"
                    echo "---> Local PC : ${local_pc} "
                    echo "------------------------------------------"

                    echo "----------------------------------------"
                    echo "---> Remote PC: ${remote_pc} "
                    echo "----------------------------------------"
      	        }
      	    }
        }
        stage('Install Dependencies') {
            steps {
                script {
                    echo "----------------------------------------"
                    echo "         Installing Dependencies"
                    echo "----------------------------------------"
                    sh "sh utilities/requirements.txt"
                }
            }
        }
        stage('Throughput Testing') {
            steps {
                script {

                    def remotePC = params['Remote PC']
                    def remotePCIP = null

                    node(remotePC) {
                        remotePCIP = sh(
                            script: "ip -4 -o addr show | awk '\$4 ~ /^192\\.168\\.1\\./ {print \$4}' | cut -d'/' -f1 | head -n1",
                            returnStdout: true
                        ).trim()

                        if (!remotePCIP) {
                            error("❌ Could not find 192.168.1.x IP on node '$remotePC' ")
                        }

                        echo "✅ Remote PC IP: ${remotePCIP}"
                    }


                    def localIP = params['Local IP Address']
                    def remoteIP = params['Remote IP Address']
                    def selectedRadio = params['Radio']
                    def selectedTrafficGenerator = params['Traffic Generator']
                    def traffic_types = params.'Traffic Type'.split(',')
                    def directions = params.Direction.split(',')
                    def bandwidths = params.Bandwidth.split(',')
                    def modulationrates = params.MCS.split(',')
                    def test_time = params['Throughput Test Time']

                    sh 'rm -f *_HT*.json iteration_results.json'
                    echo "✅ Cleared old workspace"
                    sh "echo {\\\"iterations\\\": []} > iteration_results.json"

                    def iteration = 1

                    for (bandwidth in bandwidths) {
                        echo "--------------------------------------------------------------"
                        echo " Configuring Bandwidth : ${bandwidth}"
                        echo "--------------------------------------------------------------"

                        for (mcsrate in modulationrates) {
                            echo "--------------------------------------------------------------"
                            echo " Configuring MCS : ${mcsrate}"
                            echo "--------------------------------------------------------------"

                            for (traffic_type in traffic_types) {

                                echo "--------------------------------------------------------------"
                                echo " Testing: Bandwidth=${bandwidth} | MCS=${mcsrate} | Type=${traffic_type} "
                                echo "--------------------------------------------------------------"

                                sh "echo '{\"iterations\": []}' > custom_results.json"

                                def pytest_output = sh(script: """
                                    pytest -v -s testCases/test_Throughput.py::test_throughputtest \
                                    --local-ip '${localIP}' \
                                    --remote-ip '${remoteIP}' \
                                    --radio '${selectedRadio}' \
                                    --mcs-rate '${mcsrate}' \
                                    --traffic-type '${traffic_type}' \
                                    --traffic-dir '${directions.join(",")}' \
                                    --remote-pc-ip '${remotePCIP}' \
                                    --bandwidth '${bandwidth}' \
                                    --sleep '${test_time}' \
                                    2>&1
                                """, returnStdout: true).trim()

                                echo "Pytest Output:\n${pytest_output}"

                                def iterationResults = readJSON file: 'custom_results.json'

                                def newTests = iterationResults.iterations

                                newTests.each { test ->
                                    test.iteration = iteration++
                                    test.logs = pytest_output
                                }

                                def filename = "Throughput_${bandwidth.trim()}_${mcsrate.trim()}.json"
                                writeJSON file: filename, json: [iterations: newTests]

                                newTests.each {
                                    echo "Iteration ${it.iteration} - ${it.test} => ${it.status}"
                                    echo "Bandwidth: ${it.bandwidth}, MCS: ${it.data_rate}, Direction: ${it.Direction}"
                                    echo "Throughput: ${it.throughput} Mbps"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            echo "-----------------------------------------"
            echo 'Script Done!'
            echo "-----------------------------------------"
        }

        success {
            echo "-----------------------------------------"
            echo 'Script Success'
            echo "-----------------------------------------"
        }

        failure {
            echo "-----------------------------------------"
            echo 'Script Failure'
            echo "-----------------------------------------"
        }
    }
}