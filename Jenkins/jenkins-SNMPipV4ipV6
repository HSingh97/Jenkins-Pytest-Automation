import java.text.SimpleDateFormat

pipeline {
    agent { node { label "${TARGET_STAND}" } }

    stages {
        stage('Prepare') {
            steps {
                script {
                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                    echo "TARGET STAND : ${TARGET_STAND}"
                    echo "Device IPv4  : ${params.LOCAL_IP}"
                    echo "IPv6 Address : ${params.IPV6_ADDR}/${params.PREFIX}"
                    echo "Gateway      : ${params.GATEWAY}"
                    echo "Iterations   : ${params.ITERATIONS}"
                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                }
            }
        }

        stage('Install Tools') {
            steps {
                sh '''
                    apt-get update > /dev/null 2>&1
                    apt-get install -y snmp iputils-ping sshpass python3 > /dev/null 2>&1 || true
                '''
            }
        }

        stage('IPv4 + IPv6 Static Test') {
            steps {
                script {
                    sh 'rm -f ipv6_results.json test-*.log || true'
                    sh 'echo \'{"iterations": []}\' > ipv6_results.json'

                    for (int i = 1; i <= params.ITERATIONS.toInteger(); i++) {
                        echo "RUNNING ITERATION ${i}/${params.ITERATIONS}"
                        sh """
                            python3 testCases/test_SNMP_IpV4_IpV6.py \
                                --local-ip '${params.LOCAL_IP}' \
                                --ipv6 '${params.IPV6_ADDR}' \
                                --prefix ${params.PREFIX} \
                                --gateway '${params.GATEWAY}' \
                                --iter ${i} | tee test-${i}.log
                        """
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def jsonData = readJSON file: 'ipv6_results.json'
                    def total = jsonData.iterations.size()
                    def passed = jsonData.iterations.count { it.status == 'PASS' }
                    def rate = total > 0 ? String.format("%.1f", (passed * 100.0 / total)) : "0.0"

                    def ist = new SimpleDateFormat("dd MMM yyyy, HH:mm:ss").tap {
                        setTimeZone(TimeZone.getTimeZone("Asia/Kolkata"))
                    }
                    def currentTime = ist.format(new Date())

                    def rows = ""
                    jsonData.iterations.each { r ->
                        def log = fileExists("test-${r.iteration}.log") ? readFile("test-${r.iteration}.log").replace("<", "&lt;").replace(">", "&gt;") : "Log missing"
                        rows += """
                            <tr>
                                <td style="text-align:center;font-weight:bold;">${r.iteration}</td>
                                <td style="color:${r.ipv4_initial_ping ? '#16a34a' : '#dc2626'};font-weight:bold;">${r.ipv4_initial_ping ? 'PASS' : 'FAIL'}</td>
                                <td style="color:#16a34a;font-weight:bold;">SET</td>
                                <td style="color:${r.ipv6_final_ping ? '#16a34a' : '#dc2626'};font-weight:bold;">${r.ipv6_final_ping ? 'PASS' : 'FAIL'}</td>
                                <td style="font-size:20px;color:${r.status == 'PASS' ? '#16a34a' : '#dc2626'};font-weight:bold;">${r.status}</td>
                                <td>
                                    <button onclick="document.getElementById('log${r.iteration}').style.display='block'"
                                            style="background:#3b82f6;color:white;border:none;padding:10px 20px;border-radius:8px;cursor:pointer;font-weight:bold;">
                                        View Log
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="6">
                                    <pre id="log${r.iteration}" style="display:none;background:#1e1e1e;color:#4ade80;padding:20px;margin:15px;border-radius:10px;max-height:600px;overflow:auto;font-size:13px;">${log}</pre>
                                </td>
                            </tr>
                        """
                    }

                    writeFile file: 'ipv6_report.html', text: """
                    <!DOCTYPE html>
                    <html>
                    <head>
                        <meta charset="utf-8">
                        <title>IPv4 + Static IPv6 Test Report</title>
                        <style>
                            body {font-family: 'Segoe UI', sans-serif; background:#f4f6f9; margin:0; padding:20px;}
                            .container {max-width:1400px; margin:auto; background:white; border-radius:18px; overflow:hidden; box-shadow:0 10px 40px rgba(0,0,0,0.15);}
                            .header {background:linear-gradient(135deg,#1e40af,#3b82f6); color:white; padding:50px; text-align:center;}
                            .header img {height:70px; margin-bottom:15px;}
                            h1 {margin:0; font-size:42px;}
                            .info {padding:30px; background:#f8fafc;}
                            table {width:100%; border-collapse:collapse; margin:20px 0;}
                            th {background:#1e40af; color:white; padding:18px; font-size:16px;}
                            td {padding:16px; text-align:center; border-bottom:1px solid #e2e8f0;}
                            .summary {font-size:28px; font-weight:bold; color:#1e40af; margin:20px 0;}
                        </style>
                    </head>
                    <body>
                        <div class="container">
                            <div class="header">
                                <img src="https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png" alt="Senao Networks"/>
                                <h1>IPv4 + Static IPv6 Test Report</h1>
                                <p style="font-size:22px; margin:10px 0 0;">${currentTime} • Stand: ${TARGET_STAND}</p>
                            </div>
                            <div class="info">
                                <h2>Test Parameters</h2>
                                <table>
                                    <tr><td><b>Device IPv4</b></td><td>${params.LOCAL_IP}</td></tr>
                                    <tr><td><b>IPv6 Address</b></td><td>${params.IPV6_ADDR}/${params.PREFIX}</td></tr>
                                    <tr><td><b>Gateway</b></td><td>${params.GATEWAY}</td></tr>
                                    <tr><td><b>Iterations</b></td><td>${params.ITERATIONS}</td></tr>
                                </table>
                                <div class="summary">${passed}/${total} Passed (${rate}% Success)</div>
                                <table>
                                    <tr>
                                        <th>Iteration</th>
                                        <th>IPv4 Initial</th>
                                        <th>IPv6 Set</th>
                                        <th>IPv6 Final Ping</th>
                                        <th>Status</th>
                                        <th>Full Log</th>
                                    </tr>
                                    ${rows}
                                </table>
                            </div>
                        </div>
                    </body>
                    </html>
                    """
                }
            }
        }
    }

    post {
        always {
            publishHTML(target: [
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: '.',
                reportFiles: 'ipv6_report.html',
                reportName: 'IPv4 + IPv6 Test Report'
            ])

            sh 'rm -f test-*.log || true'

            script {
                def cause = currentBuild.getBuildCauses().find { it._class.contains('UserIdCause') }
                def userId = cause?.userId ?: "unknown"
                def emailMap = [
                    puneet: "puneet.sharma@senao.com",
                    harman: "harmanjot.singh@senao.com"
                ]
                def email = emailMap.get(userId, "puneet.sharma@senao.com")

                emailext(
                    subject: "IPv6 Test #${BUILD_NUMBER} - ${currentBuild.currentResult}",
                    body: """
                    <h2 style="color:#1e40af;">IPv4 + Static IPv6 Test Completed</h2>
                    <p><strong>Status:</strong> ${currentBuild.currentResult}</p>
                    <p><strong>Passed:</strong> ${readJSON(file:'ipv6_results.json')?.iterations?.count { it.status == 'PASS' } ?: 0} / ${params.ITERATIONS}</p>
                    <p>See attached full HTML report with logs.</p>
                    """,
                    to: email,
                    mimeType: 'text/html',
                    attachmentsPattern: 'ipv6_report.html,ipv6_results.json'
                )
            }
        }
        success { echo "FULL SUCCESS — IPv6 IS WORKING PERFECTLY!" }
        failure { echo "TEST FAILED — Check parameters or device" }
    }
}