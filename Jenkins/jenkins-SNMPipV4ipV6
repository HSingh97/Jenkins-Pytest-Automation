pipeline {
    agent { node { label "${TARGET_STAND}" } }

    stages {
        stage('Prepare') {
            steps {
                echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                echo "TARGET STAND : ${TARGET_STAND}"
                echo "Device IPv4  : ${LOCAL_IP}"
                echo "IPv6 Address : ${IPV6_ADDR}"
                echo "Prefix       : ${PREFIX}"
                echo "Gateway      : ${GATEWAY}"
                echo "Iterations   : ${ITERATIONS}"
                echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            }
        }

        stage('Install Tools') {
            steps {
                sh 'apt-get update && apt-get install -y snmp iputils-ping python3 || true'
            }
        }

        stage('IPv6 Static Test') {
            steps {
                sh 'rm -f ipv6_results.json test-*.log || true'
                sh 'echo \'{"iterations": []}\' > ipv6_results.json'

                script {
                    for (int i = 1; i <= ITERATIONS.toInteger(); i++) {
                        echo "RUNNING ITERATION ${i}/${ITERATIONS}"
                        sh """
                            python3 testCases/test_SNMP_IpV4_IpV6.py \
                                --local-ip '${LOCAL_IP}' \
                                --ipv6 '${IPV6_ADDR}' \
                                --prefix '${PREFIX}' \
                                --gateway '${GATEWAY}' \
                                --iter ${i} | tee test-${i}.log
                        """
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def json = readJSON file: 'ipv6_results.json'
                    def total = json.iterations.size()
                    def passed = json.iterations.count { it.status == 'PASS' }
                    def failed = total - passed
                    def rate = total > 0 ? String.format("%.2f", (passed * 100.0 / total)) : "0.00"

                    env.TOTAL_TESTS = total
                    env.PASSED_TESTS = passed
                    env.SUCCESS_RATE = rate

                    def rows = ""
                    json.iterations.each { iter ->
                        def statusColor = iter.status == "PASS" ? "#28a745" : "#dc3545"
                        def log = fileExists("test-${iter.iteration}.log") ? readFile("test-${iter.iteration}.log") : "Log missing"
                        log = log.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

                        rows += """
                            <tr>
                                <td style="text-align:center; padding:12px;">${iter.iteration}</td>
                                <td style="text-align:center; padding:12px; background:${statusColor}; color:white; font-weight:bold;">${iter.status}</td>
                                <td style="padding:10px;"><pre style="background:#f8f9fa; padding:15px; border-radius:8px; max-height:400px; overflow:auto; margin:0;">${log}</pre></td>
                            </tr>
                        """
                    }

                    writeFile file: 'IPv6_Test_Report.html', text: """
                    <!DOCTYPE html>
                    <html>
                    <head>
                        <meta charset="utf-8">
                        <title>Senao IPv6 Static Test Report</title>
                        <style>
                            body { font-family: 'Segoe UI', sans-serif; background: #f4f6f9; color: #333; margin:0; padding:20px; }
                            .container { max-width: 1300px; margin: auto; background: white; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
                            .header { background: linear-gradient(135deg, #1e40af, #3b82f6); color: white; padding: 40px; text-align: center; }
                            .header h1 { margin: 10px 0; font-size: 40px; }
                            .info { padding: 30px; background: #f8f9fa; }
                            .info table { width: 100%; border-collapse: collapse; }
                            .info td { padding: 12px; font-size: 18px; }
                            .summary { padding: 30px; text-align: center; }
                            .grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 20px; margin: 20px 0; }
                            .box { background: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
                            .box h3 { margin: 0 0 10px; color: #666; }
                            .box p { font-size: 42px; font-weight: bold; margin: 0; }
                            .green { color: #28a745; }
                            .red { color: #dc3545; }
                            table { width: 100%; border-collapse: collapse; margin-top: 20px; }
                            th { background: #1e40af; color: white; padding: 18px; }
                            td { border: 1px solid #ddd; padding: 12px; }
                            pre { font-size: 13px; line-height: 1.4; }
                        </style>
                    </head>
                    <body>
                        <div class="container">
                            <div class="header">
                                <h1>IPv6 Static Configuration Test</h1>
                                <p>Stand: <b>${TARGET_STAND}</b> | Build #${BUILD_NUMBER}</p>
                            </div>
                            <div class="info">
                                <table>
                                    <tr><td><b>Device IPv4</b></td><td>${LOCAL_IP}</td></tr>
                                    <tr><td><b>IPv6 Address</b></td><td>${IPV6_ADDR}</td></tr>
                                    <tr><td><b>Prefix Length</b></td><td>${PREFIX}</td></tr>
                                    <tr><td><b>Gateway</b></td><td>${GATEWAY}</td></tr>
                                    <tr><td><b>Iterations</b></td><td>${ITERATIONS}</td></tr>
                                </table>
                            </div>
                            <div class="summary">
                                <h2>Test Summary</h2>
                                <div class="grid">
                                    <div class="box"><h3>Total</h3><p>${total}</p></div>
                                    <div class="box"><h3>Passed</h3><p class="green">${passed}</p></div>
                                    <div class="box"><h3>Failed</h3><p class="red">${failed}</p></div>
                                    <div class="box"><h3>Success Rate</h3><p class="green">${rate}%</p></div>
                                </div>
                            </div>
                            <div style="padding:30px;">
                                <h2 style="text-align:center; color:#1e40af;">Detailed Results</h2>
                                <table>
                                    <tr><th>Iteration</th><th>Status</th><th>Log</th></tr>
                                    ${rows}
                                </table>
                            </div>
                        </div>
                    </body>
                    </html>
                    """
                }
            }
        }
    }

    post {
        always {
            publishHTML([
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: '',
                reportFiles: 'IPv6_Test_Report.html',
                reportName: 'IPv6 Static Test Report'
            ])

            archiveArtifacts artifacts: 'IPv6_Test_Report.html', allowEmptyArchive: true

            emailext (
                to: "puneet.sharma@senao.com",
                subject: "IPv6 Static Test #${BUILD_NUMBER} - ${currentBuild.currentResult}",
                mimeType: 'text/html',
                attachmentsPattern: 'IPv6_Test_Report.html',
                body: """
                <h2 style="color:#1e40af;">Senao IPv6 Static Test Report</h2>
                <p><b>Result:</b> ${env.PASSED_TESTS}/${env.TOTAL_TESTS} Passed (${env.SUCCESS_RATE}%)</p>
                <p><b>Device:</b> ${LOCAL_IP} | <b>Stand:</b> ${TARGET_STAND}</p>
                <p>Detailed report attached below.</p>
                <p><a href="${BUILD_URL}">View in Jenkins</a></p>
                """
            )
        }

        success {
            echo "-----------------------------------------"
            echo 'Script Success'
            echo "-----------------------------------------"
        }
        failure {
            echo "-----------------------------------------"
            echo 'Script Failure'
            echo "-----------------------------------------"
        }
    }
}