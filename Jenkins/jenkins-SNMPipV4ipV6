pipeline {
    agent { node { label "${TARGET_STAND}" } }

    // NO PARAMETERS HERE — YOU CONFIGURE IN UI ONLY

    stages {
        stage('Prepare') {
            steps {
                echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                echo "TARGET STAND : ${TARGET_STAND}"
                echo "Device IPv4  : ${params.LOCAL_IP}"
                echo "IPv6 Address : ${params.IPV6_ADDR}/${params.PREFIX}"
                echo "Gateway      : ${params.GATEWAY}"
                echo "Iterations   : ${params.ITERATIONS}"
                echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            }
        }

        stage('Install Tools') {
            steps {
                sh 'apt-get update && apt-get install -y snmp iputils-ping sshpass > /dev/null 2>&1 || true'
            }
        }

        stage('IPv4 + IPv6 Static Test') {
            steps {
                script {
                    sh 'rm -f ipv6_results.json test-*.log || true'
                    sh 'echo \'{"iterations": []}\' > ipv6_results.json'

                    for (int i = 1; i <= params.ITERATIONS.toInteger(); i++) {
                        echo "STARTING ITERATION ${i}/${params.ITERATIONS}"
                        sh """
                            python3 testCases/test_SNMP_IpV4_IpV6.py \
                                --local-ip '${params.LOCAL_IP}' \
                                --ipv6 '${params.IPV6_ADDR}' \
                                --prefix ${params.PREFIX} \
                                --gateway '${params.GATEWAY}' \
                                --iter ${i} 2>&1 | tee test-${i}.log
                        """
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def json = readJSON file: 'ipv6_results.json'
                    def total = json.iterations.size()
                    def passed = json.iterations.count { it.status == 'PASS' }
                    def rate = total > 0 ? String.format("%.1f", passed * 100.0 / total) : "0.0"
                    def time = new Date().format("dd MMM yyyy, HH:mm:ss", TimeZone.getTimeZone("Asia/Kolkata"))

                    def rows = ""
                    json.iterations.each { r ->
                        def log = fileExists("test-${r.iteration}.log") ? readFile("test-${r.iteration}.log").replace("<","&lt;").replace(">","&gt;") : "No log"
                        rows += """
                        <tr>
                            <td style="padding:14px;border:1px solid #ddd;text-align:center;font-weight:bold;">${r.iteration}</td>
                            <td style="padding:14px;border:1px solid #ddd;color:${r.ipv4_initial_ping?'#16a34a':'#dc2626'};font-weight:bold;">${r.ipv4_initial_ping?'PASS':'FAIL'}</td>
                            <td style="padding:14px;border:1px solid #ddd;color:#16a34a;font-weight:bold;">SET</td>
                            <td style="padding:14px;border:1px solid #ddd;color:${r.ipv6_final_ping?'#16a34a':'#in red'};font-weight:bold;">${r.ipv6_final_ping?'PASS':'FAIL'}</td>
                            <td style="padding:14px;border:1px solid #ddd;font-size:20px;color:${r.status=='PASS'?'#16a34a':'#dc2626'};font-weight:bold;">${r.status}</td>
                            <td style="padding:14px;border:1px solid #ddd;">
                                <button onclick="document.getElementById('log${r.iteration}').style.display=document.getElementById('log${r.iteration}').style.display==='block'?'none':'block'"
                                        style="background:#3b82f6;color:white;border:none;padding:10px 18px;border-radius:8px;cursor:pointer;font-weight:bold;">
                                    Toggle Log
                                </button>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6">
                                <pre id="log${r.iteration}" style="display:none;background:#1a1a1a;color:#4ade80;padding:20px;margin:10px;border-radius:10px;max-height:700px;overflow:auto;font-size:13px;white-space:pre-wrap;">${log}</pre>
                            </td>
                        </tr>
                        """
                    }

                    writeFile file: 'ipv6_report.html', text: """
                    <!DOCTYPE html>
                    <html>
                    <head>
                        <meta charset="utf-8">
                        <title>IPv4 + Static IPv6 Test Report</title>
                        <style>
                            body {font-family: system-ui,sans-serif; background:#f0f2f5; margin:0; padding:30px;}
                            .card {max-width:1400px; margin:auto; background:white; border-radius:18px; overflow:hidden; box-shadow:0 15px 40px rgba(0,0,0,0.15);}
                            .header {background:linear-gradient(135deg,#1e3a8a,#3b82f6); color:white; padding:50px; text-align:center;}
                            h1 {margin:0; font-size:42px;}
                            .info {padding:30px; background:#f8fafc;}
                            table {width:100%; border-collapse:collapse; margin:25px 0;}
                            th {background:#1e40af; color:white; padding:18px; font-size:16px;}
                            td {padding:16px; text-align:center; border-bottom:1px solid #e2e8f0;}
                        </style>
                    </head>
                    <body>
                        <div class="card">
                            <div class="header">
                                <h1>IPv4 + Static IPv6 Test Report</h1>
                                <p style="font-size:20px;margin:10px 0 0;">${time} • Stand: ${TARGET_STAND}</p>
                            </div>
                            <div class="info">
                                <h2>Test Parameters</h2>
                                <table>
                                    <tr><td style="padding:12px;"><b>Local IPv4</b></td><td>${params.LOCAL_IP}</td></tr>
                                    <tr><td style="padding:12px;"><b>IPv6 Address</b></td><td>${params.IPV6_ADDR}/${params.PREFIX}</td></tr>
                                    <tr><td style="padding:12px;"><b>Gateway</b></td><td>${params.GATEWAY}</td></tr>
                                    <tr><td style="padding:12px;"><b>Iterations</b></td><td>${params.ITERATIONS}</td></tr>
                                </table>
                                <h2>Test Summary → ${passed}/${total} Passed (${rate}% Success Rate)</h2>
                                <table>
                                    <tr>
                                        <th>Iteration</th>
                                        <th>IPv4 Initial Ping</th>
                                        <th>IPv6 Set</th>
                                        <th>IPv6 Final Ping</th>
                                        <th>Overall Status</th>
                                        <th>Full Log</th>
                                    </tr>
                                    ${rows}
                                </table>
                            </div>
                        </div>
                    </body>
                    </html>
                    """
                }
            }
        }
    }

    post {
        always {
            publishHTML(target: [
                reportName: 'IPv4_IPv6 Test Report',
                reportDir: '.',
                reportFiles: 'ipv6_report.html',
                keepAll: true,
                alwaysLinkToLastBuild: true,
                allowMissing: false
            ])

            sh 'rm -f test-*.log || true'

            script {
                def user = currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause')?.userId?.first() ?: "unknown"
                def email = [
                    puneet: "puneet.sharma@senao.com",
                    harman: "harmanjot.singh@senao.com"
                ].get(user, "puneet.sharma@senao.com")

                emailext(
                    subject: "IPv6 Test #${BUILD_NUMBER} - ${currentBuild.currentResult}",
                    body: "<h2>IPv4 + Static IPv6 Test Completed</h2><p>See attached HTML report and JSON</p>",
                    to: email,
                    mimeType: 'text/html',
                    attachmentsPattern: 'ipv6_report.html,ipv6_results.json'
                )
            }
        }
        success { echo "SUCCESS — IPv6 CONFIGURED & REACHABLE!" }
        failure { echo "FAILED — Check console output" }
    }
}