import jenkins.model.Jenkins

pipeline {
    agent { node { label "${TARGET_STAND}" } }

    stages {
        stage('Prepare') {
            steps {
                script {
                    echo "----------------------------------------"
                    echo "TARGET STAND: ${TARGET_STAND}"
                    echo "Local IP Address: ${params.LOCAL_IP}"
                    echo "IPv6 Address: ${params.IPV6_ADDR}/${params.PREFIX}"
                    echo "IPv6 Gateway: ${params.GATEWAY}"
                    echo "Iterations: ${params.ITERATIONS}"
                    echo "----------------------------------------"
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    apt-get update
                    apt-get install -y snmp iputils-ping sshpass
                '''
            }
        }

        stage('IPv4 and IPv6 Static Test') {
            steps {
                script {
                    def localIP = params.LOCAL_IP.trim()
                    def ipv6    = params.IPV6_ADDR.trim()
                    def prefix  = params.PREFIX.trim()
                    def gateway = params.GATEWAY.trim()
                    def count   = params.ITERATIONS.toInteger()

                    sh 'rm -f ipv6_results.json test-*.log || true'
                    sh 'echo \'{"iterations": []}\' > ipv6_results.json'

                    sh "ssh-keygen -R ${localIP} || true"
                    sh "ssh-keygen -R ${remoteIP} || true"

                    for (int i = 1; i <= count; i++) {
                        echo "=== ITERATION ${i} of ${count} ==="
                        def logFile = "test-${i}.log"
                        sh """
                            set -x
                            python3 testCases/test_SNMP_IpV4_IpV6.py \
                                --local-ip '${localIP}' \
                                --ipv6 '${ipv6}' \
                                --prefix '${prefix}' \
                                --gateway '${gateway}' \
                                --iter ${i} 2>&1 | tee ${logFile}
                        """
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def localIP = params.LOCAL_IP
                    sh "ssh-keygen -R ${localIP} || true"
                    sh "ssh-keygen -R ${remoteIP} || true"

                    def fwVersion = "N/A"
                    try {
                        fwVersion = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${localIP} 'cat /etc/version || echo Unknown'", returnStdout: true).trim()
                    } catch (e) { echo "FW fetch failed" }

                    def jsonReport = readJSON file: 'ipv6_results.json'
                    def total = jsonReport.iterations.size()
                    def pass  = jsonReport.iterations.count { it.status == 'PASS' }
                    def fail  = total - pass
                    def rate  = total > 0 ? String.format("%.1f", pass * 100.0 / total) : "0.0"

                    def istDate = new Date().format("dd MMM yyyy, HH:mm:ss", TimeZone.getTimeZone("Asia/Kolkata"))
                    def companyLogo = "https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png"

                    def html = """
                    <html>
                    <head>
                        <title>IPv4 + IPv6 Test Report</title>
                        <style>
                            body {font-family:Arial,sans-serif;background:#f8fafc;color:#1e293b;margin:0;padding:20px;}
                            .container {max-width:1200px;margin:auto;background:white;padding:30px;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,0.1);}
                            .header {display:flex;justify-content:space-between;align-items:center;background:linear-gradient(135deg,#1e40af,#3b82f6);color:white;padding:25px;border-radius:12px;margin-bottom:30px;}
                            .header img {height:70px;}
                            .header h1 {margin:0;font-size:28px;}
                            h2 {color:#1e40af;border-bottom:3px solid #3b82f6;padding-bottom:8px;}
                            table {width:100%;border-collapse:collapse;margin:20px 0;background:white;}
                            th {background:#1e40af;color:white;padding:15px;text-align:center;}
                            td {padding:15px;border-bottom:1px solid #e2e8f0;text-align:center;}
                            .pass {background:#dcfce7;color:#166534;}
                            .fail {background:#fee2e2;color:#991b1b;}
                            .btn {background:#3b82f6;color:white;padding:8px 16px;border:none;border-radius:8px;cursor:pointer;}
                            .modal {display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);z-index:999;}
                            .modal-content {background:white;margin:5% auto;width:90%;max-width:1000px;max-height:80vh;overflow:auto;padding:20px;border-radius:12px;}
                            pre {background:#1e293b;color:#86efac;padding:20px;border-radius:8px;overflow-x:auto;}
                        </style>
                        <script>
                            function showLog(id) {
                                document.getElementById('modal').style.display = 'block';
                                document.getElementById('logContent').innerText = document.getElementById(id).innerText;
                            }
                            function closeModal() { document.getElementById('modal').style.display = 'none'; }
                        </script>
                    </head>
                    <body>
                        <div class="container">
                            <div class="header">
                                <img src="${companyLogo}" alt="Senao">
                                <h1>IPv4 + Static IPv6 Test Report</h1>
                            </div>

                            <h2>Parameters</h2>
                            <table>
                                <tr><th>Parameter</th><th>Value</th></tr>
                                <tr><td>Local IP</td><td>${localIP}</td></tr>
                                <tr><td>IPv6 Address</td><td>${params.IPV6_ADDR}/${params.PREFIX}</td></tr>
                                <tr><td>Gateway</td><td>${params.GATEWAY}</td></tr>
                                <tr><td>Firmware</td><td>${fwVersion}</td></tr>
                                <tr><td>Iterations</td><td>${params.ITERATIONS}</td></tr>
                                <tr><td>Date & Time</td><td>${istDate}</td></tr>
                            </table>

                            <h2>Summary</h2>
                            <table>
                                <tr><th>Total</th><th>Passed</th><th>Failed</th><th>Success Rate</th></tr>
                                <tr><td>${total}</td><td class="pass">${pass}</td><td class="fail">${fail}</td><td>${rate}%</td></tr>
                            </table>

                            <h2>Detailed Results</h2>
                            <table>
                                <tr>
                                    <th>Iteration</th>
                                    <th>IPv4 Ping</th>
                                    <th>IPv6 Set</th>
                                    <th>IPv6 Ping</th>
                                    <th>Status</th>
                                    <th>Log</th>
                                </tr>
                                ${jsonReport.iterations.collect { r ->
                                    def logId = "log-${r.iteration}"
                                    def logContent = fileExists("test-${r.iteration}.log") ? readFile("test-${r.iteration}.log") : "No log"
                                    logContent = logContent.replace("<", "&lt;").replace(">", "&gt;")
                                    """
                                    <tr>
                                        <td>${r.iteration}</td>
                                        <td>${r.ipv4_ping ? '<span class="pass">PASS</span>' : '<span class="fail">FAIL</span>'}</td>
                                        <td>${r.ipv6_set ? '<span class="pass">PASS</span>' : '<span class="fail">FAIL</span>'}</td>
                                        <td>${r.ipv6_ping ? '<span class="pass">PASS</span>' : '<span class="fail">FAIL</span>'}</td>
                                        <td><b>${r.status}</b></td>
                                        <td><button class="btn" onclick="showLog('${logId}')">View Log</button></td>
                                    </tr>
                                    <div id="${logId}" style="display:none"><pre>${logContent}</pre></div>
                                    """
                                }.join()}
                            </table>

                            <div id="modal" class="modal" onclick="closeModal()">
                                <div class="modal-content" onclick="event.stopPropagation()">
                                    <h2>Full Log Output</h2>
                                    <pre id="logContent"></pre>
                                    <button class="btn" onclick="closeModal()" style="background:#ef4444">Close</button>
                                </div>
                            </div>
                        </div>
                    </body>
                    </html>
                    """

                    writeFile file: 'ipv6_report.html', text: html
                }
            }
        }
    }

    post {
        always {
            publishHTML(target: [
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: '.',
                reportFiles: 'ipv6_report.html',
                reportName: 'IPv4_IPv6 Test Report'
            ])

            echo "Cleaning up test log files..."
            sh 'rm -f test-*.log || true'
            echo "-----------------------------------------"
            echo 'Script Done!'
            echo "-----------------------------------------"

            script {
                def buildCauses = currentBuild.getBuildCauses()
                def userCause = buildCauses.find { it._class == 'hudson.model.Cause$UserIdCause' }
                def buildUserName = userCause?.userName ?: "Unknown User"
                def buildUserId = userCause?.userId ?: "unknown"
                echo "Build started by: ${buildUserName} (${buildUserId})"

                def userEmails = [
                    "puneet": "puneet.sharma@senao.com",
                    "harman": "harmanjot.singh@senao.com",
                    "mahesh": "mahesh.battala@senao.com",
                    "sandeep": "sandeep.manchikanti@senao.com",
                    "sampath": "sampath.marella@senao.com",
                    "jayanth": "jayanth.munnaluru@senao.com",
                    "srilatha": "srilatha.tadiboina@senao.com",
                    "phani": "phani.darla@senao.com",
                    "dinesh": "dinesh.redddy@senao.com"
                ]
                def userEmail = userEmails.get(buildUserId, "puneet.sharma@senao.com")
                echo "Sending email to: ${userEmail}"

                emailext(
                    subject: "Jenkins Build: ${currentBuild.fullDisplayName} - ${currentBuild.currentResult}",
                    body: """
                        <html><body>
                            <h2 style="color:blue;">Jenkins Build Notification</h2>
                            <p><strong>Build Name:</strong> ${currentBuild.fullDisplayName}</p>
                            <p><strong>Status:</strong> <span style="color:${currentBuild.currentResult == 'SUCCESS' ? 'green' : 'red'};">${currentBuild.currentResult}</span></p>
                            <p><strong>Started By:</strong> ${buildUserName} (${buildUserId})</p>
                            <p><strong>Build URL:</strong> <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
                            <p><strong>Report:</strong> Attached</p>
                            <br/><p style="color:gray;">--<br/>Jenkins Automated Notification</p>
                        </body></html>
                    """,
                    to: userEmail,
                    mimeType: 'text/html',
                    attachmentsPattern: "ipv6_report.html,ipv6_results.json"
                )
            }
        }
        success { echo "Script Success" }
        failure { echo "Script Failure" }
    }
}