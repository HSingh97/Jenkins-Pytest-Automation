pipeline {
    agent { node { label "${TARGET_STAND}" } }

    parameters {
        string(name: 'LOCAL_IP', defaultValue: '192.168.1.10', description: 'Device IPv4 Address')
        string(name: 'IPV6_ADDR', defaultValue: '2001:db8:1::1011', description: 'Static IPv6 Address (without prefix)')
        string(name: 'PREFIX', defaultValue: '64', description: 'Prefix Length (number only)')
        string(name: 'GATEWAY', defaultValue: '2001:db8:1::1', description: 'IPv6 Gateway')
        string(name: 'ITERATIONS', defaultValue: '1', description: 'Number of test iterations')
    }

    stages {
        stage('Prepare') {
            steps {
                echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                echo "TARGET STAND : ${TARGET_STAND}"
                echo "Local IP     : ${params.LOCAL_IP}"
                echo "IPv6 Address : ${params.IPV6_ADDR}/${params.PREFIX}"
                echo "Gateway      : ${params.GATEWAY}"
                echo "Iterations   : ${params.ITERATIONS}"
                echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            }
        }

        stage('Install Tools') {
            steps {
                sh 'apt-get update && apt-get install -y snmp iputils-ping sshpass > /dev/null 2>&1 || true'
            }
        }

        stage('IPv4 + IPv6 Static Test') {
            steps {
                script {
                    def count = params.ITERATIONS.toInteger()
                    sh 'rm -f ipv6_results.json test-*.log || true'
                    sh 'echo \'{"iterations": []}\' > ipv6_results.json'

                    for (int i = 1; i <= count; i++) {
                        echo "RUNNING ITERATION ${i} of ${count}"
                        sh """
                            python3 testCases/test_SNMP_IpV4_IpV6.py \
                                --local-ip '${params.LOCAL_IP}' \
                                --ipv6 '${params.IPV6_ADDR}' \
                                --prefix ${params.PREFIX} \
                                --gateway '${params.GATEWAY}' \
                                --iter ${i} 2>&1 | tee test-${i}.log
                        """
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def jsonData = readJSON file: 'ipv6_results.json'
                    def total = jsonData.iterations.size()
                    def passed = jsonData.iterations.count { it.status == 'PASS' }
                    def rate = total > 0 ? String.format("%.1f", passed * 100.0 / total) : "0.0"
                    def now = new Date().format("dd MMM yyyy, HH:mm:ss", TimeZone.getTimeZone("Asia/Kolkata"))

                    def tableRows = ""
                    jsonData.iterations.each { r ->
                        def logFile = "test-${r.iteration}.log"
                        def logContent = fileExists(logFile) ? readFile(logFile).replace("<", "&lt;").replace(">", "&gt;") : "Log missing"
                        tableRows += """
                            <tr>
                                <td style="padding:12px;border:1px solid #ddd;text-align:center;">${r.iteration}</td>
                                <td style="padding:12px;border:1px solid #ddd;color:${r.ipv4_initial_ping?'#16a34a':'#dc2626'};font-weight:bold;">${r.ipv4_initial_ping?'PASS':'FAIL'}</td>
                                <td style="padding:12px;border:1px solid #ddd;color:#16a34a;font-weight:bold;">SET</td>
                                <td style="padding:12px;border:1px solid #ddd;color:${r.ipv6_final_ping?'#16a34a':'#dc2626'};font-weight:bold;">${r.ipv6_final_ping?'PASS':'FAIL'}</td>
                                <td style="padding:12px;border:1px solid #ddd;font-weight:bold;color:${r.status=='PASS'?'#16a34a':'#dc2626'};font-size:18px;">${r.status}</td>
                                <td style="padding:12px;border:1px solid #ddd;text-align:center;">
                                    <button onclick="document.getElementById('log${r.iteration}').style.display='block'" style="padding:8px 16px;background:#3b82f6;color:white;border:none;border-radius:8px;cursor:pointer;">View Full Log</button>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="6">
                                    <pre id="log${r.iteration}" style="display:none;background:#1a1a1a;color:#4ade80;padding:20px;margin:10px;border-radius:10px;max-height:600px;overflow:auto;font-size:13px;">${logContent}</pre>
                                </td>
                            </tr>
                        """
                    }

                    writeFile file: 'ipv6_report.html', text: """
                    <!DOCTYPE html>
                    <html>
                    <head>
                        <title>IPv4 + Static IPv6 Test Report</title>
                        <meta charset="utf-8">
                        <style>
                            body {font-family: system-ui, sans-serif; background:#f3f4f6; margin:0; padding:20px;}
                            .container {max-width:1300px; margin:auto; background:white; border-radius:16px; overflow:hidden; box-shadow:0 10px 30px rgba(0,0,0,0.1);}
                            .header {background:linear-gradient(135deg,#1e40af,#3b82f6); color:white; padding:40px; text-align:center;}
                            .header h1 {margin:0; font-size:36px;}
                            .header p {font-size:20px; margin:10px 0 0;}
                            .info, .summary {padding:30px; background:#f8fafc;}
                            table {width:100%; border-collapse:collapse; margin:20px 0;}
                            th {background:#1e40af; color:white; padding:16px; text-align:center;}
                            td {padding:14px; border-bottom:1px solid #e5e7eb;}
                            .pass {color:#16a34a; font-weight:bold;}
                            .fail {color:#dc2626; font-weight:bold;}
                        </style>
                    </head>
                    <body>
                        <div class="container">
                            <div class="header">
                                <h1>IPv4 + Static IPv6 Test Report</h1>
                                <p>${now} | Stand: ${TARGET_STAND}</p>
                            </div>
                            <div class="info">
                                <h2>Test Parameters</h2>
                                <table>
                                    <tr><td><b>Local IPv4</b></td><td>${params.LOCAL_IP}</td></tr>
                                    <tr><td><b>IPv6 Address</b></td><td>${params.IPV6_ADDR}/${params.PREFIX}</td></tr>
                                    <tr><td><b>Gateway</b></td><td>${params.GATEWAY}</td></tr>
                                    <tr><td><b>Iterations</b></td><td>${params.ITERATIONS}</td></tr>
                                </table>
                            </div>
                            <div class="summary">
                                <h2>Test Results → ${passed}/${total} Passed (${rate}% Success)</h2>
                                <table>
                                    <tr>
                                        <th>Iteration</th>
                                        <th>IPv4 Initial</th>
                                        <th>IPv6 Set</th>
                                        <th>IPv6 Final</th>
                                        <th>Status</th>
                                        <th>Full Log</th>
                                    </tr>
                                    ${tableRows}
                                </table>
                            </div>
                        </div>
                    </body>
                    </html>
                    """
                }
            }
        }
    }

    post {
        always {
            publishHTML(target: [
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: '.',
                reportFiles: 'ipv6_report.html',
                reportName: 'IPv4_IPv6 Test Report'
            ])

            echo "Cleaning up logs..."
            sh 'rm -f test-*.log || true'

            script {
                def userId = currentBuild.getBuildCauses().find { it._class.contains('UserIdCause') }?.userId ?: "unknown"
                def emailMap = [
                    "puneet": "puneet.sharma@senao.com",
                    "harman": "harmanjot.singh@senao.com",
                    "mahesh": "mahesh.battala@senao.com",
                    "sandeep": "sandeep.manchikanti@senao.com",
                    "sampath": "sampath.marella@senao.com",
                    "jayanth": "jayanth.munnaluru@senao.com",
                    "srilatha": "srilatha.tadiboina@senao.com",
                    "phani": "phani.darla@senao.com",
                    "dinesh": "dinesh.redddy@senao.com"
                ]
                def email = emailMap.get(userId, "puneet.sharma@senao.com")

                emailext(
                    subject: "IPv6 Test #${BUILD_NUMBER} - ${currentBuild.currentResult}",
                    body: """
                    <h2>IPv4 + Static IPv6 Test Completed</h2>
                    <p><strong>Status:</strong> ${currentBuild.currentResult}</p>
                    <p><strong>Iterations Passed:</strong> ${readJSON(file: 'ipv6_results.json')?.iterations?.count { it.status == 'PASS' } ?: 0} / ${params.ITERATIONS}</p>
                    <p>Report and JSON attached.</p>
                    """,
                    to: email,
                    mimeType: 'text/html',
                    attachmentsPattern: 'ipv6_report.html,ipv6_results.json'
                )
            }
        }
        success { echo "ALL TESTS PASSED SUCCESSFULLY!" }
        failure { echo "TEST FAILED - CHECK LOGS" }
    }
}