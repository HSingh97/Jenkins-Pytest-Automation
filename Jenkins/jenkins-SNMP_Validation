                         padding: 11px 16px 11px 46px; font-size: 14px; font-family: 'Inter', sans-serif;
                         background: #fff; outline: none; transition: all 0.2s; }
    .search-wrap input:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.15); }
    .search-wrap svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
                       color: #94a3b8; pointer-events: none; width: 20px; height: 20px; }
    .type-select    { padding: 11px 16px; font-size: 14px; font-family: 'Inter', sans-serif;
                      border: 1px solid #cbd5e1; border-radius: 10px; background: #fff;
                      color: #1e293b; cursor: pointer; min-width: 160px; outline: none; transition: all 0.2s; }
    .type-select:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.15); }
    .count-pill     { background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 999px;
                      padding: 9px 20px; font-size: 14px; font-weight: 600; color: #1d4ed8; white-space: nowrap; }

    /* ── CHIPS ── */
    .chip-bar       { display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
                      padding: 14px 0; margin-bottom: 16px; }
    .chip-label     { font-size: 11px; font-weight: 700; text-transform: uppercase;
                      letter-spacing: 0.8px; color: #64748b; margin-right: 4px; white-space: nowrap; }
    .chip           { border: 1.5px solid #e2e8f0; background: #f8fafc; border-radius: 999px;
                      padding: 5px 16px; font-size: 12px; font-weight: 600; color: #475569;
                      cursor: pointer; transition: all 0.15s; user-select: none; }
    .chip:hover     { border-color: #3b82f6; color: #1d4ed8; background: #eff6ff; }
    .chip.active    { background: #3b82f6; border-color: #3b82f6; color: #fff;
                      box-shadow: 0 2px 8px rgba(59,130,246,0.3); }

    /* ── DATA TABLE ── */
    .data-table-wrap { border-radius: 12px; overflow: hidden; border: 1px solid #e2e8f0; }
    table           { width: 100%; border-collapse: collapse; background: #fff; }
    thead tr        { background: #f1f5f9; }
    th              { padding: 13px 20px; font-weight: 600; color: #475569; font-size: 12px;
                      text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;
                      text-align: left; }
    tbody tr        { border-bottom: 1px solid #f1f5f9; transition: background 0.12s; }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover td { background: #f0f9ff; }
    tbody tr:hover .col-oid { color: #3b82f6 !important; }
    td              { padding: 12px 20px; vertical-align: middle; }
    .col-name       { font-size: 13.5px; font-weight: 600; color: #0f172a; min-width: 180px; }
    .col-oid        { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #64748b; }
    .col-type       { text-align: center; min-width: 120px; }
    .col-val        { font-size: 13px; color: #334155; max-width: 400px; word-break: break-all; }
    .no-name        { color: #94a3b8; font-style: italic; }
    .no-results     { text-align: center; padding: 60px 20px; color: #94a3b8; font-size: 15px; }

    /* ── BADGES ── */
    .badge          { display: inline-block; padding: 4px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; letter-spacing: 0.3px; }
    .badge-string   { background: #dbeafe; color: #1e40af; }
    .badge-integer  { background: #fef9c3; color: #92400e; }
    .badge-gauge    { background: #dcfce7; color: #166534; }
    .badge-counter  { background: #ede9fe; color: #5b21b6; }
    .badge-timeticks { background: #ffedd5; color: #9a3412; }
    .badge-ip       { background: #fce7f3; color: #9d174d; }
    .badge-oid      { background: #f1f5f9; color: #475569; }
    .badge-hex      { background: #ecfdf5; color: #065f46; }
  </style>
</head>
<body>
<div class="page">

  <!-- HEADER -->
  <div class="header">
    <img src="${companyLogoUrl}" alt="Senao Networks, Inc."/>
    <div class="header-info">
      <h1>Automated Test Report</h1>
      <p><strong>Pipeline:</strong> ${pipelineName}</p>
      <p><strong>Date &amp; Time:</strong> ${currentDateTime}</p>
    </div>
  </div>

  <!-- BUILD PARAMS -->
  <h2>Build Parameters</h2>
  <table class="params-table">
    <tr><th>Parameter</th><th>Value</th></tr>
    ${buildParams.collect { "<tr><td><strong>${it.key}</strong></td><td>${it.value}</td></tr>" }.join('\n')}
  </table>

  <!-- SNMP DATA -->
  <h2>SNMP Data</h2>

  <!-- ACCORDION 1 — READ -->
  <div class="accordion">
    <div class="acc-header" data-section="read">
      <div class="acc-title">
        <span class="acc-num">1</span>
        <span class="acc-label">Community Read</span>
        <span class="acc-meta">&mdash; ${readCount} OIDs</span>
      </div>
      <span class="acc-arrow">&#9660;</span>
    </div>
    <div class="acc-body" id="body-read">
      <div class="acc-inner">
        <div class="toolbar">
          <div class="search-wrap">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
            <input type="text" id="searchRead" placeholder="Search name, OID, or value…" oninput="applyFilters('read')"/>
          </div>
          <select class="type-select" id="typeRead" onchange="applyFilters('read')">
            <option value="">All Types</option>
            <option>STRING</option><option>INTEGER</option><option>Gauge32</option>
            <option>Counter32</option><option>Counter64</option><option>Timeticks</option>
            <option>IpAddress</option><option>OID</option><option>Hex-STRING</option>
          </select>
          <div class="count-pill" id="countRead">${readCount} entries</div>
        </div>
        <div class="chip-bar" id="chipRead">
          <span class="chip-label">Category</span>
          ${chipBar}
        </div>
        <div class="data-table-wrap">
          <table>
            <thead><tr><th>Name</th><th>OID</th><th style="text-align:center;">Type</th><th>Value</th></tr></thead>
            <tbody id="tbodyRead">${readRows}</tbody>
          </table>
          <div class="no-results" id="noRead" style="display:none;">No matching entries found.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ACCORDION 2 — WRITE -->
  <div class="accordion">
    <div class="acc-header" data-section="write">
      <div class="acc-title">
        <span class="acc-num">2</span>
        <span class="acc-label">Community Write</span>
        <span class="acc-meta">&mdash; ${writeCount} OIDs</span>
      </div>
      <span class="acc-arrow">&#9660;</span>
    </div>
    <div class="acc-body" id="body-write">
      <div class="acc-inner">
        <div class="toolbar">
          <div class="search-wrap">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
            <input type="text" id="searchWrite" placeholder="Search name, OID, or value…" oninput="applyFilters('write')"/>
          </div>
          <select class="type-select" id="typeWrite" onchange="applyFilters('write')">
            <option value="">All Types</option>
            <option>STRING</option><option>INTEGER</option><option>Gauge32</option>
            <option>Counter32</option><option>Counter64</option><option>Timeticks</option>
            <option>IpAddress</option><option>OID</option><option>Hex-STRING</option>
          </select>
          <div class="count-pill" id="countWrite">${writeCount} entries</div>
        </div>
        <div class="chip-bar" id="chipWrite">
          <span class="chip-label">Category</span>
          ${chipBar}
        </div>
        <div class="data-table-wrap">
          <table>
            <thead><tr><th>Name</th><th>OID</th><th style="text-align:center;">Type</th><th>Value</th></tr></thead>
            <tbody id="tbodyWrite">${writeRows}</tbody>
          </table>
          <div class="no-results" id="noWrite" style="display:none;">No matching entries found.</div>
        </div>
      </div>
    </div>
  </div>

</div>

<script>
  var activePrefixes = { read: 'all', write: 'all' };

  // ── Accordion ──────────────────────────────────────────────────────────────
  document.querySelectorAll('.acc-header').forEach(function(header) {
    header.addEventListener('click', function() {
      var section = header.getAttribute('data-section');
      var body    = document.getElementById('body-' + section);
      var isOpen  = body.classList.contains('open');

      document.querySelectorAll('.acc-body').forEach(function(b)  { b.classList.remove('open'); });
      document.querySelectorAll('.acc-header').forEach(function(h) { h.classList.remove('open'); });

      if (!isOpen) {
        body.classList.add('open');
        header.classList.add('open');
      }
    });
  });

  // Open first accordion by default
  (function() {
    var first = document.querySelector('.acc-header');
    if (first) {
      first.classList.add('open');
      var sec = first.getAttribute('data-section');
      document.getElementById('body-' + sec).classList.add('open');
    }
  })();

  // ── Chip filters ───────────────────────────────────────────────────────────
  document.getElementById('chipRead').querySelectorAll('.chip').forEach(function(chip) {
    chip.addEventListener('click', function() { setChip('read', this); });
  });
  document.getElementById('chipWrite').querySelectorAll('.chip').forEach(function(chip) {
    chip.addEventListener('click', function() { setChip('write', this); });
  });

  function setChip(section, el) {
    var cap = section.charAt(0).toUpperCase() + section.slice(1);
    document.getElementById('chip' + cap).querySelectorAll('.chip').forEach(function(c) { c.classList.remove('active'); });
    el.classList.add('active');
    activePrefixes[section] = el.dataset.prefix;
    applyFilters(section);
  }

  function applyFilters(section) {
    var cap    = section.charAt(0).toUpperCase() + section.slice(1);
    var search = document.getElementById('search' + cap).value.toLowerCase();
    var type   = document.getElementById('type'   + cap).value;
    var rows   = document.getElementById('tbody'  + cap).querySelectorAll('tr');
    var visible = 0;
    rows.forEach(function(row) {
      var rp = row.dataset.prefix || 'other';
      var rt = row.dataset.type   || '';
      var tx = row.textContent.toLowerCase();
      var ok = (activePrefixes[section] === 'all' || rp === activePrefixes[section])
            && (!type   || rt === type)
            && (!search || tx.includes(search));
      row.style.display = ok ? '' : 'none';
      if (ok) visible++;
    });
    document.getElementById('count' + cap).textContent = visible + ' entries';
    document.getElementById('no'    + cap).style.display = visible === 0 ? 'block' : 'none';
  }
</script>
</body>
</html>"""

                    writeFile file: 'SNMP_Validation.html', text: htmlContent
                    echo "Report generated: SNMP_Validation.html"
                }
            }
        }
    }

    post {
        always {
            script {
                archiveArtifacts artifacts: 'SNMP_Validation.json, SNMP_Validation.html, snmp_validation.log',
                                 fingerprint: true,
                                 allowEmptyArchive: true

                publishHTML(target: [
                    allowMissing         : true,
                    alwaysLinkToLastBuild: true,
                    keepAll              : true,
                    reportDir            : '.',
                    reportFiles          : 'SNMP_Validation.html',
                    reportName           : 'Automated Test Report'
                ])

                echo "-----------------------------------------"
                echo " Post Actions"
                echo "-----------------------------------------"

                if (fileExists('SNMP_Validation.json')) {
                    def jsonReport = readJSON file: 'SNMP_Validation.json'
                    def status     = jsonReport.overall_status ?: "UNKNOWN"
                    def readCount  = jsonReport.read_community?.oid_count  ?: 0
                    def writeCount = jsonReport.write_community?.oid_count ?: 0

                    def buildCauses   = currentBuild.getBuildCauses()
                    def userCause     = buildCauses.find { it._class == 'hudson.model.Cause$UserIdCause' }
                    def buildUserName = userCause?.userName ?: "Unknown User"
                    def buildUserId   = userCause?.userId   ?: "unknown"

                    def userEmails = [
                        "puneet"  : "puneet.sharma@senao.com",
                        "harman"  : "harmanjot.singh@senao.com",
                        "mahesh"  : "mahesh.battala@senao.com",
                        "sandeep" : "sandeep.manchikanti@senao.com",
                        "sampath" : "sampath.marella@senao.com",
                        "jayanth" : "jayanth.munnaluru@senao.com",
                        "srilatha": "srilatha.tadiboina@senao.com",
                        "phani"   : "phani.darla@senao.com",
                        "dinesh"  : "dinesh.redddy@senao.com"
                    ]
                    def userEmail = userEmails.get(buildUserId, "puneet.sharma@senao.com")
                    echo "Sending report email to: ${userEmail}"

                    def istZone  = TimeZone.getTimeZone("Asia/Kolkata")
                    def genTime  = new Date().format("dd MMM yyyy, HH:mm:ss z", istZone)

                    def emailBody = """
<html>
<body style="font-family: 'Segoe UI', Arial, sans-serif; color: #1f2937; line-height: 1.6; background: #f9fafb;">
  <div style="max-width: 620px; margin: 0 auto; padding: 24px;">
    <div style="background: linear-gradient(135deg,#1d4ed8,#3b82f6); border-radius: 12px 12px 0 0; padding: 28px 32px;">
      <h2 style="color: #fff; margin: 0; font-size: 22px; font-weight: 700;">SNMP Validation — Jenkins Notification</h2>
      <p style="color: #bfdbfe; margin: 6px 0 0; font-size: 14px;">${currentBuild.fullDisplayName}</p>
    </div>
    <div style="background: #fff; border: 1px solid #e5e7eb; border-top: none; border-radius: 0 0 12px 12px; padding: 28px 32px;">
      <table style="width:100%; border-collapse:collapse; margin-bottom:24px;">
        <tr>
          <td style="padding:10px 0; border-bottom:1px solid #f3f4f6; font-weight:600; color:#374151; width:45%;">Build Status</td>
          <td style="padding:10px 0; border-bottom:1px solid #f3f4f6;">
            <span style="background:${currentBuild.currentResult == 'SUCCESS' ? '#d1fae5' : '#fee2e2'};
                         color:${currentBuild.currentResult == 'SUCCESS' ? '#065f46' : '#991b1b'};
                         padding:4px 14px; border-radius:999px; font-weight:700; font-size:13px;">
              ${currentBuild.currentResult}
            </span>
          </td>
        </tr>
        <tr>
          <td style="padding:10px 0; border-bottom:1px solid #f3f4f6; font-weight:600; color:#374151;">SNMP Status</td>
          <td style="padding:10px 0; border-bottom:1px solid #f3f4f6;">
            <span style="background:${status == 'PASS' ? '#d1fae5' : '#fee2e2'};
                         color:${status == 'PASS' ? '#065f46' : '#991b1b'};
                         padding:4px 14px; border-radius:999px; font-weight:700; font-size:13px;">${status}</span>
          </td>
        </tr>
        <tr>
          <td style="padding:10px 0; border-bottom:1px solid #f3f4f6; font-weight:600; color:#374151;">Started By</td>
          <td style="padding:10px 0; border-bottom:1px solid #f3f4f6;">${buildUserName} (${buildUserId})</td>
        </tr>
        <tr>
          <td style="padding:10px 0; border-bottom:1px solid #f3f4f6; font-weight:600; color:#374151;">OIDs Collected (Read)</td>
          <td style="padding:10px 0; border-bottom:1px solid #f3f4f6; font-family:monospace;">${readCount}</td>
        </tr>
        <tr>
          <td style="padding:10px 0; font-weight:600; color:#374151;">OIDs Collected (Write)</td>
          <td style="padding:10px 0; font-family:monospace;">${writeCount}</td>
        </tr>
      </table>
      <h3 style="font-size:15px; color:#374151; margin-bottom:12px;">Quick Links</h3>
      <div style="display:flex; flex-direction:column; gap:8px;">
        <a href="${env.BUILD_URL}SNMP_Validation_Report"
           style="background:#eff6ff; border:1px solid #bfdbfe; color:#1d4ed8; padding:10px 16px;
                  border-radius:8px; text-decoration:none; font-weight:600; font-size:14px;">
          &#128196; View HTML Report
        </a>
        <a href="${env.BUILD_URL}"
           style="background:#f8fafc; border:1px solid #e2e8f0; color:#374151; padding:10px 16px;
                  border-radius:8px; text-decoration:none; font-weight:600; font-size:14px;">
          &#128279; Open Build Page
        </a>
        <a href="${env.BUILD_URL}console"
           style="background:#f8fafc; border:1px solid #e2e8f0; color:#374151; padding:10px 16px;
                  border-radius:8px; text-decoration:none; font-weight:600; font-size:14px;">
          &#128196; Console Output
        </a>
      </div>
      <p style="margin-top:28px; font-size:12px; color:#9ca3af; border-top:1px solid #f3f4f6; padding-top:16px;">
        Automated notification generated on ${genTime}
      </p>
    </div>
  </div>
</body>
</html>"""

                    emailext(
                        subject            : "Jenkins: ${currentBuild.fullDisplayName} — ${currentBuild.currentResult}",
                        body               : emailBody,
                        to                 : userEmail,
                        mimeType           : 'text/html',
                        attachmentsPattern : "SNMP_Validation.html, SNMP_Validation.json"
                    )
                } else {
                    echo "SNMP_Validation.json not found — skipping email."
                }

                sh 'rm -f snmp_validation.log || true'
                echo "-----------------------------------------"
                echo " Script Done!"
                echo "-----------------------------------------"
            }
        }
        success { echo "SNMP Validation — SUCCESS" }
        failure { echo "SNMP Validation — FAILED"  }
    }
}