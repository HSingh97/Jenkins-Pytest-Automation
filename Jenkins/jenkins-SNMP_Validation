pipeline {
    agent {
        node {
            label "${params.TARGET_STAND}"
        }
    }

    stages {

        stage('Preparation') {
            steps {
                script {
                    def deviceIP       = (params['Local IP Address'] ?: '').toString().trim()
                    def readCommunity  = (params['Read Community']   ?: '').toString().trim()
                    def writeCommunity = (params['Write Community']  ?: '').toString().trim()
                    def mibSource      = (params['MIB_Source']       ?: '').toString().trim()

                    echo "========================================"
                    echo " SNMP Validation — Preparation"
                    echo "========================================"
                    echo " DEVICE IP       : ${deviceIP}"
                    echo " READ COMMUNITY  : ${readCommunity}"
                    echo " WRITE COMMUNITY : ${writeCommunity}"
                    echo " MIB SOURCE      : ${mibSource}"
                    echo " TARGET STAND    : ${params.TARGET_STAND}"
                    echo "========================================"

                    if (!deviceIP || !readCommunity || !writeCommunity || !mibSource) {
                        error("Validation Failed: IP, Communities, and MIB Source parameters MUST be provided.")
                    }

                    // Smart File Handling: Download from URL OR read from Git workspace
                    if (mibSource.startsWith("http://") || mibSource.startsWith("https://")) {
                        echo "🌐 Detected URL. Downloading MIB file (Ignoring SSL Checks)..."
                        sh "wget --no-check-certificate -q -O downloaded_senao.mib '${mibSource}' || curl -k -s -o downloaded_senao.mib '${mibSource}'"
                        env.MIB_FILE_PATH = "${env.WORKSPACE}/downloaded_senao.mib"
                    } else {
                        echo "📂 Detected local filename. Using file from Git repository..."
                        env.MIB_FILE_PATH = "${env.WORKSPACE}/${mibSource}"
                    }

                    if (!fileExists(env.MIB_FILE_PATH)) {
                        error("❌ CRITICAL ERROR: MIB file not found at ${env.MIB_FILE_PATH}!\n\nIf using a local file, ensure it is committed to Git. If using a URL, ensure it is accessible.")
                    }

                    echo "✅ MIB File securely located at: ${env.MIB_FILE_PATH}"

                    // Clean workspace of old reports
                    sh "rm -f *.json *.html *.log || true"
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    echo "========================================"
                    echo " Installing Dependencies"
                    echo "========================================"
                    sh "sh utilities/requirements.txt"
                }
                sh '''
                    which snmpget >/dev/null 2>&1 || {
                        echo "--- Installing SNMP tools ---"
                        sudo apt-get update -qq
                        sudo apt-get install -y snmp snmp-mibs-downloader
                    }
                    which python3 >/dev/null 2>&1 || sudo apt-get install -y python3
                '''
            }
        }

        stage('Run SNMP Validation') {
            steps {
                script {
                    def deviceIP       = (params['Local IP Address'] ?: '').toString().trim()
                    def readCommunity  = (params['Read Community']   ?: '').toString().trim()
                    def writeCommunity = (params['Write Community']  ?: '').toString().trim()
                    def mibFilePath    = env.MIB_FILE_PATH
                    def scriptPath     = "testCases/test_SNMP_Validation.py"

                    echo "========================================"
                    echo " Running SNMP Validation on ${deviceIP}"
                    echo "========================================"

                    try {
                        sh """
                            set -x
                            python3 ${scriptPath} \
                                --device-ip       '${deviceIP}'        \
                                --read-community  '${readCommunity}'   \
                                --write-community '${writeCommunity}'  \
                                --mib-file        '${mibFilePath}'     \
                                | tee snmp_validation.log
                        """
                    } catch (err) {
                        echo "SNMP Validation error: ${err}"
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def deviceIP        = (params['Local IP Address'] ?: '').toString().trim()
                    def jsonReport      = readJSON file: 'SNMP_Validation.json'

                    def istZone         = TimeZone.getTimeZone("Asia/Kolkata")
                    def currentDateObj  = new Date()
                    def currentDateTime = currentDateObj.format("dd MMM yyyy, HH:mm:ss", istZone)
                    def dateStr         = currentDateObj.format("ddMMMyyyy", istZone)
                    def buildNo         = env.BUILD_NUMBER
                    def reportFileName  = "SNMPValidation_report_${buildNo}_${dateStr}.html"

                    def pipelineName    = env.JOB_NAME
                    def companyLogoUrl  = "https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png"

                    def bp = jsonReport.build_params ?: [:]
                    def buildParams = [
                        "Device Name" : bp["Device Name"] ?: "N/A",
                        "Serial No"   : bp["Serial No"]   ?: "N/A",
                        "IP Address"  : bp["IP Address"]  ?: deviceIP,
                        "FW Version"  : bp["FW Version"]  ?: "N/A",
                    ]

                    def unifiedData = jsonReport.unified_data ?: []
                    def readCom     = params['Read Community']
                    def writeCom    = params['Write Community']

                    def totalAlerts = 0

                    def buildSnmpRows = { dataList ->
                        def rows = ""
                        dataList.each { rec ->
                            def rName  = rec.name ?: ""
                            def rOid   = rec.oid  ?: ""
                            def rType  = rec.type ?: ""
                            def rData  = rec.data?.toString() ?: ""
                            def rPrefix = "other"

                            if (rName) {
                                def cleanName = rName.replaceAll(/^.*?:\s*/, "")
                                def m = (cleanName =~ /^([a-z]+)/)
                                if (m) rPrefix = m[0][1]
                            }

                            def badgeClass = [
                                "STRING"    : "badge-string",
                                "INTEGER"   : "badge-integer",
                                "Gauge32"   : "badge-gauge",
                                "Counter32" : "badge-counter",
                                "Counter64" : "badge-counter",
                                "Timeticks" : "badge-timeticks",
                                "IpAddress" : "badge-ip",
                                "OID"       : "badge-oid",
                                "Hex-STRING": "badge-hex"
                            ].get(rType, "badge-oid")

                            def nameDisplay = rName ?: "<em class='no-name'>—</em>"
                            def safeData = rData.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

                            def rawValStr = rData.trim().toLowerCase()
                            def isAlert = (rawValStr == "-1" || rawValStr.contains("error") || rawValStr == "n/a")

                            if (isAlert) { totalAlerts++ }

                            def valDisplay = isAlert ? "<span class='val-alert'>${safeData}</span>" : safeData
                            def rowStatus = isAlert ? "alert" : "pass"

                            def readIcon = rec.read_ok ? "<span class='status-icon pass'>✔</span>" : "<span class='status-icon fail'>✘</span>"
                            def writeIcon = rec.write_ok ? "<span class='status-icon pass'>✔</span>" : "<span class='status-icon fail'>✘</span>"

                            // Added data-status for JS filtering
                            rows += """
<tr class="main-row" data-prefix="${rPrefix}" data-type="${rType}" data-status="${rowStatus}">
  <td class="col-name">${nameDisplay}</td>
  <td class="col-oid">${rOid}</td>
  <td class="col-type"><span class="badge ${badgeClass}">${rType}</span></td>
  <td class="center-col">${readIcon}</td>
  <td class="center-col">${writeIcon}</td>
  <td class="col-val">${valDisplay}</td>
</tr>"""
                        }
                        return rows
                    }

                    def tableRows = buildSnmpRows(unifiedData)
                    def totalEntries = unifiedData.size()

                    def chipBar = """
    <span class="chip active" data-prefix="all"     >All</span>
    <span class="chip"        data-prefix="wireless" >Wireless</span>
    <span class="chip"        data-prefix="assoc"    >Assoc</span>
    <span class="chip"        data-prefix="sys"      >System</span>
    <span class="chip"        data-prefix="ethernet" >Ethernet</span>
    <span class="chip"        data-prefix="network"  >Network</span>
    <span class="chip"        data-prefix="vlan"     >VLAN</span>
    <span class="chip"        data-prefix="dcs"      >DCS</span>
    <span class="chip"        data-prefix="dfs"      >DFS</span>
    <span class="chip"        data-prefix="dhcp"     >DHCP</span>
    <span class="chip"        data-prefix="snmp"     >SNMP</span>
    <span class="chip"        data-prefix="radius"   >RADIUS</span>
    <span class="chip"        data-prefix="link"     >Link</span>
    <span class="chip"        data-prefix="gps"      >GPS</span>
    <span class="chip"        data-prefix="ntp"      >NTP</span>
    <span class="chip"        data-prefix="qinq"     >QinQ</span>
    <span class="chip"        data-prefix="other"    >Other</span>"""

                    def htmlContent = """<!DOCTYPE html>
