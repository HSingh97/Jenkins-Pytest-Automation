      </div>
      <div class="chip-section" id="chipWrite"><span class="chip-label">Category</span>${chipBar}</div>
      <div class="table-card">
        <table>
          <thead><tr><th></th><th>Name</th><th>OID</th><th style="text-align:center;">Type</th><th>Value</th></tr></thead>
          <tbody id="bodyWrite">${writeRows}</tbody>
        </table>
        <div class="no-results" id="noWrite" style="display:none;">No matching entries found.</div>
      </div>
    </div>
  </div>

</div>

<script>
var activePrefixes = { read: 'all', write: 'all' };

document.getElementById('chipRead').querySelectorAll('.chip').forEach(function(chip) {
  chip.addEventListener('click', function() { setChip('read', this); });
});
document.getElementById('chipWrite').querySelectorAll('.chip').forEach(function(chip) {
  chip.addEventListener('click', function() { setChip('write', this); });
});

function setChip(section, el) {
  var cap = section.charAt(0).toUpperCase() + section.slice(1);
  document.getElementById('chip' + cap).querySelectorAll('.chip').forEach(function(c) { c.classList.remove('active'); });
  el.classList.add('active');
  activePrefixes[section] = el.dataset.prefix;
  applyFilters(section);
}

function applyFilters(section) {
  var cap    = section.charAt(0).toUpperCase() + section.slice(1);
  var search = document.getElementById('search' + cap).value.toLowerCase();
  var type   = document.getElementById('type'   + cap).value;
  var rows   = document.getElementById('body'   + cap).querySelectorAll('.main-row');
  var visible = 0;

  rows.forEach(function(row) {
    var detailsRow = row.nextElementSibling;
    var rp = row.dataset.prefix || 'other';
    var rt = row.dataset.type   || '';
    var tx = row.textContent.toLowerCase();

    var ok = (activePrefixes[section] === 'all' || rp === activePrefixes[section])
          && (!type   || rt === type)
          && (!search || tx.includes(search));

    if (ok) {
      row.style.display = '';
      visible++;
    } else {
      row.style.display = 'none';
      detailsRow.style.display = 'none';
      row.querySelector('.toggle-btn').textContent = '+';
    }
  });

  document.getElementById('count' + cap).textContent = visible + ' entries';
  document.getElementById('no'    + cap).style.display = visible === 0 ? 'block' : 'none';
}

function toggleRow(btn) {
  var tr = btn.closest('.main-row');
  var detailsTr = tr.nextElementSibling;
  if (detailsTr.style.display === 'none' || detailsTr.style.display === '') {
    detailsTr.style.display = 'table-row';
    btn.textContent = '-';
  } else {
    detailsTr.style.display = 'none';
    btn.textContent = '+';
  }
}

document.querySelectorAll('.accordion-header').forEach(header => {
  header.addEventListener('click', () => {
    const targetId = header.getAttribute('data-target');
    const content = document.getElementById('content-' + targetId);
    const icon = document.getElementById('icon-' + targetId);
    const isActive = content.classList.contains('active');

    document.querySelectorAll('.accordion-content').forEach(c => c.classList.remove('active'));
    document.querySelectorAll('.accordion-header').forEach(h => h.classList.remove('active'));
    document.querySelectorAll('.accordion-icon').forEach(i => i.textContent = '+');

    if (!isActive) {
      content.classList.add('active');
      header.classList.add('active');
      icon.textContent = '-';
    }
  });
});
</script>
</body>
</html>"""

