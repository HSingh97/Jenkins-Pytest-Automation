                        body               : emailBody,
                        to                 : userEmail,
                        mimeType           : 'text/html',
                        attachmentsPattern : "SNMP_Validation.html, SNMP_Validation.json"
                    )
                } else {
                    echo "SNMP_Validation.json not found — skipping report parsing and email."
                }

                sh 'rm -f snmp_validation.log || true'
            }
        }
        success { echo "SNMP Validation — SUCCESS" }
        failure { echo "SNMP Validation — FAILED"  }
    }
}