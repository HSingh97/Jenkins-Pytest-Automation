</head>
<body>
<div class="page">

  <div class="header">
    <img src="${companyLogoUrl}" alt="Senao Networks, Inc."/>
    <div class="header-info">
      <h1>Automated Test Report</h1>
      <p><strong>Pipeline:</strong> ${pipelineName}</p>
      <p><strong>Date &amp; Time:</strong> ${currentDateTime}</p>
    </div>
  </div>

  <h2>Build Parameters</h2>
  <table class="params-table">
    <tr><th>Parameter</th><th>Value</th></tr>
    ${buildParams.collect { "<tr><td><strong>${it.key}</strong></td><td>${it.value}</td></tr>" }.join('\n')}
  </table>

  <h2>SNMP Data</h2>

  <div class="accordion">
    <div class="acc-header" data-section="read">
      <div class="acc-title">
