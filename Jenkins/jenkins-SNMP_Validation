    h2::after       { content: ''; position: absolute; left: 0; bottom: 0;
                      width: 56px; height: 3px; background: #3b82f6; border-radius: 3px; }

    /* ── BUILD PARAMS TABLE ── */
    .params-table   { width: 100%; border-collapse: collapse; background: #fff;
                      border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden;
                      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04); }
    .params-table th, .params-table td { padding: 14px 20px; border-bottom: 1px solid #e2e8f0;
