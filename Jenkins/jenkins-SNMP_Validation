    post {
        always {
            script {
                def istZone         = TimeZone.getTimeZone("Asia/Kolkata")
                def fileDate        = Calendar.getInstance(istZone).getTime().format("yyyyMMdd", istZone)
                def reportFileName  = "SNMP_Validation.html"

                archiveArtifacts artifacts: 'SNMP_Validation.json, SNMP_Validation.html, snmp_validation.log',
                                 fingerprint: true,
                                 allowEmptyArchive: true

                publishHTML(target: [
                    allowMissing         : true,
                    alwaysLinkToLastBuild: true,
                    keepAll              : true,
                    reportDir            : '.',
                    reportFiles          : reportFileName,
                    reportName           : 'Automated Test Report'
                ])

                echo "Cleaning up log files..."
                sh 'rm -f snmp_validation.log || true'

                echo "-----------------------------------------"
