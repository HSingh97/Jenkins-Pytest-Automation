    .badge-oid      { background: #f1f5f9; color: #475569; }
    .badge-hex      { background: #ecfdf5; color: #065f46; }
  </style>
</head>
<body>
<div class="container">

  <div class="header">
    <img src="${companyLogoUrl}" alt="Senao Networks, Inc."/>
    <div class="header-info">
      <h1>SNMP Validation Report</h1>
      <p><strong>Pipeline:</strong> ${pipelineName}</p>
      <p><strong>Date & Time:</strong> ${currentDateTime}</p>
    </div>
  </div>

  <h2>Build Parameters</h2>
  <table style="max-width: 600px;">
    <tr><th>Parameter</th><th>Value</th></tr>
    ${buildParams.collect { "<tr><td style='width: 150px;'><b>${it.key}</b></td><td>${it.value}</td></tr>" }.join('\n')}
  </table>

  <h2>SNMP Data</h2>

  <div class="accordion-section">
    <div class="accordion-header" data-target="read">
      <span>1. Community Read — ${readCom}</span>
      <span class="accordion-icon" id="icon-read">+</span>
    </div>
    <div class="accordion-content" id="content-read">
      <div class="toolbar">
        <div class="search-wrap">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <input type="text" id="searchRead" placeholder="Search name, OID, or value…" oninput="applyFilters('read')"/>
        </div>
        <select class="type-select" id="typeRead" onchange="applyFilters('read')">
          <option value="">All Types</option>
          <option>STRING</option><option>INTEGER</option><option>Gauge32</option>
