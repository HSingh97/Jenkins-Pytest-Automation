<script>
var activePrefix = 'all';
var showOnlyAlerts = false;

document.getElementById('chipContainer').querySelectorAll('.chip').forEach(function(chip) {
  chip.addEventListener('click', function() {
    document.getElementById('chipContainer').querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
    this.classList.add('active');
    activePrefix = this.dataset.prefix;
    applyFilters();
  });
});

function toggleAlertFilter() {
  showOnlyAlerts = !showOnlyAlerts;
  var btn = document.getElementById('alertToggleBtn');
  if (showOnlyAlerts) {
    btn.classList.add('active');
    btn.innerHTML = "❌ Showing Alerts Only";
  } else {
    btn.classList.remove('active');
    btn.innerHTML = "⚠️ ${totalAlerts} Alerts Found";
  }
  applyFilters();
}

function applyFilters() {
  var search  = document.getElementById('searchInput').value.toLowerCase();
  var typeVal = document.getElementById('typeSelect').value;
  var rows    = document.getElementById('tableBody').querySelectorAll('.main-row');
  var visible = 0;

  rows.forEach(function(row) {
    var rp = row.dataset.prefix || 'other';
    var rt = row.dataset.type   || '';
    var rStatus = row.dataset.status || 'pass';
    var tx = row.textContent.toLowerCase();

    var ok = (activePrefix === 'all' || rp === activePrefix)
          && (!typeVal || rt === typeVal)
          && (!search  || tx.includes(search))
          && (!showOnlyAlerts || rStatus === 'alert');

    if (ok) {
      row.style.display = '';
      visible++;
    } else {
      row.style.display = 'none';
    }
  });

  document.getElementById('countDisplay').textContent = visible + ' entries';
  document.getElementById('noResults').style.display = visible === 0 ? 'block' : 'none';
}
</script>
</body>
</html>"""

