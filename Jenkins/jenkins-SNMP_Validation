pipeline {
    agent {
        node {
            label "${params.TARGET_STAND}"
        }
    }

    stages {

        stage('Preparation') {
            steps {
                script {
                    def deviceIP       = (params['Local IP Address']       ?: '').toString().trim()
                    def readCommunity  = (params['Read Community']  ?: '').toString().trim()
                    def writeCommunity = (params['Write Community'] ?: '').toString().trim()

                    echo "========================================"
                    echo " SNMP Validation — Preparation"
                    echo "========================================"
                    echo " LOCAL IP        : ${deviceIP}"
                    echo " READ COMMUNITY  : ${readCommunity}"
                    echo " WRITE COMMUNITY : ${writeCommunity}"
                    echo " MIB FILE        : ${params['MIB File'] ?: '(not provided)'}"
                    echo " TARGET STAND    : ${params.TARGET_STAND}"
                    echo "========================================"

                    if (!deviceIP) { error "Missing required parameter: Local IP Address" }

                    sh "rm -f SNMP_Validation.json SNMP_Validation.html snmp_validation.log || true"
                    sh "echo '--- Workspace MIB check ---' && ls -la '${env.WORKSPACE}/' | grep -i mib || echo '[WARN] No .mib file found in workspace root'"
                    echo "Workspace cleaned."
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    echo "========================================"
                    echo " Installing Dependencies"
                    echo "========================================"
                    sh "sh utilities/requirements.txt"
                }
                sh '''
                    which snmpget >/dev/null 2>&1 || {
                        echo "--- Installing SNMP tools ---"
                        sudo apt-get update -qq
                        sudo apt-get install -y snmp snmp-mibs-downloader
                    }
                    which python3 >/dev/null 2>&1 || sudo apt-get install -y python3
                '''
            }
        }

        stage('Run SNMP Validation') {
            steps {
                script {
                    def deviceIP       = (params['Local IP Address']       ?: '').toString().trim()
                    def readCommunity  = (params['Read Community']  ?: '').toString().trim()
                    def writeCommunity = (params['Write Community'] ?: '').toString().trim()
                    def scriptPath     = "testCases/test_SNMP_Validation.py"

                    // Jenkins File Parameter stores uploaded file at:
                    // /var/lib/jenkins/jobs/<job>/builds/<N>/fileParameters/<paramName>/<filename>
                    // We copy it to workspace so Python can read it.
                    def mibFilePath = "${env.WORKSPACE}/SENAO-MIB.mib"

                    sh """
                        # Build the exact fileParameters directory path
                        JOB_ESCAPED=\$(echo "${env.JOB_NAME}" | sed 's|/|/jobs/|g')
                        MIB_DIR="/var/lib/jenkins/jobs/\${JOB_ESCAPED}/builds/${env.BUILD_NUMBER}/fileParameters/MIB File"

                        echo "Looking in: \${MIB_DIR}"

                        if [ -d "\${MIB_DIR}" ]; then
                            MIB_FILE=\$(ls -1 "\${MIB_DIR}/" 2>/dev/null | head -1)
                            if [ -n "\${MIB_FILE}" ]; then
                                cp "\${MIB_DIR}/\${MIB_FILE}" '${mibFilePath}'
                                echo "[OK] MIB copied: \${MIB_FILE}"
                            fi
                        else
                            echo "Directory not found, trying alternate name..."
                            MIB_DIR2="/var/lib/jenkins/jobs/\${JOB_ESCAPED}/builds/${env.BUILD_NUMBER}/fileParameters/MIB_File"
                            if [ -d "\${MIB_DIR2}" ]; then
                                MIB_FILE=\$(ls -1 "\${MIB_DIR2}/" 2>/dev/null | head -1)
                                if [ -n "\${MIB_FILE}" ]; then
                                    cp "\${MIB_DIR2}/\${MIB_FILE}" '${mibFilePath}'
                                    echo "[OK] MIB copied from alt path: \${MIB_FILE}"
                                fi
                            fi
                        fi
                    """

                    def mibOk = sh(script: "test -f '${mibFilePath}' && echo yes || echo no", returnStdout: true).trim()
                    if (mibOk == 'yes') {
                        echo "[OK] Using MIB file: ${mibFilePath}"
                    } else {
                        echo "[WARN] MIB file not found — OID names will be empty"
                        mibFilePath = "/dev/null"
                    }

                    echo "========================================"
                    echo " Running SNMP Validation on ${deviceIP}"
                    echo "========================================"

                    try {
                        sh """
                            set -x
                            python3 ${scriptPath} \
                                --device-ip       '${deviceIP}'        \
                                --read-community  '${readCommunity}'   \
                                --write-community '${writeCommunity}'  \
                                --mib-file        '${mibFilePath}'     \
                                | tee snmp_validation.log
                        """
                    } catch (err) {
                        echo "SNMP Validation error: ${err}"
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def deviceIP        = (params['Local IP Address'] ?: '').toString().trim()
                    def jsonReport      = readJSON file: 'SNMP_Validation.json'
                    def istZone         = TimeZone.getTimeZone("Asia/Kolkata")
                    def currentDateTime = new Date().format("dd MMM yyyy, HH:mm:ss z", istZone)
                    def pipelineName    = env.JOB_NAME
                    def companyLogoUrl  = "https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png"

                    def bp = jsonReport.build_params ?: [:]
                    def buildParams = [
                        "Device Name" : bp["Device Name"] ?: "N/A",
                        "Serial No"   : bp["Serial No"]   ?: "N/A",
                        "IP Address"  : bp["IP Address"]  ?: deviceIP,
                        "FW Version"  : bp["FW Version"]  ?: "N/A",
                    ]

                    def buildSnmpRows = { dataList ->
                        def rows = new StringBuilder()
                        dataList.each { rec ->
                            def rName  = (rec.name  ?: "").toString()
                            def rOid   = (rec.oid   ?: "").toString()
                                            .replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
                            def rType  = (rec.type  ?: "").toString()
                            def rData  = (rec.data  ?: "").toString()
                                            .replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
                            def rPrefix = "other"
                            if (rName) {
                                def m = (rName =~ /^([a-z]+)/)
                                if (m) rPrefix = m[0][1]
                            }
                            def badgeClass = [
                                "STRING"    : "badge-string",
                                "INTEGER"   : "badge-integer",
                                "Gauge32"   : "badge-gauge",
                                "Counter32" : "badge-counter",
                                "Counter64" : "badge-counter",
                                "Timeticks" : "badge-timeticks",
                                "IpAddress" : "badge-ip",
                                "OID"       : "badge-oid",
                                "Hex-STRING": "badge-hex"
                            ].get(rType, "badge-oid")
                            def nameDisplay = rName ?: "<em class='no-name'>&#8212;</em>"
                            rows.append("<tr data-prefix=\"${rPrefix}\" data-type=\"${rType}\">")
                            rows.append("<td class=\"col-name\">${nameDisplay}</td>")
                            rows.append("<td class=\"col-oid\">${rOid}</td>")
                            rows.append("<td class=\"col-type\"><span class=\"badge ${badgeClass}\">${rType}</span></td>")
                            rows.append("<td class=\"col-val\">${rData}</td>")
                            rows.append("</tr>\n")
                        }
                        return rows.toString()
                    }

                    def readData   = jsonReport.read_community  ?: [:]
                    def writeData  = jsonReport.write_community ?: [:]
                    def readRows   = buildSnmpRows(readData.data   ?: [])
                    def writeRows  = buildSnmpRows(writeData.data  ?: [])
                    def readCount  = readData.oid_count  ?: 0
                    def writeCount = writeData.oid_count ?: 0

                    def chipBar = '<span class="chip active" data-prefix="all">All</span>' +
                        '<span class="chip" data-prefix="wireless">Wireless</span>' +
                        '<span class="chip" data-prefix="assoc">Assoc</span>' +
                        '<span class="chip" data-prefix="sys">System</span>' +
                        '<span class="chip" data-prefix="ethernet">Ethernet</span>' +
                        '<span class="chip" data-prefix="network">Network</span>' +
                        '<span class="chip" data-prefix="vlan">VLAN</span>' +
                        '<span class="chip" data-prefix="dcs">DCS</span>' +
                        '<span class="chip" data-prefix="dfs">DFS</span>' +
                        '<span class="chip" data-prefix="dhcp">DHCP</span>' +
                        '<span class="chip" data-prefix="snmp">SNMP</span>' +
                        '<span class="chip" data-prefix="radius">RADIUS</span>' +
                        '<span class="chip" data-prefix="link">Link</span>' +
                        '<span class="chip" data-prefix="gps">GPS</span>' +
                        '<span class="chip" data-prefix="ntp">NTP</span>' +
                        '<span class="chip" data-prefix="qinq">QinQ</span>' +
                        '<span class="chip" data-prefix="other">Other</span>'

                    def htmlContent = """<!DOCTYPE html>
