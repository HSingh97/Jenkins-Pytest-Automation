    .toggle-btn:hover { background: #eff6ff; border-color: #3b82f6; }
    .chip-section { padding: 12px 20px; background: #ffffff; border-bottom: 1px solid #e2e8f0; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
    .chip-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #64748b; margin-right: 8px; }
    .chip { border: 1.5px solid #e2e8f0; background: #f8fafc; border-radius: 999px; padding: 6px 16px; font-size: 13px; font-weight: 600; color: #475569; cursor: pointer; user-select: none; }
    .chip:hover { border-color: #3b82f6; color: #1d4ed8; background: #eff6ff; }
    .chip.active { background: #3b82f6; border-color: #3b82f6; color: white; }
    .col-toggle { width: 40px; text-align: center; padding-right: 0; }
