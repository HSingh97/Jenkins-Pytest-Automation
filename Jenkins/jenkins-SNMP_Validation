pipeline {
    agent {
        node {
            label "${params.TARGET_STAND}"
        }
    }

    stages {

        stage('Preparation') {
            steps {
                script {
                    def deviceIP       = (params.Device_IP       ?: '').toString().trim()
                    def readCommunity  = (params.Read_Community  ?: '').toString().trim()
                    def writeCommunity = (params.Write_Community ?: '').toString().trim()
                    def mibFilePath    = "${env.WORKSPACE}/MIB_File"

                    echo "========================================"
                    echo " SNMP Validation — Preparation"
                    echo "========================================"
                    echo " DEVICE IP       : ${deviceIP}"
                    echo " READ COMMUNITY  : ${readCommunity}"
                    echo " WRITE COMMUNITY : ${writeCommunity}"
                    echo " MIB FILE PATH   : ${mibFilePath}"
                    echo " TARGET STAND    : ${params.TARGET_STAND}"
                    echo "========================================"

                    // FAIL-FAST VALIDATION: Ensure required parameters are not blank
                    if (!deviceIP || !readCommunity || !writeCommunity) {
                        error("Validation Failed: Device_IP, Read_Community, and Write_Community parameters MUST be provided.")
                    }

                    sh "rm -f SNMP_Validation.json SNMP_Validation.html snmp_validation.log || true"
                    echo "Workspace cleaned."
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    echo "========================================"
                    echo " Installing Dependencies"
                    echo "========================================"
                    sh "sh utilities/requirements.txt"
                }
                sh '''
                    which snmpget >/dev/null 2>&1 || {
                        echo "--- Installing SNMP tools ---"
                        sudo apt-get update -qq
                        sudo apt-get install -y snmp snmp-mibs-downloader
                    }
                    which python3 >/dev/null 2>&1 || sudo apt-get install -y python3
                '''
            }
        }

        stage('Run SNMP Validation') {
            steps {
                script {
                    def deviceIP       = (params.Device_IP       ?: '').toString().trim()
                    def readCommunity  = (params.Read_Community  ?: '').toString().trim()
                    def writeCommunity = (params.Write_Community ?: '').toString().trim()
                    def mibFilePath    = "${env.WORKSPACE}/MIB_File"
                    def scriptPath     = "testCases/test_SNMP_Validation.py"

                    echo "========================================"
                    echo " Running SNMP Validation on ${deviceIP}"
                    echo "========================================"

                    try {
                        sh """
                            set -x
                            python3 ${scriptPath} \
                                --device-ip       '${deviceIP}'        \
                                --read-community  '${readCommunity}'   \
                                --write-community '${writeCommunity}'  \
                                --mib-file        '${mibFilePath}'     \
                                | tee snmp_validation.log
                        """
                    } catch (err) {
                        echo "SNMP Validation error: ${err}"
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    def deviceIP        = (params.Device_IP ?: '').toString().trim()
                    def jsonReport      = readJSON file: 'SNMP_Validation.json'
                    def istZone         = TimeZone.getTimeZone("Asia/Kolkata")
                    def currentDateTime = new Date().format("dd MMM yyyy, HH:mm:ss z", istZone)
                    def pipelineName    = env.JOB_NAME
                    def companyLogoUrl  = "https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png"

                    def bp = jsonReport.build_params ?: [:]
                    def buildParams = [
                        "Device Name" : bp["Device Name"] ?: "N/A",
                        "Serial No"   : bp["Serial No"]   ?: "N/A",
                        "IP Address"  : bp["IP Address"]  ?: deviceIP,
                        "FW Version"  : bp["FW Version"]  ?: "N/A",
                    ]

                    def buildSnmpRows = { dataList ->
                        def rows = ""
                        dataList.each { rec ->
                            def rName  = rec.name ?: ""
                            def rOid   = rec.oid  ?: ""
                            def rType  = rec.type ?: ""
                            def rData  = rec.data?.toString() ?: ""
                            def rPrefix = "other"

                            if (rName) {
                                def m = (rName =~ /^([a-z]+)/)
                                if (m) rPrefix = m[0][1]
                            }

                            def badgeClass = [
                                "STRING"    : "badge-string",
                                "INTEGER"   : "badge-integer",
                                "Gauge32"   : "badge-gauge",
                                "Counter32" : "badge-counter",
                                "Counter64" : "badge-counter",
                                "Timeticks" : "badge-timeticks",
                                "IpAddress" : "badge-ip",
                                "OID"       : "badge-oid",
                                "Hex-STRING": "badge-hex"
                            ].get(rType, "badge-oid")

                            def nameDisplay = rName ?: "<em class='no-name'>—</em>"

                            def safeData = rData.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

                            rows += """
<tr class="main-row" data-prefix="${rPrefix}" data-type="${rType}">
  <td class="col-toggle"><button class="toggle-btn" onclick="toggleRow(this)">+</button></td>
  <td class="col-name">${nameDisplay}</td>
  <td class="col-oid">${rOid}</td>
  <td class="col-type"><span class="badge ${badgeClass}">${rType}</span></td>
  <td class="col-val" style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${safeData}</td>
</tr>
<tr class="details-row" data-prefix="${rPrefix}" data-type="${rType}" style="display:none;">
  <td colspan="5">
    <div class="details-content">
      <strong>OID:</strong> ${rOid}<br>
      <strong>Type:</strong> ${rType}<br>
      <strong>Value:</strong><br>
      <pre style="margin: 8px 0 0 0; white-space: pre-wrap; font-family: monospace;">${safeData}</pre>
    </div>
  </td>
</tr>"""
                        }
                        return rows
                    }

                    def readData   = jsonReport.read_community  ?: [:]
                    def writeData  = jsonReport.write_community ?: [:]
                    def readRows   = buildSnmpRows(readData.data   ?: [])
                    def writeRows  = buildSnmpRows(writeData.data  ?: [])
                    def readCount  = readData.oid_count  ?: 0
                    def writeCount = writeData.oid_count ?: 0
                    def readCom    = readData.community  ?: params.Read_Community
                    def writeCom   = writeData.community ?: params.Write_Community

                    def chipBar = """
    <span class="chip active" data-prefix="all"     >All</span>
    <span class="chip"        data-prefix="wireless" >Wireless</span>
    <span class="chip"        data-prefix="assoc"    >Assoc</span>
    <span class="chip"        data-prefix="sys"      >System</span>
    <span class="chip"        data-prefix="ethernet" >Ethernet</span>
    <span class="chip"        data-prefix="network"  >Network</span>
    <span class="chip"        data-prefix="vlan"     >VLAN</span>
    <span class="chip"        data-prefix="dcs"      >DCS</span>
    <span class="chip"        data-prefix="dfs"      >DFS</span>
    <span class="chip"        data-prefix="dhcp"     >DHCP</span>
    <span class="chip"        data-prefix="snmp"     >SNMP</span>
    <span class="chip"        data-prefix="radius"   >RADIUS</span>
    <span class="chip"        data-prefix="link"     >Link</span>
    <span class="chip"        data-prefix="gps"      >GPS</span>
    <span class="chip"        data-prefix="ntp"      >NTP</span>
    <span class="chip"        data-prefix="qinq"     >QinQ</span>
    <span class="chip"        data-prefix="other"    >Other</span>"""

                    def htmlContent = """<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>SNMP Validation Report</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 0; padding: 0; background: #f8fafc; color: #1e293b; line-height: 1.6; }
    .container { max-width: 1320px; margin: 32px auto; padding: 0 16px; }
