import jenkins.model.Jenkins

// Functions
def archiveArtifacts(pattern) {
    step([$class: 'ArtifactArchiver', artifacts: pattern, fingerprint: true, onlyIfSuccessful: false])
}

pipeline {
    agent { node { label "${TARGET_STAND}" } }

    stages {
        stage('Prepare tests') {
            steps {
                script {
                    echo "----------------------------------------"
                    echo "--- TARGET STAND: ${TARGET_STAND}"
                    echo "----------------------------------------"
                    if (!params['SU IP Address']) {
                        error "Missing required parameter: SU IP Address"
                    }
                }
            }
        }
        stage('Install Dependencies') {
            steps {
                script {
                    echo "----------------------------------------"
                    echo "Installing Dependencies"
                    echo "----------------------------------------"
                    sh 'python3 -m pip install pytest || true'
                    sh 'apt-get update && apt-get install -y snmp snmp-mibs-downloader || true'
                }
            }
        }
        stage('Roaming') {
            steps {
                script {
                    def suIP = params['SU IP Address']

                    echo "SU IP Address: ${suIP}"

                    def roamingCount = params.ROAMING_COUNT ?: 1
                    echo "Number of roaming iterations: ${roamingCount}"

                    echo "✅ Cleared old workspace"

                    echo "----------------------------------------"
                    echo "Testing Roaming - SNMP"
                    echo "----------------------------------------"

                    sh "echo [] > iteration_results.json"  // Initialize JSON array

                    for (int i = 1; i <= roamingCount.toInteger(); i++) {
                        echo "Running roaming test iteration ${i}"
                        try {
                            sh """
                                pytest -v -s testCases/test_roaming_snmp.py \
                                --su-ip '${suIP}' \
                                --iter ${i}
                            """
                        } catch (Exception e) {
                            echo "Roaming test iteration ${i} failed: ${e.message}"
                        }
                    }
                }
            }
        }
