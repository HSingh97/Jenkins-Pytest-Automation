                    def passCount = 0
                    if (jsonReport.iterations) {
                        totalTests = jsonReport.iterations.size()
                        passCount = jsonReport.iterations.count { it.status == 'PASS' }
                    }
                    def failCount = totalTests - passCount
                    def successPercentage = (totalTests > 0) ? (passCount * 100.0 / totalTests) : 0
                    def successPercentageStr = String.format("%.1f", successPercentage)

                    def buildParams = [
                        "SU IP Address": params['SU IP Address'],
                        "FW Version (SU)": "${su_fw_version}"
                    ]

                    def istZone = TimeZone.getTimeZone("Asia/Kolkata")
                    def istDate = Calendar.getInstance(istZone).getTime()
                    def currentDateTime = istDate.format("dd MMM yyyy, HH:mm:ss z", istZone)

