
// Functions

def archiveArtifacts(pattern) {
    step([$class: 'ArtifactArchiver', artifacts: pattern, fingerprint: true, onlyIfSuccessful: false])
}


// Main Pipeline

pipeline {
    agent { node { label "${TARGET_STAND}"} }

    stages {
        stage('Prepare tests') {
            steps {
                script {
                    echo "----------------------------------------"
                    echo "--- TARGET STAND: ${TARGET_STAND}"
                    echo "----------------------------------------"
      	        }
      	    }
        }
        stage('Install Python Dependencies') {
            steps {
                script {
                    echo "----------------------------------------"
                    echo "Installing Dependencies"
                    echo "----------------------------------------"
                    sh "sh utilities/requirements.txt"
                }
            }
        }
stage('Download Firmware'){
            steps {
                script {
                    echo "----------------------------------------"
                    echo "Downloading the Build"
                    echo "----------------------------------------"
                    sh "mkdir -p artifacts"
                    sh "pwd"
                    // Ensure you use the correct parameter name from your Jenkins job
                    def customBuildFile = params.UPLOADED_FIRMWARE
                    // Define the log file path once
                    def logFile = "${workspace}/artifacts/flashing-device.log"

                    // --- CHANGED ---
                    // Use simple, sandbox-safe string splitting to get all parts.
                    def parts = params['Build'].split('/')

                    def PLATFORM_ID = ""
                    def BUILD_NUMBER = ""
                    def PROJECT = ""

                    if (parts[-1].trim() == "") {
                        // URL has a trailing slash: https://.../bonsai/5018/debug/343/
                        BUILD_NUMBER = parts[-2]
                        PROJECT = parts[-3]
                        PLATFORM_ID = parts[-4] // This is the new part (e.g., 5018)
                    } else {
                        // URL has no trailing slash: https://.../bonsai/5018/debug/343
                        BUILD_NUMBER = parts[-1]
                        PROJECT = parts[-2]
                        PLATFORM_ID = parts[-3] // This is the new part (e.g., 5018)
                    }

                    if (PROJECT == "" || BUILD_NUMBER == "" || PLATFORM_ID == "") {
                        error "Could not parse PLATFORM_ID, PROJECT, and BUILD_NUMBER from URL: ${params['Build']}"
                    }

                    // --- CHANGED ---
                    // Dynamically create the target filename based on the platform
                    // e.g., "5018" -> "ipq50xx", "6018" -> "ipq60xx"
                    def platformPrefix = PLATFORM_ID.substring(0, 2) // "50" or "60"
                    def TARGET_IMG_FILENAME = "nor-ipq${platformPrefix}xx-apps.img.enc"
                    // --- END OF CHANGE ---

                    echo "Parsed PLATFORM_ID: ${PLATFORM_ID}"
                    echo "Parsed PROJECT: ${PROJECT}"
                    echo "Parsed BUILD_NUMBER: ${BUILD_NUMBER}"
                    echo "Target Image Filename: ${TARGET_IMG_FILENAME}"

                    // Check if a custom build was uploaded
                    if (customBuildFile) {
                        // --- 1. A FILE WAS UPLOADED ---

                        sh "echo 'Using uploaded custom build: ${customBuildFile}' | tee \"${logFile}\""
                        sh "mv -f '${customBuildFile}' ${TARGET_IMG_FILENAME} 2>&1 | tee -a \"${logFile}\""

                        // We still need to download the -apps.tgz file
                        sh "echo 'Downloading -apps.tgz file...' | tee -a \"${logFile}\""
                        // --- CHANGED --- Use dynamic PLATFORM_ID in URL
                        sh "wget --no-verbose --no-parent --no-check-certificate --recursive --level=1 -A '*-apps.tgz' --no-directories https://jenkins.senao.com/bonsai/${PLATFORM_ID}/${PROJECT}/${BUILD_NUMBER}/ 2>&1 | tee -a \"${logFile}\""
                        sh "mv -f *-apps.tgz test_firwmare.tgz 2>&1 | tee -a \"${logFile}\""

                    } else {
                        // --- 2. NO FILE UPLOADED, DOWNLOAD FROM URL ---

                        sh "echo 'No custom build found. Downloading from URL.' | tee \"${logFile}\""
                        // --- CHANGED --- Use dynamic PLATFORM_ID in URL
                        sh "wget --no-verbose --no-parent --no-check-certificate --recursive --level=1 -A '*-B*[0-9]-enc.img,*-apps.tgz' --no-directories https://jenkins.senao.com/bonsai/${PLATFORM_ID}/${PROJECT}/${BUILD_NUMBER}/ 2>&1 | tee -a \"${logFile}\""

                        // Rename the downloaded .tgz file
                        sh "mv -f *-apps.tgz test_firwmare.tgz 2>&1 | tee -a \"${logFile}\""

                        // --- CHANGED ---
                        // Use a safer shell script to find and rename the .img file
                        // This avoids the 'mv: missing destination' error if ls finds nothing
                        sh """
                           #!/bin/bash
                           imgfile=\$(ls *-B*[0-9]-enc.img 2>/dev/null | head -n 1)
                           if [ -n "\$imgfile" ]; then
                               echo "Found image file: \$imgfile. Renaming to ${TARGET_IMG_FILENAME}"
                               mv -f "\$imgfile" "${TARGET_IMG_FILENAME}"
                           else
                               echo "ERROR: No downloaded .img file matching '*-B*[0-9]-enc.img' was found."
                               exit 1
                           fi
                        """ + " 2>&1 | tee -a \"${logFile}\"" // Append logging to the whole block
                    }

                    // Archive the final .img file, regardless of its source
                    // --- CHANGED --- Use dynamic filename variable
                    archiveArtifacts(TARGET_IMG_FILENAME)
                }
            }
        }
        stage('Firmware Upgrade') {
            steps {
                script {

                    def localIP = params['Local IP Address']
                    def remoteIP = params['Remote IP Address']
                    def model = params['Model']
                    def buildURL = params['Build']
                    def single = params['Single Image']

                    echo "Local IP Address: ${localIP}"
                    echo "Remote IP Address: ${remoteIP}"

                    echo "----------------------------------------"
                    echo "Upgrading the Firmware"
                    echo "----------------------------------------"
                    sh "mkdir -p artifacts"
                    //for (int i = 1; i <= FIRMWARE_UPGRADE_COUNT.toInteger() ; i++) {
                    //    sh "pytest -v -s testCases/test_firmwareUpgrade.py::test_Upgrade 2>&1 | tee ${workspace}/artifacts/firmware-upgrade-device.log"
                    //}
                    archiveArtifacts('artifacts/**/*')
                    //archiveArtifacts('SerialLogs_Device.log')
                }
            }
        }
    }
    post {
        always {
            echo "-----------------------------------------"
            echo 'Script Done!'
            echo "-----------------------------------------"
        }

        success {
            echo "-----------------------------------------"
            echo 'Script Success'
            echo "-----------------------------------------"
        }

        failure {
            echo "-----------------------------------------"
            echo 'Script Failure'
            echo "-----------------------------------------"
        }
    }
}