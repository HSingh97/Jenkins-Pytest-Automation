
// Functions

def archiveArtifacts(pattern) {
    step([$class: 'ArtifactArchiver', artifacts: pattern, fingerprint: true, onlyIfSuccessful: false])
}


// Main Pipeline

pipeline {
    agent { node { label "${TARGET_STAND}"} }

    stages {
        stage('Prepare tests') {
            steps {
                script {
                    echo "----------------------------------------"
                    echo "--- TARGET STAND: ${TARGET_STAND}"
                    echo "----------------------------------------"
      	        }
      	    }
        }
        stage('Install Python Dependencies') {
            steps {
                script {
                    echo "----------------------------------------"
                    echo "Installing Dependencies"
                    echo "----------------------------------------"
                    sh "sh utilities/requirements.txt"
                }
            }
        }
        stage('Download Firmware'){
            steps {
                script {
                    echo "----------------------------------------"
                    echo "Downloading the Build"
                    echo "----------------------------------------"
                    sh "mkdir -p artifacts"
                    sh "pwd"
                    // Ensure you use the correct parameter name from your Jenkins job
                    def customBuildFile = params.UPLOADED_FIRMWARE
                    // Define the log file path once
                    def logFile = "${workspace}/artifacts/flashing-device.log"

                    // Extract PROJECT and BUILD_NUMBER from the buildURL
                    // The 'buildURL' (params['Build']) is the full URL, e.g., "https://.../5018/PROJ/123/"
                    // We need to get the last two parts.
                    def parts = new URL(params['Build']).getPath().split('/')
                    def BUILD_NUMBER = parts[-1]
                    def PROJECT = parts[-2]

                    // --- Shell Steps ---
                    stage('Download and Prepare Firmware') {
                        steps {
                            script {
                                // Check if a custom build was uploaded
                                if (customBuildFile) {
                                    // --- 1. A FILE WAS UPLOADED ---

                                    sh "echo 'Using uploaded custom build: ${customBuildFile}' | tee \"${logFile}\""

                                    // Move the uploaded file (which is already in the workspace) to the standard name
                                    // Note: The file parameter variable holds the *original* filename
                                    sh "mv -f '${customBuildFile}' nor-ipq40xx-single-enc.img 2>&1 | tee -a \"${logFile}\""

                                    // We still need to download the -apps.tgz file
                                    sh "echo 'Downloading -apps.tgz file...' | tee -a \"${logFile}\""
                                    sh "wget --no-verbose --no-parent --no-check-certificate --recursive --level=1 -A '*-apps.tgz' --no-directories https://jenkins.senao.com/bonsai/5018/${PROJECT}/${BUILD_NUMBER}/ 2>&1 | tee -a \"${logFile}\""

                                    sh "mv -f *-apps.tgz test_firwmare.tgz 2>&1 | tee -a \"${logFile}\""

                                } else {
                                    // --- 2. NO FILE UPLOADED, DOWNLOAD FROM URL ---

                                    sh "echo 'No custom build found. Downloading from URL.' | tee \"${logFile}\""

                                    // Download *both* file types from the build directory
                                    // Use double quotes (") for the sh step for Groovy variable interpolation
                                    // Use single quotes (') for the -A argument for the shell
                                    // Use escaped quotes (\") for the tee command's file path
                                    sh "wget --no-verbose --no-parent --no-check-certificate --recursive --level=1 -A '*-B*[0-9]-enc.img,*-apps.tgz' --no-directories https://jenkins.senao.com/bonsai/5018/${PROJECT}/${BUILD_NUMBER}/ 2>&1 | tee -a \"${logFile}\""

                                    // Rename the downloaded .tgz file
                                    sh "mv -f *-apps.tgz test_firwmare.tgz 2>&1 | tee -a \"${logFile}\""

                                    // Rename the downloaded .img file
                                    sh "mv -f \$(ls *-B*[0-9]-enc.img) nor-ipq40xx-single-enc.img 2>&1 | tee -a \"${logFile}\""
                                }

                                // Archive the final .img file, regardless of its source
                                archiveArtifacts('nor-ipq40xx-single-enc.img')
                            }
                        }
                    }
                }
            }
        }
        stage('Firmware Upgrade') {
            steps {
                script {

                    def localIP = params['Local IP Address']
                    def remoteIP = params['Remote IP Address']
                    def model = params['Model']
                    def buildURL = params['Build']
                    def single = params['Single Image']

                    echo "Local IP Address: ${localIP}"
                    echo "Remote IP Address: ${remoteIP}"

                    echo "----------------------------------------"
                    echo "Upgrading the Firmware"
                    echo "----------------------------------------"
                    sh "mkdir -p artifacts"
                    //for (int i = 1; i <= FIRMWARE_UPGRADE_COUNT.toInteger() ; i++) {
                    //    sh "pytest -v -s testCases/test_firmwareUpgrade.py::test_Upgrade 2>&1 | tee ${workspace}/artifacts/firmware-upgrade-device.log"
                    //}
                    archiveArtifacts('artifacts/**/*')
                    //archiveArtifacts('SerialLogs_Device.log')
                }
            }
        }
    }
    post {
        always {
            echo "-----------------------------------------"
            echo 'Script Done!'
            echo "-----------------------------------------"
        }

        success {
            echo "-----------------------------------------"
            echo 'Script Success'
            echo "-----------------------------------------"
        }

        failure {
            echo "-----------------------------------------"
            echo 'Script Failure'
            echo "-----------------------------------------"
        }
    }
}