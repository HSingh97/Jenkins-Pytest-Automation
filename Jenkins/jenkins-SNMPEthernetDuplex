pipeline {
    agent any

    stages {
        stage('Prepare Workspace') {
            steps {
                script {
                    echo "=========================================="
                    echo "ETHERNET SPEED & DUPLEX VALIDATION TEST"
                    echo "Stand        : ${params.TARGET_STAND}"
                    echo "SU IP        : ${params.'SU IP Address'}"
                    echo "Iterations   : ${params.ITERATION_COUNT}"
                    echo "=========================================="

                    sh '''
                        mkdir -p logs debug_tables
                        rm -f EthernetSpeedDuplexTest.json test-*.log debug_tables/*.txt Ethernet_Speed_Duplex_Report.html || true
                        echo '{"iterations": []}' > EthernetSpeedDuplexTest.json
                    '''
                }
            }
        }

        stage('Install SNMP Tools') {
            steps {
                sh '''
                    which snmpget > /dev/null 2>&1 || {
                        echo "Installing net-snmp tools..."
                        sudo apt-get update -qq
                        sudo apt-get install -y snmp snmp-mibs-downloader
                    }
                '''
            }
        }

        stage('Run Ethernet Test') {
            steps {
                script {
                    def suIP = params.'SU IP Address'.trim()
                    def count = params.ITERATION_COUNT.trim().toInteger()

                    for (int i = 1; i <= count; i++) {
                        echo "=== ETHERNET TEST ITERATION ${i}/${count} ==="
                        sh """
                            python3 testCases/test_SNMPEthernetDuplex.py \
                                --su-ip '${suIP}' \
                                --iter ${i} \
                            2>&1 | tee test-${i}.log
                        """
                        sh "mv debug_ethernet_table_iter${i}.txt debug_tables/ || true"
                    }
                }
            }
        }

        stage('Generate HTML Report') {
            steps {
                script {
                    def suIP = params.'SU IP Address'
                    def su_fw = "Unknown"
                    try {
                        su_fw = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${suIP} 'cat /etc/version || echo Unknown'", returnStdout: true).trim()
                    } catch (e) { su_fw = "Failed to fetch" }

                    def jsonReport = readJSON file: 'EthernetSpeedDuplexTest.json'
                    def total = jsonReport.iterations?.size() ?: 0
                    def pass = jsonReport.iterations?.count { it.overall_status == 'PASS' } ?: 0
                    def fail = total - pass
                    def rate = total > 0 ? String.format("%.1f", (pass * 100.0 / total)) : "0.0"
                    def now = new Date().format("dd MMM yyyy, HH:mm:ss z", TimeZone.getTimeZone("Asia/Kolkata"))

                    def html = """
                    <html><head><title>Ethernet Speed & Duplex Report</title>
                    <style>
                        body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;background:#f8fafc;color:#1e293b;margin:0;padding:20px;}
                        .container{max-width:1200px;margin:auto;background:white;padding:30px;border-radius:16px;box-shadow:0 10px 30px rgba(0,0,0,0.1);}
                        .header{background:linear-gradient(135deg,#0ea5e9,#3b82f6);color:white;padding:30px;border-radius:12px;text-align:center;margin-bottom:30px;}
                        .header h1{font-size:38px;margin:0;}
                        .info{background:#f0f9ff;padding:20px;border-radius:10px;border-left:6px solid #0ea5e9;margin:20px 0;}
                        .summary{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:20px;margin:30px 0;}
                        .card{background:white;padding:25px;border-radius:12px;text-align:center;box-shadow:0 4px 15px rgba(0,0,0,0.05);border-top:5px solid #0ea5e9;}
                        .card.pass{border-top-color:#10b981;}.card.fail{border-top-color:#ef4444;}
                        .card h3{margin:0 0 10px;color:#475569;}
                        .card .val{font-size:36px;font-weight:bold;color:#0ea5e9;}
                        .card.pass .val{color:#10b981;}.card.fail .val{color:#ef4444;}
                        table{width:100%;border-collapse:collapse;margin:30px 0;background:white;border-radius:12px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,0.05);}
                        th{background:#0ea5e9;color:white;padding:16px;text-align:center;}
                        td{padding:16px;text-align:center;border-bottom:1px solid #e2e8f0;}
                        tr:hover{background:#f8fafc;}
                        .pass{background:#d1fae5;color:#059669;padding:8px 16px;border-radius:50px;font-weight:bold;}
                        .fail{background:#fee2e2;color:#dc2626;padding:8px 16px;border-radius:50px;font-weight:bold;}
                        .btn{background:#0ea5e9;color:white;border:none;padding:10px 20px;border-radius:8px;cursor:pointer;font-weight:bold;}
                        .modal{display:none;position:fixed;z-index:1000;left:0;top:0;width:100%;height:100%;background:rgba(0,0,0,0.8);}
                        .modal-content{background:#1e293b;color:#e2e8f0;margin:5% auto;width:90%;max-width:1000px;border-radius:12px;max-height:80vh;overflow:auto;}
                        .modal-header{padding:20px;background:#0ea5e9;color:white;display:flex;justify-content:space-between;}
                        .close{font-size:40px;cursor:pointer;}
                        pre{padding:30px;margin:0;font-family:Consolas,monospace;font-size:14px;white-space:pre-wrap;}
                    </style>
                    <script>
                        function show(id){document.getElementById('log').innerHTML=document.getElementById(id).innerHTML;document.getElementById('modal').style.display='block';}
                        function closeM(){document.getElementById('modal').style.display='none';}
                    </script>
                    </head>
                    <body>
                        <div class="container">
                            <div class="header"><h1>Ethernet Speed & Duplex Test</h1><p>Senao Networks | Automated Report</p></div>
                            <div class="info">
                                <strong>SU IP:</strong> ${suIP} | <strong>FW:</strong> ${su_fw} | <strong>Ran:</strong> ${now}<br>
                                <strong>Iterations:</strong> ${total} | <strong>Pass Rate:</strong> ${rate}%
                            </div>
                            <div class="summary">
                                <div class="card"><h3>Total</h3><div class="val">${total}</div></div>
                                <div class="card pass"><h3>Passed</h3><div class="val">${pass}</div></div>
                                <div class="card fail"><h3>Failed</h3><div class="val">${fail}</div></div>
                                <div class="card"><h3>Success</h3><div class="val">${rate}%</div></div>
                            </div>
                            <table>
                                <tr><th>Iteration</th><th>Auto-Neg</th><th>1000M Full</th><th>100M Full</th><th>Overall</th><th>Log</th></tr>
                    """

                    def rows = ""
                    def logs = ""

                    jsonReport.iterations.each { r ->
                        def i = r.iteration
                        def a = r.tests.AutoNegotiation.status == "PASS" ? "<span class='pass'>PASS</span>" : "<span class='fail'>FAIL</span>"
                        def g = r.tests."1000MbpsFull".status == "PASS" ? "<span class='pass'>PASS</span>" : "<span class='fail'>FAIL</span>"
                        def f = r.tests."100MbpsFull".status == "PASS" ? "<span class='pass'>PASS</span>" : "<span class='fail'>FAIL</span>"
                        def o = r.overall_status == "PASS" ? "<span class='pass'>PASS</span>" : "<span class='fail'>FAIL</span>"

                        def logText = "Log missing"
                        try { logText = readFile("test-${i}.log").replace("&","&amp;").replace("<","&lt;").replace(">","&gt;") } catch(e) {}

                        rows += "<tr><td><strong>${i}</strong></td><td>${a}</td><td>${g}</td><td>${f}</td><td>${o}</td><td><button class='btn' onclick=\"show('log${i}')\">View</button></td></tr>"
                        logs += "<div id='log${i}' style='display:none;'>${logText}</div>"
                    }

                    html += rows + """
                            </table>
                            <div id="modal" class="modal" onclick="closeM()">
                                <div class="modal-content" onclick="event.stopPropagation()">
                                    <div class="modal-header"><span>Log Output</span><span class="close" onclick="closeM()">X</span></div>
                                    <pre id="log"></pre>
                                </div>
                            </div>
                            ${logs}
                        </div>
                    </body></html>
                    """

                    writeFile file: 'Ethernet_Speed_Duplex_Report.html', text: html
                }
            }
        }
    }

    post {
        always {
            publishHTML([
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: '.',
                reportFiles: 'Ethernet_Speed_Duplex_Report.html',
                reportName: 'Ethernet Speed & Duplex Test Report'
            ])
            archiveArtifacts artifacts: 'EthernetSpeedDuplexTest.json,test-*.log,debug_tables/*.txt,Ethernet_Speed_Duplex_Report.html', allowEmptyArchive: true

            script {
                def user = currentBuild.getBuildCauses()[0]?.userId ?: "unknown"
                def mail = ["puneet":"puneet.sharma@senao.com", "harman":"harmanjot.singh@senao.com"].get(user, "puneet.sharma@senao.com")
                emailext(
                    subject: "Ethernet Test #${BUILD_NUMBER} - ${currentBuild.currentResult}",
                    body: "<h2>Ethernet Speed & Duplex Test Finished</h2><p>SU: ${params.'SU IP Address'}</p><p>See report for details.</p>",
                    to: mail,
                    attachmentsPattern: 'Ethernet_Speed_Duplex_Report.html,EthernetSpeedDuplexTest.json',
                    mimeType: 'text/html'
                )
            }
        }
    }
}