pipeline {
    agent any

    stages {
        stage('Prepare Workspace') {
            steps {
                script {
                    echo "=========================================="
                    echo "ETHERNET SPEED & DUPLEX VALIDATION TEST"
                    echo "Stand        : ${params.TARGET_STAND}"
                    echo "Local IP     : ${params.'Local IP Address'}"
                    echo "Iterations   : ${params.ITERATION_COUNT}"
                    echo "=========================================="

                    sh '''
                        mkdir -p logs debug_tables
                        rm -f EthernetSpeedDuplexTest.json test-*.log debug_tables/*.txt Ethernet_Speed_Duplex_Report.html || true
                        echo '{"iterations": []}' > EthernetSpeedDuplexTest.json
                    '''
                }
            }
        }

        stage('Install SNMP Tools') {
            steps {
                sh '''
                    which snmpget > /dev/null 2>&1 || {
                        echo "Installing net-snmp tools..."
                        sudo apt-get update -qq
                        sudo apt-get install -y snmp snmp-mibs-downloader
                    }
                '''
            }
        }

        stage('Run Ethernet Test') {
            steps {
                script {
                    def localIP = params.'Local IP Address'.trim()
                    def count = params.ITERATION_COUNT.trim().toInteger()

                    for (int i = 1; i <= count; i++) {
                        echo "=== ETHERNET TEST ITERATION ${i}/${count} ==="
                        sh """
                            python3 testCases/test_SNMPEthernetDuplex.py \
                                --su-ip '${localIP}' \
                                --iter ${i} \
                            2>&1 | tee test-${i}.log
                        """
                        sh "mv debug_ethernet_table_iter${i}.txt debug_tables/ || true"
                    }
                }
            }
        }

        stage('Generate HTML Report') {
            steps {
                script {
                    def localIP = params.'Local IP Address'
                    def su_fw = "Unknown"
                    try {
                        su_fw = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${localIP} 'cat /etc/version || echo Unknown'", returnStdout: true).trim()
                    } catch (e) { su_fw = "Failed to fetch" }

                    def jsonReport = readJSON file: 'EthernetSpeedDuplexTest.json'
                    def total = jsonReport.iterations?.size() ?: 0
                    def pass = jsonReport.iterations?.count { it.overall_status == 'PASS' } ?: 0
                    def fail = total - pass
                    def rate = total > 0 ? String.format("%.1f", (pass * 100.0 / total)) : "0.0"
                    def now = new Date().format("dd MMM yyyy, HH:mm:ss z", TimeZone.getTimeZone("Asia/Kolkata"))

                    // Same beautiful HTML report (shortened here for clarity, same as before)
                    def html = """<html><head><title>Ethernet Speed & Duplex Report</title>
                    <style>/* ... same beautiful CSS as previous version ... */</style>
                    <script>function show(id){document.getElementById('log').innerHTML=document.getElementById(id).innerHTML;document.getElementById('modal').style.display='block';} function closeM(){document.getElementById('modal').style.display='none';}</script>
                    </head><body>
                        <div class="container">
                            <div class="header"><h1>Ethernet Speed & Duplex Test</h1><p>Senao Networks | Automated Report</p></div>
                            <div class="info">
                                <strong>Local IP:</strong> ${localIP} | <strong>FW:</strong> ${su_fw} | <strong>Ran:</strong> ${now}<br>
                                <strong>Iterations:</strong> ${total} | <strong>Pass Rate:</strong> ${rate}%
                            </div>
                            <!-- Summary cards & table same as before -->
                    """

                    def rows = ""
                    def logs = ""
                    jsonReport.iterations.each { r ->
                        def i = r.iteration
                        def a = r.tests.AutoNegotiation.status == "PASS" ? "<span class='pass'>PASS</span>" : "<span class='fail'>FAIL</span>"
                        def g = r.tests."1000MbpsFull".status == "PASS" ? "<span class='pass'>PASS</span>" : "<span class='fail'>FAIL</span>"
                        def f = r.tests."100MbpsFull".status == "PASS" ? "<span class='pass'>PASS</span>" : "<span class='fail'>FAIL</span>"
                        def o = r.overall_status == "PASS" ? "<span class='pass'>PASS</span>" : "<span class='fail'>FAIL</span>"

                        def logText = "Log missing"
                        try { logText = readFile("test-${i}.log").replace("&","&amp;").replace("<","&lt;").replace(">","&gt;") } catch(e) {}

                        rows += "<tr><td><strong>${i}</strong></td><td>${a}</td><td>${g}</td><td>${f}</td><td>${o}</td><td><button class='btn' onclick=\"show('log${i}')\">View</button></td></tr>"
                        logs += "<div id='log${i}' style='display:none;'>${logText}</div>"
                    }

                    html += rows + """</table>
                            <div id="modal" class="modal" onclick="closeM()">
                                <div class="modal-content" onclick="event.stopPropagation()">
                                    <div class="modal-header"><span>Log Output</span><span class="close" onclick="closeM()">X</span></div>
                                    <pre id="log"></pre>
                                </div>
                            </div>
                            ${logs}
                        </div></body></html>"""

                    writeFile file: 'Ethernet_Speed_Duplex_Report.html', text: html
                }
            }
        }
    }

    post {
        always {
            publishHTML([
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: '.',
                reportFiles: 'Ethernet_Speed_Duplex_Report.html',
                reportName: 'Ethernet Speed & Duplex Test Report'
            ])
            archiveArtifacts artifacts: 'EthernetSpeedDuplexTest.json,test-*.log,debug_tables/*.txt,Ethernet_Speed_Duplex_Report.html', allowEmptyArchive: true
        }
    }
}