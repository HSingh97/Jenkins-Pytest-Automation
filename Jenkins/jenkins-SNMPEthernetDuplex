import jenkins.model.Jenkins

// Functions
def archiveArtifacts(pattern) {
    step([$class: 'ArtifactArchiver', artifacts: pattern, fingerprint: true, onlyIfSuccessful: false])
}

pipeline {
    agent any

    stages {
        stage('Prepare Workspace') {
            steps {
                script {
                    echo "=========================================="
                    echo "ETHERNET SPEED & DUPLEX VALIDATION TEST"
                    echo "Stand        : ${params.TARGET_STAND}"
                    echo "Local IP     : ${params.'Local IP Address'}"
                    echo "Iterations   : ${params.ITERATION_COUNT}"
                    echo "=========================================="

                    sh '''
                        mkdir -p logs debug_tables
                        rm -f EthernetSpeedDuplexTest.json test-*.log debug_tables/*.txt Ethernet_Speed_Duplex_Report.html || true
                        echo '{"iterations": []}' > EthernetSpeedDuplexTest.json
                    '''
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    echo "----------------------------------------"
                    echo "Installing Dependencies"
                    echo "----------------------------------------"
                }
            }
        }

        stage('Run Ethernet Test') {
            steps {
                script {
                    def localIP = params.'Local IP Address'.trim()
                    def count = params.ITERATION_COUNT.trim().toInteger()

                    for (int i = 1; i <= count; i++) {
                        echo "=== ETHERNET TEST ITERATION ${i}/${count} ==="
                        sh """
                            python3 testCases/test_SNMPEthernetDuplex.py \
                                --su-ip '${localIP}' \
                                --iter ${i} \
                            2>&1 | tee test-${i}.log
                        """
                        sh "mv debug_ethernet_table_iter${i}.txt debug_tables/ || true"
                    }
                }
            }
        }

        stage('Generate HTML Report') {
            steps {
                script {
                    def localIP = params.'Local IP Address'
                    def su_fw = "Unknown"
                    try {
                        su_fw = sh(script: "sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${localIP} 'cat /etc/version || echo Unknown'", returnStdout: true).trim()
                    } catch (e) { su_fw = "Failed to fetch" }

                    def jsonReport = readJSON file: 'EthernetSpeedDuplexTest.json'
                    def total = jsonReport.iterations?.size() ?: 0
                    def pass = jsonReport.iterations?.count { it.overall_status == 'PASS' } ?: 0
                    def fail = total - pass
                    def rate = total > 0 ? String.format("%.1f", (pass * 100.0 / total)) : "0.0"
                    def now = new Date().format("dd MMM yyyy, HH:mm:ss z", TimeZone.getTimeZone("Asia/Kolkata"))

                    def html = """
                    <!DOCTYPE html>
                    <html><head><meta charset="utf-8"><title>Ethernet Speed & Duplex Report</title>
                    <style>
                        body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;background:#f8fafc;color:#1e293b;margin:0;padding:20px;}
                        .c{max-width:1200px;margin:auto;background:white;padding:30px;border-radius:16px;box-shadow:0 10px 30px rgba(0,0,0,0.1);}
                        .h{background:linear-gradient(135deg,#0ea5e9,#3b82f6);color:white;padding:30px;border-radius:12px;text-align:center;margin-bottom:30px;}
                        .h h1{font-size:38px;margin:0;}
                        .i{background:#f0f9ff;padding:20px;border-radius:10px;border-left:6px solid #0ea5e9;margin:20px 0;}
                        .s{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:20px;margin:30px 0;}
                        .cd{background:white;padding:25px;border-radius:12px;text-align:center;box-shadow:0 4px 15px rgba(0,0,0,0.05);border-top:5px solid #0ea5e9;}
                        .cd.pass{border-top-color:#10b981;}.cd.fail{border-top-color:#ef4444;}
                        .cd h3{margin:0 0 10px;color:#475569;}
                        .cd .v{font-size:36px;font-weight:bold;color:#0ea5e9;}
                        .cd.pass .v{color:#10b981;}.cd.fail .v{color:#ef4444;}
                        table{width:100%;border-collapse:collapse;margin:30px 0;background:white;border-radius:12px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,0.05);}
                        th{background:#0ea5e9;color:white;padding:16px;text-align:center;}
                        td{padding:16px;text-align:center;border-bottom:1px solid #e2e8f0;}
                        tr:hover{background:#f8fafc;}
                        .pass{background:#d1fae5;color:#059669;padding:8px 16px;border-radius:50px;font-weight:bold;}
                        .fail{background:#fee2e2;color:#dc2626;padding:8px 16px;border-radius:50px;font-weight:bold;}
                        .btn{background:#0ea5e9;color:white;border:none;padding:10px 20px;border-radius:8px;cursor:pointer;font-weight:bold;}
                        .m{display:none;position:fixed;z-index:1000;left:0;top:0;width:100%;height:100%;background:rgba(0,0,0,0.8);}
                        .mc{background:#1e293b;color:#e2e8f0;margin:5% auto;width:90%;max-width:1000px;border-radius:12px;max-height:80vh;overflow:auto;}
                        .mh{padding:20px;background:#0ea5e9;color:white;display:flex;justify-content:space-between;}
                        .cl{font-size:40px;cursor:pointer;}
                        pre{padding:30px;margin:0;font-family:Consolas,monospace;font-size:14px;white-space:pre-wrap;background:#0f172a;}
                    </style>
                    <script>
                        function s(id){document.getElementById('log').innerHTML=document.getElementById(id).innerHTML;document.getElementById('modal').style.display='block';}
                        function c(){document.getElementById('modal').style.display='none';}
                    </script>
                    </head>
                    <body>
                        <div class="c">
                            <div class="h"><h1>Ethernet Speed & Duplex Test</h1><p>Senao Networks | Automated Report</p></div>
                            <div class="i"><strong>Local IP:</strong> ${localIP} | <strong>FW:</strong> ${su_fw} | <strong>Ran:</strong> ${now}<br><strong>Iterations:</strong> ${total} | <strong>Pass Rate:</strong> ${rate}%</div>
                            <div class="s">
                                <div class="cd"><h3>Total</h3><div class="v">${total}</div></div>
                                <div class="cd pass"><h3>Passed</h3><div class="v">${pass}</div></div>
                                <div class="cd fail"><h3>Failed</h3><div class="v">${fail}</div></div>
                                <div class="cd"><h3>Success</h3><div class="v">${rate}%</div></div>
                            </div>
                            <table>
                                <tr><th>Iteration</th><th>Auto-Neg</th><th>1000M Full</th><th>100M Full</th><th>Overall</th><th>Log</th></tr>
                    """

                    def rows = ""
                    def logs = ""
                    jsonReport.iterations.each { r ->
                        def i = r.iteration
                        def a = r.tests.AutoNegotiation.status == "PASS" ? "<span class='pass'>PASS</span>" : "<span class='fail'>FAIL</span>"
                        def g = r.tests."1000MbpsFull".status == "PASS" ? "<span class='pass'>PASS</span>" : "<span class='fail'>FAIL</span>"
                        def f = r.tests."100MbpsFull".status == "PASS" ? "<span class='pass'>PASS</span>" : "<span class='fail'>FAIL</span>"
                        def o = r.overall_status == "PASS" ? "<span class='pass'>PASS</span>" : "<span class='fail'>FAIL</span>"
                        def logText = "Log missing"
                        try { logText = readFile("test-${i}.log").replace("&","&amp;").replace("<","&lt;").replace(">","&gt;") } catch(e) {}
                        rows += "<tr><td><strong>${i}</strong></td><td>${a}</td><td>${g}</td><td>${f}</td><td>${o}</td><td><button class='btn' onclick=\"s('log${i}')\">View</button></td></tr>"
                        logs += "<div id='log${i}' style='display:none;'>${logText}</div>"
                    }

                    html += rows + """
                            </table>
                            <div id="modal" class="m" onclick="c()">
                                <div class="mc" onclick="event.stopPropagation()">
                                    <div class="mh"><span>Log Output</span><span class="cl" onclick="c()">X</span></div>
                                    <pre id="log"></pre>
                                </div>
                            </div>
                            ${logs}
                        </div></body></html>"""

                    writeFile file: 'Ethernet_Speed_Duplex_Report.html', text: html
                }
            }
        }
    }

    post {
        always {
            publishHTML([allowMissing: false, alwaysLinkToLastBuild: true, keepAll: true, reportDir: '.', reportFiles: 'Ethernet_Speed_Duplex_Report.html', reportName: 'Ethernet Speed & Duplex Test Report'])
            archiveArtifacts artifacts: 'EthernetSpeedDuplexTest.json,test-*.log,debug_tables/*.txt,Ethernet_Speed_Duplex_Report.html', allowEmptyArchive: true
        }
    }
}