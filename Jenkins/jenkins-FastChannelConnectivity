// Functions

def archiveArtifacts(pattern) {
    step([$class: 'ArtifactArchiver', artifacts: pattern, fingerprint: true, onlyIfSuccessful: false])
}

def dateStamp = new Date().format("yyyyMMdd", TimeZone.getTimeZone("Asia/Kolkata"))
def reportFilename = "channel_test_report_${env.BUILD_NUMBER}_${dateStamp}.html"

// Main Pipeline

pipeline {
    agent { node { label "${TARGET_STAND}" } }

    stages {
        stage('Prepare tests') {
            steps {
                script {
                    echo "----------------------------------------"
                    echo "---> TARGET STAND: ${TARGET_STAND}"
                    echo "----------------------------------------"

                    // Detect the best available Python once and store in env var.
                    // Used by all later stages — mirrors logic in requirements.txt
                    // so both always agree on which interpreter to call.
                    env.PYTHON_BIN = sh(
                        script: '''#!/bin/bash
if command -v python3.10 &>/dev/null; then
    echo "python3.10"
else
    echo "python3"
fi
''',
                        returnStdout: true
                    ).trim()

                    echo "Python binary detected: ${env.PYTHON_BIN}"
                }
            }
        }

        // ----------------------------------------------------------------
        // Install Dependencies
        // Wrapped in catchError so a non-fatal pip warning does NOT kill
        // downstream stages. Hard failures still surface as UNSTABLE
        // rather than aborting Channel Testing and Generate Report.
        // ----------------------------------------------------------------
        stage('Install Dependencies') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                script {
                    echo "----------------------------------------"
                    echo "         Installing Dependencies"
                    echo "----------------------------------------"
                    sh '''#!/bin/bash
set -e
bash utilities/requirements1.txt
'''
                    }
                }
            }
        }

        // ----------------------------------------------------------------
        // Channel Testing  (PTMP — 1 local, N remotes)
        // ----------------------------------------------------------------
        stage('Channel Testing') {
            steps {
                script {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                        def localIP       = params['Local IP Address']
                        // PTMP: comma-separated remote IPs e.g. "192.168.1.2,192.168.1.3"
                        def remoteIPsRaw  = params['Remote IP Addresses']
                        def remoteIPList  = remoteIPsRaw.split(',').collect { it.trim() }.findAll { it }
                        def selectedRadio = params['Radio']
                        def bandwidths    = params.Bandwidth.split(',')
                        def countries     = params.Countries.split(',')

                        echo "----------------------------------------"
                        echo " PTMP Mode: 1 Master / ${remoteIPList.size()} Client(s)"
                        remoteIPList.eachWithIndex { ip, idx ->
                            echo "   Remote ${idx + 1}: ${ip}"
                        }
                        echo "----------------------------------------"

                        // Clear old JSON files from previous build
                        sh 'rm -f *_HT*.json iteration_results.json custom_results.json'
                        echo "Cleared old workspace"

                        // Initialise master results file
                        sh "echo '{\"iterations\": []}' > iteration_results.json"

                        def iteration = 1

                        for (country in countries) {
                            echo "--------------------------------------------------------------"
                            echo " Configuring Country : ${country}"
                            echo "--------------------------------------------------------------"

                            // Change country on all devices (local + all remotes)
                            sh """
                                ${PYTHON_BIN} -m pytest -v -s testCases/test_channelTest.py::test_changecountry \
                                --local-ip '${localIP}' --remote-ip '${remoteIPsRaw}' \
                                --radio '${selectedRadio}' --country '${country}' 2>&1
                            """

                            for (bandwidth in bandwidths) {
                                echo "----------------------------------------"
                                echo " Testing: Country=${country}, Bandwidth=${bandwidth}"
                                echo "----------------------------------------"

                                // Reset per-run results file
                                sh "echo '{\"iterations\": []}' > custom_results.json"

                                // Skip HT160 for regions that do not support it
                                if ((country == "Canada" || country == "US 5GHz Non-DFS") && bandwidth == "HT160") {
                                    echo "Skipping HT160 — not supported in ${country}"
                                    continue
                                }

                                def pytest_output = sh(script: """
                                    ${PYTHON_BIN} -m pytest -v -s testCases/test_channelTest.py::test_channelconnectivity \
                                    --local-ip '${localIP}' --remote-ip '${remoteIPsRaw}' \
                                    --radio '${selectedRadio}' --bandwidth '${bandwidth}' \
                                    --country '${country}' --extra '1' 2>&1
                                """, returnStdout: true).trim()

                                echo "Pytest Output:\n${pytest_output}"

                                def iterationResults    = readJSON file: 'custom_results.json'
                                def normalizedBandwidth = bandwidth == "HT40" ? "HT40+" : bandwidth

                                def newTests = iterationResults.iterations.findAll {
                                    it.Country == country && it.Bandwidth == normalizedBandwidth
                                }

                                newTests.each { test ->
                                    test.iteration = iteration++
                                    test.logs = pytest_output
                                }

                                def filename = "${country.trim().replaceAll("\\s+", "_")}_${bandwidth.trim()}.json"
                                writeJSON file: filename, json: [iterations: newTests]

                                // Console summary
                                newTests.each { test ->
                                    echo "Iteration ${test.iteration} - ${test.test} => ${test.status}"
                                    echo "Country: ${test.Country}, Bandwidth: ${test.Bandwidth}"
                                    echo "Channels Tested:"
                                    test['Tested Channels'].each { ch ->
                                        echo "  - Channel: ${ch.channel}, Overall Status: ${ch.status}"
                                        if (ch.remotes) {
                                            ch.remotes.each { ip, data ->
                                                echo "      Remote ${ip}: ${data.status}"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    } // catchError
                }
            }
        }

        // ----------------------------------------------------------------
        // Generate HTML Report
        // ----------------------------------------------------------------
        stage('Generate Report') {
            steps {
                script {
                    def reportFiles = findFiles(glob: '*_HT*.json').findAll {
                        it.name != 'iteration_results.json' && it.length > 20
                    }

                    def allResults = []
                    reportFiles.each { file ->
                        def data = readJSON file: file.name
                        if (data?.iterations && !data.iterations.isEmpty()) {
                            allResults << [filename: file.name, content: data.iterations]
                        }
                    }

                    def localIP      = params['Local IP Address']
                    def remoteIPsRaw = params['Remote IP Addresses']
                    def remoteIPList = remoteIPsRaw.split(',').collect { it.trim() }.findAll { it }

                    // ---- Firmware version: local device ----------------------------------
                    def local_fw_version
                    try {
                        local_fw_version = sh(script: """
                            ssh-keygen -R ${localIP} >/dev/null 2>&1 || true
                            ssh-keyscan -H ${localIP} >> ~/.ssh/known_hosts 2>/dev/null
                            sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${localIP} 'cat /etc/version'
                        """, returnStdout: true).trim()
                    } catch (e) {
                        echo "WARNING: Could not retrieve local firmware version from ${localIP}."
                        local_fw_version = "N/A (device unreachable)"
                    }

                    // ---- Firmware version: each remote -----------------------------------
                    def remoteFWMap = [:]
                    remoteIPList.each { rip ->
                        try {
                            remoteFWMap[rip] = sh(script: """
                                ssh-keygen -R ${rip} >/dev/null 2>&1 || true
                                ssh-keyscan -H ${rip} >> ~/.ssh/known_hosts 2>/dev/null
                                sshpass -p 'admin' ssh -o StrictHostKeyChecking=no root@${rip} 'cat /etc/version'
                            """, returnStdout: true).trim()
                        } catch (e) {
                            echo "WARNING: Could not retrieve firmware version from remote ${rip}."
                            remoteFWMap[rip] = "N/A (device unreachable)"
                        }
                    }

                    def remoteFWDisplay = remoteIPList.collect { rip ->
                        "${rip}: ${remoteFWMap[rip]}"
                    }.join('<br/>')

                    def buildParams = [
                        "Local IP Address"      : localIP,
                        "Remote IP Address(es)" : remoteIPsRaw,
                        "Radio"                 : params['Radio'],
                        "Countries"             : params['Countries'],
                        "Bandwidths"            : params['Bandwidth'],
                        "FW Version (Local)"    : local_fw_version,
                        "FW Version (Remote)"   : remoteFWDisplay
                    ]

                    def istZone         = TimeZone.getTimeZone("Asia/Kolkata")
                    def istDate         = Calendar.getInstance(istZone).getTime()
                    def currentDateTime = istDate.format("dd MMM yyyy, HH:mm:ss z", istZone)
                    def companyLogoUrl  = "https://manuals.plus/wp-content/uploads/2023/06/Senao-Networks-logo.png"
                    def pipelineName    = env.JOB_NAME

                    // ---- HTML head + build params table ----------------------------------
                    def htmlContent = """
                        <html>
                        <head>
                            <title>Channel Test Report</title>
                            <style>
                                body { font-family: 'Segoe UI', Tahoma, sans-serif; padding: 20px; background-color: #f9f9f9; color: #2c3e50; }
                                .header { display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 20px; border-bottom: 2px solid #e0e0e0; }
                                .header img { height: 60px; }
                                .header-info { text-align: right; }
                                .header-info h1 { margin: 0; font-size: 24px; }
                                .header-info p  { margin: 5px 0; font-size: 14px; color: #555; }
                                h2 { margin-top: 40px; font-size: 20px; border-bottom: 2px solid #ddd; padding-bottom: 5px; }
                                table {
                                    width: 100%;
                                    border-collapse: collapse;
                                    margin-top: 15px;
                                    background: #fff;
                                    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
                                    table-layout: auto;
                                }
                                th, td {
                                    padding: 10px 12px;
                                    border: 1px solid #ddd;
                                    text-align: center;
                                    vertical-align: middle;
                                    font-size: 13px;
                                    white-space: nowrap;
                                }
                                th { background: #2c3e50; color: white; }
                                .remote-header { background: #1a252f !important; color: #aad4f5 !important; }
                                table.build-params td, table.build-params th { text-align: left !important; white-space: normal; }
                                tr:nth-child(even) { background-color: #f4f4f4; }
                                .pass    { color: green;  font-weight: bold; }
                                .fail    { color: red;    font-weight: bold; }
                                .badge-pass    { background: #d4edda; color: green;  padding: 2px 8px; border-radius: 5px; font-weight: bold; }
                                .badge-fail    { background: #f8d7da; color: red;    padding: 2px 8px; border-radius: 5px; font-weight: bold; }
                                .badge-partial { background: #fff3cd; color: orange; padding: 2px 8px; border-radius: 5px; font-weight: bold; }
                            </style>
                        </head>
                        <body>
                            <div class="header">
                                <img src="${companyLogoUrl}" alt="Senao Networks" />
                                <div class="header-info">
                                    <h1>Automated Channel Connectivity Report</h1>
                                    <p><strong>Pipeline:</strong> ${pipelineName}</p>
                                    <p><strong>Date:</strong> ${currentDateTime}</p>
                                    <p><strong>Mode:</strong> PTMP &mdash; 1 Master / ${remoteIPList.size()} Client(s)</p>
                                </div>
                            </div>

                            <h2>Build Parameters</h2>
                            <table class="build-params">
                                ${buildParams.collect { k, v -> "<tr><td><b>${k}</b></td><td>${v}</td></tr>" }.join('\n')}
                            </table>
                    """

                    // ---- Per-file (country + bandwidth) section --------------------------
                    allResults.each { resultFile ->
                        def parts     = resultFile.filename.replace('.json', '').split('_')
                        def country   = parts[0..-2].join(' ')
                        def bandwidth = parts[-1]

                        def statuses = resultFile.content.collect { it.status }
                        def iterationStatus = statuses.every { it == "PASS" } ? "PASS" :
                                             (statuses.every { it == "FAIL" } ? "FAIL" : "PARTIAL")

                        def statusBadgeClass = iterationStatus == "PASS"    ? "badge-pass"    :
                                              (iterationStatus == "FAIL"    ? "badge-fail"    : "badge-partial")

                        htmlContent += """
                            <h2>
                                Country: <i><span style="background-color:#ffff99; padding:2px 6px; border-radius:4px;"><b>${country}</b></span></i> &nbsp;|&nbsp;
                                Bandwidth: <i><span style="background-color:#d0ebff; padding:2px 6px; border-radius:4px;"><b>${bandwidth} MHz</b></span></i> &nbsp;|&nbsp;
                                Status: <span class="${statusBadgeClass}">${iterationStatus}</span>
                            </h2>
                            <table>
                        """

                        // ---- Table header row 1: fixed cols + one colspan per remote ----
                        htmlContent += "<tr>"
                        htmlContent += "<th rowspan='2'>Channel</th>"
                        htmlContent += "<th rowspan='2'>Overall<br/>Status</th>"
                        htmlContent += "<th rowspan='2'>Local<br/>Active Ch</th>"
                        htmlContent += "<th rowspan='2'>Local<br/>HTMODE</th>"
                        htmlContent += "<th rowspan='2'>Conf<br/>HTMODE</th>"
                        htmlContent += "<th rowspan='2'>Device<br/>Uptime</th>"
                        htmlContent += "<th rowspan='2'>Local<br/>SNR A1</th>"
                        htmlContent += "<th rowspan='2'>Local<br/>SNR A2</th>"
                        htmlContent += "<th rowspan='2'>Local<br/>Noise</th>"
                        htmlContent += "<th rowspan='2'>Tx Rate</th>"
                        htmlContent += "<th rowspan='2'>Rx Rate</th>"
                        remoteIPList.each { rip ->
                            htmlContent += "<th colspan='8' class='remote-header'>Remote: ${rip}</th>"
                        }
                        htmlContent += "</tr>"

                        // ---- Table header row 2: per-remote sub-columns -----------------
                        htmlContent += "<tr>"
                        remoteIPList.each { rip ->
                            htmlContent += "<th>Status</th>"
                            htmlContent += "<th>Active Ch</th>"
                            htmlContent += "<th>HTMODE</th>"
                            htmlContent += "<th>SNR A1</th>"
                            htmlContent += "<th>SNR A2</th>"
                            htmlContent += "<th>Noise</th>"
                            htmlContent += "<th>Link Uptime</th>"
                            htmlContent += "<th>Ping</th>"
                        }
                        htmlContent += "</tr>"

                        // ---- HT mode validator (reused per row) -------------------------
                        def isHTMatch = { htmode, bw ->
                            def validMap = [
                                "20":  ["11AHE20"],
                                "40":  ["11AHE40PLUS", "11AHE40MINUS"],
                                "80":  ["11AHE80"],
                                "160": ["11AHE160"]
                            ]
                            return validMap[bw]?.contains(htmode?.toUpperCase())
                        }

                        def expectedBW = bandwidth.replaceAll("[^\\d]", "")

                        // ---- Data rows --------------------------------------------------
                        resultFile.content.each { iteration ->
                            iteration["Tested Channels"].each { channel ->
                                def localStats = channel["link_stats"]

                                def overallStatusHtml = channel["status"] == "PASS"
                                    ? "<span class='pass'>&#10003; PASS</span>"
                                    : "<span class='fail'>&#10007; FAIL</span>"

                                def localHT    = channel.local_htmode ?: "-"
                                def localStyle = !isHTMatch(localHT, expectedBW) ? "color:red; font-weight:bold;" : ""

                                htmlContent += "<tr>"
                                htmlContent += "<td>${channel.channel}</td>"
                                htmlContent += "<td>${overallStatusHtml}</td>"
                                htmlContent += "<td>${channel.local_active ?: '-'}</td>"
                                htmlContent += "<td style='${localStyle}'>${localHT}</td>"
                                htmlContent += "<td>${channel.conf_htmode ?: '-'}</td>"
                                htmlContent += "<td>${channel.device_uptime ?: '-'}</td>"
                                htmlContent += "<td>${localStats?.local_SNR_A1 ?: '-'}</td>"
                                htmlContent += "<td>${localStats?.local_SNR_A2 ?: '-'}</td>"
                                htmlContent += "<td>${localStats?.local_noise ?: '-'}</td>"
                                htmlContent += "<td>${localStats?.tx_rate ?: '-'}</td>"
                                htmlContent += "<td>${localStats?.rx_rate ?: '-'}</td>"

                                // Per-remote columns (one group of 8 per remote)
                                remoteIPList.each { rip ->
                                    def rd      = channel?.remotes?.get(rip)
                                    def rStats  = rd?.link_stats ?: [:]
                                    def rStatus = rd?.status ?: "N/A"
                                    def rHT     = rd?.remote_htmode ?: "-"
                                    def rActive = rd?.remote_active ?: "-"
                                    def rPing   = rd?.ping != null ? (rd.ping ? "OK" : "FAIL") : "-"

                                    def rStatusHtml = rStatus == "PASS"
                                        ? "<span class='pass'>&#10003; PASS</span>"
                                        : (rStatus == "FAIL" ? "<span class='fail'>&#10007; FAIL</span>" : rStatus)

                                    def rHTStyle = !isHTMatch(rHT, expectedBW) ? "color:red; font-weight:bold;" : ""

                                    htmlContent += "<td>${rStatusHtml}</td>"
                                    htmlContent += "<td>${rActive}</td>"
                                    htmlContent += "<td style='${rHTStyle}'>${rHT}</td>"
                                    htmlContent += "<td>${rStats?.remote_SNR_A1 ?: '-'}</td>"
                                    htmlContent += "<td>${rStats?.remote_SNR_A2 ?: '-'}</td>"
                                    htmlContent += "<td>${rStats?.remote_noise ?: '-'}</td>"
                                    htmlContent += "<td>${rStats?.link_uptime ?: '-'}</td>"
                                    htmlContent += "<td>${rPing}</td>"
                                }

                                htmlContent += "</tr>"
                            }
                        }

                        htmlContent += "</table>"
                    }

                    htmlContent += "</body></html>"
                    writeFile file: reportFilename, text: htmlContent
                    echo "HTML report generated: ${reportFilename}"
                }
            }
        }
    }

    post {
        always {
            // allowMissing: true — report may not exist if an early stage aborted
            publishHTML(target: [
                allowMissing          : true,
                alwaysLinkToLastBuild : true,
                keepAll               : true,
                reportDir             : '.',
                reportFiles           : "${reportFilename}",
                reportName            : "Channel Test Report - Build ${env.BUILD_NUMBER}"
            ])
            echo "-----------------------------------------"
            echo 'Script Done!'
            echo "-----------------------------------------"
            script {
                def buildCauses   = currentBuild.getBuildCauses()
                def userCause     = buildCauses.find { it._class == 'hudson.model.Cause$UserIdCause' }
                def buildUserName = userCause?.userName ?: "Unknown User"
                def buildUserId   = userCause?.userId   ?: "unknown"

                echo "Build started by: ${buildUserName} (${buildUserId})"

                // ---- Email map — add new users here --------------------------------
                def userEmails = [
                    "harman"  : "harmanjot.singh@senao.com",
                    "mahesh"  : "mahesh.battala@senao.com",
                    "sandeep" : "sandeep.manchikanti@senao.com",
                    "sampath" : "sampath.marella@senao.com",
                    "jayanth" : "jayanth.munnaluru@senao.com",
                    "srilatha": "srilatha.tadiboina@senao.com",
                    "phani"   : "phani.darla@senao.com",
                    "dinesh"  : "dinesh.redddy@senao.com",
                    "puneet"  : "puneet.sharma@senao.com"
                ]

                def userEmail = userEmails.get(buildUserId, "puneet.sharma@senao.com")
                echo "Sending email to: ${userEmail}"

                def remoteIPsRaw = params['Remote IP Addresses']

                emailext(
                    subject: "Jenkins Build: ${currentBuild.fullDisplayName} - ${currentBuild.currentResult}",
                    body: """
                        <html>
                        <body>
                            <h2 style="color:blue;">Jenkins Build Notification</h2>
                            <p><strong>Build Name:</strong> ${currentBuild.fullDisplayName}</p>
                            <p><strong>Status:</strong>
                                <span style="color:${currentBuild.currentResult == 'SUCCESS' ? 'green' : 'red'};">
                                    ${currentBuild.currentResult}
                                </span>
                            </p>
                            <p><strong>Mode:</strong> PTMP</p>
                            <p><strong>Local IP:</strong> ${params['Local IP Address']}</p>
                            <p><strong>Remote IP(s):</strong> ${remoteIPsRaw}</p>
                            <p><strong>Started By:</strong> ${buildUserName} (${buildUserId})</p>
                            <p><strong>Build URL:</strong> <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
                            <p><strong>Console Output:</strong> <a href="${env.BUILD_URL}console">${env.BUILD_URL}console</a></p>
                            <p><strong>HTML Report:</strong> <a href="${env.BUILD_URL}artifact/${reportFilename}">Click here to view</a></p>
                            <br/>
                            <p style="color:gray;">--<br/>Jenkins Automated Notification</p>
                        </body>
                        </html>
                    """,
                    to                : userEmail,
                    mimeType          : 'text/html',
                    attachmentsPattern: "${reportFilename}"
                )
            }
        }

        success {
            echo "-----------------------------------------"
            echo 'Script Success'
            echo "-----------------------------------------"
        }

        failure {
            echo "-----------------------------------------"
            echo 'Script Failure'
            echo "-----------------------------------------"
        }
    }
}